import ExactCriticalCurve.Counting.AffineContainment
import ExactCriticalCurve.Counting.Complements
import Mathlib.LinearAlgebra.Prod
import Mathlib.LinearAlgebra.Dimension.Constructions

noncomputable section
open scoped BigOperators

namespace ExactCriticalCurve.Counting

abbrev BinarySubspaces (V : Type*) [AddCommGroup V] [Module (ZMod 2) V] (r : ℕ) :=
  {U : Submodule (ZMod 2) V // Module.finrank (ZMod 2) U = r}

/-- The Gaussian coefficient is the cardinality of the actual subspace family. -/
def binaryGaussian (n r : ℕ) : ℕ :=
  Nat.card (BinarySubspaces (Fin n → ZMod 2) r)

theorem binaryGaussian_zero (n : ℕ) : binaryGaussian n 0 = 1 := by
  letI : Unique (BinarySubspaces (Fin n → ZMod 2) 0) := {
    default := ⟨⊥, by simp⟩
    uniq U := Subtype.ext ((Submodule.finrank_eq_zero).mp U.property) }
  exact Nat.card_unique

theorem binaryGaussian_eq_zero_of_lt {n r : ℕ} (h : n < r) :
    binaryGaussian n r = 0 := by
  letI : IsEmpty (BinarySubspaces (Fin n → ZMod 2) r) := ⟨fun U => by
    have hle := U.val.finrank_le
    rw [U.property] at hle
    have hn : Module.finrank (ZMod 2) (Fin n → ZMod 2) = n := by simp
    omega⟩
  exact Nat.card_of_isEmpty

section Graph

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

/-- The whole vertical one-dimensional kernel is generated by this vector. -/
def verticalOne : V × ZMod 2 := (0, 1)

def binaryProjectionImage (N : Submodule (ZMod 2) (V × ZMod 2)) :
    Submodule (ZMod 2) V :=
  N.map (LinearMap.fst (ZMod 2) V (ZMod 2))

/-- A graph on an actual, potentially proper, subspace of the first factor. -/
def binaryGraphOn (U : Submodule (ZMod 2) V) (f : U →ₗ[ZMod 2] ZMod 2) :
    Submodule (ZMod 2) (V × ZMod 2) :=
  LinearMap.range (U.subtype.prod f)

@[simp] theorem mem_binaryGraphOn (U : Submodule (ZMod 2) V)
    (f : U →ₗ[ZMod 2] ZMod 2) (x : V × ZMod 2) :
    x ∈ binaryGraphOn U f ↔ ∃ u : U, (u.val, f u) = x := Iff.rfl

@[simp] theorem binaryProjectionImage_graphOn (U : Submodule (ZMod 2) V)
    (f : U →ₗ[ZMod 2] ZMod 2) :
    binaryProjectionImage (binaryGraphOn U f) = U := by
  ext x
  constructor
  · rintro ⟨y, ⟨u, rfl⟩, rfl⟩
    exact u.property
  · intro hx
    exact ⟨(x, f ⟨x, hx⟩), ⟨⟨x, hx⟩, rfl⟩, rfl⟩

theorem verticalOne_not_mem_graphOn (U : Submodule (ZMod 2) V)
    (f : U →ₗ[ZMod 2] ZMod 2) :
    (verticalOne : V × ZMod 2) ∉ binaryGraphOn U f := by
  rintro ⟨u, hu⟩
  have hu0 : u = 0 := Subtype.ext (congrArg Prod.fst hu)
  subst u
  have h := congrArg Prod.snd hu
  simp [verticalOne] at h

theorem finrank_binaryGraphOn [FiniteDimensional (ZMod 2) V]
    (U : Submodule (ZMod 2) V) (f : U →ₗ[ZMod 2] ZMod 2) :
    Module.finrank (ZMod 2) (binaryGraphOn U f) = Module.finrank (ZMod 2) U := by
  apply LinearMap.finrank_range_of_inj
  intro x y h
  exact Subtype.ext (congrArg Prod.fst h)

theorem binaryGraphOn_injective (U : Submodule (ZMod 2) V) :
    Function.Injective (binaryGraphOn U) := by
  intro f g h
  ext x
  have hx : (x.val, f x) ∈ binaryGraphOn U g := by
    rw [← h]
    exact ⟨x, rfl⟩
  obtain ⟨y, hy⟩ := hx
  have hyx : y = x := Subtype.ext (congrArg Prod.fst hy)
  simpa [hyx] using (congrArg Prod.snd hy).symm

/-- In the binary case, omitting the vertical unit excludes the entire nonzero kernel. -/
theorem fst_injective_of_verticalOne_not_mem (N : Submodule (ZMod 2) (V × ZMod 2))
    (hN : (verticalOne : V × ZMod 2) ∉ N) :
    Function.Injective ((LinearMap.fst (ZMod 2) V (ZMod 2)).domRestrict N) := by
  apply LinearMap.ker_eq_bot.mp
  apply bot_unique
  intro x hx
  have hx0 : x.val.1 = 0 := hx
  have hs : x.val.2 = 0 := by
    have hcases : x.val.2 = 0 ∨ x.val.2 = 1 := by
      generalize x.val.2 = b
      fin_cases b <;> simp
    rcases hcases with hz | ho
    · exact hz
    · exfalso
      apply hN
      have he : x.val = verticalOne := Prod.ext hx0 ho
      rw [← he]
      exact x.property
  exact Subtype.ext (Prod.ext hx0 hs)

/-- Restriction of the coordinate projection to its actual image. -/
def binaryProjectionToImage (N : Submodule (ZMod 2) (V × ZMod 2)) :
    N →ₗ[ZMod 2] binaryProjectionImage N :=
  ((LinearMap.fst (ZMod 2) V (ZMod 2)).domRestrict N).codRestrict
    (binaryProjectionImage N) (fun x => ⟨x.val, x.property, rfl⟩)

theorem binaryProjectionToImage_surjective (N : Submodule (ZMod 2) (V × ZMod 2)) :
    Function.Surjective (binaryProjectionToImage N) := by
  rintro ⟨x, y, hy, rfl⟩
  exact ⟨⟨y, hy⟩, rfl⟩

/-- The projection is an isomorphism when the vertical unit is absent. -/
def binaryProjectionEquiv (N : Submodule (ZMod 2) (V × ZMod 2))
    (hN : (verticalOne : V × ZMod 2) ∉ N) :
    N ≃ₗ[ZMod 2] binaryProjectionImage N :=
  LinearEquiv.ofBijective (binaryProjectionToImage N) ⟨
    fun _ _ h => fst_injective_of_verticalOne_not_mem N hN
      (congrArg Subtype.val h), binaryProjectionToImage_surjective N⟩

/-- The unique graph function of a subspace missing the vertical kernel. -/
def binaryGraphFunction (N : Submodule (ZMod 2) (V × ZMod 2))
    (hN : (verticalOne : V × ZMod 2) ∉ N) :
    binaryProjectionImage N →ₗ[ZMod 2] ZMod 2 :=
  ((LinearMap.snd (ZMod 2) V (ZMod 2)).domRestrict N).comp
    (binaryProjectionEquiv N hN).symm.toLinearMap

theorem eq_binaryGraphOn (N : Submodule (ZMod 2) (V × ZMod 2))
    (hN : (verticalOne : V × ZMod 2) ∉ N) :
    N = binaryGraphOn (binaryProjectionImage N) (binaryGraphFunction N hN) := by
  ext x
  constructor
  · intro hx
    refine ⟨binaryProjectionEquiv N hN ⟨x, hx⟩, ?_⟩
    apply Prod.ext
    · rfl
    · change ((binaryProjectionEquiv N hN).symm
        (binaryProjectionEquiv N hN ⟨x, hx⟩)).val.2 = x.2
      rw [LinearEquiv.symm_apply_apply]
  · rintro ⟨u, rfl⟩
    let y := (binaryProjectionEquiv N hN).symm u
    have hy : y.val.1 = u.val := by
      exact congrArg Subtype.val ((binaryProjectionEquiv N hN).apply_symm_apply u)
    have he : (u.val, binaryGraphFunction N hN u) = y.val := by
      apply Prod.ext
      · exact hy.symm
      · rfl
    change (u.val, binaryGraphFunction N hN u) ∈ N
    rw [he]
    exact y.property

/-- All points over a prescribed projected subspace. -/
def binaryFullExtension (U : Submodule (ZMod 2) V) :
    Submodule (ZMod 2) (V × ZMod 2) := U.prod ⊤

def binaryFullExtensionEquiv (U : Submodule (ZMod 2) V) :
    binaryFullExtension U ≃ₗ[ZMod 2] (U × ZMod 2) where
  toFun x := (⟨x.val.1, x.property.1⟩, x.val.2)
  invFun x := ⟨(x.1.val, x.2), x.1.property, Submodule.mem_top⟩
  left_inv x := by rfl
  right_inv x := by rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem finrank_binaryFullExtension [FiniteDimensional (ZMod 2) V]
    (U : Submodule (ZMod 2) V) :
    Module.finrank (ZMod 2) (binaryFullExtension U) = Module.finrank (ZMod 2) U + 1 := by
  rw [(binaryFullExtensionEquiv U).finrank_eq, Module.finrank_prod]
  simp

@[simp] theorem binaryProjectionImage_fullExtension (U : Submodule (ZMod 2) V) :
    binaryProjectionImage (binaryFullExtension U) = U := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact hy.1
  · intro hx
    exact ⟨(x, 0), ⟨hx, Submodule.mem_top⟩, rfl⟩

theorem verticalOne_mem_fullExtension (U : Submodule (ZMod 2) V) :
    (verticalOne : V × ZMod 2) ∈ binaryFullExtension U :=
  ⟨U.zero_mem, Submodule.mem_top⟩

/-- A subspace containing the kernel is the full inverse image of its image. -/
theorem eq_binaryFullExtension (N : Submodule (ZMod 2) (V × ZMod 2))
    (hN : (verticalOne : V × ZMod 2) ∈ N) :
    N = binaryFullExtension (binaryProjectionImage N) := by
  ext x
  constructor
  · intro hx
    exact ⟨⟨x, hx, rfl⟩, Submodule.mem_top⟩
  · intro hx
    obtain ⟨y, hy, hyx⟩ := hx.1
    have hv : (0, x.2 - y.2) ∈ N := by
      simpa [verticalOne] using N.smul_mem (x.2 - y.2) hN
    have he : y + (0, x.2 - y.2) = x := by
      apply Prod.ext
      · simpa using hyx
      · simp
    rw [← he]
    exact N.add_mem hy hv

/-- Every omitted-kernel subspace occurs exactly once as a graph over its image. -/
def binaryGraphEquiv [FiniteDimensional (ZMod 2) V] (r : ℕ) :
    (Σ U : BinarySubspaces V r, U.val →ₗ[ZMod 2] ZMod 2) ≃
      {N : BinarySubspaces (V × ZMod 2) r // verticalOne ∉ N.val} := by
  let F : (Σ U : BinarySubspaces V r, U.val →ₗ[ZMod 2] ZMod 2) →
      {N : BinarySubspaces (V × ZMod 2) r // verticalOne ∉ N.val} :=
    fun P => ⟨⟨binaryGraphOn P.1.val P.2,
      (finrank_binaryGraphOn _ _).trans P.1.property⟩, verticalOne_not_mem_graphOn _ _⟩
  refine Equiv.ofBijective F ⟨?_, ?_⟩
  · rintro ⟨U, f⟩ ⟨W, g⟩ h
    have hgraph : binaryGraphOn U.val f = binaryGraphOn W.val g :=
      congrArg (fun N => N.val.val) h
    have hUW : U = W := Subtype.ext (by
      have hi := congrArg binaryProjectionImage hgraph
      simpa only [binaryProjectionImage_graphOn] using hi)
    subst W
    have hfg := binaryGraphOn_injective U.val hgraph
    subst g
    rfl
  · intro N
    let U : BinarySubspaces V r := ⟨binaryProjectionImage N.val.val, by
      rw [← (binaryProjectionEquiv N.val.val N.property).finrank_eq]
      exact N.val.property⟩
    refine ⟨⟨U, binaryGraphFunction N.val.val N.property⟩, ?_⟩
    apply Subtype.ext
    apply Subtype.ext
    exact (eq_binaryGraphOn N.val.val N.property).symm

/-- Every containing-kernel subspace is the unique full inverse image of its image. -/
def binaryFullExtensionEquivSubspaces [FiniteDimensional (ZMod 2) V] (r : ℕ) :
    BinarySubspaces V r ≃
      {N : BinarySubspaces (V × ZMod 2) (r + 1) // verticalOne ∈ N.val} := by
  let F : BinarySubspaces V r →
      {N : BinarySubspaces (V × ZMod 2) (r + 1) // verticalOne ∈ N.val} :=
    fun U => ⟨⟨binaryFullExtension U.val, by
      rw [finrank_binaryFullExtension, U.property]⟩, verticalOne_mem_fullExtension _⟩
  refine Equiv.ofBijective F ⟨?_, ?_⟩
  · intro U W h
    apply Subtype.ext
    have he : binaryFullExtension U.val = binaryFullExtension W.val :=
      congrArg (fun N => N.val.val) h
    have hi := congrArg binaryProjectionImage he
    simpa only [binaryProjectionImage_fullExtension] using hi
  · intro N
    let U : BinarySubspaces V r := ⟨binaryProjectionImage N.val.val, by
      have hd := N.val.property
      rw [eq_binaryFullExtension N.val.val N.property, finrank_binaryFullExtension] at hd
      exact Nat.add_right_cancel hd⟩
    refine ⟨U, ?_⟩
    apply Subtype.ext
    apply Subtype.ext
    exact (eq_binaryFullExtension N.val.val N.property).symm

/-- The exhaustive dimension-graded split into containing-kernel and graph subspaces. -/
def binarySubspacesProdEquiv [FiniteDimensional (ZMod 2) V] (r : ℕ) :
    BinarySubspaces (V × ZMod 2) (r + 1) ≃
      (BinarySubspaces V r ⊕
        (Σ U : BinarySubspaces V (r + 1), U.val →ₗ[ZMod 2] ZMod 2)) := by
  classical
  exact (Equiv.Set.sumCompl
    {N : BinarySubspaces (V × ZMod 2) (r + 1) | verticalOne ∈ N.val}).symm.trans
      (Equiv.sumCongr (binaryFullExtensionEquivSubspaces r).symm
        (binaryGraphEquiv (r + 1)).symm)

instance finiteBinarySubspaces [Finite V] (r : ℕ) : Finite (BinarySubspaces V r) :=
  Finite.of_injective (fun U : BinarySubspaces V r => (U.val : Set V))
    (fun _ _ h => Subtype.ext (SetLike.coe_injective h))

/-- Counting the exhaustive projection/graph decomposition. -/
theorem card_binarySubspaces_prod [FiniteDimensional (ZMod 2) V] (r : ℕ) :
    Nat.card (BinarySubspaces (V × ZMod 2) (r + 1)) =
      Nat.card (BinarySubspaces V r) +
        2 ^ (r + 1) * Nat.card (BinarySubspaces V (r + 1)) := by
  classical
  letI : Finite V := Finite.of_equiv
    (Fin (Module.finrank (ZMod 2) V) → ZMod 2)
    (Module.finBasis (ZMod 2) V).equivFun.toEquiv.symm
  letI : Fintype (BinarySubspaces V (r + 1)) := Fintype.ofFinite _
  letI (U : BinarySubspaces V (r + 1)) : Finite (U.val →ₗ[ZMod 2] ZMod 2) :=
    Finite.of_injective DFunLike.coe DFunLike.coe_injective
  rw [Nat.card_congr (binarySubspacesProdEquiv (V := V) r), Nat.card_sum, Nat.card_sigma]
  have hcard (U : BinarySubspaces V (r + 1)) :
      Nat.card (U.val →ₗ[ZMod 2] ZMod 2) = 2 ^ (r + 1) := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2),
      Module.finrank_linearMap (R := ZMod 2) (S := ZMod 2)]
    simp [U.property, Nat.card_eq_fintype_card]
  simp only [hcard, Finset.sum_const, Finset.card_univ, smul_eq_mul,
    Nat.card_eq_fintype_card]
  ac_rfl

end Graph

/-- Concrete splitting of the last-dimensional coordinate space. -/
def binaryCoordinatesSucc (n : ℕ) :
    (Fin (n + 1) → ZMod 2) ≃ₗ[ZMod 2] ((Fin n → ZMod 2) × ZMod 2) where
  toFun x := (Fin.tail x, x 0)
  invFun x := Fin.cons x.2 x.1
  left_inv x := by
    funext i
    exact Fin.cases rfl (fun _ => rfl) i
  right_inv x := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Pascal recurrence from actual subspaces and complete projection fibers. -/
theorem binaryGaussian_succ (n r : ℕ) :
    binaryGaussian (n + 1) (r + 1) =
      binaryGaussian n r + 2 ^ (r + 1) * binaryGaussian n (r + 1) := by
  unfold binaryGaussian
  rw [Nat.card_congr (subspacesOfFinrankEquiv (binaryCoordinatesSucc n) (r + 1))]
  exact card_binarySubspaces_prod r

/-- The affine containment count in binary coordinates is the actual Gaussian count. -/
theorem card_affineSupportsContaining_binary (n : ℕ)
    (A₀ : AffineSubspace (ZMod 2) (Fin n → ZMod 2)) (hA₀ : Nonempty A₀)
    (m : ℕ) (hm : Module.finrank (ZMod 2) A₀.direction ≤ m) :
    Nat.card (AffineSupportsContaining A₀ m) =
      binaryGaussian (n - Module.finrank (ZMod 2) A₀.direction)
        (m - Module.finrank (ZMod 2) A₀.direction) := by
  have hd : Module.finrank (ZMod 2) (Fin n → ZMod 2) = n := by simp
  have h := card_affineSupportsContaining_eq_coordinateSubspaces A₀ hA₀ m hm
  rw [hd] at h
  exact h


end ExactCriticalCurve.Counting
