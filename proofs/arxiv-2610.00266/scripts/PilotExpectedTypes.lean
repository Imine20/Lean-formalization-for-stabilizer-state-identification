open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let modules := #[`ExactCriticalCurve.FiniteQuadratic.BinaryAlternatingWitt,
    `ExactCriticalCurve.FiniteQuadratic.SymplecticTupleOrbits]
  let mut declarations := 0
  let mut theorems := 0
  let mut closure : CollectAxioms.State := {}
  for (name, info) in env.constants.toList do
    let inPackage := match env.getModuleIdxFor? name with
      | some idx => modules.contains env.header.moduleNames[idx]!
      | none => false
    if inPackage then
      declarations := declarations + 1
      if let .thmInfo _ := info then theorems := theorems + 1
      if let .axiomInfo _ := info then throwError "Unproved project axiom: {name}"
      let (_, next) := ((CollectAxioms.collect name).run env).run closure
      closure := next
      for ax in closure.axioms do
        unless #[`propext, `Classical.choice, `Quot.sound].contains ax do
          throwError "Forbidden transitive axiom {ax} in {name}"
      logInfo m!"NEW_DECLARATION_AXIOMS_OK {name}"
  logInfo m!"PROJECT_AXIOMS_UNION {closure.axioms}"
  logInfo m!"PROJECT_AUDIT_OK declarations={declarations} theorems={theorems}"


open Lean Elab Command Meta in
def auditOrdinaryProductDefinition (actual expected : Name) : CommandElabM Unit := do
  liftTermElabM do
    let actualInfo ← getConstInfo actual
    let expectedInfo ← getConstInfo expected
    unless actualInfo.levelParams.length == expectedInfo.levelParams.length do
      throwError "Universe generality mismatch: {actual}"
    let levelParams := (List.range actualInfo.levelParams.length).map
      (fun i => Name.mkSimple ("auditUniverse" ++ toString i))
    let levels := levelParams.map Level.param
    let term := mkConst actual levels
    let expectedTerm := mkConst expected levels
    let expectedType ← inferType expectedTerm
    -- Abstract all universe-polymorphic typeclass and index parameters on expected definitions.
    let expectedValue ← forallTelescope expectedType fun args _ => do
      let body := mkAppN expectedTerm args
      mkForallFVars args body
    unless ← isDefEq (← inferType term) expectedValue do
      throwError "Exact theorem type mismatch: {actual}\nactual: {← inferType term}\nexpected: {expectedValue}"
    -- Check both the theorem constant and its original proof body directly in
    -- the kernel against the independently constructed expected type.
    -- addDeclCore has no skipKernelTC option and returns synchronously.
    let kernelEnv := (← getEnv).toKernelEnv
    let heartbeatLimit := (Core.getMaxHeartbeats (← getOptions)).toUSize
    for (label, proof) in #[
        ("constant", term),
        ("body", actualInfo.instantiateValueLevelParams! levels)] do
      let witnessName ← mkFreshUserName (Name.mkSimple ("kernelAudit_" ++ label))
      let decl : Declaration := .defnDecl {
        name := witnessName
        levelParams := levelParams
        type := expectedValue
        value := proof
        hints := .opaque
        safety := .safe
      }
      let _ ← ofExceptKernelException <|
        Kernel.Environment.addDeclCore kernelEnv heartbeatLimit decl none
      logInfo m!"KERNEL_EXPECTED_DEFINITION_OK {label} {actual}"
  let axioms ← collectAxioms actual
  for ax in axioms do
    unless #[`propext, `Classical.choice, `Quot.sound].contains ax do
      throwError "Forbidden transitive axiom {ax} in {actual}"
  logInfo m!"EXACT_DEFINITION_TYPE_AND_AXIOMS_OK {actual}"



namespace OrdinaryScalarProductsExpected
open ExactCriticalCurve.Quantum ExactCriticalCurve.Counting
def Overlap (n k r : ℕ) : ℂ :=
  (((2 : ℂ)^n)^r)⁻¹ * ∏ j ∈ Finset.range r, ((2 : ℂ)^n + (2 : ℂ)^(k-2*r-1+j))
def Scalar (n k r : ℕ) : ℂ :=
  ∏ j ∈ Finset.range r, ((2 : ℂ)^n + (2 : ℂ)^(k-r-1+j))
def ProductType := ℕ → ℕ → ℕ → ℂ
example (n k r : ℕ) : ordinaryOverlapProduct n k r = Overlap n k r := rfl
example (n k r : ℕ) : ordinaryScalarProduct n k r = Scalar n k r := rfl
def OverlapZero : Prop := ∀ n k : ℕ, Overlap n k 0 = 1
def ScalarZero : Prop := ∀ n k : ℕ, Scalar n k 0 = 1
def OverlapNonzero : Prop := ∀ n k r : ℕ, Overlap n k r ≠ 0
def WeightedSum : Prop := ∀ n k r : ℕ,
  (∑ ell ∈ Finset.range (r+1), (binaryGaussian r ell : ℂ) *
    (2 : ℂ)^(ell*(k-2*r-1)+ell.choose 2) * (((2 : ℂ)^n)^ell)⁻¹) = Overlap n k r
def Split : Prop := ∀ n k r : ℕ, 2*r < k →
  gnwNormalization n k = gnwNormalization n (k-2*r) *
    (∏ j ∈ Finset.range r, ((2 : ℂ)^n + (2 : ℂ)^(k-2*r-1+j))) * Scalar n k r
def Ratio : Prop := ∀ n k r : ℕ, 2*r < k →
  (gnwNormalization n k * (((2 : ℂ)^n)^r)⁻¹ * (gnwNormalization n (k-2*r))⁻¹) /
    Overlap n k r = Scalar n k r
