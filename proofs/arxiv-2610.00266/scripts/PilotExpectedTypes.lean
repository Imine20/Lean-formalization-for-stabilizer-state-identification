  Module.finrank (ZMod 2) L = r →
  ∀ U : Submodule (ZMod 2) V, (∀ x ∈ U, Q x = 0) →
    ((∀ W : Submodule (ZMod 2) V, (∀ x ∈ W, Q x = 0) → U ≤ W → W = U) ↔
    Module.finrank (ZMod 2) U = r)

