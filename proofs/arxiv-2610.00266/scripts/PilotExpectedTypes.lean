namespace OrthogonalQuotientExpected
universe u v
open ExactCriticalCurve ExactCriticalCurve.FiniteQuadratic Module
open scoped BigOperators

def Embeddable {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (Q : QuadraticForm (ZMod 2) V) (E : Type v) [AddCommGroup E] [Module (ZMod 2) E] :=
  {q : QuadraticForm (ZMod 2) E // ∃ f : E →ₗ[ZMod 2] V,
    Function.Injective f ∧ ∀ x, Q (f x)=q x}
def Quotients {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (Q : QuadraticForm (ZMod 2) V) (n : ℕ) :=
  Σ K : Submodule (ZMod 2) (Fin n → ZMod 2), Embeddable Q ((Fin n → ZMod 2) ⧸ K)

def Descent : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E],
    ∀ (K : Submodule (ZMod 2) E) (q : QuadraticForm (ZMod 2) (E ⧸ K)),
    K ≤ LinearMap.ker (q.comp K.mkQ).polarBilin ∧
      (∀ x ∈ K, (q.comp K.mkQ) x=0)

def DescentApply : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E],
    ∀ (K : Submodule (ZMod 2) E) (q : QuadraticForm (ZMod 2) (E ⧸ K)),
    (quadraticQuotientEquivDescent K q).val=q.comp K.mkQ

def RealizationEmbedding : Prop :=
  ∀ {E : Type u} {V : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    [AddCommGroup V] [Module (ZMod 2) V],
    ∀ (K : Submodule (ZMod 2) E) (q : QuadraticForm (ZMod 2) (E ⧸ K))
      (Q : QuadraticForm (ZMod 2) V),
    (∃ f : E →ₗ[ZMod 2] V, LinearMap.ker f=K ∧ ∀ x, Q (f x)=q (K.mkQ x)) ↔
    (∃ g : (E ⧸ K) →ₗ[ZMod 2] V, Function.Injective g ∧ ∀ x, Q (g x)=q x)

def RealizationCriterion : Prop :=
  ∀ {E : Type u} {V : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) E] [FiniteDimensional (ZMod 2) V] [Fintype V],
    ∀ (K : Submodule (ZMod 2) E) [Fintype (E ⧸ K)]
      (q : QuadraticForm (ZMod 2) (E ⧸ K)) (Q : QuadraticForm (ZMod 2) V),
    LinearMap.BilinForm.Nondegenerate Q.polarBilin →
    ((∃ f : E →ₗ[ZMod 2] V, LinearMap.ker f=K ∧ ∀ x, Q (f x)=q (K.mkQ x)) ↔
      finrank (ZMod 2) (E ⧸ K)+finrank (ZMod 2) (LinearMap.ker q.polarBilin) ≤ finrank (ZMod 2) V ∧
      (finrank (ZMod 2) (E ⧸ K)+finrank (ZMod 2) (LinearMap.ker q.polarBilin) < finrank (ZMod 2) V ∨
        binaryQuadraticGaussSum q=0 ∨ binaryQuadraticGaussSum Q=binaryQuadraticGaussSum q))

def MapInjective : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V],
    ∀ (Q : QuadraticForm (ZMod 2) V) (n : ℕ), Function.Injective (quadraticQuotientInvariantMap Q n)
def MapSurjective : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V],
    ∀ (Q : QuadraticForm (ZMod 2) V) (n : ℕ), Function.Surjective (quadraticQuotientInvariantMap Q n)
def ActualAverage : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V],
    ∀ (Q : QuadraticForm (ZMod 2) V), LinearMap.BilinForm.Nondegenerate Q.polarBilin →
    ∀ n : ℕ,
    (∑ g : BinaryQuadraticIsometryGroup Q, ((2 : ℚ)^n)^
      finrank (ZMod 2) (Counting.fixedSubmodule (ZMod 2) V g)) /
      (Nat.card (BinaryQuadraticIsometryGroup Q) : ℚ) = (Nat.card (Quotients Q n) : ℚ)

def DescentEquivType :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E], ∀ K : Submodule (ZMod 2) E,
    QuadraticForm (ZMod 2) (E ⧸ K) ≃
      {q : QuadraticForm (ZMod 2) E // K ≤ LinearMap.ker q.polarBilin ∧ ∀ x ∈ K, q x=0}
def EmbeddableType :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V],
    QuadraticForm (ZMod 2) V → (E : Type v) → [AddCommGroup E] → [Module (ZMod 2) E] → Type v
def InvariantMapType :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V],
    ∀ (Q : QuadraticForm (ZMod 2) V) (n : ℕ), Quotients Q n → Set.range (quadraticTupleInvariant Q n)
def RealizedEquivType :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V],
    ∀ (Q : QuadraticForm (ZMod 2) V) (n : ℕ), Set.range (quadraticTupleInvariant Q n) ≃ Quotients Q n
def OrbitEquivType :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V],
    ∀ (Q : QuadraticForm (ZMod 2) V), LinearMap.BilinForm.Nondegenerate Q.polarBilin →
    ∀ n : ℕ, MulAction.orbitRel.Quotient (BinaryQuadraticIsometryGroup Q) (Fin n → V) ≃ Quotients Q n

example {E : Type u} [AddCommGroup E] [Module (ZMod 2) E]
    (K : Submodule (ZMod 2) E) (q : QuadraticForm (ZMod 2) (E ⧸ K)) :
    (quadraticQuotientEquivDescent K q).val=q.comp K.mkQ := rfl
example {E : Type u} [AddCommGroup E] [Module (ZMod 2) E]
    (K : Submodule (ZMod 2) E)
    (q : {q : QuadraticForm (ZMod 2) E // K ≤ LinearMap.ker q.polarBilin ∧ TotallySingular q K}) :
    (quadraticQuotientEquivDescent K).symm q =
      quotientForm q.val K q.property.2 (fun x hx y =>
        congrArg (fun l : E →ₗ[ZMod 2] ZMod 2 => l y) (q.property.1 hx)) := rfl
example {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (Q : QuadraticForm (ZMod 2) V) (E : Type v) [AddCommGroup E] [Module (ZMod 2) E] :
    EmbeddableQuadraticForm Q E =
      {q : QuadraticForm (ZMod 2) E // ∃ f : E →ₗ[ZMod 2] V,
        Function.Injective f ∧ ∀ x, Q (f x)=q x} := rfl
example {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (Q : QuadraticForm (ZMod 2) V) (n : ℕ) (p : Quotients Q n) :
    (quadraticQuotientInvariantMap Q n p).val=(p.1,p.2.val.comp p.1.mkQ) := rfl
example {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (Q : QuadraticForm (ZMod 2) V) (n : ℕ) (p : Quotients Q n) :
    ((quadraticTupleRealizedEquivQuotients Q n).symm p).val=(p.1,p.2.val.comp p.1.mkQ) := rfl
example {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (Q : QuadraticForm (ZMod 2) V) (hQ : LinearMap.BilinForm.Nondegenerate Q.polarBilin) (n : ℕ) :
    quadraticTupleOrbitEquivQuotients Q hQ n =
      (quadraticTupleOrbitEquivRealized Q hQ n).trans (quadraticTupleRealizedEquivQuotients Q n) := rfl
end OrthogonalQuotientExpected
