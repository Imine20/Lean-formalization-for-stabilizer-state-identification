namespace MatrixPolynomialSupportExpected
open ExactCriticalCurve Matrix Polynomial Classical
open scoped BigOperators Polynomial ComplexOrder

-- Independently written actual polynomial and its ordinary algebraic evaluation.
def Poly {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι ℂ) (h : A.IsHermitian) : ℝ[X] :=
  1 - ∏ i ∈ Finset.univ.filter (fun i => h.eigenvalues i ≠ 0),
    (1 - Polynomial.C ((h.eigenvalues i)⁻¹) * Polynomial.X)

def Proj {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι ℂ) (h : A.IsHermitian) : Matrix ι ι ℂ :=
  Polynomial.aeval A (Poly A h)

def SpectralEval {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ (A : Matrix ι ι ℂ) (h : A.IsHermitian) (p : ℝ[X]),
    Polynomial.aeval A p = (h.eigenvectorUnitary : Matrix ι ι ℂ) *
      Matrix.diagonal (fun i => ((p.eval (h.eigenvalues i) : ℝ) : ℂ)) *
      star (h.eigenvectorUnitary : Matrix ι ι ℂ)

def PolyType {ι : Type*} [Fintype ι] [DecidableEq ι] :=
  (A : Matrix ι ι ℂ) → A.IsHermitian → ℝ[X]

def ZeroValue {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ (A : Matrix ι ι ℂ) (h : A.IsHermitian), (Poly A h).eval 0=0

def ZeroConstant {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ (A : Matrix ι ι ℂ) (h : A.IsHermitian), (Poly A h).coeff 0=0

def EigenvalueValue {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ (A : Matrix ι ι ℂ) (h : A.IsHermitian) (i : ι),
    (Poly A h).eval (h.eigenvalues i) = if h.eigenvalues i=0 then 0 else 1

def ProjType {ι : Type*} [Fintype ι] [DecidableEq ι] :=
  (A : Matrix ι ι ℂ) → A.IsHermitian → Matrix ι ι ℂ

def SpectralProj {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ (A : Matrix ι ι ℂ) (h : A.IsHermitian),
    Proj A h = (h.eigenvectorUnitary : Matrix ι ι ℂ) *
      Matrix.diagonal (fun i => if h.eigenvalues i=0 then (0 : ℂ) else 1) *
      star (h.eigenvectorUnitary : Matrix ι ι ℂ)

def Positive {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ (A : Matrix ι ι ℂ) (h : A.IsHermitian), (Proj A h).PosSemidef

def Hermitian {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ (A : Matrix ι ι ℂ) (h : A.IsHermitian), (Proj A h).IsHermitian

def Idempotent {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ (A : Matrix ι ι ℂ) (h : A.IsHermitian), Proj A h * Proj A h = Proj A h

def LeftSupport {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ (A : Matrix ι ι ℂ) (h : A.IsHermitian), Proj A h * A=A

def RightSupport {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ (A : Matrix ι ι ℂ) (h : A.IsHermitian), A * Proj A h=A

def ActualRange {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ (A : Matrix ι ι ℂ) (h : A.IsHermitian),
    LinearMap.range (Proj A h).mulVecLin = LinearMap.range A.mulVecLin

def ExistsSupport {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ (A : Matrix ι ι ℂ), A.IsHermitian →
    ∃ p : ℝ[X], p.coeff 0=0 ∧
      (Polynomial.aeval A p).IsHermitian ∧
      (Polynomial.aeval A p)*(Polynomial.aeval A p)=Polynomial.aeval A p ∧
      LinearMap.range (Polynomial.aeval A p).mulVecLin = LinearMap.range A.mulVecLin ∧
      (Polynomial.aeval A p)*A=A

-- Both definition contents are checked against the independent construction,
-- not only against the much weaker function type.
example {ι : Type*} [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℂ) (h : A.IsHermitian) :
