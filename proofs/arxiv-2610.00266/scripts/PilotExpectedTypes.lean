set_option maxHeartbeats 2400000

def CompositionMembership : Prop :=
  ∀ {k : ℕ} (T U : StochasticLagrangian k) (x z : Fin k → ZMod 2),
    (x,z) ∈ LinearMap.range (relationOuterMap T U) ↔
      ∃ y : Fin k → ZMod 2, (x,y) ∈ T.carrier ∧ (y,z) ∈ U.carrier

def DifferenceOrthogonal : Prop :=
  ∀ {k : ℕ} (T U : StochasticLagrangian k),
    (binaryDotForm k).orthogonal (LinearMap.range (relationMiddleDifference T U)) =
      (T.carrier.comap (LinearMap.inr (ZMod 2) (Fin k → ZMod 2) (Fin k → ZMod 2))) ⊓
      (U.carrier.comap (LinearMap.inl (ZMod 2) (Fin k → ZMod 2) (Fin k → ZMod 2)))

def MatchingDimension : Prop :=
  ∀ {k : ℕ} (T U : StochasticLagrangian k),
    finrank (ZMod 2) ↥(LinearMap.ker (relationMiddleDifference T U)) =
      k + finrank (ZMod 2) ↥(T.rightDefect ⊓ U.leftDefect)

def CompositionDimension : Prop :=
  ∀ {k : ℕ} (T U : StochasticLagrangian k),
    finrank (ZMod 2) ↥(LinearMap.range (relationOuterMap T U)) = k

def FiberCoset : Prop :=
  ∀ {k : ℕ} (T U : StochasticLagrangian k) (x z y₀ : Fin k → ZMod 2),
    (x,y₀) ∈ T.carrier → (y₀,z) ∈ U.carrier →
    ∀ y : Fin k → ZMod 2,
      ((x,y) ∈ T.carrier ∧ (y,z) ∈ U.carrier) ↔
        y-y₀ ∈ (T.carrier.comap (LinearMap.inr (ZMod 2) (Fin k → ZMod 2) (Fin k → ZMod 2))) ⊓
        (U.carrier.comap (LinearMap.inl (ZMod 2) (Fin k → ZMod 2) (Fin k → ZMod 2)))

def FiberCardinality : Prop :=
  ∀ {k : ℕ} (T U : StochasticLagrangian k) (x z : Fin k → ZMod 2),
    Nat.card {y : Fin k → ZMod 2 // (x,y) ∈ T.carrier ∧ (y,z) ∈ U.carrier} =
      if (x,z) ∈ LinearMap.range (relationOuterMap T U)
      then 2 ^ finrank (ZMod 2) ↥(T.rightDefect ⊓ U.leftDefect) else 0

def MatrixEntryCount : Prop :=
  ∀ {k : ℕ} (T U : StochasticLagrangian k) (x z : Fin k → ZMod 2),
    (∑ y : Fin k → ZMod 2,
      (if (x,y) ∈ T.carrier then (1 : ℂ) else 0) *
      (if (y,z) ∈ U.carrier then (1 : ℂ) else 0)) =
      (Nat.card {y : Fin k → ZMod 2 // (x,y) ∈ T.carrier ∧ (y,z) ∈ U.carrier} : ℂ)

def MatrixProduct : Prop :=
  ∀ {k : ℕ} (T U : StochasticLagrangian k),
    (fun x z : Fin k → ZMod 2 => ∑ y : Fin k → ZMod 2,
      (if (x,y) ∈ T.carrier then (1 : ℂ) else 0) *
      (if (y,z) ∈ U.carrier then (1 : ℂ) else 0)) =
      ((2 : ℂ) ^ finrank (ZMod 2) ↥(T.rightDefect ⊓ U.leftDefect)) •
        (fun x z : Fin k → ZMod 2 =>
          if (x,z) ∈ LinearMap.range (relationOuterMap T U) then (1 : ℂ) else 0)

def PhysicalProduct : Prop :=
  ∀ {k : ℕ} (n : ℕ) (T U : StochasticLagrangian k),
    (fun X Z : Fin n → (Fin k → ZMod 2) => ∑ Y : Fin n → (Fin k → ZMod 2),
      (∏ a, if (X a,Y a) ∈ T.carrier then (1 : ℂ) else 0) *
      (∏ a, if (Y a,Z a) ∈ U.carrier then (1 : ℂ) else 0)) =
      (((2 : ℂ) ^ n) ^ finrank (ZMod 2) ↥(T.rightDefect ⊓ U.leftDefect)) •
      (fun X Z : Fin n → (Fin k → ZMod 2) =>
        ∏ a, if (X a,Z a) ∈ LinearMap.range (relationOuterMap T U) then (1 : ℂ) else 0)

def DoubleOrbit : Prop :=
  ∀ {k : ℕ} (T U : StochasticLagrangian k),
    (∃ g h : StochasticIsometryGroup k, stochasticLagrangianAction g h T = U) ↔
      finrank (ZMod 2) ↥(T.carrier.comap
        (LinearMap.inr (ZMod 2) (Fin k → ZMod 2) (Fin k → ZMod 2))) =
      finrank (ZMod 2) ↥(U.carrier.comap
        (LinearMap.inr (ZMod 2) (Fin k → ZMod 2) (Fin k → ZMod 2))) ∧
      (((0 : Fin k → ZMod 2),(fun _ : Fin k => (1 : ZMod 2))) ∈ T.carrier ↔
       ((0 : Fin k → ZMod 2),(fun _ : Fin k => (1 : ZMod 2))) ∈ U.carrier)

def DifferenceType : Type :=
  ∀ {k : ℕ} (T U : StochasticLagrangian k),
    (T.carrier × U.carrier) →ₗ[ZMod 2] (Fin k → ZMod 2)
def MatchingType : Type :=
  ∀ {k : ℕ} (T U : StochasticLagrangian k),
    Submodule (ZMod 2) (T.carrier × U.carrier)
def OuterType : Type :=
  ∀ {k : ℕ} (T U : StochasticLagrangian k),
    ↥(LinearMap.ker (relationMiddleDifference T U)) →ₗ[ZMod 2]
      ((Fin k → ZMod 2) × (Fin k → ZMod 2))
def CompositionType : Type :=
  ∀ {k : ℕ} (T U : StochasticLagrangian k),
    Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))
def KernelEquivType : Type :=
  ∀ {k : ℕ} (T U : StochasticLagrangian k),
    ↥(T.rightDefect ⊓ U.leftDefect) ≃ₗ[ZMod 2] ↥(LinearMap.ker (relationOuterMap T U))
def LagrangianCompositionType : Type :=
  ∀ {k : ℕ}, StochasticLagrangian k → StochasticLagrangian k → StochasticLagrangian k
def FiberType : Type 1 :=
  ∀ {k : ℕ}, StochasticLagrangian k → StochasticLagrangian k →
    (Fin k → ZMod 2) → (Fin k → ZMod 2) → Type
def FiberEquivType : Type :=
  ∀ {k : ℕ} (T U : StochasticLagrangian k) (x z y₀ : Fin k → ZMod 2),
    (x,y₀) ∈ T.carrier → (y₀,z) ∈ U.carrier →
      ↥(T.rightDefect ⊓ U.leftDefect) ≃
        {y : Fin k → ZMod 2 // (x,y) ∈ T.carrier ∧ (y,z) ∈ U.carrier}

example {k : ℕ} (T U : StochasticLagrangian k) (p : T.carrier × U.carrier) :
    relationMiddleDifference T U p = p.1.val.2-p.2.val.1 := rfl
example {k : ℕ} (T U : StochasticLagrangian k) :
    (stochasticLagrangianComposition T U).carrier = LinearMap.range (relationOuterMap T U) := rfl
example {k : ℕ} (T U : StochasticLagrangian k) (p : RelationMatching T U) :
    relationOuterMap T U p = (p.val.1.val.1,p.val.2.val.2) := rfl

end StochasticCompositionExpected

