example (k r : ℕ) : oddGradeRankPolynomialQ k r =
  if r=k/2 then Polynomial.X else
    Polynomial.X*(Polynomial.X-Polynomial.C ((if k%8=1 ∨ k%8=7 then (1 : ℚ) else -1)*2^(k/2-r-1)))*
      (Polynomial.X+Polynomial.C ((2 : ℚ)^(2*(k/2-r)-1)))*
      (∏ j ∈ Finset.range (k/2-r-1), (Polynomial.X^2-Polynomial.C ((4 : ℚ)^j)))*
      Polynomial.C ((binaryOrthogonalFactor (k/2-r) (if k%8=1 ∨ k%8=7 then 1 else -1))⁻¹) := rfl
example (k r : ℕ) : evenTwoGradeRankPolynomialQ k r =
  if k=2*r+2 then Polynomial.X*(Polynomial.X+1)*Polynomial.C ((2 : ℚ)⁻¹) else
    (Polynomial.X*(Polynomial.X+1)*Polynomial.C ((2 : ℚ)⁻¹))*
      ((Polynomial.X-1)*(∏ j ∈ Finset.range (k/2-r-2), (Polynomial.X^2-Polynomial.C ((4 : ℚ)^(j+1))))*
        (Polynomial.X+Polynomial.C ((4 : ℚ)^(k/2-r-1)))*Polynomial.C ((binarySymplecticFactor (k/2-r-1))⁻¹)) := rfl
example (k r : ℕ) : exceptionalGradeRankPolynomialQ k r =
  if r<k/2 then
    (Polynomial.X-Polynomial.C ((if k%8=0 then (1 : ℚ) else -1)*2^(k/2-r-1)))*
      (Polynomial.X+Polynomial.C ((2 : ℚ)^(2*(k/2-r)-1)))*
      (∏ j ∈ Finset.range (k/2-r-1), (Polynomial.X^2-Polynomial.C ((4 : ℚ)^j)))*
      Polynomial.C ((binaryOrthogonalFactor (k/2-r) (if k%8=0 then 1 else -1))⁻¹)
  else if r=k/2 ∧ k%8=0 then 1 else 0 := rfl
example (k r : ℕ) : rawFixedCSSRankPolynomialQ k r =
  if h : Nonempty (ExactCriticalCurve.Binary.OrdinaryDefect k r) then
    let N := Classical.choice h
    (∑ g : CSSQuotientIsometryGroup N.val N.property.1,
      Polynomial.X^Module.finrank (ZMod 2) (fixedSubmodule (ZMod 2) (CSSQuotient N.val) g))*
        Polynomial.C ((Nat.card (CSSQuotientIsometryGroup N.val N.property.1) : ℚ)⁻¹)
  else 0 := rfl
example (k r : ℕ) : evenZeroGradeRankPolynomialQ k r =
  rawFixedCSSRankPolynomialQ k r-rawFixedCSSRankPolynomialQ k (r+1)-
    exceptionalGradeRankPolynomialQ k (r+1) := rfl
example {k : ℕ} (hk : 0<k) : physicalSectorRankPolynomialQ hk =
  (fun a => match a with
    | .inl r => if 4∣k then evenZeroGradeRankPolynomialQ k r.val.val
