open Lean Elab Command Meta in
def auditSymplecticDefinition (actual expected : Name) : CommandElabM Unit := do
  liftTermElabM do
    let info ← getConstInfo actual
    let expectedInfo ← getConstInfo expected
    unless info.levelParams.length == expectedInfo.levelParams.length do
      throwError "Definition universe generality mismatch: {actual}"
    let levelParams := (List.range info.levelParams.length).map
      (fun i => Name.mkSimple ("auditUniverse" ++ toString i))
    let levels := levelParams.map Level.param
    let term := mkConst actual levels
    let expectedTerm := mkConst expected levels
    let expectedType ← inferType expectedTerm
    let expectedValue ← forallTelescope expectedType fun args _ => do
      mkForallFVars args (mkAppN expectedTerm args)
    unless ← isDefEq (← inferType term) expectedValue do
      throwError "Independent definition type mismatch {actual}"
    let kernelEnv := (← getEnv).toKernelEnv
    let limit := (Core.getMaxHeartbeats (← getOptions)).toUSize
    for (label, value) in #[
        ("constant", term), ("body", info.instantiateValueLevelParams! levels)] do
      let name ← mkFreshUserName (Name.mkSimple ("definitionAudit_" ++ label))
      let decl : Declaration := .defnDecl {
        name := name, levelParams := levelParams, type := expectedValue, value := value,
        hints := .opaque, safety := .safe
      }
      let _ ← ofExceptKernelException <| Kernel.Environment.addDeclCore kernelEnv limit decl none
      logInfo m!"KERNEL_EXPECTED_DEFINITION_OK {label} {actual}"

namespace AlternatingWittExpected
universe u v
open ExactCriticalCurve.FiniteQuadratic Module

def Symmetry : Prop := ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
  (B : LinearMap.BilinForm (ZMod 2) V), B.IsAlt → B.IsSymm

def FiberType : Type (max u v + 1) :=
  ∀ {V : Type u} {W : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    [AddCommGroup W] [Module (ZMod 2) W],
    LinearMap.BilinForm (ZMod 2) V → (W →ₗ[ZMod 2] V) →
      (W →ₗ[ZMod 2] ZMod 2) → Type u

def FiberCard : Prop :=
  ∀ {V : Type u} {W : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    [AddCommGroup W] [Module (ZMod 2) W] [Fintype V] [Fintype W]
    (B : LinearMap.BilinForm (ZMod 2) V), B.IsAlt → B.Nondegenerate →
    ∀ (f : W →ₗ[ZMod 2] V), Function.Injective f →
    ∀ (l : W →ₗ[ZMod 2] ZMod 2),
      Fintype.card W * Fintype.card {y : V // ∀ s, B y (f s) = l s} = Fintype.card V

def Exterior : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [Fintype V]
    (B : LinearMap.BilinForm (ZMod 2) V), B.IsAlt → B.Nondegenerate →
    ∀ (S : Submodule (ZMod 2) V) (f : S →ₗ[ZMod 2] V),
    Function.Injective f → (∀ s t : S, B (f s) (f t) = B s.val t.val) →
    ∀ (x : V), x ∉ S →
      ∃ y : V, y ∉ LinearMap.range f ∧ ∀ s : S, B y (f s) = B x s.val

def Step : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) V), B.IsAlt → B.Nondegenerate →
    ∀ (S : Submodule (ZMod 2) V) (f : S →ₗ[ZMod 2] V),
    Function.Injective f → (∀ s t : S, B (f s) (f t) = B s.val t.val) →
    ∀ (x : V), x ∉ S →
      ∃ g : ↥(S ⊔ Submodule.span (ZMod 2) {x}) →ₗ[ZMod 2] V,
        Function.Injective g ∧ (∀ z w, B (g z) (g w) = B z.val w.val) ∧
        ∀ s : S, g ⟨s.val, (show S ≤ S ⊔ Submodule.span (ZMod 2) {x} from le_sup_left) s.property⟩ = f s

def EmbeddingExtension : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) V), B.IsAlt → B.Nondegenerate →
    ∀ (S : Submodule (ZMod 2) V) (f : S →ₗ[ZMod 2] V),
    Function.Injective f → (∀ s t : S, B (f s) (f t) = B s.val t.val) →
      ∃ e : V ≃ₗ[ZMod 2] V, (∀ v w, B (e v) (e w) = B v w) ∧
        ∀ s : S, e s.val = f s

def WittExtension : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) V), B.IsAlt → B.Nondegenerate →
    ∀ (S T : Submodule (ZMod 2) V) (f : S ≃ₗ[ZMod 2] T),
    (∀ s t : S, B (f s).val (f t).val = B s.val t.val) →
      ∃ e : V ≃ₗ[ZMod 2] V, (∀ v w, B (e v) (e w) = B v w) ∧
        ∀ s : S, e s.val = (f s).val

example {V : Type u} {W : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    [AddCommGroup W] [Module (ZMod 2) W] (B : LinearMap.BilinForm (ZMod 2) V)
    (f : W →ₗ[ZMod 2] V) (l : W →ₗ[ZMod 2] ZMod 2) :
    alternatingPairingFiber B f l = {y : V // ∀ s, B y (f s) = l s} := rfl
end AlternatingWittExpected

