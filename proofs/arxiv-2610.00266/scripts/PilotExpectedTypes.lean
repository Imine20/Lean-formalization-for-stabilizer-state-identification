def ExtractRight {ι α : Type*} [Fintype ι] [Fintype α] : Prop :=
  ∀ F : α → Matrix ι ι ℂ, (∀ i, F i*F i=F i) →
    (∀ i j, i≠j → F i*F j=0) → ∀ (c : α → ℝ) (i : α),
    (∑ j, c j • F j)*F i=c i • F i

def ExtractLeft {ι α : Type*} [Fintype ι] [Fintype α] : Prop :=
  ∀ F : α → Matrix ι ι ℂ, (∀ i, F i*F i=F i) →
    (∀ i j, i≠j → F i*F j=0) → ∀ (c : α → ℝ) (i : α),
    F i*(∑ j, c j • F j)=c i • F i

def Independent {ι α : Type*} [Fintype ι] [Fintype α] : Prop :=
  ∀ F : α → Matrix ι ι ℂ, (∀ i, F i*F i=F i) →
    (∀ i j, i≠j → F i*F j=0) → (∀ i, F i≠0) → LinearIndependent ℝ F

def SpanDimension {ι α : Type*} [Fintype ι] [Fintype α] : Prop :=
  ∀ F : α → Matrix ι ι ℂ, (∀ i, F i*F i=F i) →
    (∀ i j, i≠j → F i*F j=0) → (∀ i, F i≠0) →
    Module.finrank ℝ (Submodule.span ℝ (Set.range F))=Fintype.card α

def CoefficientInjective {ι α : Type*} [Fintype ι] [Fintype α] : Prop :=
  ∀ F : α → Matrix ι ι ℂ, (∀ i, F i*F i=F i) →
    (∀ i j, i≠j → F i*F j=0) → (∀ i, F i≠0) →
    Function.Injective (fun c : α → ℝ => ∑ i, c i • F i)

def ContainingSpace {ι α : Type*} [Fintype ι] [Fintype α] : Prop :=
  ∀ F : α → Matrix ι ι ℂ, (∀ i, F i*F i=F i) →
    (∀ i j, i≠j → F i*F j=0) → (∀ i, F i≠0) →
    ∀ A : Submodule ℝ (Matrix ι ι ℂ), (∀ i, F i∈A) →
    Module.finrank ℝ A≤Fintype.card α → A=Submodule.span ℝ (Set.range F)

def UniqueExpansion {ι α : Type*} [Fintype ι] [Fintype α] : Prop :=
  ∀ F : α → Matrix ι ι ℂ, (∀ i, F i*F i=F i) →
    (∀ i j, i≠j → F i*F j=0) → (∀ i, F i≠0) →
    ∀ A : Submodule ℝ (Matrix ι ι ℂ), (∀ i, F i∈A) →
    Module.finrank ℝ A≤Fintype.card α →
    ∀ X : Matrix ι ι ℂ, X∈A → ∃! c : α → ℝ, X=∑ i, c i • F i

def ScalarAction {ι α : Type*} [Fintype ι] [Fintype α] : Prop :=
  ∀ F : α → Matrix ι ι ℂ, (∀ i, F i*F i=F i) →
    (∀ i j, i≠j → F i*F j=0) →
    ∀ (X : Matrix ι ι ℂ) (c : α → ℝ), X=∑ i, c i • F i →
    ∀ i, X*F i=c i • F i ∧ F i*X=c i • F i

def CornerUnit {ι α : Type*} [Fintype ι] [Fintype α] : Prop :=
  ∀ F : α → Matrix ι ι ℂ, (∀ i, F i*F i=F i) →
    (∀ i j, i≠j → F i*F j=0) → (∀ i, F i≠0) →
    ∀ A : Submodule ℝ (Matrix ι ι ℂ), (∀ i, F i∈A) →
    Module.finrank ℝ A≤Fintype.card α →
    ∀ U : Matrix ι ι ℂ, U∈A → (∀ i, U*F i=F i) → U=∑ i, F i

