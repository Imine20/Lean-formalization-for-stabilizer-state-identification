namespace CriticalCurveExpected
open ExactCriticalCurve ExactCriticalCurve.Binary ExactCriticalCurve.Quantum Matrix

def ConcreteQuadraticConjugation : Prop :=
  ∀ {n : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (p : (Fin n → ZMod 2) →ₗ[ZMod 2] L) (q : StabilizerPhaseData L) (g : PauliLabel n),
    (Matrix.diagonal (fun x => Complex.I ^ (q.phase (p x)).val)) * pauliOperator g *
        (Matrix.diagonal (fun x => Complex.I ^ (q.phase (p x)).val))ᴴ =
      pauliOperator ⟨g.phase + q.phase (p g.shift), g.shift,
        g.clock + (fun i => q.polar (p g.shift) (p (Pi.single i 1)))⟩

def ConcreteHadamardConjugation : Prop :=
  ∀ {n : ℕ} (a b c d : Fin n → ZMod 2), binaryDot b a = 1 →
    (((Real.sqrt 2 : ℂ)⁻¹) • (pauliMatrix a 0 + pauliMatrix 0 b)) *
      pauliMatrix c d *
        (((Real.sqrt 2 : ℂ)⁻¹) • (pauliMatrix a 0 + pauliMatrix 0 b)) =
      if binaryDot d a = binaryDot b c
      then pauliSign (binaryDot d a) • pauliMatrix c d
      else pauliMatrix (c+a) (d+b)

def ConcreteComputationalOrbit : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n),
    ∃ U : ((pauliUnitaryRepresentation n).range).normalizer,
      cliffordStabilizer U (computationalStabilizerGroup n) = S

def ConcreteCliffordTransitivity : Prop :=
  ∀ {n : ℕ} (S T : StabilizerGroup n),
    ∃ U : ((pauliUnitaryRepresentation n).range).normalizer, cliffordStabilizer U S = T

def ConcreteProjectorOrbit : Prop :=
  ∀ n : ℕ, Set.range (@stabilizerProjection n) =
    Set.range (fun U : ((pauliUnitaryRepresentation n).range).normalizer =>
      U.val.val * Matrix.vecMulVec
        (fun x : Fin n → ZMod 2 => if x = 0 then (1 : ℂ) else 0)
        (star (fun x : Fin n → ZMod 2 => if x = 0 then (1 : ℂ) else 0)) *
      U.val.valᴴ)

def ConcreteTensorCovariance : Prop :=
  ∀ {n : ℕ} (U : ((pauliUnitaryRepresentation n).range).normalizer)
    (S : StabilizerGroup n) (k : ℕ),
    matrixTensorPower k (stabilizerProjection (cliffordStabilizer U S)) =
      matrixTensorPower k U.val.val * matrixTensorPower k (stabilizerProjection S) *
        (matrixTensorPower k U.val.val)ᴴ

def ConcreteRayTransitivity : Prop :=
  ∀ n k : ℕ, ∀ S T : StabilizerGroup n,
    ∃ R : PGM.RaySymmetry (stabilizerSynthesis n k), R.permutation S = T

def ConcretePGMAttainment : Prop :=
  ∀ n k : ℕ,
    (∑ S : StabilizerGroup n, (Matrix.trace ((stabilizerPrettyGoodMeasurement n k).effect S *
      matrixTensorPower k (stabilizerProjection S))).re) / Fintype.card (StabilizerGroup n) =
      ((Matrix.trace (CFC.sqrt ((stabilizerSynthesis n k)ᴴ * stabilizerSynthesis n k))).re /
        Fintype.card (StabilizerGroup n)) ^ 2

def ConcretePGMOptimum : Prop :=
  ∀ n k : ℕ,
    IsGreatest {v : ℝ | ∃ M : POVM (Fin k → (Fin n → ZMod 2)) (StabilizerGroup n),
      (∑ S : StabilizerGroup n, (Matrix.trace (M.effect S *
        matrixTensorPower k (stabilizerProjection S))).re) /
          Fintype.card (StabilizerGroup n) = v}
      (((Matrix.trace (CFC.sqrt ((stabilizerSynthesis n k)ᴴ * stabilizerSynthesis n k))).re /
        Fintype.card (StabilizerGroup n)) ^ 2)

def ConcreteDecodedBound {Γ : Type*} [Fintype Γ] : Prop :=
  ∀ n k : ℕ, ∀ (M : POVM (Fin k → (Fin n → ZMod 2)) Γ)
    (decoder : Γ → StabilizerGroup n → ℝ),
    (∀ g S, 0 ≤ decoder g S) → (∀ g, ∑ S, decoder g S = 1) →
    (∑ S : StabilizerGroup n, ∑ g : Γ, decoder g S *
      (Matrix.trace (M.effect g * matrixTensorPower k (stabilizerProjection S))).re) /
        Fintype.card (StabilizerGroup n) ≤
      ((Matrix.trace (CFC.sqrt ((stabilizerSynthesis n k)ᴴ * stabilizerSynthesis n k))).re /
        Fintype.card (StabilizerGroup n)) ^ 2

def ConcretePGMPointwise : Prop :=
  ∀ n k : ℕ, ∀ S : StabilizerGroup n,
    (Matrix.trace ((stabilizerPrettyGoodMeasurement n k).effect S *
      matrixTensorPower k (stabilizerProjection S))).re =
      ((Matrix.trace (CFC.sqrt ((stabilizerSynthesis n k)ᴴ * stabilizerSynthesis n k))).re /
        Fintype.card (StabilizerGroup n)) ^ 2

def ConcreteMinimaxOptimum : Prop :=
  ∀ n k : ℕ,
    IsGreatest {v : ℝ | ∃ M : POVM (Fin k → (Fin n → ZMod 2)) (StabilizerGroup n),
      ∀ S : StabilizerGroup n, v ≤
        (Matrix.trace (M.effect S * matrixTensorPower k (stabilizerProjection S))).re}
      (((Matrix.trace (CFC.sqrt ((stabilizerSynthesis n k)ᴴ * stabilizerSynthesis n k))).re /
        Fintype.card (StabilizerGroup n)) ^ 2)

end CriticalCurveExpected

