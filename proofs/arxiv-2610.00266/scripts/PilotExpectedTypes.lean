def Pi (n k : ℕ) : Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ :=
  (Fintype.card (StochasticIsometryGroup k) : ℂ)⁻¹ •
    ∑ g : StochasticIsometryGroup k, stochasticIsometryMatrix n g
def Q (n k : ℕ) : Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ :=
  if 4 ∣ k then 1-cssColumnProjection n (wuLine k) else 1
def O (n k r : ℕ) : Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ :=
  ∑ N : OrdinaryDefect k r, (Pi n k * Q n k) * cssColumnProjection n N.val * (Pi n k * Q n k)ᴴ
def E (n k r : ℕ) : Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ :=
  ∑ N : ExceptionalDefect k r, Pi n k * cssColumnProjection n N.val * (Pi n k)ᴴ
def OP (n k r : ℕ) : Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ :=
  hermitianSupportProjection (O n k r) (ordinaryFixedCSSSum_posSemidef n k r).isHermitian
def EP (n k r : ℕ) : Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ :=
  hermitianSupportProjection (E n k r) (exceptionalFixedCSSSum_posSemidef n k r).isHermitian

def FilterType := (n k : ℕ) → Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ
def FamilyType := (n k r : ℕ) → Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ
example (n k : ℕ) : ordinaryCSSBranchFilter n k = Q n k := rfl
example (n k r : ℕ) : ordinaryFixedCSSSum n k r = O n k r := rfl
example (n k r : ℕ) : exceptionalFixedCSSSum n k r = E n k r := rfl
example (n k r : ℕ) : ordinaryFixedCSSProjection n k r = OP n k r := rfl
example (n k r : ℕ) : exceptionalFixedCSSProjection n k r = EP n k r := rfl

def BranchRange : Prop := ∀ n k r,
  (rawCSSFiltration n k r).map (Q n k).mulVecLin = ordinaryCSSFiltration n k r
def OPositive : Prop := ∀ n k r, (O n k r).PosSemidef
def EPositive : Prop := ∀ n k r, (E n k r).PosSemidef
def ORange : Prop := ∀ n k r,
  LinearMap.range (O n k r).mulVecLin = ordinaryCSSFiltration n k r ⊓ LinearMap.range (Pi n k).mulVecLin
def ERange : Prop := ∀ n k r,
  LinearMap.range (E n k r).mulVecLin = exceptionalCSSFiltration n k r ⊓ LinearMap.range (Pi n k).mulVecLin
def OPPositive : Prop := ∀ n k r, (OP n k r).PosSemidef
def EPPositive : Prop := ∀ n k r, (EP n k r).PosSemidef
def OPHermitian : Prop := ∀ n k r, (OP n k r).IsHermitian
def EPHermitian : Prop := ∀ n k r, (EP n k r).IsHermitian
def OPIdempotent : Prop := ∀ n k r, OP n k r * OP n k r = OP n k r
def EPIdempotent : Prop := ∀ n k r, EP n k r * EP n k r = EP n k r
def OPRange : Prop := ∀ n k r,
  LinearMap.range (OP n k r).mulVecLin = ordinaryCSSFiltration n k r ⊓ LinearMap.range (Pi n k).mulVecLin
def EPRange : Prop := ∀ n k r,
  LinearMap.range (EP n k r).mulVecLin = exceptionalCSSFiltration n k r ⊓ LinearMap.range (Pi n k).mulVecLin
def OPAntitone : Prop := ∀ n k,
  Antitone (fun r => LinearMap.range (OP n k r).mulVecLin)
def EPAntitone : Prop := ∀ {k : ℕ}, 0<k → 4∣k → ∀ n,
  Antitone (fun r => LinearMap.range (EP n k (r+1)).mulVecLin)

