  ∀ {k : ℕ} (hk : (k : ZMod 2)=1), oddWuSplit hk (allOnes k)=(0,1)

def T_stochasticEvenRestriction :=
  ∀ {k : ℕ}, StochasticIsometryGroup k → E k ≃ₗ[ZMod 2] E k

def T_stochasticToEvenOrthogonal :=
  ∀ {k : ℕ}, StochasticIsometryGroup k → O k

def T_even_add_wu_quadratic : Prop :=
  ∀ {k : ℕ} (x : E k) (a : ZMod 2), weightQuadratic (x.val+a • allOnes k)=weightQuadratic x.val+weightQuadratic (a • allOnes k)

def T_oddOrthogonalLinear :=
  ∀ {k : ℕ}, (k : ZMod 2)=1 → O k → BinaryVector k ≃ₗ[ZMod 2] BinaryVector k

def T_oddOrthogonalLinear_apply : Prop :=
  ∀ {k : ℕ} (hk : (k : ZMod 2)=1) (h : O k) (x : BinaryVector k), oddOrthogonalLinear hk h x=(h.val (oddWuCorrectionLinear hk x)).val+weightParity k x • allOnes k

def T_oddOrthogonalLinear_quadratic : Prop :=
  ∀ {k : ℕ} (hk : (k : ZMod 2)=1) (h : O k) (x : BinaryVector k), weightQuadratic (oddOrthogonalLinear hk h x)=weightQuadratic x

def T_oddOrthogonalLinear_wu : Prop :=
  ∀ {k : ℕ} (hk : (k : ZMod 2)=1) (h : O k), oddOrthogonalLinear hk h (allOnes k)=allOnes k

def T_oddOrthogonalToStochastic :=
  ∀ {k : ℕ}, (k : ZMod 2)=1 → O k → StochasticIsometryGroup k

def T_stochasticOddOrthogonalEquiv :=
  ∀ {k : ℕ}, (k : ZMod 2)=1 → StochasticIsometryGroup k ≃* O k

def T_stochasticOdd_fixedEquiv :=
  ∀ {k : ℕ} (hk : (k : ZMod 2)=1) (g : StochasticIsometryGroup k), F g.val ≃ₗ[ZMod 2] (F (stochasticOddOrthogonalEquiv hk g).val × ZMod 2)

def T_stochasticOdd_fixed_finrank : Prop :=
  ∀ {k : ℕ} (hk : (k : ZMod 2)=1) (g : StochasticIsometryGroup k), finrank (ZMod 2) (F g.val)=finrank (ZMod 2) (F (stochasticOddOrthogonalEquiv hk g).val)+1

def T_evenWeightSpace_finrank_add_one : Prop :=
  ∀ {k : ℕ}, (k : ZMod 2)=1 → finrank (ZMod 2) (E k)+1=k

def T_stochasticOdd_fixedSpace_sum {k : ℕ} {R : Type u} [CommSemiring R] : Prop :=
  (k : ZMod 2)=1 → ∀ D : R,
    (∑ g : StochasticIsometryGroup k, D^finrank (ZMod 2) (F g.val)) =
      D * ∑ h : O k, D^finrank (ZMod 2) (F h.val)

def T_stochasticOdd_fixedSpace_average {k : ℕ} {R : Type u} [Field R] : Prop :=
  (k : ZMod 2)=1 → ∀ D : R,
    (∑ g : StochasticIsometryGroup k, D^finrank (ZMod 2) (F g.val)) /
      (Fintype.card (StochasticIsometryGroup k) : R) =
    D * ((∑ h : O k, D^finrank (ZMod 2) (F h.val)) /
      (Fintype.card (O k) : R))

def T_stochasticEven_fixedSpace_sum {k : ℕ} {R : Type u} [CommSemiring R] : Prop :=
  (k : ZMod 2)=0 → ∀ D : R,
    (∑ g : StochasticIsometryGroup k, D^finrank (ZMod 2) (F g.val)) =
      ∑ h : P k, D^finrank (ZMod 2) (F h.val.val)

def T_stochasticEven_fixedSpace_average {k : ℕ} {R : Type u} [Field R] : Prop :=
  (k : ZMod 2)=0 → ∀ D : R,
    (∑ g : StochasticIsometryGroup k, D^finrank (ZMod 2) (F g.val)) /
      (Fintype.card (StochasticIsometryGroup k) : R) =
    ((∑ h : P k, D^finrank (ZMod 2) (F h.val.val)) /
      (Fintype.card (P k) : R))

def T_stochastic_zero_fixed_finrank : Prop :=
  ∀ g : StochasticIsometryGroup 0, finrank (ZMod 2) (F g.val)=0

def T_stochastic_one_fixed_finrank : Prop :=
  ∀ g : StochasticIsometryGroup 1, finrank (ZMod 2) (F g.val)=1

