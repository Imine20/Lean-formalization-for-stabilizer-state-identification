namespace CSSSphericalExpected
open Classical Module ExactCriticalCurve ExactCriticalCurve.Binary ExactCriticalCurve.Quantum
open scoped BigOperators
abbrev V (k : ℕ) := Fin k → ZMod 2
abbrev D (k : ℕ) := Submodule (ZMod 2) (V k)
abbrev Good {k : ℕ} (N : D k) := {g : StochasticIsometryGroup k //
  ∀ x ∈ orthogonal N, g.val x-x ∈ N ⊔ N.map g.val.toLinearMap}
abbrev Pair {k r : ℕ} (N : OrdinaryDefect k r) := {M : OrdinaryDefect k r //
  N.val ⊓ orthogonal M.val = N.val ⊓ M.val ∧ M.val ⊓ orthogonal N.val = N.val ⊓ M.val}
abbrev Family {k r : ℕ} (N : OrdinaryDefect k r) (K : D k) := {M : OrdinaryDefect k r //
  N.val ⊓ M.val = K ∧ N.val ⊓ orthogonal M.val = K ∧ M.val ⊓ orthogonal N.val = K}
abbrev Inter {k r : ℕ} (N : OrdinaryDefect k r) := {K : D k // K ≤ N.val}
local instance {k r : ℕ} (N : OrdinaryDefect k r) : Fintype (Inter N) :=
  cssDefectIntersectionFintype N
abbrev Fiber {k : ℕ} (N M : D k) := {g : StochasticIsometryGroup k //
  N.map g.val.toLinearMap = M ∧ ∀ x ∈ orthogonal N, g.val x-x ∈ N ⊔ M}
def IntersectionMap {k r : ℕ} (N : OrdinaryDefect k r) (M : Pair N) : Inter N :=
  ⟨N.val ⊓ M.val.val, inf_le_left⟩

def TargetSum : Prop := ∀ {k r : ℕ} (N : OrdinaryDefect k r) (w : D k → ℂ),
  (∑ g : StochasticIsometryGroup k,
    if ∀ x ∈ orthogonal N.val, g.val x-x ∈ N.val ⊔ N.val.map g.val.toLinearMap
    then w (N.val.map g.val.toLinearMap) else 0) =
  (Nat.card (stochasticParabolicKernel N.val) : ℂ) * ∑ M : Pair N, w M.val.val

def IntersectionSum : Prop := ∀ {k r : ℕ} (N : OrdinaryDefect k r) (w : Inter N → ℂ),
  (∑ M : Pair N, w (IntersectionMap N M)) =
    ∑ K : Inter N, (Nat.card (Family N K.val) : ℂ) * w K

def SphericalRow : Prop := ∀ {k r : ℕ} (n : ℕ) (N : OrdinaryDefect k r),
  (∑ g : StochasticIsometryGroup k,
    if ∀ x ∈ orthogonal N.val, g.val x-x ∈ N.val ⊔ N.val.map g.val.toLinearMap
    then (((2 : ℂ)^n)^(finrank (ZMod 2) N.val-
      finrank (ZMod 2) ↥(N.val ⊓ N.val.map g.val.toLinearMap)))⁻¹ else 0) =
  (Nat.card (stochasticParabolicKernel N.val) : ℂ) *
    ∑ K : Inter N, (Nat.card (Family N K.val) : ℂ) *
      (((2 : ℂ)^n)^(r-finrank (ZMod 2) K.val))⁻¹

def GoodType : Type 1 := ∀ {k : ℕ}, D k → Type
def PairType : Type 1 := ∀ {k r : ℕ}, OrdinaryDefect k r → Type
def FamilyType : Type 1 := ∀ {k r : ℕ}, OrdinaryDefect k r → D k → Type
def InterType : Type 1 := ∀ {k r : ℕ}, OrdinaryDefect k r → Type
def InterFintypeType : Type := ∀ {k r : ℕ} (N : OrdinaryDefect k r), Fintype (Inter N)
def DecompositionType : Type := ∀ {k r : ℕ} (N : OrdinaryDefect k r),
  Good N.val ≃ (Σ M : Pair N, Fiber N.val M.val.val)
def IntersectionMapType : Type := ∀ {k r : ℕ} (N : OrdinaryDefect k r), Pair N → Inter N
def IntersectionFiberType : Type := ∀ {k r : ℕ} (N : OrdinaryDefect k r) (K : Inter N),
  {M : Pair N // IntersectionMap N M = K} ≃ Family N K.val

example {k : ℕ} (N : D k) : CSSOverlapIsometry N = Good N := rfl
example {k r : ℕ} (N : OrdinaryDefect k r) : CSSPairedOrdinaryDefect N = Pair N := rfl
example {k r : ℕ} (N : OrdinaryDefect k r) (K : D k) : CSSIntersectionFamily N K = Family N K := rfl
example {k r : ℕ} (N : OrdinaryDefect k r) : CSSDefectIntersection N = Inter N := rfl
example {k r : ℕ} (N : OrdinaryDefect k r) (g : Good N.val) :
  ((cssOverlapFiberDecomposition N g).1).val.val = N.val.map g.val.val.toLinearMap := rfl
example {k r : ℕ} (N : OrdinaryDefect k r) (g : Good N.val) :
  ((cssOverlapFiberDecomposition N g).2).val = g.val := rfl
example {k r : ℕ} (N : OrdinaryDefect k r) (p : Σ M : Pair N, Fiber N.val M.val.val) :
  ((cssOverlapFiberDecomposition N).symm p).val = p.2.val := rfl
example {k r : ℕ} (N : OrdinaryDefect k r) (M : Pair N) :
  cssPairedIntersection N M = IntersectionMap N M := rfl
example {k r : ℕ} (N : OrdinaryDefect k r) (K : Inter N)
  (p : {M : Pair N // IntersectionMap N M = K}) :
  (cssPairedIntersectionFiberEquiv N K p).val = p.val.val := rfl
example {k r : ℕ} (N : OrdinaryDefect k r) (K : Inter N) (M : Family N K.val) :
  (((cssPairedIntersectionFiberEquiv N K).symm M).val).val = M.val := rfl

def CodimMap {k r : ℕ} (N : OrdinaryDefect k r) (K : Inter N) : Fin (r+1) :=
  ⟨r-finrank (ZMod 2) K.val, Nat.lt_succ_of_le (Nat.sub_le _ _)⟩
abbrev AtCodim {k r : ℕ} (N : OrdinaryDefect k r) (ell : Fin (r+1)) :=
  {K : Inter N // finrank (ZMod 2) K.val + ell.val = r}

def CodimensionCriterion : Prop := ∀ {k r : ℕ} (N : OrdinaryDefect k r)
  (K : Inter N) (ell : Fin (r+1)),
  CodimMap N K = ell ↔ finrank (ZMod 2) K.val + ell.val = r

def CodimensionSum : Prop := ∀ {k r : ℕ} (n : ℕ) (N : OrdinaryDefect k r) (a : Inter N → ℂ),
  (∑ K : Inter N, a K * (((2 : ℂ)^n)^(r-finrank (ZMod 2) K.val))⁻¹) =
    ∑ ell : Fin (r+1), (∑ K : AtCodim N ell, a K.val) * (((2 : ℂ)^n)^ell.val)⁻¹

def CodimensionRow : Prop := ∀ {k r : ℕ} (n : ℕ) (N : OrdinaryDefect k r),
  (∑ g : StochasticIsometryGroup k,
    if ∀ x ∈ orthogonal N.val, g.val x-x ∈ N.val ⊔ N.val.map g.val.toLinearMap
    then (((2 : ℂ)^n)^(finrank (ZMod 2) N.val-
      finrank (ZMod 2) ↥(N.val ⊓ N.val.map g.val.toLinearMap)))⁻¹ else 0) =
  (Nat.card (stochasticParabolicKernel N.val) : ℂ) *
    ∑ ell : Fin (r+1),
      (∑ K : AtCodim N ell, (Nat.card (Family N K.val.val) : ℂ)) * (((2 : ℂ)^n)^ell.val)⁻¹

def CodimMapType : Type := ∀ {k r : ℕ} (N : OrdinaryDefect k r), Inter N → Fin (r+1)
def AtCodimType : Type 1 := ∀ {k r : ℕ} (N : OrdinaryDefect k r), Fin (r+1) → Type
def CodimFiberType : Type := ∀ {k r : ℕ} (N : OrdinaryDefect k r) (ell : Fin (r+1)),
  {K : Inter N // CodimMap N K = ell} ≃ AtCodim N ell

example {k r : ℕ} (N : OrdinaryDefect k r) (K : Inter N) :
  cssIntersectionCodimension N K = CodimMap N K := rfl
example {k r : ℕ} (N : OrdinaryDefect k r) (ell : Fin (r+1)) :
  CSSIntersectionsAtCodimension N ell = AtCodim N ell := rfl
example {k r : ℕ} (N : OrdinaryDefect k r) (ell : Fin (r+1))
  (p : {K : Inter N // CodimMap N K = ell}) :
  (cssIntersectionCodimensionFiberEquiv N ell p).val = p.val := rfl
example {k r : ℕ} (N : OrdinaryDefect k r) (ell : Fin (r+1)) (K : AtCodim N ell) :
  ((cssIntersectionCodimensionFiberEquiv N ell).symm K).val = K.val := rfl

end CSSSphericalExpected
