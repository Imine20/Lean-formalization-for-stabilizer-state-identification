      `CriticalCurveExpected.povm_unrestricted,
      `CriticalCurveExpected.povm_effects_valid,
      `CriticalCurveExpected.pgm_effect_expanded,
      `CriticalCurveExpected.fixedSubmodule_expanded] do
    let axs ← Lean.collectAxioms target
    for ax in axs do
      unless #[`propext, `Classical.choice, `Quot.sound].contains ax do
        throwError "Forbidden axiom in semantic structure bridge {target}: {ax}"
    logInfo m!"SEMANTIC_STRUCTURE_BRIDGE_OK {target}"


