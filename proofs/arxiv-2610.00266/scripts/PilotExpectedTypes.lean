namespace CSSPairedExpected
open Classical Module ExactCriticalCurve ExactCriticalCurve.Binary ExactCriticalCurve.Quantum
abbrev V (k : ℕ) := Fin k → ZMod 2
abbrev D (k : ℕ) := Submodule (ZMod 2) (V k)
abbrev C {k : ℕ} (N M : D k) (hN : IsDefect N) (hM : IsDefect M) :=
  stochasticLagrangianComposition hM.stochasticLagrangian hN.stochasticLagrangian

def KernelBound : Prop := ∀ {k : ℕ} (A B : D k),
  orthogonal A ≤ A ⊔ orthogonal B → orthogonal A ⊓ B ≤ A

def OrthogonalSpans : Prop := ∀ {k : ℕ} (N : D k) (hN : IsDefect N)
  (g : StochasticIsometryGroup k),
  (∀ x ∈ orthogonal N, g.val x-x ∈ N ⊔ N.map g.val.toLinearMap) →
  orthogonal N ≤ N ⊔ orthogonal (N.map g.val.toLinearMap) ∧
    orthogonal (N.map g.val.toLinearMap) ≤ N.map g.val.toLinearMap ⊔ orthogonal N

def PairingKernels : Prop := ∀ {k : ℕ} (N : D k) (hN : IsDefect N)
  (g : StochasticIsometryGroup k),
  (∀ x ∈ orthogonal N, g.val x-x ∈ N ⊔ N.map g.val.toLinearMap) →
  N ⊓ orthogonal (N.map g.val.toLinearMap) = N ⊓ N.map g.val.toLinearMap ∧
    N.map g.val.toLinearMap ⊓ orthogonal N = N ⊓ N.map g.val.toLinearMap

def CompositionMembership : Prop := ∀ {k : ℕ} (N M : D k)
  (hN : IsDefect N) (hM : IsDefect M) (x y : V k),
  (x,y) ∈ (C N M hN hM).carrier ↔ x ∈ orthogonal M ∧ y ∈ orthogonal N ∧ x-y ∈ M ⊔ N

def LeftDefect : Prop := ∀ {k : ℕ} (N M : D k) (hN : IsDefect N) (hM : IsDefect M),
  (C N M hN hM).leftDefect = M ⊔ (N ⊓ orthogonal M)
def RightDefect : Prop := ∀ {k : ℕ} (N M : D k) (hN : IsDefect N) (hM : IsDefect M),
  (C N M hN hM).rightDefect = N ⊔ (M ⊓ orthogonal N)
def PairedDefects : Prop := ∀ {k : ℕ} (N M : D k) (hN : IsDefect N) (hM : IsDefect M),
  N ⊓ orthogonal M = N ⊓ M → M ⊓ orthogonal N = N ⊓ M →
    (C N M hN hM).leftDefect = M ∧ (C N M hN hM).rightDefect = N

def Existence : Prop := ∀ {k : ℕ} (N M : D k) (hN : IsDefect N) (hM : IsDefect M),
  N ⊓ orthogonal M = N ⊓ M → M ⊓ orthogonal N = N ⊓ M →
  ∃ e : CSSQuotient N ≃ₗ[ZMod 2] CSSQuotient M,
    (∀ q, cssQuotientQuadratic M hM (e q) = cssQuotientQuadratic N hN q) ∧
    e (cssQuotientWu N hN) = cssQuotientWu M hM ∧
    (∀ (x : orthogonal M) (y : orthogonal N),
      e (Submodule.Quotient.mk y) = Submodule.Quotient.mk x ↔ x.val-y.val ∈ M ⊔ N)

def Quadratic : Prop := ∀ {k : ℕ} (N M : D k) (hN : IsDefect N) (hM : IsDefect M)
  (hNM : N ⊓ orthogonal M = N ⊓ M) (hMN : M ⊓ orthogonal N = N ⊓ M) (q : CSSQuotient N),
  cssQuotientQuadratic M hM (cssPairedQuotientEquiv N M hN hM hNM hMN q) =
    cssQuotientQuadratic N hN q

def Wu : Prop := ∀ {k : ℕ} (N M : D k) (hN : IsDefect N) (hM : IsDefect M)
  (hNM : N ⊓ orthogonal M = N ⊓ M) (hMN : M ⊓ orthogonal N = N ⊓ M),
  cssPairedQuotientEquiv N M hN hM hNM hMN (cssQuotientWu N hN) = cssQuotientWu M hM

def Graph : Prop := ∀ {k : ℕ} (N M : D k) (hN : IsDefect N) (hM : IsDefect M)
  (hNM : N ⊓ orthogonal M = N ⊓ M) (hMN : M ⊓ orthogonal N = N ⊓ M)
  (x : orthogonal M) (y : orthogonal N),
  cssPairedQuotientEquiv N M hN hM hNM hMN (Submodule.Quotient.mk y) =
    Submodule.Quotient.mk x ↔ x.val-y.val ∈ M ⊔ N

def CompositionType : Type := ∀ {k : ℕ} (N M : D k), IsDefect N → IsDefect M → StochasticLagrangian k
def QuotientMapType : Type := ∀ {k : ℕ} (N M : D k), IsDefect N → IsDefect M →
  N ⊓ orthogonal M = N ⊓ M → M ⊓ orthogonal N = N ⊓ M →
    (CSSQuotient N ≃ₗ[ZMod 2] CSSQuotient M)
example {k : ℕ} (N M : D k) (hN : IsDefect N) (hM : IsDefect M) :
  cssDefectComposition N M hN hM = C N M hN hM := rfl
end CSSPairedExpected

