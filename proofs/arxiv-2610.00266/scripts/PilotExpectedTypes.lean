def G (n k r : ℕ) : Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ :=
  ordinaryFixedCSSProjection n k r - ordinaryFixedCSSProjection n k (r+1)
def H (n k r : ℕ) : Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ :=
  exceptionalFixedCSSProjection n k r - exceptionalFixedCSSProjection n k (r+1)
def GradeType := (n k r : ℕ) → Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ
example (n k r : ℕ) : ordinaryCSSGrade n k r = G n k r := rfl
example (n k r : ℕ) : exceptionalCSSGrade n k r = H n k r := rfl

def GHermitian : Prop := ∀ n k r, (G n k r).IsHermitian
def HHermitian : Prop := ∀ n k r, (H n k r).IsHermitian
def GIdempotent : Prop := ∀ n k r, G n k r * G n k r = G n k r
def HIdempotent : Prop := ∀ {k : ℕ}, 0<k → 4∣k → ∀ n r,
  H n k (r+1) * H n k (r+1) = H n k (r+1)
def GPositive : Prop := ∀ n k r, (G n k r).PosSemidef
def HPositive : Prop := ∀ {k : ℕ}, 0<k → 4∣k → ∀ n r, (H n k (r+1)).PosSemidef
def GRange : Prop := ∀ n k r, LinearMap.range (G n k r).mulVecLin =
  (ordinaryCSSFiltration n k r ⊓ LinearMap.range (stochasticFixedProjection n k).mulVecLin) ⊓
    LinearMap.ker (ordinaryFixedCSSProjection n k (r+1)).mulVecLin
def HRange : Prop := ∀ {k : ℕ}, 0<k → 4∣k → ∀ n r,
  LinearMap.range (H n k (r+1)).mulVecLin =
  (exceptionalCSSFiltration n k (r+1) ⊓ LinearMap.range (stochasticFixedProjection n k).mulVecLin) ⊓
    LinearMap.ker (exceptionalFixedCSSProjection n k (r+1+1)).mulVecLin
def FilterHermitian : Prop := ∀ n k,
  ((if 4∣k then 1-cssColumnProjection n (wuLine k) else 1) :
    Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ).IsHermitian
def FilterFixed : Prop := ∀ {n k : ℕ} {v : ColumnConfig n k → ℂ},
  cssColumnProjection n (wuLine k) *ᵥ v = 0 →
    ((if 4∣k then 1-cssColumnProjection n (wuLine k) else 1) :
      Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ) *ᵥ v = v
def OrdinarySuccessorKills : Prop := ∀ {n k r : ℕ} {v : ColumnConfig n k → ℂ},
  stochasticFixedProjection n k *ᵥ v = v →
  cssColumnProjection n (wuLine k) *ᵥ v = 0 →
  (∀ M : Submodule (ZMod 2) (BinaryVector k), IsDefect M →
    r < Module.finrank (ZMod 2) M → cssColumnProjection n M *ᵥ v = 0) →
  ordinaryFixedCSSSum n k (r+1) *ᵥ v = 0
def ExceptionalSuccessorKills : Prop := ∀ {n k r : ℕ} {v : ColumnConfig n k → ℂ},
  stochasticFixedProjection n k *ᵥ v = v →
  (∀ M : Submodule (ZMod 2) (BinaryVector k), IsDefect M →
    r < Module.finrank (ZMod 2) M → cssColumnProjection n M *ᵥ v = 0) →
  exceptionalFixedCSSSum n k (r+1) *ᵥ v = 0
def GNonzero : Prop := ∀ {n k r : ℕ} (_ : OrdinaryDefect k r), k-2*r ≤ n → G n k r ≠ 0
def HNonzero : Prop := ∀ {n k r : ℕ} (_ : ExceptionalDefect k r), k-2*r ≤ n → H n k r ≠ 0
def GOrthogonal : Prop := ∀ n k r s, r≠s → G n k r * G n k s = 0
def HOrthogonal : Prop := ∀ {k : ℕ}, 0<k → 4∣k → ∀ n r s,
  r≠s → H n k (r+1) * H n k (s+1) = 0
def GTelescope : Prop := ∀ n k m,
  (∑ i : Fin m, G n k i.val) + ordinaryFixedCSSProjection n k m = ordinaryFixedCSSProjection n k 0
def HTelescope : Prop := ∀ n k m,
  (∑ i : Fin m, H n k (i.val+1)) + exceptionalFixedCSSProjection n k (m+1) =
    exceptionalFixedCSSProjection n k 1

