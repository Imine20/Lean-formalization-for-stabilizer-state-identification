def WuMembership : Prop :=
  ∀ {k : ℕ} (g : StochasticIsometryGroup k)
    (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    (fun _ : Fin k => (1 : ZMod 2)) ∈ N.map g.val.toLinearMap ↔
      (fun _ : Fin k => (1 : ZMod 2)) ∈ N

def PointedPartial : Prop :=
  ∀ {k : ℕ} (N M : Submodule (ZMod 2) (Fin k → ZMod 2)),
    finrank (ZMod 2) N = finrank (ZMod 2) M →
    ((fun _ : Fin k => (1 : ZMod 2)) ∈ N ↔ (fun _ : Fin k => (1 : ZMod 2)) ∈ M) →
    ∃ f : N ≃ₗ[ZMod 2] M,
      ∀ hn : (fun _ : Fin k => (1 : ZMod 2)) ∈ N,
        (f ⟨fun _ : Fin k => (1 : ZMod 2), hn⟩).val = (fun _ : Fin k => (1 : ZMod 2))

def OrbitExistence : Prop :=
  ∀ {k : ℕ} (N M : Submodule (ZMod 2) (Fin k → ZMod 2)),
    (∀ x : Fin k → ZMod 2, x ∈ N → (∑ i, bitLift (x i)) = 0) →
    (∀ x : Fin k → ZMod 2, x ∈ M → (∑ i, bitLift (x i)) = 0) →
    finrank (ZMod 2) N = finrank (ZMod 2) M →
    ((fun _ : Fin k => (1 : ZMod 2)) ∈ N ↔ (fun _ : Fin k => (1 : ZMod 2)) ∈ M) →
    ∃ g : {e : (Fin k → ZMod 2) ≃ₗ[ZMod 2] (Fin k → ZMod 2) //
      (∀ x, (∑ i, bitLift (e x i)) = ∑ i, bitLift (x i)) ∧
      e (fun _ : Fin k => (1 : ZMod 2)) = (fun _ : Fin k => (1 : ZMod 2))},
      N.map g.val.toLinearMap = M

def OrbitIff : Prop :=
  ∀ {k : ℕ} (N M : Submodule (ZMod 2) (Fin k → ZMod 2)),
    (∀ x : Fin k → ZMod 2, x ∈ N → (∑ i, bitLift (x i)) = 0) →
    (∀ x : Fin k → ZMod 2, x ∈ M → (∑ i, bitLift (x i)) = 0) →
    ((∃ g : {e : (Fin k → ZMod 2) ≃ₗ[ZMod 2] (Fin k → ZMod 2) //
      (∀ x, (∑ i, bitLift (e x i)) = ∑ i, bitLift (x i)) ∧
      e (fun _ : Fin k => (1 : ZMod 2)) = (fun _ : Fin k => (1 : ZMod 2))},
      N.map g.val.toLinearMap = M) ↔
      finrank (ZMod 2) N = finrank (ZMod 2) M ∧
      ((fun _ : Fin k => (1 : ZMod 2)) ∈ N ↔ (fun _ : Fin k => (1 : ZMod 2)) ∈ M))

def SubspaceOne : Prop :=
  ∀ {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    N.map (1 : StochasticIsometryGroup k).val.toLinearMap = N

def SubspaceMul : Prop :=
  ∀ {k : ℕ} (g h : StochasticIsometryGroup k)
    (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    N.map (g * h).val.toLinearMap = (N.map h.val.toLinearMap).map g.val.toLinearMap

def SubspaceInv : Prop :=
  ∀ {k : ℕ} (g : StochasticIsometryGroup k)
    (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    (N.map g.val.toLinearMap).map g⁻¹.val.toLinearMap = N

def RelationOne : Prop :=
  ∀ {k : ℕ} (T : Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))),
    stochasticRelation (1 : StochasticIsometryGroup k) 1 T = T

def RelationMul : Prop :=
  ∀ {k : ℕ} (g₁ g₂ h₁ h₂ : StochasticIsometryGroup k)
    (T : Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))),
    T.map ((g₁ * g₂).val.prodCongr (h₁ * h₂).val).toLinearMap =
      (T.map (g₂.val.prodCongr h₂.val).toLinearMap).map (g₁.val.prodCongr h₁.val).toLinearMap

def RelationInv : Prop :=
  ∀ {k : ℕ} (g h : StochasticIsometryGroup k)
    (T : Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))),
    stochasticRelation g⁻¹ h⁻¹ (stochasticRelation g h T) = T

def ActionOne : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k), stochasticLagrangianAction 1 1 T = T

def ActionMul : Prop :=
  ∀ {k : ℕ} (g₁ g₂ h₁ h₂ : StochasticIsometryGroup k) (T : StochasticLagrangian k),
    stochasticLagrangianAction (g₁ * g₂) (h₁ * h₂) T =
      stochasticLagrangianAction g₁ h₁ (stochasticLagrangianAction g₂ h₂ T)

def ActionInv : Prop :=
  ∀ {k : ℕ} (g h : StochasticIsometryGroup k) (T : StochasticLagrangian k),
    stochasticLagrangianAction g⁻¹ h⁻¹ (stochasticLagrangianAction g h T) = T

def LeftTransport : Prop :=
  ∀ {k : ℕ} (g h : StochasticIsometryGroup k) (T : StochasticLagrangian k),
    (T.carrier.map (g.val.prodCongr h.val).toLinearMap).comap
        (LinearMap.inl (ZMod 2) (Fin k → ZMod 2) (Fin k → ZMod 2)) =
      (T.carrier.comap (LinearMap.inl (ZMod 2) (Fin k → ZMod 2) (Fin k → ZMod 2))).map
        g.val.toLinearMap

def RightTransport : Prop :=
  ∀ {k : ℕ} (g h : StochasticIsometryGroup k) (T : StochasticLagrangian k),
    (T.carrier.map (g.val.prodCongr h.val).toLinearMap).comap
        (LinearMap.inr (ZMod 2) (Fin k → ZMod 2) (Fin k → ZMod 2)) =
      (T.carrier.comap (LinearMap.inr (ZMod 2) (Fin k → ZMod 2) (Fin k → ZMod 2))).map
        h.val.toLinearMap

end StochasticDefectExpected

