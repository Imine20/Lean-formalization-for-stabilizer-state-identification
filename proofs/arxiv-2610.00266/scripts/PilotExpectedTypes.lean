namespace CSSLiftFiberExpected
open Classical Module ExactCriticalCurve ExactCriticalCurve.Binary ExactCriticalCurve.Quantum
abbrev V (k : ℕ) := Fin k → ZMod 2
abbrev D (k : ℕ) := Submodule (ZMod 2) (V k)
def Fiber {k : ℕ} (N M : D k) := {g : StochasticIsometryGroup k //
  N.map g.val.toLinearMap = M ∧ ∀ x ∈ orthogonal N, g.val x-x ∈ N ⊔ M}

def CanonicalCriterion : Prop := ∀ {k : ℕ} (N M : D k) (hN : IsDefect N) (hM : IsDefect M)
  (hNM : N ⊓ orthogonal M = N ⊓ M) (hMN : M ⊓ orthogonal N = N ⊓ M)
  (g : StochasticIsometryGroup k), N.map g.val.toLinearMap = M →
  ((∀ x ∈ orthogonal N, g.val x-x ∈ N ⊔ M) ↔
    ∀ x : orthogonal N, ∃ hx : g.val x.val ∈ orthogonal M,
      cssPairedQuotientEquiv N M hN hM hNM hMN (Submodule.Quotient.mk x) =
        Submodule.Quotient.mk (⟨g.val x.val,hx⟩ : orthogonal M))

def Existence : Prop := ∀ {k : ℕ} (N M : D k) (hN : IsDefect N) (hM : IsDefect M),
  N ⊓ orthogonal M = N ⊓ M → M ⊓ orthogonal N = N ⊓ M → Nonempty (Fiber N M)

def Difference : Prop := ∀ {k : ℕ} (N M : D k) (hM : IsDefect M),
  N ⊓ orthogonal M = N ⊓ M → ∀ (g₀ g : Fiber N M) (x : orthogonal N),
    g.val.val x.val-g₀.val.val x.val ∈ M

def Cardinality : Prop := ∀ {k : ℕ} (N M : D k) (hN : IsDefect N) (hM : IsDefect M),
  N ⊓ orthogonal M = N ⊓ M → M ⊓ orthogonal N = N ⊓ M →
    Nat.card (Fiber N M) = Nat.card (stochasticParabolicKernel N)

def FiberType : Type 1 := ∀ {k : ℕ}, D k → D k → Type
def EquivType : Type := ∀ {k : ℕ} (N M : D k), IsDefect M →
  N ⊓ orthogonal M = N ⊓ M → Fiber N M → (stochasticParabolicKernel N ≃ Fiber N M)

example {k : ℕ} (N M : D k) : ActualCSSOverlapFiber N M = Fiber N M := rfl
example {k : ℕ} (N M : D k) (hM : IsDefect M)
  (hNM : N ⊓ orthogonal M = N ⊓ M) (g₀ : Fiber N M) (h : stochasticParabolicKernel N) :
  (actualCSSOverlapFiberEquiv N M hM hNM g₀ h).val = g₀.val*h.val := rfl
example {k : ℕ} (N M : D k) (hM : IsDefect M)
  (hNM : N ⊓ orthogonal M = N ⊓ M) (g₀ g : Fiber N M) :
  ((actualCSSOverlapFiberEquiv N M hM hNM g₀).symm g).val = g₀.val⁻¹*g.val := rfl
end CSSLiftFiberExpected
