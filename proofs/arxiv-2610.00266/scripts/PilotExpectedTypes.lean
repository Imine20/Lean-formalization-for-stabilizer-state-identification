def RawRelationEntries {k : ℕ}
    (T : Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))) :
    Matrix (Fin k → ZMod 2) (Fin k → ZMod 2) ℂ :=
  fun x y => if (x, y) ∈ T then 1 else 0

def RawRelationTensorEntries {k : ℕ} (n : ℕ)
    (T : Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))) :
    Matrix (Fin n → Fin k → ZMod 2) (Fin n → Fin k → ZMod 2) ℂ :=
  fun X Y => ∏ a : Fin n, if (X a, Y a) ∈ T then 1 else 0

def RelationWordTraceCard : Prop :=
  ∀ {k p : ℕ}
    (T : Fin p → Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))),
    (∑ x : Fin k → ZMod 2, (List.ofFn (fun j => RawRelationEntries (T j))).prod x x) =
      (Nat.card (relationClosedSpace T) : ℂ)

def RelationWordTracePower : Prop :=
  ∀ {k p : ℕ} (n : ℕ)
    (T : Fin p → Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))),
    (∑ X : Fin n → Fin k → ZMod 2,
      (List.ofFn (fun j => RawRelationTensorEntries n (T j))).prod X X) =
      ((2 : ℂ) ^ n) ^ Module.finrank (ZMod 2) (relationClosedSpace T)

def RelationEmptyTrace : Prop :=
  ∀ {k : ℕ} (n : ℕ)
    (T : Fin 0 → Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))),
    (∑ X : Fin n → Fin k → ZMod 2,
      (List.ofFn (fun j => RawRelationTensorEntries n (T j))).prod X X) =
      ((2 : ℂ) ^ n) ^ k

def NoncommWordExpansion {ι : Type u} {R : Type v} [Fintype ι] [Semiring R] : Prop :=
  ∀ (A : ι → R) (p : ℕ),
    (∑ i, A i) ^ p = ∑ w : Fin p → ι, (List.ofFn (fun j => A (w j))).prod

def RelationPowerPolynomial {ι : Type u} [Fintype ι] : Prop :=
  ∀ {k : ℕ} (n p : ℕ)
    (T : ι → Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))),
    (∑ X : Fin n → Fin k → ZMod 2,
      ((∑ i, RawRelationTensorEntries n (T i)) ^ p) X X) =
      (relationTracePolynomial T p).eval₂ (Nat.castRingHom ℂ) ((2 : ℂ) ^ n)

def RelationPolynomialZero {ι : Type u} [Fintype ι] : Prop :=
  ∀ {k : ℕ}
    (T : ι → Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))),
    relationTracePolynomial T 0 = Polynomial.monomial k 1

/-- Independently expose the exact simultaneous linear constraints, including the free p=0 vertex. -/
theorem relationClosedSpace_carrier_expanded {k p : ℕ}
    (T : Fin p → Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))) :
    (relationClosedSpace T : Set (Fin (p + 1) → Fin k → ZMod 2)) =
      {v | v 0 = v (Fin.last p) ∧
        ∀ j : Fin p, (v j.castSucc, v j.succ) ∈ T j} := rfl

/-- Independently expose every monomial and its actual closed-space dimension; no n occurs. -/
theorem relationTracePolynomial_word_sum_expanded {ι : Type u} [Fintype ι] {k : ℕ}
    (T : ι → Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))) (p : ℕ) :
    relationTracePolynomial T p =
      ∑ w : Fin p → ι,
        Polynomial.monomial
          (Module.finrank (ZMod 2) (relationClosedSpace (fun j => T (w j)))) 1 := rfl

end CriticalCurveExpected

