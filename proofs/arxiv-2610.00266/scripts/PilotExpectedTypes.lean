namespace PhysicalSectorScalarExtractionExpected
open Classical Matrix ExactCriticalCurve ExactCriticalCurve.Binary ExactCriticalCurve.Quantum
open scoped BigOperators
def A (n k : ℕ) := ∑ T : StochasticLagrangian k, relationOperator n T.carrier
def v {k : ℕ} (n : ℕ) (N : Submodule (ZMod 2) (BinaryVector k)) (f : CSSHom n N) :=
  (cssHomSynthesis n N).col f
def w {k : ℕ} (n : ℕ) (N : Submodule (ZMod 2) (BinaryVector k)) (f : CSSHom n N) :=
  stochasticFixedProjection n k *ᵥ v n N f
def weight {k : ℕ} (n : ℕ) (N : Submodule (ZMod 2) (BinaryVector k)) (f : CSSHom n N) :=
  star (v n N f) ⬝ᵥ w n N f
def alpha (n k r : ℕ) :=
  gnwNormalization n k * (((2 : ℂ)^n)^r)⁻¹ * (gnwNormalization n (k-2*r))⁻¹

def SumMembership : Prop := ∀ n k : ℕ, A n k ∈ compressedRelationSpan n k
def ActualGradeVector : Prop := ∀ {n k r : ℕ} (N : OrdinaryDefect k r)
    (f : CSSHom n N.val), Function.Surjective f →
    ordinaryCSSGrade n k r *ᵥ w n N.val f = w n N.val f
def NonzeroWeight : Prop := ∀ {n k : ℕ}
    (N : Submodule (ZMod 2) (BinaryVector k)) (f : CSSHom n N), weight n N f ≠ 0
def ActualScalar : Prop := ∀ {n k r : ℕ} (N : OrdinaryDefect k r), k ≤ n →
    ∃ θ : ℝ, A n k * ordinaryCSSGrade n k r = θ • ordinaryCSSGrade n k r ∧
      ordinaryCSSGrade n k r * A n k = θ • ordinaryCSSGrade n k r
def DiagonalIdentity : Prop := ∀ {n k r : ℕ} (N : OrdinaryDefect k r)
    (f : CSSHom n N.val), Function.Surjective f → ∀ θ : ℝ,
    A n k * ordinaryCSSGrade n k r = θ • ordinaryCSSGrade n k r →
    (θ : ℂ) * weight n N.val f = alpha n k r
def ActualRatio : Prop := ∀ {n k r : ℕ} (N : OrdinaryDefect k r), k ≤ n →
    ∀ f : CSSHom n N.val, Function.Surjective f → ∃ θ : ℝ,
      (A n k * ordinaryCSSGrade n k r = θ • ordinaryCSSGrade n k r ∧
       ordinaryCSSGrade n k r * A n k = θ • ordinaryCSSGrade n k r) ∧
      (θ : ℂ) = alpha n k r / weight n N.val f

