end CompressedCSSMembershipExpected


namespace CSSStabilizerCompressionExpected
open ExactCriticalCurve ExactCriticalCurve.Binary ExactCriticalCurve.Quantum

def CompressionRankoneRay {α : Type*} [Fintype α] : Prop :=
  ∀ v w : α → ℂ, Matrix.trace (Matrix.vecMulVec w (star w)) = 1 →
    Matrix.vecMulVec w (star w) *ᵥ v = v →
    Matrix.vecMulVec v (star v) =
      Matrix.trace (Matrix.vecMulVec v (star v)) • Matrix.vecMulVec w (star w)

def CompressionCosetPauli : Prop :=
  ∀ {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (v : orthogonal N) (a b : ZMod 2),
    pauliMatrix (a • v.val) (b • v.val) * cssCosetSynthesis N =
      cssCosetSynthesis N * cssQuotientPauli N v a b

def CompressionSelectiveFactor : Prop :=
  ∀ {k n : ℕ} (v : Fin k → ZMod 2) (g : PauliLabel n),
    copyMatrixInColumnOrder n k (selectivePauli v g) =
      pauliPhase (g.phase * weightQuadratic v) •
        matrixTensorFamily n (fun a => pauliMatrix (g.shift a • v) (g.clock a • v))

def CompressionQuotientAction : Prop :=
  ∀ {k n : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (v : orthogonal N) (g : PauliLabel n),
    copyMatrixInColumnOrder n k (selectivePauli v.val g) * cssColumnSynthesis n N =
      cssColumnSynthesis n N * cssQuotientSelectivePauli N v g

def CompressionConjugation : Prop :=
  ∀ {n : ℕ} (c : Bool) (g : PauliLabel n),
    pauliOperator (conjugatedPauliLabel c g) =
      if c then (pauliOperator g).map (starRingEnd ℂ) else pauliOperator g

def CompressionSignedPauli : Prop :=
  ∀ {n k s : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (v : orthogonal N)
    (e : CSSQuotient N ≃ₗ[ZMod 2] (Fin s → ZMod 2)),
    (∀ x y, cssQuotientBilinear N x y = binaryDot (e x) (e y)) →
    ∀ j : Fin s, e (Submodule.Quotient.mk v) = (Pi.single j (1 : ZMod 2) : Fin s → ZMod 2) →
    ∀ c : Bool, weightQuadratic v.val = (if c then -1 else 1) →
    ∀ g : PauliLabel n,
      copyMatrixInColumnOrder n k (selectivePauli v.val g) * cssSignedSynthesis n N e =
        cssSignedSynthesis n N e * copyMatrixInColumnOrder n s
          (selectivePauli (Pi.single j 1) (conjugatedPauliLabel c g))

def CompressionBasisLift : Prop :=
  ∀ {k s : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (hN : IsDefect N)
    (mask : Fin s → Bool) (e : CSSQuotient N ≃ₗ[ZMod 2] (Fin s → ZMod 2)),
    (∀ x, cssQuotientQuadratic N hN x = signedWeightQuadratic mask (e x)) →
    ∀ j : Fin s, ∃ v : orthogonal N,
      e (Submodule.Quotient.mk v) = (Pi.single j (1 : ZMod 2) : Fin s → ZMod 2) ∧
        weightQuadratic v.val = if mask j then -1 else 1

def CompressionSelectedStabilizer : Prop :=
  ∀ {n k : ℕ} (S : StabilizerGroup n) (v : Fin k → ZMod 2) (g : S.carrier),
    selectivePauli v g.val *ᵥ stabilizerTensorVector S k = stabilizerTensorVector S k

def CompressionMixedFixed : Prop :=
  ∀ {n k : ℕ} (mask : Fin k → Bool) (S : StabilizerGroup n) (w : (Fin n → Fin k → ZMod 2) → ℂ),
    (∀ (j : Fin k) (g : S.carrier),
      copyMatrixInColumnOrder n k (selectivePauli (Pi.single j 1)
        (conjugatedPauliLabel (mask j) g.val)) *ᵥ w = w) →
    copyMatrixInColumnOrder n k
      (Matrix.vecMulVec (mixedTensorVector mask (stabilizerVector S))
        (star (mixedTensorVector mask (stabilizerVector S)))) *ᵥ w = w

def CompressionSynthesisIsometry : Prop :=
  ∀ {n k s : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)), IsDefect N →
    ∀ e : CSSQuotient N ≃ₗ[ZMod 2] (Fin s → ZMod 2),
      (cssSignedSynthesis n N e)ᴴ * cssSignedSynthesis n N e = 1

def CompressionSynthesisProjection : Prop :=
  ∀ {n k s : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2))
    (e : CSSQuotient N ≃ₗ[ZMod 2] (Fin s → ZMod 2)),
    cssSignedSynthesis n N e * (cssSignedSynthesis n N e)ᴴ = cssColumnProjection n N

def CompressionMixedRay : Prop :=
  ∀ {n k s : ℕ} (S : StabilizerGroup n)
    (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (hN : IsDefect N)
    (mask : Fin s → Bool) (e : CSSQuotient N ≃ₗ[ZMod 2] (Fin s → ZMod 2)),
    (∀ x, cssQuotientQuadratic N hN x = signedWeightQuadratic mask (e x)) →
    (∀ x y, cssQuotientBilinear N x y = binaryDot (e x) (e y)) →
    copyMatrixInColumnOrder n s
      (Matrix.vecMulVec (mixedTensorVector mask (stabilizerVector S))
        (star (mixedTensorVector mask (stabilizerVector S)))) *ᵥ
          cssSignedCompressedVector S N e = cssSignedCompressedVector S N e

def CompressionVectorProjector : Prop :=
  ∀ {n k s : ℕ} (S : StabilizerGroup n)
    (N : Submodule (ZMod 2) (Fin k → ZMod 2))
    (e : CSSQuotient N ≃ₗ[ZMod 2] (Fin s → ZMod 2)),
    Matrix.vecMulVec (cssSignedCompressedVector S N e) (star (cssSignedCompressedVector S N e)) =
      (cssSignedSynthesis n N e)ᴴ *
        copyMatrixInColumnOrder n k (matrixTensorPower k (stabilizerProjection S)) *
          cssSignedSynthesis n N e

def CompressionZeroEntry : Prop :=
  ∀ {n k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    cssColumnProjection n N 0 0 = (((2 : ℂ)^n)^Module.finrank (ZMod 2) N)⁻¹

def CompressionZeroTensor : Prop :=
  ∀ n k : ℕ,
    copyMatrixInColumnOrder n k
      (matrixTensorPower k (stabilizerProjection (computationalStabilizerGroup n))) =
        Matrix.single (0 : Fin n → Fin k → ZMod 2) 0 (1 : ℂ)

def CompressionCliffordOverlap : Prop :=
  ∀ {n k : ℕ} (U : CliffordGroup n) (S : StabilizerGroup n)
    (N : Submodule (ZMod 2) (Fin k → ZMod 2)), IsDefect N →
    Matrix.trace (cssColumnProjection n N *
      copyMatrixInColumnOrder n k (matrixTensorPower k (stabilizerProjection (cliffordStabilizer U S)))) =
    Matrix.trace (cssColumnProjection n N *
      copyMatrixInColumnOrder n k (matrixTensorPower k (stabilizerProjection S)))

def CompressionOverlap : Prop :=
  ∀ {n k : ℕ} (S : StabilizerGroup n) (N : Submodule (ZMod 2) (Fin k → ZMod 2)), IsDefect N →
    Matrix.trace (cssColumnProjection n N *
      copyMatrixInColumnOrder n k (matrixTensorPower k (stabilizerProjection S))) =
        (((2 : ℂ)^n)^Module.finrank (ZMod 2) N)⁻¹

def CompressionVectorTrace : Prop :=
  ∀ {n k s : ℕ} (S : StabilizerGroup n)
    (N : Submodule (ZMod 2) (Fin k → ZMod 2)), IsDefect N →
    ∀ e : CSSQuotient N ≃ₗ[ZMod 2] (Fin s → ZMod 2),
    Matrix.trace (Matrix.vecMulVec (cssSignedCompressedVector S N e)
      (star (cssSignedCompressedVector S N e))) =
        (((2 : ℂ)^n)^Module.finrank (ZMod 2) N)⁻¹

def CompressionMixedTrace : Prop :=
  ∀ {n s : ℕ} (mask : Fin s → Bool) (S : StabilizerGroup n),
    Matrix.trace (copyMatrixInColumnOrder n s
      (Matrix.vecMulVec (mixedTensorVector mask (stabilizerVector S))
        (star (mixedTensorVector mask (stabilizerVector S))))) = 1

def CompressionActualState : Prop :=
  ∀ {n k s : ℕ} (S : StabilizerGroup n)
    (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (hN : IsDefect N)
    (mask : Fin s → Bool) (e : CSSQuotient N ≃ₗ[ZMod 2] (Fin s → ZMod 2)),
    (∀ x, cssQuotientQuadratic N hN x = signedWeightQuadratic mask (e x)) →
    (∀ x y, cssQuotientBilinear N x y = binaryDot (e x) (e y)) →
    (cssSignedSynthesis n N e)ᴴ *
      copyMatrixInColumnOrder n k (matrixTensorPower k (stabilizerProjection S)) *
        cssSignedSynthesis n N e =
      (((2 : ℂ)^n)^Module.finrank (ZMod 2) N)⁻¹ •
        copyMatrixInColumnOrder n s
          (Matrix.vecMulVec (mixedTensorVector mask (stabilizerVector S))
            (star (mixedTensorVector mask (stabilizerVector S))))

def CompressionActualMoment : Prop :=
  ∀ {n k s : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (hN : IsDefect N)
    (mask : Fin s → Bool) (e : CSSQuotient N ≃ₗ[ZMod 2] (Fin s → ZMod 2)),
    (∀ x, cssQuotientQuadratic N hN x = signedWeightQuadratic mask (e x)) →
    (∀ x y, cssQuotientBilinear N x y = binaryDot (e x) (e y)) →
    (cssSignedSynthesis n N e)ᴴ * stabilizerColumnMoment n k * cssSignedSynthesis n N e =
      (((2 : ℂ)^n)^Module.finrank (ZMod 2) N)⁻¹ • mixedStabilizerColumnMoment n mask

def CompressionActualRelationSum : Prop :=
  ∀ {n k s : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (hN : IsDefect N)
    (mask : Fin s → Bool) (e : CSSQuotient N ≃ₗ[ZMod 2] (Fin s → ZMod 2)),
    (∀ x, cssQuotientQuadratic N hN x = signedWeightQuadratic mask (e x)) →
    (∀ x y, cssQuotientBilinear N x y = binaryDot (e x) (e y)) →
    1 ≤ k → 1 ≤ s →
    (cssSignedSynthesis n N e)ᴴ *
      (∑ T : StochasticLagrangian k, relationOperator n T.carrier) * cssSignedSynthesis n N e =
      (gnwNormalization n k * (((2 : ℂ)^n)^Module.finrank (ZMod 2) N)⁻¹ *
        (gnwNormalization n s)⁻¹) •
          ∑ T : SignedStochasticLagrangian mask, relationOperator n T.carrier

def CompressionOrdinaryPositive : Prop :=
  ∀ {k r : ℕ} (N : OrdinaryDefect k r),
    0 < Module.finrank (ZMod 2) (CSSQuotient N.val)

def CompressionOrdinaryState : Prop :=
  ∀ {n k r : ℕ} (N : OrdinaryDefect k r),
    ∃ (mask : Fin (Module.finrank (ZMod 2) (CSSQuotient N.val)) → Bool)
      (e : CSSQuotient N.val ≃ₗ[ZMod 2] (Fin (Module.finrank (ZMod 2) (CSSQuotient N.val)) → ZMod 2)),
      (∀ x, cssQuotientQuadratic N.val N.property.1 x = signedWeightQuadratic mask (e x)) ∧
      (∀ x y, cssQuotientBilinear N.val x y = binaryDot (e x) (e y)) ∧
      e (cssQuotientWu N.val N.property.1) = allOnes (Module.finrank (ZMod 2) (CSSQuotient N.val)) ∧
      ∀ S : StabilizerGroup n,
        (cssSignedSynthesis n N.val e)ᴴ *
          copyMatrixInColumnOrder n k (matrixTensorPower k (stabilizerProjection S)) *
            cssSignedSynthesis n N.val e =
          (((2 : ℂ)^n)^r)⁻¹ •
            copyMatrixInColumnOrder n (Module.finrank (ZMod 2) (CSSQuotient N.val))
              (Matrix.vecMulVec (mixedTensorVector mask (stabilizerVector S))
                (star (mixedTensorVector mask (stabilizerVector S))))

def CompressionOrdinaryMomentAndRelation : Prop :=
  ∀ {n k r : ℕ} (N : OrdinaryDefect k r),
    ∃ (mask : Fin (Module.finrank (ZMod 2) (CSSQuotient N.val)) → Bool)
      (e : CSSQuotient N.val ≃ₗ[ZMod 2] (Fin (Module.finrank (ZMod 2) (CSSQuotient N.val)) → ZMod 2)),
      (∀ x, cssQuotientQuadratic N.val N.property.1 x = signedWeightQuadratic mask (e x)) ∧
      (∀ x y, cssQuotientBilinear N.val x y = binaryDot (e x) (e y)) ∧
      e (cssQuotientWu N.val N.property.1) = allOnes (Module.finrank (ZMod 2) (CSSQuotient N.val)) ∧
      (cssSignedSynthesis n N.val e)ᴴ * stabilizerColumnMoment n k * cssSignedSynthesis n N.val e =
        (((2 : ℂ)^n)^r)⁻¹ • mixedStabilizerColumnMoment n mask ∧
      (cssSignedSynthesis n N.val e)ᴴ *
        (∑ T : StochasticLagrangian k, relationOperator n T.carrier) * cssSignedSynthesis n N.val e =
        (gnwNormalization n k * (((2 : ℂ)^n)^r)⁻¹ *
          (gnwNormalization n (Module.finrank (ZMod 2) (CSSQuotient N.val)))⁻¹) •
          ∑ T : SignedStochasticLagrangian mask, relationOperator n T.carrier

end CSSStabilizerCompressionExpected

