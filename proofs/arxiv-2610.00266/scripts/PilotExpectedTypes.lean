def Interpolation : Prop :=
  ∀ P Q : ℚ[X], (∀ n : ℕ, P.eval ((2 : ℚ)^n)=Q.eval ((2 : ℚ)^n)) → P=Q

def IncrementInterpolation : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V] {W : Type v} [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W], ∀ (B : LinearMap.BilinForm (ZMod 2) V) (C : LinearMap.BilinForm (ZMod 2) W) (P : ℚ[X]), (∀ n : ℕ, Average C ((2 : ℚ)^n)-Average B ((2 : ℚ)^n)=P.eval ((2 : ℚ)^n)) → symplecticFixedSpacePolynomial C-symplecticFixedSpacePolynomial B=P

