-- Literal finite-dimensional matrix statements; no target theorem supplies a type.
def LowerRange {ι : Type*} [Fintype ι] : Prop :=
  ∀ A P : Matrix ι ι ℂ, P.PosSemidef → (A-P).PosSemidef → P*A=A →
    LinearMap.range A.mulVecLin = LinearMap.range P.mulVecLin

def SumPSD {ι : Type*} [Fintype ι] {α : Type*} : Prop :=
  ∀ (s : Finset α) (F : α → Matrix ι ι ℂ),
    (∀ t ∈ s, (F t).PosSemidef) → (∑ t ∈ s, F t).PosSemidef

def DeletePSD {ι : Type*} [Fintype ι] {α : Type*} [Fintype α] : Prop :=
  ∀ F : α → Matrix ι ι ℂ, (∀ t, (F t).PosSemidef) →
    ∀ t : α, ((∑ u, F u)-F t).PosSemidef

def SumRange {ι : Type*} [Fintype ι] {α : Type*} [Fintype α] : Prop :=
  ∀ (F : α → Matrix ι ι ℂ) (P : Matrix ι ι ℂ),
    (∀ t, (F t).PosSemidef) → ∀ t : α, F t=P → P*(∑ u, F u)=∑ u, F u →
      LinearMap.range (∑ u, F u).mulVecLin = LinearMap.range P.mulVecLin

def FrameRange {ι : Type*} [Fintype ι] {κ : Type*} [Fintype κ] : Prop :=
  ∀ C : Matrix ι κ ℂ,
    LinearMap.range (C*Cᴴ).mulVecLin = LinearMap.range C.mulVecLin

def ScalarRange {ι : Type*} [Fintype ι] {κ : Type*} [Fintype κ] : Prop :=
  ∀ (C : Matrix ι κ ℂ) (c : ℂ), c≠0 →
    LinearMap.range (c • C).mulVecLin = LinearMap.range C.mulVecLin

-- Physical definitions are independently unfolded to permutation matrices,
-- the actual finite average, relation indicators, and product coset columns.
abbrev Index (n k : ℕ) := Fin n → Fin k → ZMod 2

def U (n : ℕ) {k : ℕ} (g : StochasticIsometryGroup k) :
    Matrix (Index n k) (Index n k) ℂ :=
  (stochasticColumnPerm n g).symm.toPEquiv.toMatrix

def P (n k : ℕ) : Matrix (Index n k) (Index n k) ℂ :=
  (Fintype.card (StochasticIsometryGroup k) : ℂ)⁻¹ •
    ∑ g : StochasticIsometryGroup k, U n g

def R (n : ℕ) {k : ℕ}
    (T : Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))) :
    Matrix (Index n k) (Index n k) ℂ :=
  fun X Y => ∏ a : Fin n, if (X a,Y a) ∈ T then 1 else 0

def C (n : ℕ) {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) :
    Matrix (Index n k) (Fin n → CosetQuotient (orthogonal N) N) ℂ :=
  fun X q => ∏ a : Fin n, cosetSynthesis (orthogonal N) N (X a) (q a)

def Hermitian : Prop := ∀ n k : ℕ, (P n k).IsHermitian

def RightAverage : Prop := ∀ n : ℕ, ∀ {k : ℕ} (g : StochasticIsometryGroup k),
  P n k * U n g = P n k

def LeftAdjointAverage : Prop := ∀ n : ℕ, ∀ {k : ℕ} (g : StochasticIsometryGroup k),
  (U n g)ᴴ * P n k = P n k

def Compression : Prop := ∀ n : ℕ, ∀ {k : ℕ}
    (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (g h : StochasticIsometryGroup k),
  P n k * R n (stochasticRelation g h (defectRelation N)) * P n k =
    (((2 : ℂ)^n)^Module.finrank (ZMod 2) N) •
      (P n k * (C n N * (C n N)ᴴ) * P n k)

def CompressionPSD : Prop := ∀ n : ℕ, ∀ {k : ℕ}
    (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (g h : StochasticIsometryGroup k),
  (P n k * R n (stochasticRelation g h (defectRelation N)) * P n k).PosSemidef

def IdentityType : Type := (k : ℕ) → StochasticLagrangian k

-- Content check for the actual identity object, in addition to its literal type.
example (k : ℕ) : (identityStochasticLagrangian k).carrier =
    defectRelation (⊥ : Submodule (ZMod 2) (Fin k → ZMod 2)) := rfl

def IdentityOperator : Prop := ∀ n k : ℕ,
  R n (identityStochasticLagrangian k).carrier = 1

def IdentityCompression : Prop := ∀ n k : ℕ,
  P n k * R n (identityStochasticLagrangian k).carrier * P n k = P n k

def ActualCompressedSum : Prop := ∀ n k : ℕ,
  (∑ T : StochasticLagrangian k, R n T.carrier) =
    ∑ T : StochasticLagrangian k, P n k * R n T.carrier * P n k

