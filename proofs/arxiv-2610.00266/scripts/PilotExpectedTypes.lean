 0≤C → 0≤L0 → (∀n r,0≤w n r) → (∀n r,0≤v n r) →
 (∀r,Tendsto (fun n=>w n r) atTop (𝓝 (W c r))) →
 (∀r,Tendsto (fun n=>v n r) atTop (𝓝 (L c r))) →
 (∀ᶠn in atTop,∀r,R≤r→w n r≤C*Phi (2*(r:ℝ)-(c:ℝ))) →
 (∀ᶠn in atTop,∀r,v n r≤L0*F r ((2:ℝ)^(3-(c:ℝ)))) →
 Tendsto (fun n=>∑'r,w n r*Real.sqrt (v n r)) atTop (𝓝 (∑'r,W c r*Real.sqrt (L c r)))
