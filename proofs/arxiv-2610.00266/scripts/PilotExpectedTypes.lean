def IdentityType := {k : ℕ} → (mask : Fin k → Bool) → SignedStochasticLagrangian mask
example {k : ℕ} (mask : Fin k → Bool) :
    (identitySignedStochasticLagrangian mask).carrier =
      LinearMap.range ((LinearMap.id : BinaryVector k →ₗ[ZMod 2] BinaryVector k).prod LinearMap.id) := rfl

def DiagonalIndicator : Prop := ∀ {n k : ℕ}
    (T : Submodule (ZMod 2) (BinaryVector k × BinaryVector k)) (X : Fin n → BinaryVector k),
    relationOperator n T X X = if ∀ a, (X a,X a) ∈ T then 1 else 0
def DiagonalInclusion : Prop := ∀ {n k : ℕ}
    (T : Submodule (ZMod 2) (BinaryVector k × BinaryVector k)) (X : Fin n → BinaryVector k),
    Function.Surjective ((homColumnsEquiv n (BinaryVector k)).symm X) →
    (∀ a, (X a,X a) ∈ T) → Binary.StochasticCounting.diagonal k ≤ T
def SpanningDiagonal : Prop := ∀ {n k : ℕ}
    (T : Submodule (ZMod 2) (BinaryVector k × BinaryVector k)),
    Module.finrank (ZMod 2) T = k → ∀ X : Fin n → BinaryVector k,
    Function.Surjective ((homColumnsEquiv n (BinaryVector k)).symm X) →
    relationOperator n T X X = if T = Binary.StochasticCounting.diagonal k then 1 else 0
def SignedSumDiagonal : Prop := ∀ {n k : ℕ} (mask : Fin k → Bool) (X : Fin n → BinaryVector k),
    Function.Surjective ((homColumnsEquiv n (BinaryVector k)).symm X) →
    (∑ T : SignedStochasticLagrangian mask, relationOperator n T.carrier) X X = 1

def HomCoordinates : Prop := ∀ {n k s : ℕ}
    (N : Submodule (ZMod 2) (BinaryVector k))
    (e : CSSQuotient N ≃ₗ[ZMod 2] BinaryVector s) (f : BinaryVector n →ₗ[ZMod 2] CSSQuotient N),
    (homColumnsEquiv n (BinaryVector s)).symm
      ((Equiv.piCongrRight (fun _ : Fin n => e.toEquiv)) (homColumnsEquiv n (CSSQuotient N) f)) = e.toLinearMap.comp f
def HomSurjective : Prop := ∀ {n k s : ℕ}
    (N : Submodule (ZMod 2) (BinaryVector k))
    (e : CSSQuotient N ≃ₗ[ZMod 2] BinaryVector s) (f : BinaryVector n →ₗ[ZMod 2] CSSQuotient N),
    Function.Surjective f → Function.Surjective
      ((homColumnsEquiv n (BinaryVector s)).symm ((Equiv.piCongrRight (fun _ : Fin n => e.toEquiv)) (homColumnsEquiv n (CSSQuotient N) f)))
def SynthesisColumns : Prop := ∀ {n k s : ℕ}
    (N : Submodule (ZMod 2) (BinaryVector k))
    (e : CSSQuotient N ≃ₗ[ZMod 2] BinaryVector s) (f : BinaryVector n →ₗ[ZMod 2] CSSQuotient N),
    (cssSignedSynthesis n N e).col ((Equiv.piCongrRight (fun _ : Fin n => e.toEquiv)) (homColumnsEquiv n (CSSQuotient N) f)) =
      (cssHomSynthesis n N).col f

universe u v
def CompressionEntry {ι : Type u} {κ : Type v} [Fintype ι] : Prop :=
    ∀ (E : Matrix ι κ ℂ) (A : Matrix ι ι ℂ) (q : κ),
    (Eᴴ * A * E) q q =
      ∑ i, star (E i q) * ∑ j, A i j * E j q

def SignedCSSDiagonal : Prop := ∀ {n k s : ℕ}
    (N : Submodule (ZMod 2) (BinaryVector k)) (hN : IsDefect N)
    (mask : Fin s → Bool) (e : CSSQuotient N ≃ₗ[ZMod 2] BinaryVector s),
    (∀ x, cssQuotientQuadratic N hN x = signedWeightQuadratic mask (e x)) →
    (∀ x y, cssQuotientBilinear N x y = binaryDot (e x) (e y)) →
    1 ≤ k → 1 ≤ s → ∀ f : BinaryVector n →ₗ[ZMod 2] CSSQuotient N,
    Function.Surjective f →
    (∑ X, star (cssHomSynthesis n N X f) *
      ∑ Y, (∑ T : StochasticLagrangian k, relationOperator n T.carrier) X Y *
        cssHomSynthesis n N Y f) =
    gnwNormalization n k * (((2 : ℂ)^n)^Module.finrank (ZMod 2) N)⁻¹ *
      (gnwNormalization n s)⁻¹
def OrdinaryCSSDiagonal : Prop := ∀ {n k r : ℕ} (N : OrdinaryDefect k r)
    (f : BinaryVector n →ₗ[ZMod 2] CSSQuotient N.val),
    Function.Surjective f →
    (∑ X, star (cssHomSynthesis n N.val X f) *
      ∑ Y, (∑ T : StochasticLagrangian k, relationOperator n T.carrier) X Y *
        cssHomSynthesis n N.val Y f) =
    gnwNormalization n k * (((2 : ℂ)^n)^r)⁻¹ * (gnwNormalization n (k-2*r))⁻¹

