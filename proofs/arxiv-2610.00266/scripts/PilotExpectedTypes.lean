namespace BinaryNewtonExpected
open ExactCriticalCurve.Counting
universe u
variable {R : Type u} [CommRing R]
def Fall (z c : R) (a : ℕ) := ∏ j ∈ Finset.range a, (z-(2:R)^j*c)
def Rise (c y : R) (a : ℕ) := ∏ j ∈ Finset.range a, (c+(2:R)^j*y)
def Term (m a : ℕ) (z c y : R) := (binaryGaussian m a:R)*Fall z c a*Rise c y (m-a)
def ProductType (R : Type u) [CommRing R] := R → R → ℕ → R
def TermType (R : Type u) [CommRing R] := ℕ → ℕ → R → R → R → R
def FallZero (R : Type u) [CommRing R] : Prop := ∀ z c : R, Fall z c 0 = 1
def RiseZero (R : Type u) [CommRing R] : Prop := ∀ c y : R, Rise c y 0 = 1
def FallSucc (R : Type u) [CommRing R] : Prop := ∀ (z c : R) (a : ℕ),
  Fall z c (a+1)=Fall z c a*(z-(2:R)^a*c)
def RiseSucc (R : Type u) [CommRing R] : Prop := ∀ (c y : R) (a : ℕ),
  Rise c y (a+1)=Rise c y a*(c+(2:R)^a*y)
def Newton (R : Type u) [CommRing R] : Prop := ∀ (m : ℕ) (z c y : R),
  (∏ j ∈ Finset.range m, (z+(2:R)^j*y)) =
    ∑ a ∈ Finset.range (m+1), (binaryGaussian m a:R) *
      (∏ j ∈ Finset.range a, (z-(2:R)^j*c)) *
      (∏ j ∈ Finset.range (m-a), (c+(2:R)^j*y))
example (z c : R) (a : ℕ) : binaryNewtonFalling z c a = Fall z c a := rfl
example (c y : R) (a : ℕ) : binaryNewtonRising c y a = Rise c y a := rfl
example (m a : ℕ) (z c y : R) : binaryNewtonTerm m a z c y = Term m a z c y := rfl
