def T20 : Prop := ∀ (c:ℤ), ∀ᶠ n:ℕ in atTop, ∀ r, Nonempty (OrdinaryDefect ((n:ℤ)+c).toNat r) → ordinaryGramValue n ((n:ℤ)+c).toNat r≤(2*criticalLambdaZero c)*criticalF r ((2:ℝ)^(3-(c:ℝ)))

