def SqrtRemainder : Type := ℝ → ℝ
def SqrtFactor : Prop := ∀ t : ℝ, 0≤t →
  sqrtTaylorRemainder t=(Real.sqrt t-1)^3*(Real.sqrt t+3)/8
def SqrtAbsFactor : Prop := ∀ t : ℝ, 0≤t →
  |sqrtTaylorRemainder t|=|Real.sqrt t-1|^3*(Real.sqrt t+3)/8
def SqrtDifferenceFactor : Prop := ∀ t : ℝ, 0≤t →
  |t-1|=|Real.sqrt t-1| * (Real.sqrt t+1)
def SqrtCubic : Prop := ∀ t : ℝ, 0≤t →
  |sqrtTaylorRemainder t|≤(3/8 : ℝ)*|t-1|^3
def SqrtQuadratic : Prop := ∀ t : ℝ, 0≤t →
  |sqrtTaylorRemainder t|≤(3/8 : ℝ)*(t-1)^2

def WeightedQuadratic : Prop := ∀ w t : ℝ, 0≤w → 0≤t →
  w*|sqrtTaylorRemainder t|≤(3/8 : ℝ)*(w*(t-1)^2)
def WeightedBulk : Prop := ∀ w t ε : ℝ, 0≤w → 0≤t → |t-1|≤ε →
  w*|sqrtTaylorRemainder t|≤((3/8 : ℝ)*ε)*(w*(t-1)^2)
def AbsoluteSummable : Prop := ∀ {ι : Type u} (w lam : ι → ℝ),
  (∀ i, 0≤w i) → (∀ i, 0≤lam i) → Summable (fun i => w i*(lam i-1)^2) →
    Summable (fun i => w i*|sqrtTaylorRemainder (lam i)|)
def SignedSummable : Prop := ∀ {ι : Type u} (w lam : ι → ℝ),
  (∀ i, 0≤w i) → (∀ i, 0≤lam i) → Summable (fun i => w i*(lam i-1)^2) →
    Summable (fun i => w i*sqrtTaylorRemainder (lam i))
def AbsoluteBulkTail : Prop := ∀ {ι : Type u} (w lam : ι → ℝ),
  (∀ i, 0≤w i) → (∀ i, 0≤lam i) → Summable (fun i => w i*(lam i-1)^2) →
    ∀ (B : Set ι) (ε : ℝ), (∀ i∈B, |lam i-1|≤ε) →
      (∑' i, w i*|sqrtTaylorRemainder (lam i)|) ≤ (3/8 : ℝ)*
        (ε*(∑' i : B, w i.val*(lam i.val-1)^2)+
          ∑' i : ↑(Bᶜ), w i.val*(lam i.val-1)^2)
def SignedBulkTail : Prop := ∀ {ι : Type u} (w lam : ι → ℝ),
  (∀ i, 0≤w i) → (∀ i, 0≤lam i) → Summable (fun i => w i*(lam i-1)^2) →
    ∀ (B : Set ι) (ε : ℝ), (∀ i∈B, |lam i-1|≤ε) →
      |∑' i, w i*sqrtTaylorRemainder (lam i)| ≤ (3/8 : ℝ)*
        (ε*(∑' i : B, w i.val*(lam i.val-1)^2)+
          ∑' i : ↑(Bᶜ), w i.val*(lam i.val-1)^2)
end WeightedSqrtExpected

