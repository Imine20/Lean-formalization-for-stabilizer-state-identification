namespace CSSGammaScalarExpected
open Classical ExactCriticalCurve ExactCriticalCurve.Quantum ExactCriticalCurve.Binary
open ExactCriticalCurve.Counting Module
abbrev Stratum {k r : ℕ} (N : OrdinaryDefect k r) (ell : Fin (r+1)) :=
  {K : {K : Submodule (ZMod 2) (BinaryVector k) // K ≤ N.val} //
    finrank (ZMod 2) K.val + ell.val = r}
def InternalEquivType := ∀ {k r : ℕ} (N : OrdinaryDefect k r) (ell : Fin (r+1)),
  Stratum N ell ≃ {K : Submodule (ZMod 2) N.val // finrank (ZMod 2) K = r-ell.val}
def OrthogonalEquivType := ∀ r ell : ℕ, ell ≤ r →
  {K : Submodule (ZMod 2) (BinaryVector r) // finrank (ZMod 2) K = r-ell} ≃
  {K : Submodule (ZMod 2) (BinaryVector r) // finrank (ZMod 2) K = ell}
def Count : Prop := ∀ {k r : ℕ} (N : OrdinaryDefect k r) (ell : Fin (r+1)),
  Nat.card (Stratum N ell) = binaryGaussian r ell.val
def Gamma (n k r : ℕ) : ℂ := (((2 : ℂ)^n)^r)⁻¹ *
  ∏ j ∈ Finset.range r, ((2 : ℂ)^n + (2 : ℂ)^(k-2*r-1+j))
def H (n k r : ℕ) : ℂ := ∏ j ∈ Finset.range r,
  ((2 : ℂ)^n + (2 : ℂ)^(k-r-1+j))
def WeightedRow : Prop := ∀ {k r : ℕ} (n : ℕ) (N : OrdinaryDefect k r),
  (∑ g : StochasticIsometryGroup k,
    if ∀ x ∈ orthogonal N.val, g.val x-x ∈ N.val ⊔ N.val.map g.val.toLinearMap
    then (((2 : ℂ)^n)^(finrank (ZMod 2) N.val -
      finrank (ZMod 2) ↥(N.val ⊓ N.val.map g.val.toLinearMap)))⁻¹ else 0) =
    (Nat.card (stochasticParabolicKernel N.val) : ℂ) * Gamma n k r
def A (n k : ℕ) := ∑ T : StochasticLagrangian k, relationOperator n T.carrier
def Scalar : Prop := ∀ {n k r : ℕ} (N : OrdinaryDefect k r), k ≤ n →
  ∃ θ : ℝ,
    (A n k * ordinaryCSSGrade n k r = θ • ordinaryCSSGrade n k r ∧
     ordinaryCSSGrade n k r * A n k = θ • ordinaryCSSGrade n k r) ∧
    (θ : ℂ) = (Fintype.card (StochasticIsometryGroup k) : ℂ) /
      (Nat.card (stochasticParabolicKernel N.val) : ℂ) * H n k r
def ClosedScalar : Prop := ∀ {n k r : ℕ} (N : OrdinaryDefect k r), k ≤ n →
  ∃ θ : ℝ,
    (A n k * ordinaryCSSGrade n k r = θ • ordinaryCSSGrade n k r ∧
     ordinaryCSSGrade n k r * A n k = θ • ordinaryCSSGrade n k r) ∧
    (θ : ℂ) = (Fintype.card (StochasticIsometryGroup k) : ℂ) /
      ((2 : ℂ)^(r*(k-r-2)) * ∏ j ∈ Finset.range r, ((2 : ℂ)^(j+1)-1)) *
        ∏ j ∈ Finset.range r, ((2 : ℂ)^n + (2 : ℂ)^(k-r-1+j))
example {k r : ℕ} (N : OrdinaryDefect k r) (ell : Fin (r+1))
    (K : Stratum N ell) :
    (cssIntersectionSubspacesEquiv N ell K).val = K.val.val.comap N.val.subtype := rfl
example (r ell : ℕ) (h : ell ≤ r)
    (K : {K : Submodule (ZMod 2) (BinaryVector r) // finrank (ZMod 2) K = r-ell}) :
    (binarySubspacesOrthogonalEquiv r ell h K).val = orthogonal K.val := rfl
example (r ell : ℕ) (h : ell ≤ r)
    (K : {K : Submodule (ZMod 2) (BinaryVector r) // finrank (ZMod 2) K = ell}) :
    ((binarySubspacesOrthogonalEquiv r ell h).symm K).val = orthogonal K.val := rfl
