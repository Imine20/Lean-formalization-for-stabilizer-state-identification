def PolarProjection : Prop :=
  ∀ {A : Type u} {V : Type v} [AddCommGroup A] [Module (ZMod 2) A]
    [AddCommGroup V] [Module (ZMod 2) V], ∀ (Q : QuadraticForm (ZMod 2) V)
    (q : EmbeddableQuadraticForm Q A), (embeddableQuadraticPolarEquiv Q q).1.val=q.val.polarBilin
def RadicalProjection : Prop :=
  ∀ {A : Type u} {V : Type v} [AddCommGroup A] [Module (ZMod 2) A]
    [AddCommGroup V] [Module (ZMod 2) V], ∀ (Q : QuadraticForm (ZMod 2) V)
    (q : EmbeddableQuadraticForm Q A), (embeddableQuadraticRadicalEquiv Q q).1=LinearMap.ker q.val.polarBilin
def RadicalCount : Prop :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] [FiniteDimensional (ZMod 2) A],
    ∀ b t : ℕ, finrank (ZMod 2) A=b+2*t →
    Nat.card {B : {B : LinearMap.BilinForm (ZMod 2) A // B.IsAlt} //
      finrank (ZMod 2) (LinearMap.ker B.val)=b} =
      Counting.binaryGaussian (b+2*t) b * nondegenerateAlternatingCount (2*t)

def PolarEquivType :=
  ∀ {A : Type u} {V : Type v} [AddCommGroup A] [Module (ZMod 2) A]
    [AddCommGroup V] [Module (ZMod 2) V], ∀ Q : QuadraticForm (ZMod 2) V,
    {q : QuadraticForm (ZMod 2) A // ∃ f : A →ₗ[ZMod 2] V,
      Function.Injective f ∧ ∀ x, Q (f x)=q x} ≃
    Σ B : {B : LinearMap.BilinForm (ZMod 2) A // B.IsAlt},
      {q : {q : QuadraticForm (ZMod 2) A // q.polarBilin=B.val} //
        ∃ f : A →ₗ[ZMod 2] V, Function.Injective f ∧ ∀ x, Q (f x)=q.val x}
def RadicalEquivType :=
  ∀ {A : Type u} {V : Type v} [AddCommGroup A] [Module (ZMod 2) A]
    [AddCommGroup V] [Module (ZMod 2) V], ∀ Q : QuadraticForm (ZMod 2) V,
    {q : QuadraticForm (ZMod 2) A // ∃ f : A →ₗ[ZMod 2] V,
      Function.Injective f ∧ ∀ x, Q (f x)=q x} ≃
    Σ R : Submodule (ZMod 2) A,
      Σ C : {C : LinearMap.BilinForm (ZMod 2) (A ⧸ R) // C.IsAlt ∧ C.Nondegenerate},
        {q : {q : QuadraticForm (ZMod 2) A // q.polarBilin=C.val.comp R.mkQ R.mkQ} //
          ∃ f : A →ₗ[ZMod 2] V, Function.Injective f ∧ ∀ x, Q (f x)=q.val x}
def RankEquivType :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A], ∀ b : ℕ,
    {B : {B : LinearMap.BilinForm (ZMod 2) A // B.IsAlt} //
      finrank (ZMod 2) (LinearMap.ker B.val)=b} ≃
      Σ R : {R : Submodule (ZMod 2) A // finrank (ZMod 2) R=b},
        {C : LinearMap.BilinForm (ZMod 2) (A ⧸ R.val) // C.IsAlt ∧ C.Nondegenerate}

example {A : Type u} {V : Type v} [AddCommGroup A] [Module (ZMod 2) A]
    [AddCommGroup V] [Module (ZMod 2) V] (Q : QuadraticForm (ZMod 2) V)
    (q : EmbeddableQuadraticForm Q A) : (embeddableQuadraticPolarEquiv Q q).2.val.val=q.val := rfl
example {A : Type u} {V : Type v} [AddCommGroup A] [Module (ZMod 2) A]
    [AddCommGroup V] [Module (ZMod 2) V] (Q : QuadraticForm (ZMod 2) V) :
    embeddableQuadraticRadicalEquiv (A := A) Q =
      ((embeddableQuadraticPolarEquiv Q).trans
        (Equiv.sigmaCongrLeft' (alternatingRadicalEquiv (E := A)))).trans
          (Equiv.sigmaAssoc (fun (R : Submodule (ZMod 2) A)
            (C : NondegenerateAlternatingForm (A ⧸ R)) =>
              BinaryQuadraticEmbeddableRefinements (C.val.comp R.mkQ R.mkQ) Q)) := rfl
example {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] (b : ℕ) :
    alternatingRadicalRankEquiv (A := A) b =
      (alternatingRadicalEquiv.subtypeEquiv (fun _ => Iff.rfl)).trans
        (Equiv.subtypeSigmaEquiv
          (fun R : Submodule (ZMod 2) A => NondegenerateAlternatingForm (A ⧸ R))
          (fun R => finrank (ZMod 2) R=b)) := rfl
end OrthogonalPolarExpected
