  let mut count := 0
  for (name, _) in env.constants.toList do
    if name.toString.startsWith "ExactCriticalCurve.FiniteQuadratic.NonsingularWu." ||
        (name.toString.startsWith "_private.ExactCriticalCurve.FiniteQuadratic.NonsingularWu") then
