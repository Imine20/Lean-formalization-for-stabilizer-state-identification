def QuotientSplit {K V : Type*} [Field K] [AddCommGroup V] [Module K V] : Prop :=
  ∀ N : Submodule K V, ∃ s : ((V ⧸ N) × N) ≃ₗ[K] V,
    ∀ (q : V ⧸ N) (n : N), (Submodule.Quotient.mk (s (q, n)) : V ⧸ N) = q

def QuotientUnpointedLift {K V W : Type*} [Field K]
    [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W] : Prop :=
  ∀ (N : Submodule K V) (M : Submodule K W)
    (e : (V ⧸ N) ≃ₗ[K] (W ⧸ M)) (f : N ≃ₗ[K] M),
    ∃ g : V ≃ₗ[K] W,
      ∀ x : V, (Submodule.Quotient.mk (g x) : W ⧸ M) = e (Submodule.Quotient.mk x)

def BinaryShearPreservesClass {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] : Prop :=
  ∀ (N : Submodule (ZMod 2) V) (l : V →ₗ[ZMod 2] ZMod 2) (d : V),
    l d = 0 → d ∈ N → ∀ x : V,
      (Submodule.Quotient.mk (x + l x • d) : V ⧸ N) = Submodule.Quotient.mk x

def BinaryClassTransitivity {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] : Prop :=
  ∀ (N : Submodule (ZMod 2) V) (a b : V), a ≠ 0 → b ≠ 0 →
    (Submodule.Quotient.mk a : V ⧸ N) = Submodule.Quotient.mk b →
    ∃ u : V ≃ₗ[ZMod 2] V, u a = b ∧
      ∀ x : V, (Submodule.Quotient.mk (u x) : V ⧸ N) = Submodule.Quotient.mk x

def BinaryPointedLift {V W : Type*}
    [AddCommGroup V] [Module (ZMod 2) V] [AddCommGroup W] [Module (ZMod 2) W] : Prop :=
  ∀ (N : Submodule (ZMod 2) V) (M : Submodule (ZMod 2) W)
    (e : (V ⧸ N) ≃ₗ[ZMod 2] (W ⧸ M)) (f : N ≃ₗ[ZMod 2] M) (v : V) (w : W),
    (v = 0 ↔ w = 0) → e (Submodule.Quotient.mk v) = Submodule.Quotient.mk w →
    ∃ g : V ≃ₗ[ZMod 2] W, g v = w ∧
      ∀ x : V, (Submodule.Quotient.mk (g x) : W ⧸ M) = e (Submodule.Quotient.mk x)

def CSSLiftExists : Prop :=
  ∀ {k : ℕ} (N M : Submodule (ZMod 2) (Fin k → ZMod 2))
    (hN : IsDefect N) (hM : IsDefect M)
    (e : ((orthogonal N) ⧸ N.comap (orthogonal N).subtype) ≃ₗ[ZMod 2]
      ((orthogonal M) ⧸ M.comap (orthogonal M).subtype))
    (hq : ∀ x, cssQuotientQuadratic M hM (e x) = cssQuotientQuadratic N hN x)
    (hw : e (cssQuotientWu N hN) = cssQuotientWu M hM),
    ∃ f : orthogonal N ≃ₗ[ZMod 2] orthogonal M,
      (∀ x, (Submodule.Quotient.mk (f x) : CSSQuotient M) = e (Submodule.Quotient.mk x)) ∧
      (∀ x, (∑ i, bitLift ((f x).val i)) = ∑ i, bitLift (x.val i)) ∧
      f ⟨allOnes k, hN.allOnes_mem_orthogonal⟩ = ⟨allOnes k, hM.allOnes_mem_orthogonal⟩

def CSSLiftCoversActualQuotient : Prop :=
  ∀ {k : ℕ} (N M : Submodule (ZMod 2) (Fin k → ZMod 2))
    (hN : IsDefect N) (hM : IsDefect M)
    (e : ((orthogonal N) ⧸ N.comap (orthogonal N).subtype) ≃ₗ[ZMod 2]
      ((orthogonal M) ⧸ M.comap (orthogonal M).subtype))
    (hq : ∀ x, cssQuotientQuadratic M hM (e x) = cssQuotientQuadratic N hN x)
    (hw : e (cssQuotientWu N hN) = cssQuotientWu M hM) (x : orthogonal N),
    (Submodule.Quotient.mk (cssQuotientLift N M hN hM e hq hw x) : CSSQuotient M) =
      e (Submodule.Quotient.mk x)

def CSSLiftFullQuadratic : Prop :=
  ∀ {k : ℕ} (N M : Submodule (ZMod 2) (Fin k → ZMod 2))
    (hN : IsDefect N) (hM : IsDefect M)
    (e : ((orthogonal N) ⧸ N.comap (orthogonal N).subtype) ≃ₗ[ZMod 2]
      ((orthogonal M) ⧸ M.comap (orthogonal M).subtype))
    (hq : ∀ x, cssQuotientQuadratic M hM (e x) = cssQuotientQuadratic N hN x)
    (hw : e (cssQuotientWu N hN) = cssQuotientWu M hM) (x : orthogonal N),
    (∑ i, bitLift ((cssQuotientLift N M hN hM e hq hw x).val i)) =
      ∑ i, bitLift (x.val i)

def CSSLiftActualWu : Prop :=
  ∀ {k : ℕ} (N M : Submodule (ZMod 2) (Fin k → ZMod 2))
    (hN : IsDefect N) (hM : IsDefect M)
    (e : ((orthogonal N) ⧸ N.comap (orthogonal N).subtype) ≃ₗ[ZMod 2]
      ((orthogonal M) ⧸ M.comap (orthogonal M).subtype))
    (hq : ∀ x, cssQuotientQuadratic M hM (e x) = cssQuotientQuadratic N hN x)
    (hw : e (cssQuotientWu N hN) = cssQuotientWu M hM),
    cssQuotientLift N M hN hM e hq hw ⟨allOnes k, hN.allOnes_mem_orthogonal⟩ =
      ⟨allOnes k, hM.allOnes_mem_orthogonal⟩

def CSSLiftActualKernel : Prop :=
  ∀ {k : ℕ} (N M : Submodule (ZMod 2) (Fin k → ZMod 2))
    (hN : IsDefect N) (hM : IsDefect M)
    (e : ((orthogonal N) ⧸ N.comap (orthogonal N).subtype) ≃ₗ[ZMod 2]
      ((orthogonal M) ⧸ M.comap (orthogonal M).subtype))
    (hq : ∀ x, cssQuotientQuadratic M hM (e x) = cssQuotientQuadratic N hN x)
    (hw : e (cssQuotientWu N hN) = cssQuotientWu M hM) (x : orthogonal N),
    (cssQuotientLift N M hN hM e hq hw x).val ∈ M ↔ x.val ∈ N

def RelationLiftCoversQuotient : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k) (x : orthogonal T.rightDefect),
    (Submodule.Quotient.mk (relationOrthogonalEquiv T x) : CSSQuotient T.leftDefect) =
      relationQuotientEquiv T (Submodule.Quotient.mk x)

def RelationLiftFullQuadratic : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k) (x : orthogonal T.rightDefect),
    (∑ i, bitLift ((relationOrthogonalEquiv T x).val i)) = ∑ i, bitLift (x.val i)

def RelationLiftActualWu : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k),
    relationOrthogonalEquiv T ⟨allOnes k, T.rightDefect_isDefect.allOnes_mem_orthogonal⟩ =
      ⟨allOnes k, T.leftDefect_isDefect.allOnes_mem_orthogonal⟩

def RelationLiftActualKernels : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k) (x : orthogonal T.rightDefect),
    (relationOrthogonalEquiv T x).val ∈ T.leftDefect ↔ x.val ∈ T.rightDefect

def RelationLiftActualPair : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k) (x : orthogonal T.rightDefect),
    ((relationOrthogonalEquiv T x).val, x.val) ∈ T.carrier

end CSSQuotientLiftExpected

