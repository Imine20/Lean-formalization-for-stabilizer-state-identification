open Lean Elab Command Meta in
def auditSymplecticRealizedDefinition (actual expected : Name) : CommandElabM Unit := do
  liftTermElabM do
    let info ← getConstInfo actual
    let expectedInfo ← getConstInfo expected
    unless info.levelParams.length == expectedInfo.levelParams.length do
      throwError "Definition universe generality mismatch: {actual}"
    let levelParams := (List.range info.levelParams.length).map
      (fun i => Name.mkSimple ("auditUniverse" ++ toString i))
    let levels := levelParams.map Level.param
    let term := mkConst actual levels
    let expectedTerm := mkConst expected levels
    let expectedType ← inferType expectedTerm
    let expectedValue ← forallTelescope expectedType fun args _ => do
      mkForallFVars args (mkAppN expectedTerm args)
    unless ← isDefEq (← inferType term) expectedValue do
      throwError "Independent definition type mismatch {actual}"
    let kernelEnv := (← getEnv).toKernelEnv
    let limit := (Core.getMaxHeartbeats (← getOptions)).toUSize
    for (label, value) in #[
        ("constant", term), ("body", info.instantiateValueLevelParams! levels)] do
      let name ← mkFreshUserName (Name.mkSimple ("definitionAudit_" ++ label))
      let decl : Declaration := .defnDecl {
        name := name, levelParams := levelParams, type := expectedValue, value := value,
        hints := .opaque, safety := .safe
      }
      let _ ← ofExceptKernelException <| Kernel.Environment.addDeclCore kernelEnv limit decl none
      logInfo m!"KERNEL_EXPECTED_DEFINITION_OK {label} {actual}"

namespace SymplecticRealizedExpected
universe u v
open ExactCriticalCurve ExactCriticalCurve.FiniteQuadratic Module
open scoped BigOperators

def NotOne : Prop := ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V] (B : LinearMap.BilinForm (ZMod 2) V),
  B.IsAlt → B.Nondegenerate → finrank (ZMod 2) V ≠ 1

def EvenDimension : Prop := ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V] (B : LinearMap.BilinForm (ZMod 2) V),
  B.IsAlt → B.Nondegenerate → Even (finrank (ZMod 2) V)

def EvenRank : Prop := ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V] (A : LinearMap.BilinForm (ZMod 2) V),
  A.IsAlt → Even (finrank (ZMod 2) (LinearMap.range A))

def QuotientType : Type (u+1) :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E]
    (A : LinearMap.BilinForm (ZMod 2) E), A.IsAlt →
    ∀ K : Submodule (ZMod 2) E, K ≤ LinearMap.ker A → LinearMap.BilinForm (ZMod 2) (E ⧸ K)

def QuotientApply : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E]
    (A : LinearMap.BilinForm (ZMod 2) E) (hA : A.IsAlt)
    (K : Submodule (ZMod 2) E) (hK : K ≤ LinearMap.ker A) (x y : E),
    alternatingQuotientForm A hA K hK (K.mkQ x) (K.mkQ y) = A x y

def QuotientAlternating : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E]
    (A : LinearMap.BilinForm (ZMod 2) E) (hA : A.IsAlt)
    (K : Submodule (ZMod 2) E) (hK : K ≤ LinearMap.ker A),
    (alternatingQuotientForm A hA K hK).IsAlt

def QuotientRadical : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E]
    (A : LinearMap.BilinForm (ZMod 2) E) (hA : A.IsAlt)
    (K : Submodule (ZMod 2) E) (hK : K ≤ LinearMap.ker A),
    LinearMap.ker (alternatingQuotientForm A hA K hK) = (LinearMap.ker A).map K.mkQ

def QuotientEmbedding : Prop :=
  ∀ {E : Type u} {V : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    [AddCommGroup V] [Module (ZMod 2) V]
    (K : Submodule (ZMod 2) E) (A : LinearMap.BilinForm (ZMod 2) (E ⧸ K))
    (B : LinearMap.BilinForm (ZMod 2) V),
    (∃ f : E →ₗ[ZMod 2] V, LinearMap.ker f = K ∧
      ∀ x y, B (f x) (f y) = A (K.mkQ x) (K.mkQ y)) ↔
    (∃ g : (E ⧸ K) →ₗ[ZMod 2] V, Function.Injective g ∧ ∀ x y, B (g x) (g y) = A x y)

def QuotientCriterion : Prop :=
  ∀ {E : Type u} {V : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) E] [FiniteDimensional (ZMod 2) V]
    (K : Submodule (ZMod 2) E) (A : LinearMap.BilinForm (ZMod 2) (E ⧸ K)), A.IsAlt →
    ∀ B : LinearMap.BilinForm (ZMod 2) V, B.IsAlt → B.Nondegenerate →
    ((∃ f : E →ₗ[ZMod 2] V, LinearMap.ker f = K ∧
      ∀ x y, B (f x) (f y) = A (K.mkQ x) (K.mkQ y)) ↔
    finrank (ZMod 2) (E ⧸ K) + finrank (ZMod 2) (LinearMap.ker A) ≤ finrank (ZMod 2) V)

def QuotientRadicalDimension : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E]
    (A : LinearMap.BilinForm (ZMod 2) E) (hA : A.IsAlt)
    (K : Submodule (ZMod 2) E) (hK : K ≤ LinearMap.ker A),
    finrank (ZMod 2) (LinearMap.ker (alternatingQuotientForm A hA K hK)) +
      finrank (ZMod 2) K = finrank (ZMod 2) (LinearMap.ker A)

def FullCriterion : Prop :=
  ∀ {E : Type u} {V : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) E] [FiniteDimensional (ZMod 2) V]
    (K : Submodule (ZMod 2) E) (A : LinearMap.BilinForm (ZMod 2) E)
    (B : LinearMap.BilinForm (ZMod 2) V), B.IsAlt → B.Nondegenerate →
    ((∃ f : E →ₗ[ZMod 2] V, LinearMap.ker f = K ∧ ∀ x y, B (f x) (f y) = A x y) ↔
      A.IsAlt ∧ K ≤ LinearMap.ker A ∧
        finrank (ZMod 2) E + finrank (ZMod 2) (LinearMap.ker A) ≤
          finrank (ZMod 2) V + 2 * finrank (ZMod 2) K)

abbrev Data (E : Type u) [AddCommGroup E] [Module (ZMod 2) E] (d : ℕ) :=
  {p : Submodule (ZMod 2) E × LinearMap.BilinForm (ZMod 2) E //
    p.2.IsAlt ∧ p.1 ≤ LinearMap.ker p.2 ∧
      finrank (ZMod 2) E + finrank (ZMod 2) (LinearMap.ker p.2) ≤ d + 2 * finrank (ZMod 2) p.1}

def DataType : Type (u+1) :=
  ∀ (E : Type u) [AddCommGroup E] [Module (ZMod 2) E], ℕ → Type u

def RangeCriterion : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) V), B.IsAlt → B.Nondegenerate →
    ∀ (n : ℕ) (p : Submodule (ZMod 2) (Fin n → ZMod 2) × LinearMap.BilinForm (ZMod 2) (Fin n → ZMod 2)),
      p ∈ Set.range (fun x : Fin n → V =>
        let f := (Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x
        (LinearMap.ker f, B.comp f f)) ↔
      p.2.IsAlt ∧ p.1 ≤ LinearMap.ker p.2 ∧
        finrank (ZMod 2) (Fin n → ZMod 2) + finrank (ZMod 2) (LinearMap.ker p.2) ≤
          finrank (ZMod 2) V + 2 * finrank (ZMod 2) p.1

def RangeEquivType : Type (u+1) :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) V), B.IsAlt → B.Nondegenerate → ∀ n : ℕ,
    Set.range (fun x : Fin n → V =>
      let f := (Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x
      (LinearMap.ker f, B.comp f f)) ≃ Data (Fin n → ZMod 2) (finrank (ZMod 2) V)

def OrbitEquivType : Type (u+1) :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) V), B.IsAlt → B.Nondegenerate → ∀ n : ℕ,
    MulAction.orbitRel.Quotient (BinarySymplecticIsometryGroup B) (Fin n → V) ≃
      Data (Fin n → ZMod 2) (finrank (ZMod 2) V)

def Average : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) V), B.IsAlt → B.Nondegenerate → ∀ n : ℕ,
    (∑ g : BinarySymplecticIsometryGroup B, ((2 : ℚ)^n)^
      finrank (ZMod 2) (Counting.fixedSubmodule (ZMod 2) V g)) /
        (Nat.card (BinarySymplecticIsometryGroup B) : ℚ) =
      (Nat.card (Data (Fin n → ZMod 2) (finrank (ZMod 2) V)) : ℚ)

example {E : Type u} [AddCommGroup E] [Module (ZMod 2) E]
    (A : LinearMap.BilinForm (ZMod 2) E) (hA : A.IsAlt)
    (K : Submodule (ZMod 2) E) (hK : K ≤ LinearMap.ker A) (x y : E) :
    alternatingQuotientForm A hA K hK (K.mkQ x) (K.mkQ y) = A x y := rfl
example (E : Type u) [AddCommGroup E] [Module (ZMod 2) E] (d : ℕ) :
    RealizableAlternatingInvariant E d = Data E d := rfl
example {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) V) (hB : B.IsAlt) (hBn : B.Nondegenerate)
    (n : ℕ) (p : Set.range (symplecticTupleInvariant B n)) :
    (symplecticTupleRealizedEquivExplicit B hB hBn n p).val = p.val := rfl
example {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) V) (hB : B.IsAlt) (hBn : B.Nondegenerate)
    (n : ℕ) (p : Data (Fin n → ZMod 2) (finrank (ZMod 2) V)) :
    ((symplecticTupleRealizedEquivExplicit B hB hBn n).symm p).val = p.val := rfl
example {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) V) (hB : B.IsAlt) (hBn : B.Nondegenerate)
    (n : ℕ) (x : Fin n → V) :
    (symplecticTupleOrbitEquivExplicit B hB hBn n (Quotient.mk _ x)).val =
      (LinearMap.ker ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x),
        B.comp ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x)
          ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x)) := rfl

end SymplecticRealizedExpected

