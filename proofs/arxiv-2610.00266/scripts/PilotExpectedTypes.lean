      let (_, next) := ((CollectAxioms.collect name).run env).run closure
      closure := next
      for ax in closure.axioms do
        unless #[`propext, `Classical.choice, `Quot.sound].contains ax do
          throwError "Forbidden transitive axiom {ax} in {name}"
      logInfo m!"NEW_DECLARATION_AXIOMS_OK {name}"
  logInfo m!"PROJECT_AXIOMS_UNION {closure.axioms}"
  logInfo m!"PROJECT_AUDIT_OK declarations={declarations} theorems={theorems}"


open Lean Elab Command Meta in
def auditShorteningRelationsDefinition (actual expected : Name) : CommandElabM Unit := do
  liftTermElabM do
    let actualInfo ← getConstInfo actual
    unless actualInfo matches .defnInfo _ do
      throwError "Expected definition: {actual}"
    let expectedInfo ← getConstInfo expected
    unless actualInfo.levelParams.length == expectedInfo.levelParams.length do
      throwError "Definition universe mismatch: {actual}"
    let params := (List.range actualInfo.levelParams.length).map (fun i => Name.mkSimple ("auditUniverse" ++ toString i))
    let levels := params.map Level.param
    let term := mkConst actual levels
    let expectedTerm := mkConst expected levels
    let expectedType ← inferType expectedTerm
    let expectedValue ← forallTelescope expectedType fun args _ =>
      mkForallFVars args (mkAppN expectedTerm args)
    unless ← isDefEq (← inferType term) expectedValue do
      throwError "Exact definition type mismatch {actual}: {← inferType term}"
    let env := (← getEnv).toKernelEnv
    let limit := (Core.getMaxHeartbeats (← getOptions)).toUSize
    for (label, value) in #[("constant",term),("body",actualInfo.instantiateValueLevelParams! levels)] do
      let name ← mkFreshUserName (Name.mkSimple ("kernelDefinition_" ++ label))
      let decl : Declaration := .defnDecl {
        name := name
        levelParams := params
        type := expectedValue
        value := value
        hints := .opaque
        safety := .safe
      }
      let _ ← ofExceptKernelException <| Kernel.Environment.addDeclCore env limit decl none
      logInfo m!"KERNEL_EXPECTED_DEFINITION_OK {label} {actual}"
    logInfo m!"EXACT_DEFINITION_TYPE_OK {actual}"

open Classical
namespace ShorteningRelationsExpected
open ExactCriticalCurve ExactCriticalCurve.Binary
open ExactCriticalCurve.Binary.StochasticCounting

def ShorteningClosedObject : Type :=
  ∀ {m : ℕ}, 4 ∣ m+1 →
    StochasticLagrangian m ≃
      {R : StochasticLagrangian (m+1) // (allOnes (m+1),0) ∈ R.carrier}

def ShorteningSaturationObject : Type :=
  ∀ {k : ℕ}, 0 < k → 4 ∣ k → StochasticLagrangian k → StochasticLagrangian k

def ShorteningMapObject : Type :=
  ∀ {m : ℕ}, 4 ∣ m+1 → StochasticLagrangian (m+1) → StochasticLagrangian m

def ShorteningTransverseObject : Type :=
  ∀ {k : ℕ} (hk : 0 < k) (h4 : 4 ∣ k) (R : StochasticLagrangian k),
    (allOnes k,0) ∈ R.carrier →
      {H : Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2)) //
        H ≤ R.carrier ∧ Module.finrank (ZMod 2) H + 1 = k ∧
          (allOnes k,allOnes k) ∈ H ∧ (allOnes k,0) ∉ H} ≃
      {T : StochasticLagrangian k //
        (allOnes k,0) ∉ T.carrier ∧ shorteningSaturation hk h4 T = R}

def ShorteningFiberObject : Type :=
  ∀ {m : ℕ} (h4 : 4 ∣ m+1) (S : StochasticLagrangian m),
    {T : StochasticLagrangian (m+1) // shorteningRelation h4 T = S} ≃
      Option {H : Submodule (ZMod 2) ((Fin (m+1) → ZMod 2) × (Fin (m+1) → ZMod 2)) //
        H ≤ (shorteningClosedLift h4 S).carrier ∧
          Module.finrank (ZMod 2) H + 1 = m+1 ∧
          (allOnes (m+1),allOnes (m+1)) ∈ H ∧ (allOnes (m+1),0) ∉ H}

def ShorteningClosedInverseLeft : Prop :=
  ∀ {m : ℕ} (hm : Odd m) (S : Submodule (ZMod 2) ((Fin m → ZMod 2) × (Fin m → ZMod 2))),
    (∀ p ∈ S, shorteningRelationParity m p = 0) →
      shorteningClosedRestrict (shorteningClosedCarrier S) = S

def ShorteningClosedInverseRight : Prop :=
  ∀ {m : ℕ} (hm : Odd m) (R : StochasticLagrangian (m+1)),
    (allOnes (m+1),0) ∈ R.carrier →
      shorteningClosedCarrier (shorteningClosedRestrict R.carrier) = R.carrier

def ShorteningSaturationRank : Prop :=
  ∀ {k : ℕ}, 0 < k → ∀ T : StochasticLagrangian k,
    Module.finrank (ZMod 2) (shorteningSaturationCarrier T) = k

def ShorteningTransverseUnique : Prop :=
  ∀ {k : ℕ} (hk : 0 < k) (h4 : 4 ∣ k) (R : StochasticLagrangian k)
    (hR : (allOnes k,0) ∈ R.carrier) (H : ShorteningHyperplane R)
    (T : StochasticLagrangian k), shorteningEvenPart T = H.val →
      T = shorteningTransverseLift h4 R hR H

def ShorteningSurjective : Prop :=
  ∀ {m : ℕ} (h4 : 4 ∣ m+1), Function.Surjective (shorteningRelation h4)

def ShorteningFiberCriterion : Prop :=
  ∀ {m : ℕ} (h4 : 4 ∣ m+1) (T : StochasticLagrangian (m+1)) (S : StochasticLagrangian m),
    shorteningRelation h4 T = S ↔
      shorteningSaturation (Nat.zero_lt_succ m) h4 T = shorteningClosedLift h4 S

def ShorteningClosedUnique : Prop :=
  ∀ {m : ℕ} (h4 : 4 ∣ m+1) (T : StochasticLagrangian (m+1)) (S : StochasticLagrangian m),
    shorteningRelation h4 T = S → (allOnes (m+1),0) ∈ T.carrier →
      T = shorteningClosedLift h4 S

def ShorteningTransverseCount : Prop :=
  ∀ {k : ℕ} (hk : 0 < k) (h4 : 4 ∣ k) (R : StochasticLagrangian k),
    (allOnes k,0) ∈ R.carrier →
      Nat.card {T : StochasticLagrangian k //
        (allOnes k,0) ∉ T.carrier ∧ shorteningSaturation hk h4 T = R} = 2 ^ (k-2)

def ShorteningFullCount : Prop :=
  ∀ {m : ℕ} (h4 : 4 ∣ m+1) (S : StochasticLagrangian m),
    Nat.card {T : StochasticLagrangian (m+1) // shorteningRelation h4 T = S} =
      1 + 2 ^ ((m+1)-2)
end ShorteningRelationsExpected


