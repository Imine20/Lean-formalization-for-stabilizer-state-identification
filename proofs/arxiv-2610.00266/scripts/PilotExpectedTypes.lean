  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E], ∀ P : Submodule (ZMod 2) E → Submodule (ZMod 2) E → Prop, {p : Submodule (ZMod 2) E × LinearMap.BilinForm (ZMod 2) E // p.2.IsAlt ∧ P p.1 (LinearMap.ker p.2)} ≃ (Σ K : Submodule (ZMod 2) E, Σ R : {R : Submodule (ZMod 2) E // P K R}, ND (E ⧸ R.val))

