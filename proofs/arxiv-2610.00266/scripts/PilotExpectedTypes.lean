theorem recoveryNonemptySupport_expanded (n : ℕ) :
    NonemptyAffineSupport n =
      {A : AffineSubspace (ZMod 2) (Fin n → ZMod 2) // Nonempty A} := rfl

theorem recoveryAffineData_expanded (n : ℕ) :
    AffineRefinementData n =
      (Σ A : {A : AffineSubspace (ZMod 2) (Fin n → ZMod 2) // Nonempty A},
        StabilizerPhaseData A.val.direction) := rfl

theorem recoveryAffineDirection_forward {n : ℕ} (A : NonemptyAffineSupport n)
    (t : A.val.direction) :
    (affineSupportDirectionEquiv A t).val = t.val + affineSupportAnchor A := rfl

theorem recoveryAffineDirection_inverse {n : ℕ} (A : NonemptyAffineSupport n)
    (x : A.val) :
    ((affineSupportDirectionEquiv A).symm x).val = x.val - affineSupportAnchor A := rfl

theorem recoveryActualGroup_membership {n : ℕ} (p : AffineRefinementData n)
    (g : PauliLabel n) :
    g ∈ (affineRefinementStabilizer p).carrier ↔
      ∃ t : p.1.val.direction,
        g.shift = t.val ∧ clockRestriction p.1.val.direction g.clock = p.2.polar t ∧
        g.phase + 2 * ((∑ i, g.clock i * affineSupportAnchor p.1 i : ZMod 2).val : ZMod 4) =
          p.2.phase t :=
  mem_phaseStabilizer _ _ _

theorem recoverySupport_nonzero_exact {n : ℕ}
    {L : Submodule (ZMod 2) (Fin n → ZMod 2)} (a : Fin n → ZMod 2)
    (q : StabilizerPhaseData L) (x : Fin n → ZMod 2) :
    stabilizerVector (phaseStabilizer a q) x ≠ 0 ↔ x - a ∈ L := by
  rw [← mem_stabilizerSupport, phaseStabilizer_support]
  rfl

def RecoveryTranslationMembership : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (x : Fin n → ZMod 2),
    x ∈ stabilizerTranslationSpace S ↔ ∃ g : S.carrier, g.val.shift = x

def RecoveryGroupByInclusion : Prop :=
  ∀ {n : ℕ} {S T : StabilizerGroup n}, S.carrier ≤ T.carrier → S = T

def RecoveryClockRestriction : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (g : S.carrier) (t : stabilizerTranslationSpace S),
    g.val.shift = t.val →
      clockRestriction (stabilizerTranslationSpace S) g.val.clock = stabilizerPairing S t

def RecoveryActualSignedGroup : Prop :=
