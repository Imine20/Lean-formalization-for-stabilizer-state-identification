def RecoveryFullFamilySurjective : Prop :=
  ∀ n : ℕ, Function.Surjective (fun p :
    (Σ A : {A : AffineSubspace (ZMod 2) (Fin n → ZMod 2) // Nonempty A},
      StabilizerPhaseData A.val.direction) =>
    phaseStabilizer (affineSupportAnchor p.1) p.2)

def RecoveryFixedAnchorPhaseUnique : Prop :=
  ∀ {n : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (a : Fin n → ZMod 2) (q r : StabilizerPhaseData L),
    phaseStabilizer a q = phaseStabilizer a r → q.phase = r.phase

theorem recoveryRefinementEquiv_forward (n : ℕ) (p : AffineRefinementData n) :
    affineRefinementEquivStabilizer n p = phaseStabilizer (affineSupportAnchor p.1) p.2 := rfl

theorem recoveryNormalForm_inverse (n : ℕ)
    (p : Σ A : {A : AffineSubspace (ZMod 2) (Fin n → ZMod 2) // Nonempty A},
      (Fin (Module.finrank (ZMod 2) A.val.direction) → ZMod 4) ×
        ({ij : Fin (Module.finrank (ZMod 2) A.val.direction) ×
            Fin (Module.finrank (ZMod 2) A.val.direction) // ij.1 < ij.2} → ZMod 2)) :
    (stabilizerAffineNormalForm n).symm p =
      phaseStabilizer (affineSupportAnchor p.1)
        (phaseDataOfCoefficients (Module.finBasis (ZMod 2) p.1.val.direction) p.2) := rfl

theorem recoveryNormalForm_trueSupport {n : ℕ} (S : StabilizerGroup n) :
    (stabilizerAffineNormalForm n S).1.val = stabilizerSupport S := by
  let p := stabilizerAffineNormalForm n S
  have hp : (stabilizerAffineNormalForm n).symm p = S :=
    (stabilizerAffineNormalForm n).symm_apply_apply S
  rw [recoveryNormalForm_inverse] at hp
  have hs := affineRefinementStabilizer_support
    ⟨p.1, phaseDataOfCoefficients (Module.finBasis (ZMod 2) p.1.val.direction) p.2⟩
  change stabilizerSupport (phaseStabilizer (affineSupportAnchor p.1)
    (phaseDataOfCoefficients (Module.finBasis (ZMod 2) p.1.val.direction) p.2)) = p.1.val at hs
  rw [hp] at hs
  exact hs.symm

def RecoveryFullFamilyInjective : Prop :=
  ∀ n : ℕ, Function.Injective (fun p :
    (Σ A : {A : AffineSubspace (ZMod 2) (Fin n → ZMod 2) // Nonempty A},
      StabilizerPhaseData A.val.direction) =>
    phaseStabilizer (affineSupportAnchor p.1) p.2)

def RecoveryActualNormalFormBijection : Prop :=
  ∀ n : ℕ, Function.Bijective
    (stabilizerAffineNormalForm n :
      StabilizerGroup n →
      (Σ A : {A : AffineSubspace (ZMod 2) (Fin n → ZMod 2) // Nonempty A},
        (Fin (Module.finrank (ZMod 2) A.val.direction) → ZMod 4) ×
          ({ij : Fin (Module.finrank (ZMod 2) A.val.direction) ×
              Fin (Module.finrank (ZMod 2) A.val.direction) // ij.1 < ij.2} → ZMod 2)))

end CriticalCurveExpected
