namespace OrthogonalActualExpected
universe u v
open ExactCriticalCurve ExactCriticalCurve.FiniteQuadratic Module
open scoped BigOperators

def QData (E : Type u) [AddCommGroup E] [Module (ZMod 2) E] :=
  Σ K : Submodule (ZMod 2) E, {B : LinearMap.BilinForm (ZMod 2) (E ⧸ K) // B.IsAlt}
def Quotients {V : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    (Q : QuadraticForm (ZMod 2) V) (E : Type u) [AddCommGroup E] [Module (ZMod 2) E] :=
  Σ K : Submodule (ZMod 2) E, {q : QuadraticForm (ZMod 2) (E ⧸ K) //
    ∃ f : (E ⧸ K) →ₗ[ZMod 2] V, Function.Injective f ∧ ∀ x, Q (f x)=q x}
def Refinements {A : Type u} {V : Type v} [AddCommGroup A] [Module (ZMod 2) A]
    [AddCommGroup V] [Module (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) A) (Q : QuadraticForm (ZMod 2) V) :=
  {q : {q : QuadraticForm (ZMod 2) A // q.polarBilin=B} //
    ∃ f : A →ₗ[ZMod 2] V, Function.Injective f ∧ ∀ x, Q (f x)=q.val x}
def PolarSigma {V : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    (Q : QuadraticForm (ZMod 2) V) (E : Type u) [AddCommGroup E] [Module (ZMod 2) E] :=
  Σ p : QData E, Refinements p.2.val Q

def Weight (sigma : ℚ) (m b t : ℕ) : ℚ :=
  if b+t<m then (2 : ℚ)^(b+2*t) else
    if b+t=m then ((2 : ℚ)^b-1)*(2 : ℚ)^(2*t)+((2 : ℚ)^(2*t)+sigma*(2 : ℚ)^t)/2 else 0
def WeightSum (E : Type u) [AddCommGroup E] [Module (ZMod 2) E]
    [FiniteDimensional (ZMod 2) E] (sigma : ℚ) (m : ℕ) : ℚ :=
  letI : Fintype (QData E) := quotientAlternatingDataFintype (E := E)
  ∑ p : QData E, Weight sigma m (finrank (ZMod 2) (LinearMap.ker p.2.val))
    (finrank (ZMod 2) (LinearMap.range p.2.val)/2)
def Flag (n ell t : ℕ) : ℚ :=
  (Counting.binaryGaussian n (ell+t) : ℚ)*(Counting.binaryGaussian (ell+t) (ell-t) : ℚ)*
    (nondegenerateAlternatingCount (2*t) : ℚ)
def NewSum (n m : ℕ) (sigma : ℚ) : ℚ :=
  ∑ t ∈ Finset.range (m+1), Flag n m t*
    (((2 : ℚ)^(m-t)-1)*(4 : ℚ)^t+((4 : ℚ)^t+sigma*(2 : ℚ)^t)/2)
def OldSum (n m : ℕ) (sigma : ℚ) : ℚ :=
  ∑ t ∈ Finset.range m, Flag n (m-1) t*(((4 : ℚ)^t-sigma*(2 : ℚ)^t)/2)
def Average {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] (Q : QuadraticForm (ZMod 2) V) (z : ℚ) : ℚ :=
  (∑ g : BinaryQuadraticIsometryGroup Q, z^finrank (ZMod 2) (Counting.fixedSubmodule (ZMod 2) V g)) /
    (Nat.card (BinaryQuadraticIsometryGroup Q) : ℚ)

def MinusWeightZero : Prop := ∀ b t : ℕ, Weight (-1) 0 b t=0
def MinusSumZero : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E], WeightSum E (-1) 0=0
def FormalIncrement : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E],
    ∀ (sigma : ℚ) (m : ℕ), 0<m → WeightSum E sigma m-WeightSum E sigma (m-1)=
      NewSum (finrank (ZMod 2) E) m sigma+OldSum (finrank (ZMod 2) E) m sigma

def QuotientCard : Prop :=
  ∀ {E : Type u} {V : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) E]
    [FiniteDimensional (ZMod 2) V] [Fintype V],
    ∀ Q : QuadraticForm (ZMod 2) V, LinearMap.BilinForm.Nondegenerate Q.polarBilin →
    ∀ m : ℕ, finrank (ZMod 2) V=2*m → ∀ sigma : ℚ, (sigma=1 ∨ sigma= -1) →
      binaryQuadraticGaussSum Q=(sigma : ℂ)*(2 : ℂ)^m →
      (Nat.card (Quotients Q E) : ℚ)=WeightSum E sigma m

def ActualAverage : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V] [Fintype V],
    ∀ Q : QuadraticForm (ZMod 2) V, LinearMap.BilinForm.Nondegenerate Q.polarBilin →
    ∀ m n : ℕ, finrank (ZMod 2) V=2*m → ∀ sigma : ℚ, (sigma=1 ∨ sigma= -1) →
      binaryQuadraticGaussSum Q=(sigma : ℂ)*(2 : ℂ)^m →
      Average Q ((2 : ℚ)^n)=WeightSum (Fin n → ZMod 2) sigma m

def MinusInitial : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V] [Fintype V],
    ∀ Q : QuadraticForm (ZMod 2) V, LinearMap.BilinForm.Nondegenerate Q.polarBilin →
    ∀ n : ℕ, finrank (ZMod 2) V=2 → binaryQuadraticGaussSum Q= -2 →
      Average Q ((2 : ℚ)^n)=NewSum n 1 (-1)+OldSum n 1 (-1)

def ActualIncrement : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V] [Fintype V]
    {W : Type v} [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W] [Fintype W],
    ∀ Q : QuadraticForm (ZMod 2) V, LinearMap.BilinForm.Nondegenerate Q.polarBilin →
    ∀ P : QuadraticForm (ZMod 2) W, LinearMap.BilinForm.Nondegenerate P.polarBilin →
    ∀ m n : ℕ, 0<m → finrank (ZMod 2) V=2*m → finrank (ZMod 2) W=2*(m-1) →
    ∀ sigma : ℚ, (sigma=1 ∨ sigma= -1) →
      binaryQuadraticGaussSum Q=(sigma : ℂ)*(2 : ℂ)^m →
      binaryQuadraticGaussSum P=(sigma : ℂ)*(2 : ℂ)^(m-1) →
      Average Q ((2 : ℚ)^n)-Average P ((2 : ℚ)^n)=NewSum n m sigma+OldSum n m sigma

def WeightSumType :=
  ∀ (E : Type u) [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E], ℚ → ℕ → ℚ
def PolarEquivType :=
  ∀ {E : Type u} {V : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    [AddCommGroup V] [Module (ZMod 2) V], ∀ Q : QuadraticForm (ZMod 2) V, Quotients Q E ≃ PolarSigma Q E

example (E : Type u) [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E]
    (sigma : ℚ) (m : ℕ) : quotientQuadraticWeightSum E sigma m=WeightSum E sigma m := rfl
example {E : Type u} {V : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    [AddCommGroup V] [Module (ZMod 2) V] (Q : QuadraticForm (ZMod 2) V) (p : Quotients Q E) :
    (quadraticQuotientPolarEquiv Q p).1.1=p.1 := rfl
example {E : Type u} {V : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    [AddCommGroup V] [Module (ZMod 2) V] (Q : QuadraticForm (ZMod 2) V) (p : Quotients Q E) :
    (quadraticQuotientPolarEquiv Q p).1.2.val=p.2.val.polarBilin := rfl
example {E : Type u} {V : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    [AddCommGroup V] [Module (ZMod 2) V] (Q : QuadraticForm (ZMod 2) V) (p : Quotients Q E) :
    (quadraticQuotientPolarEquiv Q p).2.val.val=p.2.val := rfl
example {E : Type u} {V : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    [AddCommGroup V] [Module (ZMod 2) V] (Q : QuadraticForm (ZMod 2) V) (p : PolarSigma Q E) :
    ((quadraticQuotientPolarEquiv Q).symm p).2.val=p.2.val.val := rfl
end OrthogonalActualExpected
