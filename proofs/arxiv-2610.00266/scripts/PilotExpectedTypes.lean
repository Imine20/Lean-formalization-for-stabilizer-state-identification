def SqrtTrace {n : Type*} [Fintype n] [DecidableEq n] : Prop :=
  ∀ (A : Matrix n n ℂ) (hA : A.PosSemidef),
    (Matrix.trace (CFC.sqrt A)).re = ∑ i, Real.sqrt (hA.isHermitian.eigenvalues i)

def NonzeroSqrtTrace {n : Type*} [Fintype n] [DecidableEq n] : Prop :=
  ∀ (A : Matrix n n ℂ) (hA : A.PosSemidef),
    (Matrix.trace (CFC.sqrt A)).re =
      (((Finset.univ.val.map hA.isHermitian.eigenvalues).filter (· ≠ 0)).map Real.sqrt).sum

