theorem stabilizerLabels_expanded {n : ℕ} (S : StabilizerGroup n)
    (p : (Fin n → ZMod 2) × (Fin n → ZMod 2)) :
    p ∈ stabilizerLabelSpace S ↔
      ∃ g : PauliLabel n, g ∈ S.carrier ∧ g.shift = p.1 ∧ g.clock = p.2 := by
  constructor
  · rintro ⟨⟨g, hg⟩, he⟩
    exact ⟨g, hg, congrArg Prod.fst he, congrArg Prod.snd he⟩
  · rintro ⟨g, hg, hs, hc⟩
    exact ⟨⟨g, hg⟩, Prod.ext hs hc⟩

theorem stabilizerTranslations_expanded {n : ℕ} (S : StabilizerGroup n)
    (a : Fin n → ZMod 2) :
    a ∈ stabilizerTranslationSpace S ↔
      ∃ g : PauliLabel n, g ∈ S.carrier ∧ g.shift = a := by
  constructor
  · rintro ⟨p, hp, he⟩
    obtain ⟨g, hg, hs, hc⟩ := (stabilizerLabels_expanded S p).mp hp
    exact ⟨g, hg, hs.trans he⟩
  · rintro ⟨g, hg, hs⟩
    exact ⟨(g.shift, g.clock), ⟨⟨g, hg⟩, rfl⟩, hs⟩

