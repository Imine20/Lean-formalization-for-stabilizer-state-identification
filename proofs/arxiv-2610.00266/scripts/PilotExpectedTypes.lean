namespace OrthogonalRefinementWeightsExpected
universe u v w
open ExactCriticalCurve ExactCriticalCurve.FiniteQuadratic Module

def SignedCard : Prop :=
  ∀ {A : Type u} {V : Type v} [AddCommGroup A] [Module (ZMod 2) A]
    [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) A]
    [FiniteDimensional (ZMod 2) V] [Fintype A] [Fintype V],
    ∀ (B : LinearMap.BilinForm (ZMod 2) A) (hB : B.IsAlt)
      (Q : QuadraticForm (ZMod 2) V) (hQ : LinearMap.BilinForm.Nondegenerate Q.polarBilin)
      (b t m : ℕ) (hb : finrank (ZMod 2) (LinearMap.ker B)=b)
      (hd : finrank (ZMod 2) A=b+2*t) (hm : finrank (ZMod 2) V=2*m)
      (sigma : ℚ) (hsigma : sigma=1 ∨ sigma= -1)
      (hg : binaryQuadraticGaussSum Q=(sigma : ℂ)*(2 : ℂ)^m),
      (Nat.card {P : {P : QuadraticForm (ZMod 2) A // P.polarBilin=B} //
        ∃ f : A →ₗ[ZMod 2] V, Function.Injective f ∧ ∀ x, Q (f x)=P.val x} : ℚ) =
        if b+t<m then (2 : ℚ)^(b+2*t) else
          if b+t=m then ((2 : ℚ)^b-1)*(2 : ℚ)^(2*t)+((2 : ℚ)^(2*t)+sigma*(2 : ℚ)^t)/2 else 0

def WeightDifference : Prop :=
  ∀ (sigma : ℚ) (m b t : ℕ) (hm : 0<m),
    (if b+t<m then (2 : ℚ)^(b+2*t) else
      if b+t=m then ((2 : ℚ)^b-1)*(2 : ℚ)^(2*t)+((2 : ℚ)^(2*t)+sigma*(2 : ℚ)^t)/2 else 0) -
    (if b+t<m-1 then (2 : ℚ)^(b+2*t) else
      if b+t=m-1 then ((2 : ℚ)^b-1)*(2 : ℚ)^(2*t)+((2 : ℚ)^(2*t)+sigma*(2 : ℚ)^t)/2 else 0) =
      (if b+t=m then ((2 : ℚ)^b-1)*(2 : ℚ)^(2*t)+((2 : ℚ)^(2*t)+sigma*(2 : ℚ)^t)/2 else 0) +
      (if b+t=m-1 then ((2 : ℚ)^(2*t)-sigma*(2 : ℚ)^t)/2 else 0)

def ActualIncrement : Prop :=
  ∀ {A : Type u} {V : Type v} [AddCommGroup A] [Module (ZMod 2) A]
    [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) A]
    [FiniteDimensional (ZMod 2) V] [Fintype A] [Fintype V]
    {W : Type w} [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W] [Fintype W],
    ∀ (B : LinearMap.BilinForm (ZMod 2) A) (hB : B.IsAlt)
      (Q : QuadraticForm (ZMod 2) V) (hQ : LinearMap.BilinForm.Nondegenerate Q.polarBilin)
      (P : QuadraticForm (ZMod 2) W) (hP : LinearMap.BilinForm.Nondegenerate P.polarBilin)
      (b t m : ℕ) (hb : finrank (ZMod 2) (LinearMap.ker B)=b)
      (hd : finrank (ZMod 2) A=b+2*t) (hmQ : finrank (ZMod 2) V=2*m)
      (hmP : finrank (ZMod 2) W=2*(m-1)) (hm : 0<m)
      (sigma : ℚ) (hsigma : sigma=1 ∨ sigma= -1)
      (hgQ : binaryQuadraticGaussSum Q=(sigma : ℂ)*(2 : ℂ)^m)
      (hgP : binaryQuadraticGaussSum P=(sigma : ℂ)*(2 : ℂ)^(m-1)),
      (Nat.card {q : {q : QuadraticForm (ZMod 2) A // q.polarBilin=B} //
        ∃ f : A →ₗ[ZMod 2] V, Function.Injective f ∧ ∀ x, Q (f x)=q.val x} : ℚ) -
      (Nat.card {q : {q : QuadraticForm (ZMod 2) A // q.polarBilin=B} //
        ∃ f : A →ₗ[ZMod 2] W, Function.Injective f ∧ ∀ x, P (f x)=q.val x} : ℚ) =
      (if b+t=m then ((2 : ℚ)^b-1)*(2 : ℚ)^(2*t)+((2 : ℚ)^(2*t)+sigma*(2 : ℚ)^t)/2 else 0) +
      (if b+t=m-1 then ((2 : ℚ)^(2*t)-sigma*(2 : ℚ)^t)/2 else 0)

def WeightType : Type := ℚ → ℕ → ℕ → ℕ → ℚ
example : orthogonalRefinementWeight = fun (sigma : ℚ) (m b t : ℕ) =>
    if b+t<m then (2 : ℚ)^(b+2*t) else
      if b+t=m then ((2 : ℚ)^b-1)*(2 : ℚ)^(2*t)+((2 : ℚ)^(2*t)+sigma*(2 : ℚ)^t)/2 else 0 := rfl
end OrthogonalRefinementWeightsExpected
