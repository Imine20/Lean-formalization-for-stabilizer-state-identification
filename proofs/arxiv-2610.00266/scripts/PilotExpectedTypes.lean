def DoubledParity : Prop :=
  ∀ c : ZMod 4, (2 : ZMod 4) * ((phaseParity c).val : ZMod 4) = 2 * c
def ActualPolarBasis : Prop :=
  ∀ {m : ℕ} (q : (Fin m → ZMod 4) ×
    ({p : Fin m × Fin m // p.1 < p.2} → ZMod 2)) (i j : Fin m),
    quadraticPhasePolarForm q (Pi.single i 1) (Pi.single j 1) =
      if i = j then phaseParity (q.1 i) else
        if h : i < j then q.2 ⟨(i,j), h⟩ else
          if h : j < i then q.2 ⟨(j,i), h⟩ else 0
