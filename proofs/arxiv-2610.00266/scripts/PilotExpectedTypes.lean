/- These expected types are written independently of the implementation's target aliases.
   In particular the power sums and spectra are expanded into their mathematical data. -/
namespace CriticalCurveExpected
def FinitePowerSums : Prop :=
  ∀ A B : Multiset ℝ, (∀ x ∈ A, x ≠ 0) → (∀ x ∈ B, x ≠ 0) →
    (∀ p : ℕ, 0 < p → p ≤ (A.toFinset ∪ B.toFinset).card →
      (A.map (fun x => x ^ p)).sum = (B.map (fun x => x ^ p)).sum) → A = B

def AllPositivePowerSums : Prop :=
  ∀ A B : Multiset ℝ, (∀ x ∈ A, x ≠ 0) → (∀ x ∈ B, x ≠ 0) →
    (∀ p : ℕ, 0 < p →
      (A.map (fun x => x ^ p)).sum = (B.map (fun x => x ^ p)).sum) → A = B

def TracePowers {ι : Type u} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ (A : Matrix ι ι ℂ) (hA : A.IsHermitian) (p : ℕ),
    Matrix.trace (A ^ p) = ((∑ i, hA.eigenvalues i ^ p : ℝ) : ℂ)

def NonzeroTraces {ι : Type u} [Fintype ι] [DecidableEq ι]
    {κ : Type v} [Fintype κ] [DecidableEq κ] : Prop :=
  ∀ (A : Matrix ι ι ℂ) (B : Matrix κ κ ℂ)
    (hA : A.IsHermitian) (hB : B.IsHermitian),
    (∀ p : ℕ, 0 < p → Matrix.trace (A ^ p) = Matrix.trace (B ^ p)) →
      (Finset.univ.val.map hA.eigenvalues).filter (· ≠ 0) =
      (Finset.univ.val.map hB.eigenvalues).filter (· ≠ 0)

def FiniteTracePowers {ι : Type u} [Fintype ι] [DecidableEq ι]
    {κ : Type v} [Fintype κ] [DecidableEq κ] : Prop :=
  ∀ (A : Matrix ι ι ℂ) (B : Matrix κ κ ℂ)
    (hA : A.IsHermitian) (hB : B.IsHermitian),
    (∀ p : ℕ, 0 < p →
      p ≤ (((Finset.univ.val.map hA.eigenvalues).filter (· ≠ 0)).toFinset ∪
        ((Finset.univ.val.map hB.eigenvalues).filter (· ≠ 0)).toFinset).card →
      Matrix.trace (A ^ p) = Matrix.trace (B ^ p)) →
      (Finset.univ.val.map hA.eigenvalues).filter (· ≠ 0) =
      (Finset.univ.val.map hB.eigenvalues).filter (· ≠ 0)

def FullSpectrum {ι : Type u} [Fintype ι] [DecidableEq ι]
    {κ : Type v} [Fintype κ] [DecidableEq κ] : Prop :=
  ∀ (A : Matrix ι ι ℂ) (B : Matrix κ κ ℂ)
    (hA : A.IsHermitian) (hB : B.IsHermitian),
    Fintype.card ι = Fintype.card κ →
    (∀ p : ℕ, 0 < p → Matrix.trace (A ^ p) = Matrix.trace (B ^ p)) →
      Finset.univ.val.map hA.eigenvalues = Finset.univ.val.map hB.eigenvalues

def ZeroMultiplicity {ι : Type u} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ (A : Matrix ι ι ℂ) (hA : A.IsHermitian),
    (Finset.univ.val.map hA.eigenvalues).count 0 = Fintype.card ι - A.rank

def DimensionIdentity {ι : Type u} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ (A : Matrix ι ι ℂ) (hA : A.IsHermitian),
    (Finset.univ.val.map hA.eigenvalues).count 0 +
      ((Finset.univ.val.map hA.eigenvalues).filter (· ≠ 0)).card = Fintype.card ι

def GramFrameSpectrum {ι κ : Type*} [Fintype ι] [Fintype κ]
    [DecidableEq ι] [DecidableEq κ] : Prop :=
  ∀ S : Matrix ι κ ℂ,
    (Finset.univ.val.map (Matrix.isHermitian_transpose_mul_self S).eigenvalues).filter (· ≠ 0) =
    (Finset.univ.val.map (Matrix.isHermitian_mul_conjTranspose_self S).eigenvalues).filter (· ≠ 0)

def GramZero {ι κ : Type*} [Fintype ι] [Fintype κ] [DecidableEq κ] : Prop :=
  ∀ S : Matrix ι κ ℂ,
    (Finset.univ.val.map (Matrix.isHermitian_transpose_mul_self S).eigenvalues).count 0 =
      Fintype.card κ - S.rank

def FrameZero {ι κ : Type*} [Fintype ι] [Fintype κ] [DecidableEq ι] : Prop :=
  ∀ S : Matrix ι κ ℂ,
    (Finset.univ.val.map (Matrix.isHermitian_mul_conjTranspose_self S).eigenvalues).count 0 =
      Fintype.card ι - S.rank

def ProductPositive : Prop :=
  ∀ {n m : ℕ}, m ≤ n + 1 →
    0 < ∏ j ∈ Finset.range (m - 1), (((2 : ℝ) ^ n) ^ 2 - (4 : ℝ) ^ j)

def ProductZero : Prop :=
  ∀ {n m : ℕ}, n + 2 ≤ m →
    (∏ j ∈ Finset.range (m - 1), (((2 : ℝ) ^ n) ^ 2 - (4 : ℝ) ^ j)) = 0

def MinusProductNonnegative : Prop :=
  ∀ n m : ℕ, 0 ≤ ((2 : ℝ) ^ n - 2 ^ (m - 1)) *
    ∏ j ∈ Finset.range (m - 1), (((2 : ℝ) ^ n) ^ 2 - (4 : ℝ) ^ j)
end CriticalCurveExpected

open Lean Elab Command Meta in
def auditExactTheorem (actual expected : Name) : CommandElabM Unit := do
  let env ← getEnv
  match env.find? actual with
  | some (.thmInfo _) => pure ()
  | _ => throwError "Expected a theorem declaration: {actual}"
  liftTermElabM do
    let actualInfo ← getConstInfo actual
    let expectedInfo ← getConstInfo expected
    unless actualInfo.levelParams.length == expectedInfo.levelParams.length do
      throwError "Universe generality mismatch: {actual}"
    let levelParams := (List.range actualInfo.levelParams.length).map
      (fun i => Name.mkSimple ("auditUniverse" ++ toString i))
    let levels := levelParams.map Level.param
    let term := mkConst actual levels
    let expectedTerm := mkConst expected levels
    let expectedType ← inferType expectedTerm
    -- Abstract all universe-polymorphic typeclass and index parameters on expected definitions.
    let expectedValue ← forallTelescope expectedType fun args _ => do
      let body := mkAppN expectedTerm args
      mkForallFVars args body
    unless ← isDefEq (← inferType term) expectedValue do
      throwError "Exact theorem type mismatch: {actual}\nactual: {← inferType term}\nexpected: {expectedValue}"
    -- Check both the theorem constant and its original proof body directly in
    -- the kernel against the independently constructed expected type.
    -- addDeclCore has no skipKernelTC option and returns synchronously.
    let kernelEnv := (← getEnv).toKernelEnv
    let heartbeatLimit := (Core.getMaxHeartbeats (← getOptions)).toUSize
    for (label, proof) in #[
        ("constant", term),
        ("body", actualInfo.instantiateValueLevelParams! levels)] do
      let witnessName ← mkFreshUserName (Name.mkSimple ("kernelAudit_" ++ label))
      let decl : Declaration := .thmDecl {
        name := witnessName
        levelParams := levelParams
        type := expectedValue
        value := proof
      }
      let _ ← ofExceptKernelException <|
        Kernel.Environment.addDeclCore kernelEnv heartbeatLimit decl none
      logInfo m!"KERNEL_EXPECTED_TYPE_OK {label} {actual}"
  let axioms ← collectAxioms actual
  for ax in axioms do
    unless #[`propext, `Classical.choice, `Quot.sound].contains ax do
      throwError "Forbidden transitive axiom {ax} in {actual}"
  logInfo m!"EXACT_TYPE_AND_AXIOMS_OK {actual}"

