namespace AlternatingRealizabilityExpected
universe u v
open ExactCriticalCurve.FiniteQuadratic Module

def ExteriorBetween : Prop :=
  ∀ {U : Type u} {V : Type v} [AddCommGroup U] [Module (ZMod 2) U]
    [AddCommGroup V] [Module (ZMod 2) V] [Fintype U] [Fintype V]
    (A : LinearMap.BilinForm (ZMod 2) U), A.IsAlt → A.Nondegenerate →
    ∀ (B : LinearMap.BilinForm (ZMod 2) V), B.IsAlt → B.Nondegenerate →
    Fintype.card U ≤ Fintype.card V →
    ∀ (S : Submodule (ZMod 2) U) (f : S →ₗ[ZMod 2] V),
    Function.Injective f → (∀ s t : S, B (f s) (f t) = A s.val t.val) →
    ∀ (x : U), x ∉ S →
      ∃ y : V, y ∉ LinearMap.range f ∧ ∀ s : S, B y (f s) = A x s.val

def StepBetween : Prop :=
  ∀ {U : Type u} {V : Type v} [AddCommGroup U] [Module (ZMod 2) U]
    [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) U] [FiniteDimensional (ZMod 2) V]
    (A : LinearMap.BilinForm (ZMod 2) U), A.IsAlt → A.Nondegenerate →
    ∀ (B : LinearMap.BilinForm (ZMod 2) V), B.IsAlt → B.Nondegenerate →
    finrank (ZMod 2) U ≤ finrank (ZMod 2) V →
    ∀ (S : Submodule (ZMod 2) U) (f : S →ₗ[ZMod 2] V),
    Function.Injective f → (∀ s t : S, B (f s) (f t) = A s.val t.val) →
    ∀ (x : U), x ∉ S →
      ∃ g : ↥(S ⊔ Submodule.span (ZMod 2) {x}) →ₗ[ZMod 2] V,
        Function.Injective g ∧ (∀ z w, B (g z) (g w) = A z.val w.val) ∧
        ∀ s : S, g ⟨s.val, (show S ≤ S ⊔ Submodule.span (ZMod 2) {x} from le_sup_left) s.property⟩ = f s

def ExtensionBetween : Prop :=
  ∀ {U : Type u} {V : Type v} [AddCommGroup U] [Module (ZMod 2) U]
    [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) U] [FiniteDimensional (ZMod 2) V]
    (A : LinearMap.BilinForm (ZMod 2) U), A.IsAlt → A.Nondegenerate →
    ∀ (B : LinearMap.BilinForm (ZMod 2) V), B.IsAlt → B.Nondegenerate →
    finrank (ZMod 2) U ≤ finrank (ZMod 2) V →
    ∀ (S : Submodule (ZMod 2) U) (f : S →ₗ[ZMod 2] V),
    Function.Injective f → (∀ s t : S, B (f s) (f t) = A s.val t.val) →
      ∃ e : U →ₗ[ZMod 2] V, Function.Injective e ∧
        (∀ x y, B (e x) (e y) = A x y) ∧ ∀ s : S, e s.val = f s

def NondegenerateEmbedding : Prop :=
  ∀ {U : Type u} {V : Type v} [AddCommGroup U] [Module (ZMod 2) U]
    [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) U] [FiniteDimensional (ZMod 2) V]
    (A : LinearMap.BilinForm (ZMod 2) U), A.IsAlt → A.Nondegenerate →
    ∀ (B : LinearMap.BilinForm (ZMod 2) V), B.IsAlt → B.Nondegenerate →
    finrank (ZMod 2) U ≤ finrank (ZMod 2) V →
      ∃ f : U →ₗ[ZMod 2] V, Function.Injective f ∧ ∀ x y, B (f x) (f y) = A x y

def EnvelopeType : Type (u + 1) :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E]
    (A : LinearMap.BilinForm (ZMod 2) E), (E →ₗ[ZMod 2] LinearMap.ker A) →
    LinearMap.BilinForm (ZMod 2) (E × Module.Dual (ZMod 2) (LinearMap.ker A))

def EnvelopeApply : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E]
    (A : LinearMap.BilinForm (ZMod 2) E) (p : E →ₗ[ZMod 2] LinearMap.ker A)
    (x y : E × Module.Dual (ZMod 2) (LinearMap.ker A)),
    alternatingEnvelopeForm A p x y = A x.1 y.1 + x.2 (p y.1) + y.2 (p x.1)

def EnvelopeAlternating : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E]
    (A : LinearMap.BilinForm (ZMod 2) E), A.IsAlt →
    ∀ p : E →ₗ[ZMod 2] LinearMap.ker A, (alternatingEnvelopeForm A p).IsAlt

def EnvelopeNondegenerate : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E]
    (A : LinearMap.BilinForm (ZMod 2) E), A.IsAlt →
    ∀ p : E →ₗ[ZMod 2] LinearMap.ker A, (∀ r : LinearMap.ker A, p r.val = r) →
    (alternatingEnvelopeForm A p).Nondegenerate

def EnvelopeInclusion : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E]
    (A : LinearMap.BilinForm (ZMod 2) E) (p : E →ₗ[ZMod 2] LinearMap.ker A) (x y : E),
    alternatingEnvelopeForm A p (x,0) (y,0) = A x y

def EnvelopeExists : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E]
    (A : LinearMap.BilinForm (ZMod 2) E), A.IsAlt →
    ∃ C : LinearMap.BilinForm (ZMod 2) (E × Module.Dual (ZMod 2) (LinearMap.ker A)),
      C.IsAlt ∧ C.Nondegenerate ∧ ∀ x y : E, C (x,0) (y,0) = A x y

def DimensionBound : Prop :=
  ∀ {E : Type u} {V : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) E] [FiniteDimensional (ZMod 2) V]
    (A : LinearMap.BilinForm (ZMod 2) E) (B : LinearMap.BilinForm (ZMod 2) V),
    B.IsAlt → B.Nondegenerate → ∀ (f : E →ₗ[ZMod 2] V), Function.Injective f →
    (∀ x y, B (f x) (f y) = A x y) →
      finrank (ZMod 2) E + finrank (ZMod 2) (LinearMap.ker A) ≤ finrank (ZMod 2) V

def Realizability : Prop :=
  ∀ {E : Type u} {V : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) E] [FiniteDimensional (ZMod 2) V]
    (A : LinearMap.BilinForm (ZMod 2) E), A.IsAlt →
    ∀ (B : LinearMap.BilinForm (ZMod 2) V), B.IsAlt → B.Nondegenerate →
    ((∃ f : E →ₗ[ZMod 2] V, Function.Injective f ∧ ∀ x y, B (f x) (f y) = A x y) ↔
      finrank (ZMod 2) E + finrank (ZMod 2) (LinearMap.ker A) ≤ finrank (ZMod 2) V)

example {E : Type u} [AddCommGroup E] [Module (ZMod 2) E]
    (A : LinearMap.BilinForm (ZMod 2) E) (p : E →ₗ[ZMod 2] LinearMap.ker A)
    (x y : E × Module.Dual (ZMod 2) (LinearMap.ker A)) :
    alternatingEnvelopeForm A p x y = A x.1 y.1 + x.2 (p y.1) + y.2 (p x.1) := rfl

end AlternatingRealizabilityExpected

