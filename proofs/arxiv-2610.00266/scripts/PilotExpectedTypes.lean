    (hw : D.wu∉U) (b : Basis (Fin d) (ZMod 2) U), finrank (ZMod 2) (Core D U hw b)+2*d=finrank (ZMod 2) V

def T_coreEven_finrank_add_one {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (D : ModFourQuadraticSpace V) [FiniteDimensional (ZMod 2) V] : Prop :=
