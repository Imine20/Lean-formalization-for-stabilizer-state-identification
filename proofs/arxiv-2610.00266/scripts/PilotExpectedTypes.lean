def RecoveryTransportCoherence : Prop :=
  ∀ {n : ℕ} {L M : Submodule (ZMod 2) (Fin n → ZMod 2)} (h : L=M)
    (a : Fin n → ZMod 2) (q : StabilizerPhaseData L),
