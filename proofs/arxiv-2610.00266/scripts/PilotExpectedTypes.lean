open Lean Elab Command Meta in
def auditSupportDefinition (actual expected : Name) : CommandElabM Unit := do
  liftTermElabM do
    let info ← getConstInfo actual
    match info with
    | .defnInfo _ => pure ()
    | _ => throwError "Expected definition: {actual}"
    let einfo ← getConstInfo expected
    unless info.levelParams.length == einfo.levelParams.length do
      throwError "Definition universe generality mismatch: {actual}"
    let params := (List.range info.levelParams.length).map (fun i => Name.mkSimple ("supportAuditUniverse" ++ toString i))
    let levels := params.map Level.param
    let eterm := mkConst expected levels
    let etype ← inferType eterm
    let expectedValue ← forallTelescope etype fun args _ => mkForallFVars args (mkAppN eterm args)
    let constant := mkConst actual levels
    unless ← isDefEq (← inferType constant) expectedValue do
      throwError "Definition literal type mismatch: {actual}"
    let env := (← getEnv).toKernelEnv
    let limit := (Core.getMaxHeartbeats (← getOptions)).toUSize
    for (label,value) in #[("constant",constant),("body",info.instantiateValueLevelParams! levels)] do
      let name ← mkFreshUserName (Name.mkSimple ("supportDefinitionKernel_" ++ label))
      let decl : Declaration := .defnDecl {
        name := name, levelParams := params, type := expectedValue, value := value,
        hints := .opaque, safety := .safe }
      let _ ← ofExceptKernelException <| Kernel.Environment.addDeclCore env limit decl none
      logInfo m!"KERNEL_EXPECTED_TYPE_OK {label} {actual}"
  let axioms ← collectAxioms actual
  for ax in axioms do
    unless #[`propext, `Classical.choice, `Quot.sound].contains ax do
      throwError "Forbidden transitive axiom {ax} in {actual}"
  logInfo m!"EXACT_DEFINITION_TYPE_AND_AXIOMS_OK {actual}"

run_cmd auditSupportDefinition ``hermitianSupportPolynomial ``PolyType
run_cmd auditSupportDefinition ``hermitianSupportProjection ``ProjType
end MatrixPolynomialSupportExpected


namespace StableFiltrationWitnessExpected
open ExactCriticalCurve ExactCriticalCurve.Binary ExactCriticalCurve.Quantum

def StableBinarySurjection {Q : Type*} [AddCommGroup Q]
    [Module (ZMod 2) Q] [FiniteDimensional (ZMod 2) Q] : Prop :=
  ∀ n : ℕ, Module.finrank (ZMod 2) Q ≤ n →
    ∃ f : (Fin n → ZMod 2) →ₗ[ZMod 2] Q, Function.Surjective f

def CSSSupportPullback : Prop :=
  ∀ {n k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2))
    (f : CSSHom n N) (X : Fin n → Fin k → ZMod 2),
    cssHomSynthesis n N X f ≠ 0 →
      configurationPullback X = (cssQuotientBilinear N).compl₁₂ f f

def CSSFullSupportRank : Prop :=
  ∀ {n k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)), IsDefect N →
    ∀ f : CSSHom n N, Function.Surjective f →
    ∀ X : Fin n → Fin k → ZMod 2, cssHomSynthesis n N X f ≠ 0 →
      Module.finrank (ZMod 2) (LinearMap.range (configurationPullback X)) =
        k - 2 * Module.finrank (ZMod 2) N

def CSSSupportRankBound : Prop :=
  ∀ {n k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)), IsDefect N →
    ∀ (f : CSSHom n N) (X : Fin n → Fin k → ZMod 2),
      cssHomSynthesis n N X f ≠ 0 →
      Module.finrank (ZMod 2) (LinearMap.range (configurationPullback X)) ≤
        k - 2 * Module.finrank (ZMod 2) N

def CSSDeeperColumnOrthogonality : Prop :=
  ∀ {n k : ℕ} (N M : Submodule (ZMod 2) (Fin k → ZMod 2)),
    IsDefect N → IsDefect M → ∀ f : CSSHom n N, Function.Surjective f →
    Module.finrank (ZMod 2) N < Module.finrank (ZMod 2) M →
      (cssHomSynthesis n M)ᴴ *ᵥ (cssHomSynthesis n N).col f = 0

def CSSDeeperProjectionAnnihilation : Prop :=
  ∀ {n k : ℕ} (N M : Submodule (ZMod 2) (Fin k → ZMod 2)),
    IsDefect N → IsDefect M → ∀ f : CSSHom n N, Function.Surjective f →
    Module.finrank (ZMod 2) N < Module.finrank (ZMod 2) M →
      cssColumnProjection n M *ᵥ (cssHomSynthesis n N).col f = 0

def CSSWuSupportExclusion : Prop :=
  ∀ {n k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (hN : IsDefect N)
    (f : CSSHom n N), Function.Surjective f → cssQuotientWu N hN ≠ 0 →
    ∀ X : Fin n → Fin k → ZMod 2, cssHomSynthesis n N X f ≠ 0 →
      ¬ ∀ a, X a ∈ orthogonal (wuLine k)

def CSSWuProjectionAnnihilation : Prop :=
  ∀ {n k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (hN : IsDefect N)
    (f : CSSHom n N), Function.Surjective f → cssQuotientWu N hN ≠ 0 →
      cssColumnProjection n (wuLine k) *ᵥ (cssHomSynthesis n N).col f = 0

def StochasticRawFiltration : Prop :=
  ∀ {n k r : ℕ} (g : StochasticIsometryGroup k) {v : (Fin n → Fin k → ZMod 2) → ℂ},
    v ∈ rawCSSFiltration n k r → stochasticIsometryMatrix n g *ᵥ v ∈ rawCSSFiltration n k r

def StochasticOrdinaryFiltration : Prop :=
  ∀ {n k r : ℕ} (g : StochasticIsometryGroup k) {v : (Fin n → Fin k → ZMod 2) → ℂ},
    v ∈ ordinaryCSSFiltration n k r →
      stochasticIsometryMatrix n g *ᵥ v ∈ ordinaryCSSFiltration n k r

def StochasticExceptionalFiltration : Prop :=
  ∀ {n k r : ℕ} (g : StochasticIsometryGroup k) {v : (Fin n → Fin k → ZMod 2) → ℂ},
    v ∈ exceptionalCSSFiltration n k r →
      stochasticIsometryMatrix n g *ᵥ v ∈ exceptionalCSSFiltration n k r

def AverageOrdinaryFiltration : Prop :=
  ∀ {n k r : ℕ} {v : (Fin n → Fin k → ZMod 2) → ℂ},
    v ∈ ordinaryCSSFiltration n k r →
      stochasticFixedProjection n k *ᵥ v ∈ ordinaryCSSFiltration n k r

def AverageExceptionalFiltration : Prop :=
  ∀ {n k r : ℕ} {v : (Fin n → Fin k → ZMod 2) → ℂ},
    v ∈ exceptionalCSSFiltration n k r →
      stochasticFixedProjection n k *ᵥ v ∈ exceptionalCSSFiltration n k r

def PositiveAverageNonzero : Prop :=
  ∀ {n k : ℕ} (v : (Fin n → Fin k → ZMod 2) → ℂ),
    (∀ X, 0 ≤ v X) → (∃ X, 0 < v X) → stochasticFixedProjection n k *ᵥ v ≠ 0

def ActualCSSColumnCode : Prop :=
  ∀ {n k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)), IsDefect N →
    ∀ f : CSSHom n N, (cssHomSynthesis n N).col f ∈ cssCode n N

def DeeperAverageAnnihilation : Prop :=
  ∀ {n k : ℕ} (N M : Submodule (ZMod 2) (Fin k → ZMod 2)),
    IsDefect N → IsDefect M → ∀ f : CSSHom n N, Function.Surjective f →
    Module.finrank (ZMod 2) N < Module.finrank (ZMod 2) M →
      cssColumnProjection n M *ᵥ
        (stochasticFixedProjection n k *ᵥ (cssHomSynthesis n N).col f) = 0

def WuAverageAnnihilation : Prop :=
  ∀ {n k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (hN : IsDefect N)
    (f : CSSHom n N), Function.Surjective f → cssQuotientWu N hN ≠ 0 →
      cssColumnProjection n (wuLine k) *ᵥ
        (stochasticFixedProjection n k *ᵥ (cssHomSynthesis n N).col f) = 0

def ActualStableCSSSurjection : Prop :=
  ∀ {n k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)), IsDefect N →
    k - 2 * Module.finrank (ZMod 2) N ≤ n →
      ∃ f : (Fin n → ZMod 2) →ₗ[ZMod 2] CSSQuotient N, Function.Surjective f

def OrdinaryStableFixedWitness : Prop :=
  ∀ {n k r : ℕ} (N : OrdinaryDefect k r), k - 2 * r ≤ n →
    ∃ v : (Fin n → Fin k → ZMod 2) → ℂ, v ≠ 0 ∧
      stochasticFixedProjection n k *ᵥ v = v ∧ v ∈ ordinaryCSSFiltration n k r ∧
      cssColumnProjection n (wuLine k) *ᵥ v = 0 ∧
      ∀ M : Submodule (ZMod 2) (Fin k → ZMod 2), IsDefect M →
        r < Module.finrank (ZMod 2) M → cssColumnProjection n M *ᵥ v = 0

def ExceptionalStableFixedWitness : Prop :=
  ∀ {n k r : ℕ} (N : ExceptionalDefect k r), k - 2 * r ≤ n →
    ∃ v : (Fin n → Fin k → ZMod 2) → ℂ, v ≠ 0 ∧
      stochasticFixedProjection n k *ᵥ v = v ∧ v ∈ exceptionalCSSFiltration n k r ∧
      ∀ M : Submodule (ZMod 2) (Fin k → ZMod 2), IsDefect M →
        r < Module.finrank (ZMod 2) M → cssColumnProjection n M *ᵥ v = 0

end StableFiltrationWitnessExpected

