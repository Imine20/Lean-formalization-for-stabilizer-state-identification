def BinaryPolarization : Prop :=
  ∀ {k : ℕ} (x y : Fin k → ZMod 2),
    (∑ i, ((x i + y i).val : ZMod 4)) =
      (∑ i, ((x i).val : ZMod 4)) + (∑ i, ((y i).val : ZMod 4)) +
        2 * ((∑ i, x i * y i).val : ZMod 4)

def BinaryOnesWeight : Prop :=
  ∀ k : ℕ, (∑ _i : Fin k, ((1 : ZMod 2).val : ZMod 4)) = (k : ZMod 4)

def BinaryWuIdentity : Prop :=
  ∀ {k : ℕ} (x : Fin k → ZMod 2),
    (∑ i, x i * x i) = ∑ i, x i * (1 : ZMod 2)

def BinaryExceptionalMod4 : Prop :=
  ∀ k : ℕ, (∑ _i : Fin k, ((1 : ZMod 2).val : ZMod 4)) = 0 ↔ 4 ∣ k

def DoubledLiftZero : Prop :=
  ∀ b : ZMod 2, (2 : ZMod 4) * (b.val : ZMod 4) = 0 ↔ b = 0

def BinaryEmptyWeight : Prop :=
  ∀ x : Fin 0 → ZMod 2, (∑ i, ((x i).val : ZMod 4)) = 0

def BinaryEmptyDot : Prop :=
  ∀ x y : Fin 0 → ZMod 2, (∑ i, x i * y i) = 0

end CriticalCurveExpected

