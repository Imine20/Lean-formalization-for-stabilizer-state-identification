def LinearCharacter {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] [Fintype V] : Prop :=
  ∀ l : V →ₗ[ZMod 2] ZMod 2,
    (∑ x, pauliSign (l x)) = if l = 0 then (Fintype.card V : ℂ) else 0

def CharacterIndicator : Prop :=
  ∀ a b : ZMod 2, 1 + pauliSign (a+b) = if a=b then (2:ℂ) else 0

def PolarCharacter {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] [Fintype V] : Prop :=
  ∀ Q : QuadraticForm (ZMod 2) V,
    (∀ x : V, (∀ y : V, Q.polarBilin x y = 0) → x = 0) →
    ∀ z : V, (∑ y, pauliSign (Q.polarBilin y z)) =
      if z = 0 then (Fintype.card V : ℂ) else 0

def GaussTranslate {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] [Fintype V] : Prop :=
  ∀ (Q : QuadraticForm (ZMod 2) V) (z : V),
    (∑ y, pauliSign (Q y + Q.polarBilin y z)) =
      pauliSign (Q z) * ∑ y, pauliSign (Q y)

def ConstraintCharacter {V W : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    [AddCommGroup W] [Module (ZMod 2) W] [Fintype W] : Prop :=
  ∀ (Q : QuadraticForm (ZMod 2) V) (f : W →ₗ[ZMod 2] V)
    (l : W →ₗ[ZMod 2] ZMod 2) (y : V),
    (∑ s, pauliSign (Q.polarBilin y (f s) + l s)) =
      if ∀ s, Q.polarBilin y (f s) = l s then (Fintype.card W : ℂ) else 0

def ScaledFiberCard {V W : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    [AddCommGroup W] [Module (ZMod 2) W] [Fintype V] [Fintype W] : Prop :=
  ∀ Q : QuadraticForm (ZMod 2) V,
    (∀ x : V, (∀ y : V, Q.polarBilin x y = 0) → x = 0) →
    ∀ f : W →ₗ[ZMod 2] V, Function.Injective f →
    ∀ (a : ZMod 2) (l : W →ₗ[ZMod 2] ZMod 2),
      (2 * (Fintype.card W : ℂ)) *
        Fintype.card {y : V // Q y = a ∧ ∀ s, Q.polarBilin y (f s) = l s} =
      (Fintype.card V : ℂ) + pauliSign a * (∑ y, pauliSign (Q y)) *
        ∑ s, pauliSign (Q (f s) + l s)

def EqualFiberCard {V W : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    [AddCommGroup W] [Module (ZMod 2) W] [Fintype V] [Fintype W] : Prop :=
  ∀ Q : QuadraticForm (ZMod 2) V,
    (∀ x : V, (∀ y : V, Q.polarBilin x y = 0) → x = 0) →
    ∀ f g : W →ₗ[ZMod 2] V, Function.Injective f → Function.Injective g →
    (∀ s, Q (f s) = Q (g s)) →
    ∀ (a : ZMod 2) (l : W →ₗ[ZMod 2] ZMod 2),
      Fintype.card {y : V // Q y = a ∧ ∀ s, Q.polarBilin y (f s) = l s} =
      Fintype.card {y : V // Q y = a ∧ ∀ s, Q.polarBilin y (g s) = l s}

def PolarPreservation {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] : Prop :=
  ∀ (Q : QuadraticForm (ZMod 2) V) (S : Submodule (ZMod 2) V)
    (f : S →ₗ[ZMod 2] V), (∀ s : S, Q (f s) = Q s.val) →
    ∀ s t : S, Q.polarBilin (f s) (f t) = Q.polarBilin s.val t.val

def ExteriorPoint {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] [Fintype V] : Prop :=
  ∀ Q : QuadraticForm (ZMod 2) V,
    (∀ x : V, (∀ y : V, Q.polarBilin x y = 0) → x = 0) →
    ∀ (S : Submodule (ZMod 2) V) (f : S →ₗ[ZMod 2] V),
      Function.Injective f → (∀ s : S, Q (f s) = Q s.val) →
    ∀ x : V, x ∉ S →
      ∃ y : V, y ∉ LinearMap.range f ∧ Q y = Q x ∧
        ∀ s : S, Q.polarBilin y (f s) = Q.polarBilin x s.val

def ExtensionStep {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] : Prop :=
  ∀ Q : QuadraticForm (ZMod 2) V,
    (∀ x : V, (∀ y : V, Q.polarBilin x y = 0) → x = 0) →
    ∀ (S : Submodule (ZMod 2) V) (f : S →ₗ[ZMod 2] V),
      Function.Injective f → (∀ s : S, Q (f s) = Q s.val) →
    ∀ x : V, x ∉ S →
      ∃ g : ↥(S ⊔ Submodule.span (ZMod 2) {x}) →ₗ[ZMod 2] V,
        Function.Injective g ∧ (∀ z, Q (g z) = Q z.val) ∧
        ∀ s : S,
          g ⟨s.val, (show S ≤ S ⊔ Submodule.span (ZMod 2) {x} from le_sup_left) s.property⟩ = f s

def AmbientExtension {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] : Prop :=
  ∀ Q : QuadraticForm (ZMod 2) V,
    (∀ x : V, (∀ y : V, Q.polarBilin x y = 0) → x = 0) →
    ∀ (S : Submodule (ZMod 2) V) (f : S →ₗ[ZMod 2] V),
      Function.Injective f → (∀ s : S, Q (f s) = Q s.val) →
      ∃ e : V ≃ₗ[ZMod 2] V, (∀ v, Q (e v) = Q v) ∧
        ∀ s : S, e s.val = f s

def WittExtension {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] : Prop :=
  ∀ Q : QuadraticForm (ZMod 2) V,
    (∀ x : V, (∀ y : V, Q.polarBilin x y = 0) → x = 0) →
    ∀ (S T : Submodule (ZMod 2) V) (f : S ≃ₗ[ZMod 2] T),
      (∀ s : S, Q (f s).val = Q s.val) →
      ∃ e : V ≃ₗ[ZMod 2] V, (∀ v, Q (e v) = Q v) ∧
        ∀ s : S, e s.val = (f s).val

end BinaryWittExpected
