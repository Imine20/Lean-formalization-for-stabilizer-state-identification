/- These bridges guard the mathematical meaning of shared input/output structures. -/
theorem povm_unrestricted {ι Ω : Type*} [Fintype ι] [DecidableEq ι] [Fintype Ω]
    (E : Ω → Matrix ι ι ℂ) (hE : ∀ j, (E j).PosSemidef) (hN : ∑ j, E j = 1) :
    ∃ M : POVM ι Ω, M.effect = E :=
  ⟨⟨E, hE, hN⟩, rfl⟩

theorem povm_effects_valid {ι Ω : Type*} [Fintype ι] [DecidableEq ι] [Fintype Ω]
    (M : POVM ι Ω) :
    (∀ j, (M.effect j).PosSemidef) ∧ (∑ j, M.effect j = 1) :=
  ⟨M.positive, M.normalized⟩

theorem pgm_effect_expanded {ι Ω : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype Ω] [DecidableEq Ω] (S : Matrix ι Ω ℂ) (i₀ j : Ω) :
    let T := S * cfc (fun x : ℝ => (Real.sqrt x)⁻¹) (Sᴴ * S)
    (prettyGoodMeasurement S i₀).effect j =
      Matrix.vecMulVec (fun x => T x j) (star (fun x => T x j)) +
        if j = i₀ then 1 - T * Tᴴ else 0 := by
  rfl

theorem fixedSubmodule_expanded {G V : Type*} [Group G] [AddCommGroup V]
    [Module (ZMod 2) V] [DistribMulAction G V] [SMulCommClass G (ZMod 2) V]
    (g : G) (v : V) :
    v ∈ fixedSubmodule (ZMod 2) V g ↔ g • v = v :=
  Iff.rfl

end CriticalCurveExpected

open Lean Elab Command in
run_cmd do
