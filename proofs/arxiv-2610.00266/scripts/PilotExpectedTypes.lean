abbrev Family {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V] (d l : V) :=
  {H : Submodule K V // finrank K H + 1 = finrank K V ∧ d ∈ H ∧ l ∉ H}
def FamilyType {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V] :=
  V → V → Type v
def EquivType {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] := ∀ (d l : V), d ≠ 0 →
  Family (K := K) d l ≃
    {H : Submodule K (V ⧸ Submodule.span K {d}) //
      finrank K H + 1 = finrank K (V ⧸ Submodule.span K {d}) ∧
        (Submodule.span K {d}).mkQ l ∉ H}
def Dimension {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] : Prop := ∀ d l : V, d ≠ 0 →
  l ∉ Submodule.span K {d} → 2 ≤ finrank K V
def Count {V : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] : Prop := ∀ d l : V, d ≠ 0 →
  l ∉ Submodule.span (ZMod 2) {d} →
    Nat.card (Family (K := ZMod 2) d l) = 2 ^ (finrank (ZMod 2) V - 2)
example {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V] (d l : V) :
  PointedHyperplanes (K := K) d l = Family (K := K) d l := rfl
