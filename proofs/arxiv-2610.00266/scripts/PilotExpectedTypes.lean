  ∀ F : V n →ₗ[ZMod 2] orthogonal N, Function.Surjective F →
  let v := (cssHomSynthesis n N).col ((N.comap (orthogonal N).subtype).mkQ.comp F)
  star v ⬝ᵥ (stochasticFixedProjection n k *ᵥ v) =
    (Fintype.card (StochasticIsometryGroup k) : ℂ)⁻¹ * ∑ g, W n N g
def Nonzero : Prop := ∀ {n k : ℕ} (N : S k), IsDefect N →
  ∀ F : V n →ₗ[ZMod 2] orthogonal N, Function.Surjective F → (∑ g, W n N g) ≠ 0
def Scalar : Prop := ∀ {n k r : ℕ} (N : OrdinaryDefect k r), k ≤ n →
  ∃ θ : ℝ,
    ((∑ T : StochasticLagrangian k, relationOperator n T.carrier) * ordinaryCSSGrade n k r =
        θ • ordinaryCSSGrade n k r ∧
      ordinaryCSSGrade n k r * (∑ T : StochasticLagrangian k, relationOperator n T.carrier) =
        θ • ordinaryCSSGrade n k r) ∧
    (θ : ℂ) =
      (gnwNormalization n k * (((2 : ℂ)^n)^r)⁻¹ * (gnwNormalization n (k-2*r))⁻¹) /
        ((Fintype.card (StochasticIsometryGroup k) : ℂ)⁻¹ * ∑ g, W n N.val g)
