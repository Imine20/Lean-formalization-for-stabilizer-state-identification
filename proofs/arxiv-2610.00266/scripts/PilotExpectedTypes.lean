def StabilizerPhaseTranslation : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (a : Fin n → ZMod 2)
    (t : stabilizerTranslationSpace S),
    stabilizerVector S (a + t.val) =
      Complex.I ^ (stabilizerPhase S a t).val * stabilizerVector S a

def StabilizerPhaseAnyLift : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (a : Fin n → ZMod 2),
    stabilizerVector S a ≠ 0 → ∀ (t : stabilizerTranslationSpace S)
      (g : S.carrier), g.val.shift = t.val →
    stabilizerPhase S a t = g.val.phase +
      2 * ((∑ i, g.val.clock i * a i).val : ZMod 4)

def StabilizerPhaseAtZero : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (a : Fin n → ZMod 2),
    stabilizerVector S a ≠ 0 → stabilizerPhase S a 0 = 0

def StabilizerPhaseCocycle : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (a : Fin n → ZMod 2),
    stabilizerVector S a ≠ 0 → ∀ t u : stabilizerTranslationSpace S,
    stabilizerPhase S a (t + u) = stabilizerPhase S a t + stabilizerPhase S a u +
      2 * ((∑ i, (stabilizerShiftLift S t).val.clock i * u.val i).val : ZMod 4)

def StabilizerLiftSymmetric : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (t u : stabilizerTranslationSpace S),
    (∑ i, (stabilizerShiftLift S t).val.clock i * u.val i) =
      ∑ i, (stabilizerShiftLift S u).val.clock i * t.val i

def StabilizerPhaseDiagonal : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (a : Fin n → ZMod 2),
    stabilizerVector S a ≠ 0 → ∀ t : stabilizerTranslationSpace S,
    2 * stabilizerPhase S a t =
      2 * ((∑ i, (stabilizerShiftLift S t).val.clock i * t.val i).val : ZMod 4)

theorem stabilizerRelativePhase_expanded {n : ℕ} (S : StabilizerGroup n)
    (a : Fin n → ZMod 2) (t : stabilizerTranslationSpace S) :
    stabilizerPhase S a t = (stabilizerShiftLift S t).val.phase +
      2 * ((∑ i, (stabilizerShiftLift S t).val.clock i * a i).val : ZMod 4) := rfl
end CriticalCurveExpected

