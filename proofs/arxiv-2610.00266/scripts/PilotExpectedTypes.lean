namespace QuadraticTupleExpected
universe u v
open ExactCriticalCurve ExactCriticalCurve.FiniteQuadratic Module
open scoped BigOperators

def GroupType : Type (u + 1) :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V],
    QuadraticForm (ZMod 2) V → Subgroup (V ≃ₗ[ZMod 2] V)
def RangeEquivType : Type (max u v + 1) :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    {E : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    (f g : E →ₗ[ZMod 2] V), LinearMap.ker f = LinearMap.ker g →
      LinearMap.range f ≃ₗ[ZMod 2] LinearMap.range g
def CoordinateEquivType : Type (u + 1) :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] (n : ℕ),
    (Fin n → V) ≃ₗ[ZMod 2] ((Fin n → ZMod 2) →ₗ[ZMod 2] V)
def InvariantType : Type (u + 1) :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (Q : QuadraticForm (ZMod 2) V) (n : ℕ) (x : Fin n → V),
    Submodule (ZMod 2) (Fin n → ZMod 2) × QuadraticForm (ZMod 2) (Fin n → ZMod 2)

def RangeApply : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    {E : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    (f g : E →ₗ[ZMod 2] V) (h : LinearMap.ker f = LinearMap.ker g) (x : E),
    (quadraticTupleRangeEquiv f g h ⟨f x,⟨x,rfl⟩⟩).val = g x
def LinearOrbit : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    {E : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    [FiniteDimensional (ZMod 2) V] (Q : QuadraticForm (ZMod 2) V)
    (hQ : LinearMap.BilinForm.Nondegenerate Q.polarBilin) (f g : E →ₗ[ZMod 2] V),
    (∃ a : {a : V ≃ₗ[ZMod 2] V // ∀ x, Q (a x) = Q x},
      a.val.toLinearMap.comp f = g) ↔ LinearMap.ker f = LinearMap.ker g ∧ Q.comp f = Q.comp g
def CoordinateAction : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (Q : QuadraticForm (ZMod 2) V) (n : ℕ) (a : BinaryQuadraticIsometryGroup Q) (x : Fin n → V),
    (Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) (a • x) =
      a.val.toLinearMap.comp ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x)
def TupleOrbit : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] (Q : QuadraticForm (ZMod 2) V)
    (hQ : LinearMap.BilinForm.Nondegenerate Q.polarBilin) (n : ℕ) (x y : Fin n → V),
    y ∈ MulAction.orbit (BinaryQuadraticIsometryGroup Q) x ↔
      (LinearMap.ker ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x),
        Q.comp ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x)) =
      (LinearMap.ker ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) y),
        Q.comp ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) y))
def OrbitEquivType : Type (u + 1) :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] (Q : QuadraticForm (ZMod 2) V)
    (hQ : LinearMap.BilinForm.Nondegenerate Q.polarBilin) (n : ℕ),
    MulAction.orbitRel.Quotient (BinaryQuadraticIsometryGroup Q) (Fin n → V) ≃
      Set.range (fun x : Fin n → V =>
        (LinearMap.ker ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x),
          Q.comp ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x)))
def Average : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] (Q : QuadraticForm (ZMod 2) V)
    (hQ : LinearMap.BilinForm.Nondegenerate Q.polarBilin) (n : ℕ),
    (∑ a : BinaryQuadraticIsometryGroup Q, ((2 : ℚ) ^ n) ^
      finrank (ZMod 2) (Counting.fixedSubmodule (ZMod 2) V a)) /
        (Nat.card (BinaryQuadraticIsometryGroup Q) : ℚ) =
      (Nat.card (Set.range (fun x : Fin n → V =>
        (LinearMap.ker ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x),
          Q.comp ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x)))) : ℚ)

example {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] (Q : QuadraticForm (ZMod 2) V) :
    (binaryQuadraticIsometrySubgroup Q).carrier = {a | ∀ x, Q (a x) = Q x} := rfl
example {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] (Q : QuadraticForm (ZMod 2) V)
    (n : ℕ) (x : Fin n → V) :
    quadraticTupleInvariant Q n x =
      (LinearMap.ker ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x),
        Q.comp ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x)) := rfl
end QuadraticTupleExpected

