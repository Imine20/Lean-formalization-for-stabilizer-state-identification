def Complement : Prop :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] (q : QuadraticForm (ZMod 2) A) (C : Submodule (ZMod 2) A), IsCompl (LinearMap.ker q.polarBilin) C → LinearMap.BilinForm.Nondegenerate (q.comp C.subtype).polarBilin

def RadicalZero : Prop :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] [Fintype A] (q : QuadraticForm (ZMod 2) A), (∑ x : A, pauliSign (q x)) = 0 ↔ binaryRadicalLinear q ≠ 0

def RadicalGauss : Prop :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] [Fintype A] (q : QuadraticForm (ZMod 2) A) (C : Submodule (ZMod 2) A), IsCompl (LinearMap.ker q.polarBilin) C → (∑ x : A, pauliSign (q x)) = (∑ c : C, pauliSign (q c.val)) * (if binaryRadicalLinear q = 0 then (Fintype.card (LinearMap.ker q.polarBilin) : ℂ) else 0)

def EvenDimension : Prop :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] [FiniteDimensional (ZMod 2) A] [Fintype A] (q : QuadraticForm (ZMod 2) A), LinearMap.BilinForm.Nondegenerate q.polarBilin → Even (finrank (ZMod 2) A)

def EnvelopeND : Prop :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] (q : QuadraticForm (ZMod 2) A) (p : A →ₗ[ZMod 2] (LinearMap.ker q.polarBilin)), (∀ r : (LinearMap.ker q.polarBilin), p r.val = r) → ∀ u : (LinearMap.ker q.polarBilin), LinearMap.BilinForm.Nondegenerate (binaryQuadraticEnvelope q p u).polarBilin

def EnvelopeInl : Prop :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] (q : QuadraticForm (ZMod 2) A) (p : A →ₗ[ZMod 2] (LinearMap.ker q.polarBilin)) (u : (LinearMap.ker q.polarBilin)) (x : A), binaryQuadraticEnvelope q p u (x,0) = q x

def EnvelopeDimension : Prop :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] [FiniteDimensional (ZMod 2) A] (q : QuadraticForm (ZMod 2) A), finrank (ZMod 2) (A × Module.Dual (ZMod 2) (LinearMap.ker q.polarBilin)) = finrank (ZMod 2) A + finrank (ZMod 2) (LinearMap.ker q.polarBilin)

def EnvelopeExists : Prop :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] (q : QuadraticForm (ZMod 2) A), ∃ P : QuadraticForm (ZMod 2) (A × Module.Dual (ZMod 2) (LinearMap.ker q.polarBilin)), LinearMap.BilinForm.Nondegenerate P.polarBilin ∧ ∀ x : A, P (x,0) = q x

def EnvelopeGauss : Prop :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] [FiniteDimensional (ZMod 2) A] [Fintype A] (q : QuadraticForm (ZMod 2) A) (C : Submodule (ZMod 2) A) (hC : IsCompl (LinearMap.ker q.polarBilin) C) (u : (LinearMap.ker q.polarBilin)), (∑ z : A × Module.Dual (ZMod 2) (LinearMap.ker q.polarBilin), pauliSign (binaryQuadraticEnvelope q ((LinearMap.ker q.polarBilin).linearProjOfIsCompl C hC) u z)) = (∑ c : C, pauliSign (q c.val)) * (Fintype.card (LinearMap.ker q.polarBilin) : ℂ) * pauliSign (q u.val)

def DimensionBound : Prop :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] {V : Type v} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) A] [FiniteDimensional (ZMod 2) V] (q : QuadraticForm (ZMod 2) A) (Q : QuadraticForm (ZMod 2) V), LinearMap.BilinForm.Nondegenerate Q.polarBilin → ∀ f : A →ₗ[ZMod 2] V, Function.Injective f → (∀ x, Q (f x) = q x) → finrank (ZMod 2) A + finrank (ZMod 2) (LinearMap.ker q.polarBilin) ≤ finrank (ZMod 2) V

def LinearPair : Prop :=
  ∀ {R : Type u} [AddCommGroup R] [Module (ZMod 2) R] [Fintype R] [Fintype (Module.Dual (ZMod 2) R)] (l : R →ₗ[ZMod 2] ZMod 2) (u : R), (∑ r : R, ∑ φ : Module.Dual (ZMod 2) R, pauliSign (l r + φ r + φ u)) = (Fintype.card (Module.Dual (ZMod 2) R) : ℂ) * pauliSign (l u)

def AddPolar : Prop :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] (q : QuadraticForm (ZMod 2) A) (l : A →ₗ[ZMod 2] ZMod 2), (q + binaryLinearQuadratic l).polarBilin = q.polarBilin

def Refinement : Prop :=
  ∀ {A : Type u} {V : Type v} [AddCommGroup A] [Module (ZMod 2) A] [AddCommGroup V] [Module (ZMod 2) V] (q : QuadraticForm (ZMod 2) A) (Q : QuadraticForm (ZMod 2) V) (f : A →ₗ[ZMod 2] V), Function.Injective f → (∀ x y, Q.polarBilin (f x) (f y) = q.polarBilin x y) → ∃ P : QuadraticForm (ZMod 2) V, P.polarBilin = Q.polarBilin ∧ ∀ x, P (f x) = q x

def ShiftGauss : Prop :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] [Fintype A] (q : QuadraticForm (ZMod 2) A) (a : A), (∑ x : A, pauliSign ((q + binaryLinearQuadratic (q.polarBilin.flip a)) x)) = pauliSign (q a) * (∑ x : A, pauliSign (q x))

def Average : Prop :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] [Fintype A] (q : QuadraticForm (ZMod 2) A) (S : Submodule (ZMod 2) A), (∀ s : S, q s.val = 0) → (∑ x : A, pauliSign (q x)) = ∑ x : LinearMap.BilinForm.orthogonal q.polarBilin S, pauliSign (q x.val)

def RadicalImage : Prop :=
  ∀ {A : Type u} {V : Type v} [AddCommGroup A] [Module (ZMod 2) A] [AddCommGroup V] [Module (ZMod 2) V] (q : QuadraticForm (ZMod 2) A) (Q : QuadraticForm (ZMod 2) V) (f : A →ₗ[ZMod 2] V), (∀ x, Q (f x) = q x) → LinearMap.range (f.comp (LinearMap.ker q.polarBilin).subtype) = LinearMap.range f ⊓ LinearMap.BilinForm.orthogonal Q.polarBilin (LinearMap.range f)

def RangeGauss : Prop :=
  ∀ {A : Type u} {V : Type v} [AddCommGroup A] [Module (ZMod 2) A] [AddCommGroup V] [Module (ZMod 2) V] [Fintype A] [Fintype V] (q : QuadraticForm (ZMod 2) A) (Q : QuadraticForm (ZMod 2) V) (f : A →ₗ[ZMod 2] V), Function.Injective f → (∀ x, Q (f x) = q x) → (∑ z : LinearMap.range f, pauliSign (Q z.val)) = (∑ x : A, pauliSign (q x))

def Boundary : Prop :=
  ∀ {A : Type u} {V : Type v} [AddCommGroup A] [Module (ZMod 2) A] [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) A] [FiniteDimensional (ZMod 2) V] [Fintype A] [Fintype V] (q : QuadraticForm (ZMod 2) A) (Q : QuadraticForm (ZMod 2) V), LinearMap.BilinForm.Nondegenerate Q.polarBilin → ∀ f : A →ₗ[ZMod 2] V, Function.Injective f → (∀ x, Q (f x) = q x) → (∀ z : LinearMap.BilinForm.orthogonal Q.polarBilin (LinearMap.range f), Q z.val = 0) → finrank (ZMod 2) V = finrank (ZMod 2) A + finrank (ZMod 2) (LinearMap.ker q.polarBilin) ∧ (∑ y : V, pauliSign (Q y)) = (∑ x : A, pauliSign (q x))

def NecessaryBoundary : Prop :=
  ∀ {A : Type u} {V : Type v} [AddCommGroup A] [Module (ZMod 2) A] [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) A] [FiniteDimensional (ZMod 2) V] [Fintype A] [Fintype V] (q : QuadraticForm (ZMod 2) A) (Q : QuadraticForm (ZMod 2) V), LinearMap.BilinForm.Nondegenerate Q.polarBilin → ∀ f : A →ₗ[ZMod 2] V, Function.Injective f → (∀ x, Q (f x) = q x) → finrank (ZMod 2) V = finrank (ZMod 2) A + finrank (ZMod 2) (LinearMap.ker q.polarBilin) → (∑ x : A, pauliSign (q x)) ≠ 0 → (∑ y : V, pauliSign (Q y)) = (∑ x : A, pauliSign (q x))

def Criterion : Prop :=
  ∀ {A : Type u} {V : Type v} [AddCommGroup A] [Module (ZMod 2) A] [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) A] [FiniteDimensional (ZMod 2) V] [Fintype A] [Fintype V] (q : QuadraticForm (ZMod 2) A) (Q : QuadraticForm (ZMod 2) V), LinearMap.BilinForm.Nondegenerate Q.polarBilin → ((∃ f : A →ₗ[ZMod 2] V, Function.Injective f ∧ ∀ x, Q (f x) = q x) ↔ finrank (ZMod 2) A + finrank (ZMod 2) (LinearMap.ker q.polarBilin) ≤ finrank (ZMod 2) V ∧ (finrank (ZMod 2) A + finrank (ZMod 2) (LinearMap.ker q.polarBilin) < finrank (ZMod 2) V ∨ (∑ x : A, pauliSign (q x)) = 0 ∨ (∑ y : V, pauliSign (Q y)) = (∑ x : A, pauliSign (q x))))
def LinearQuadraticType : Type (u + 1) :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A], (A →ₗ[ZMod 2] ZMod 2) → QuadraticForm (ZMod 2) A

def RadicalLinearType : Type (u + 1) :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] (q : QuadraticForm (ZMod 2) A), (LinearMap.ker q.polarBilin) →ₗ[ZMod 2] ZMod 2

def SplitType : Type (u + 1) :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] (q : QuadraticForm (ZMod 2) A) (C : Submodule (ZMod 2) A), IsCompl (LinearMap.ker q.polarBilin) C → q.IsometryEquiv ((q.comp C.subtype).prod (binaryLinearQuadratic (binaryRadicalLinear q)))

def IntegerGaussType : Type (u + 1) :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] [Fintype A], QuadraticForm (ZMod 2) A → ℤ

def EnvelopeType : Type (u + 1) :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] (q : QuadraticForm (ZMod 2) A), (A →ₗ[ZMod 2] (LinearMap.ker q.polarBilin)) → (LinearMap.ker q.polarBilin) → QuadraticForm (ZMod 2) (A × Module.Dual (ZMod 2) (LinearMap.ker q.polarBilin))

def DifferenceType : Type (u + 1) :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] (q p : QuadraticForm (ZMod 2) A), q.polarBilin = p.polarBilin → A →ₗ[ZMod 2] ZMod 2

def OrthogonalType : Type (u + 1) :=
  ∀ {A : Type u} [AddCommGroup A] [Module (ZMod 2) A], QuadraticForm (ZMod 2) A → Submodule (ZMod 2) A → Submodule (ZMod 2) A

example {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] (q : QuadraticForm (ZMod 2) A) : binaryPolarRadical q = LinearMap.ker q.polarBilin := rfl
example {A : Type u} [AddCommGroup A] [Module (ZMod 2) A] (q : QuadraticForm (ZMod 2) A) (r : LinearMap.ker q.polarBilin) : binaryRadicalLinear q r = q r.val := rfl
