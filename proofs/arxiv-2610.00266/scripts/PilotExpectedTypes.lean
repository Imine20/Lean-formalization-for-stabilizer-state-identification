open scoped BigOperators ComplexOrder MatrixOrder
open Classical
namespace CriticalCurveExpected
open ExactCriticalCurve ExactCriticalCurve.Binary ExactCriticalCurve.Quantum Matrix

def CSSActualCharacterSum : Prop :=
  ∀ {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (y : Fin k → ZMod 2),
    (∑ b : N, (-1 : ℂ) ^ (binaryDot b.val y).val) =
      if y ∈ orthogonal N then (Fintype.card N : ℂ) else 0

def CSSActualPauliAverageSum : Prop :=
  ∀ {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)), IsDefect N →
    (∑ p : N × N, Matrix.of (fun x y : Fin k → ZMod 2 =>
      if x = y+p.1.val then (-1 : ℂ) ^ (binaryDot p.2.val y).val else 0)) =
    ((Fintype.card N : ℂ)^2) •
      (cosetSynthesis (orthogonal N) N * (cosetSynthesis (orthogonal N) N)ᴴ)

def CSSActualConstraintAverage : Prop :=
  ∀ {k : ℕ} (n : ℕ) (N : Submodule (ZMod 2) (Fin k → ZMod 2)), IsDefect N →
    cssColumnSynthesis n N * (cssColumnSynthesis n N)ᴴ =
      (Fintype.card (Multiplicative (Fin n → N × N)) : ℂ)⁻¹ •
        ∑ g : Multiplicative (Fin n → N × N), Matrix.of
          (fun X Y : Fin n → Fin k → ZMod 2 =>
            ∏ a, if X a = Y a + (g.toAdd a).1.val
              then (-1 : ℂ) ^ (binaryDot (g.toAdd a).2.val (Y a)).val else 0)

def CSSActualTensorTranspose : Prop :=
  ∀ n k : ℕ, ∀ A B : Fin k → (Fin n → ZMod 2),
    (matrixTensorFamily k (fun i => pauliMatrix (A i) (B i))).submatrix
        (fun X : Fin n → Fin k → ZMod 2 => fun i a => X a i) (fun Y : Fin n → Fin k → ZMod 2 => fun i a => Y a i) =
      matrixTensorFamily n (fun a => pauliMatrix (fun i => A i a) (fun i => B i a))

def CSSActualSelectivePhase : Prop :=
  ∀ {n k : ℕ} (v : Fin k → ZMod 2) (g : PauliLabel n),
    matrixTensorFamily k (fun i => if v i = 1 then pauliOperator g else 1) =
      Complex.I ^ (g.phase * ∑ i, bitLift (v i)).val •
        matrixTensorFamily k (fun i => pauliMatrix ((v i) • g.shift) ((v i) • g.clock))

def CSSActualSelectiveConstraint : Prop :=
  ∀ {n k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)), IsDefect N →
    ∀ (v : N) (g : PauliLabel n),
      (matrixTensorFamily k (fun i => if v.val i = 1 then pauliOperator g else 1)).submatrix
          (fun X : Fin n → Fin k → ZMod 2 => fun i a => X a i) (fun Y : Fin n → Fin k → ZMod 2 => fun i a => Y a i) =
        matrixTensorFamily n (fun a =>
          pauliMatrix (g.shift a • v.val) (g.clock a • v.val))

def CSSActualSelectiveConjugation : Prop :=
  ∀ {n k : ℕ} (U : ((pauliUnitaryRepresentation n).range).normalizer)
    (v : Fin k → ZMod 2) (g : PauliLabel n),
    matrixTensorPower k U.val.val *
      matrixTensorFamily k (fun i => if v i = 1 then pauliOperator g else 1) *
        (matrixTensorPower k U.val.val)ᴴ =
      matrixTensorFamily k (fun i =>
        if v i = 1 then pauliOperator (cliffordPauliAut U g) else 1)

def CSSActualColumnUnitary : Prop :=
  ∀ {n : ℕ} (U : ((pauliUnitaryRepresentation n).range).normalizer) (k : ℕ),
    ((matrixTensorPower k U.val.val).submatrix (fun X : Fin n → Fin k → ZMod 2 => fun i a => X a i) (fun Y : Fin n → Fin k → ZMod 2 => fun i a => Y a i))ᴴ *
      ((matrixTensorPower k U.val.val).submatrix (fun X : Fin n → Fin k → ZMod 2 => fun i a => X a i) (fun Y : Fin n → Fin k → ZMod 2 => fun i a => Y a i)) = 1

def CSSActualFixedCriterion : Prop :=
  ∀ {n k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)), IsDefect N →
    ∀ w : (Fin n → Fin k → ZMod 2) → ℂ,
      (cssColumnSynthesis n N * (cssColumnSynthesis n N)ᴴ) *ᵥ w = w ↔
        ∀ (v : N) (g : PauliLabel n),
          ((matrixTensorFamily k (fun i => if v.val i = 1 then pauliOperator g else 1)).submatrix
            (fun X : Fin n → Fin k → ZMod 2 => fun i a => X a i) (fun Y : Fin n → Fin k → ZMod 2 => fun i a => Y a i)) *ᵥ w = w

def CSSActualFullCliffordCommutes : Prop :=
  ∀ {n k : ℕ} (U : ((pauliUnitaryRepresentation n).range).normalizer)
    (N : Submodule (ZMod 2) (Fin k → ZMod 2)), IsDefect N →
    (cssColumnSynthesis n N * (cssColumnSynthesis n N)ᴴ) *
      ((matrixTensorPower k U.val.val).submatrix (fun X : Fin n → Fin k → ZMod 2 => fun i a => X a i) (fun Y : Fin n → Fin k → ZMod 2 => fun i a => Y a i)) =
    ((matrixTensorPower k U.val.val).submatrix (fun X : Fin n → Fin k → ZMod 2 => fun i a => X a i) (fun Y : Fin n → Fin k → ZMod 2 => fun i a => Y a i)) *
      (cssColumnSynthesis n N * (cssColumnSynthesis n N)ᴴ)

def CSSActualFullCliffordCovariance : Prop :=
  ∀ {n k : ℕ} (U : ((pauliUnitaryRepresentation n).range).normalizer)
    (N : Submodule (ZMod 2) (Fin k → ZMod 2)), IsDefect N →
    ((matrixTensorPower k U.val.val).submatrix (fun X : Fin n → Fin k → ZMod 2 => fun i a => X a i) (fun Y : Fin n → Fin k → ZMod 2 => fun i a => Y a i)) *
      (cssColumnSynthesis n N * (cssColumnSynthesis n N)ᴴ) *
      ((matrixTensorPower k U.val.val).submatrix (fun X : Fin n → Fin k → ZMod 2 => fun i a => X a i) (fun Y : Fin n → Fin k → ZMod 2 => fun i a => Y a i))ᴴ =
