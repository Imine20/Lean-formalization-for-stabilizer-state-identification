namespace SymplecticTupleExpected
universe u v
open ExactCriticalCurve ExactCriticalCurve.FiniteQuadratic Module
open scoped BigOperators

def GroupType : Type (u + 1) :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V],
    LinearMap.BilinForm (ZMod 2) V → Subgroup (V ≃ₗ[ZMod 2] V)
def RangeEquivType : Type (max u v + 1) :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    {E : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    (f g : E →ₗ[ZMod 2] V), LinearMap.ker f = LinearMap.ker g →
      LinearMap.range f ≃ₗ[ZMod 2] LinearMap.range g
def CoordinateEquivType : Type (u + 1) :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] (n : ℕ),
    (Fin n → V) ≃ₗ[ZMod 2] ((Fin n → ZMod 2) →ₗ[ZMod 2] V)
def InvariantType : Type (u + 1) :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) V) (n : ℕ) (x : Fin n → V),
    Submodule (ZMod 2) (Fin n → ZMod 2) × LinearMap.BilinForm (ZMod 2) (Fin n → ZMod 2)

def RangeApply : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    {E : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    (f g : E →ₗ[ZMod 2] V) (h : LinearMap.ker f = LinearMap.ker g) (x : E),
    (symplecticTupleRangeEquiv f g h ⟨f x,⟨x,rfl⟩⟩).val = g x
def LinearOrbit : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    {E : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    [FiniteDimensional (ZMod 2) V] (B : LinearMap.BilinForm (ZMod 2) V)
    (hB : B.IsAlt) (hnd : B.Nondegenerate) (f g : E →ₗ[ZMod 2] V),
    (∃ a : {a : V ≃ₗ[ZMod 2] V // ∀ x y, B (a x) (a y) = B x y},
      a.val.toLinearMap.comp f = g) ↔ LinearMap.ker f = LinearMap.ker g ∧ B.comp f f = B.comp g g
def CoordinateAction : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) V) (n : ℕ) (a : BinarySymplecticIsometryGroup B) (x : Fin n → V),
    (Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) (a • x) =
      a.val.toLinearMap.comp ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x)
def TupleOrbit : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] (B : LinearMap.BilinForm (ZMod 2) V)
    (hB : B.IsAlt) (hnd : B.Nondegenerate) (n : ℕ) (x y : Fin n → V),
    y ∈ MulAction.orbit (BinarySymplecticIsometryGroup B) x ↔
      (LinearMap.ker ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x),
        B.comp ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x) ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x)) =
      (LinearMap.ker ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) y),
        B.comp ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) y) ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) y))
def OrbitEquivType : Type (u + 1) :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] (B : LinearMap.BilinForm (ZMod 2) V)
    (hB : B.IsAlt) (hnd : B.Nondegenerate) (n : ℕ),
    MulAction.orbitRel.Quotient (BinarySymplecticIsometryGroup B) (Fin n → V) ≃
      Set.range (fun x : Fin n → V =>
        (LinearMap.ker ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x),
          B.comp ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x) ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x)))
def Average : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] (B : LinearMap.BilinForm (ZMod 2) V)
    (hB : B.IsAlt) (hnd : B.Nondegenerate) (n : ℕ),
    (∑ a : BinarySymplecticIsometryGroup B, ((2 : ℚ) ^ n) ^
      finrank (ZMod 2) (Counting.fixedSubmodule (ZMod 2) V a)) /
        (Nat.card (BinarySymplecticIsometryGroup B) : ℚ) =
      (Nat.card (Set.range (fun x : Fin n → V =>
        (LinearMap.ker ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x),
          B.comp ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x) ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x)))) : ℚ)

example {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] (B : LinearMap.BilinForm (ZMod 2) V) :
    (binarySymplecticIsometrySubgroup B).carrier = {a | ∀ x y, B (a x) (a y) = B x y} := rfl
example {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] (B : LinearMap.BilinForm (ZMod 2) V)
    (n : ℕ) (x : Fin n → V) :
    symplecticTupleInvariant B n x =
      (LinearMap.ker ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x),
        B.comp ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x) ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x)) := rfl
end SymplecticTupleExpected

