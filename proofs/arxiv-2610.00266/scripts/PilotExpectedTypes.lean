def SupportContainment : Prop :=
  ∀ {n k : ℕ} (X Y : CopyConfig n k)
    (A : AffineSubspace (ZMod 2) (BinaryVector n)),
    affineSpan (ZMod 2) (Set.range X ∪ Set.range Y) ≤ A ↔
      (∀ i, X i ∈ A) ∧ ∀ i, Y i ∈ A

def SupportMembership : Prop :=
  ∀ {n : ℕ} (A : NonemptyAffineSupport n) (x : BinaryVector n),
    x ∈ A.val ↔ x - affineSupportAnchor A ∈ A.val.direction

def FixedSupportSum : Prop :=
  ∀ {n k : ℕ} (A : NonemptyAffineSupport n) (X Y : CopyConfig n k),
    (∑ c : QuadraticPhaseData (Module.finrank (ZMod 2) A.val.direction),
      matrixTensorPower k (stabilizerProjection (phaseStabilizer (affineSupportAnchor A)
        (phaseDataOfCoefficients (Module.finBasis (ZMod 2) A.val.direction) c))) X Y) =
      if affineSpan (ZMod 2) (Set.range X ∪ Set.range Y) ≤ A.val ∧
          phaseStatisticsVanish X Y then
        (2 : ℂ)^(2 * Module.finrank (ZMod 2) A.val.direction +
          (Module.finrank (ZMod 2) A.val.direction).choose 2) /
          (2 : ℂ)^(Module.finrank (ZMod 2) A.val.direction * k)
      else 0

def RankAddition : Prop :=
  ∀ {n : ℕ} (A₀ : NonemptyAffineSupport n)
    (A : {A : NonemptyAffineSupport n // A₀.val ≤ A.val}),
    Module.finrank (ZMod 2) A₀.val.direction +
      (Module.finrank (ZMod 2) A.val.val.direction -
        Module.finrank (ZMod 2) A₀.val.direction) =
      Module.finrank (ZMod 2) A.val.val.direction

def ContainingSupportSum : Prop :=
  ∀ {n : ℕ} (A₀ : NonemptyAffineSupport n) (f : ℕ → ℂ),
    (∑ A : {A : NonemptyAffineSupport n // A₀.val ≤ A.val},
      f (Module.finrank (ZMod 2) A.val.val.direction)) =
      ∑ r ∈ Finset.range (n - Module.finrank (ZMod 2) A₀.val.direction + 1),
        (Nat.card {U : Submodule (ZMod 2)
          (Fin (n - Module.finrank (ZMod 2) A₀.val.direction) → ZMod 2) //
          Module.finrank (ZMod 2) U = r} : ℂ) *
          f (Module.finrank (ZMod 2) A₀.val.direction + r)

def SupportIndicatorSum : Prop :=
  ∀ {n : ℕ} (A₀ : NonemptyAffineSupport n) (f : ℕ → ℂ),
    (∑ A : NonemptyAffineSupport n,
      if A₀.val ≤ A.val then f (Module.finrank (ZMod 2) A.val.direction) else 0) =
      ∑ r ∈ Finset.range (n - Module.finrank (ZMod 2) A₀.val.direction + 1),
        (Nat.card {U : Submodule (ZMod 2)
          (Fin (n - Module.finrank (ZMod 2) A₀.val.direction) → ZMod 2) //
          Module.finrank (ZMod 2) U = r} : ℂ) *
          f (Module.finrank (ZMod 2) A₀.val.direction + r)

def EnsembleSupportSum : Prop :=
  ∀ {n k : ℕ} (X Y : CopyConfig n k),
    (∑ S : StabilizerGroup n, matrixTensorPower k (stabilizerProjection S) X Y) =
      ∑ A : NonemptyAffineSupport n,
        if affineSpan (ZMod 2) (Set.range X ∪ Set.range Y) ≤ A.val ∧
            phaseStatisticsVanish X Y then
          (2 : ℂ)^(2 * Module.finrank (ZMod 2) A.val.direction +
            (Module.finrank (ZMod 2) A.val.direction).choose 2) /
            (2 : ℂ)^(Module.finrank (ZMod 2) A.val.direction * k)
        else 0

def EnsembleGaussianSum : Prop :=
  ∀ {n k : ℕ}, 1 ≤ k → ∀ X Y : CopyConfig n k,
    (∑ S : StabilizerGroup n, matrixTensorPower k (stabilizerProjection S) X Y) =
      if phaseStatisticsVanish X Y then
        ∑ r ∈ Finset.range (n - Module.finrank (ZMod 2)
          (affineSpan (ZMod 2) (Set.range X ∪ Set.range Y)).direction + 1),
          (Nat.card {U : Submodule (ZMod 2)
            (Fin (n - Module.finrank (ZMod 2)
              (affineSpan (ZMod 2) (Set.range X ∪ Set.range Y)).direction) → ZMod 2) //
            Module.finrank (ZMod 2) U = r} : ℂ) *
          ((2 : ℂ)^(2 * (Module.finrank (ZMod 2)
            (affineSpan (ZMod 2) (Set.range X ∪ Set.range Y)).direction + r) +
            (Module.finrank (ZMod 2)
              (affineSpan (ZMod 2) (Set.range X ∪ Set.range Y)).direction + r).choose 2) /
            (2 : ℂ)^((Module.finrank (ZMod 2)
              (affineSpan (ZMod 2) (Set.range X ∪ Set.range Y)).direction + r) * k))
      else 0

def NormalizationNonzero : Prop :=
  ∀ n k : ℕ,
    ((2 : ℂ)^n * ∏ j ∈ Finset.range (k-1), ((2 : ℂ)^n + (2 : ℂ)^j)) ≠ 0

def EnsembleCardinality : Prop :=
  ∀ n : ℕ, (Fintype.card (StabilizerGroup n) : ℂ) =
    (2 : ℂ)^n * ∏ j ∈ Finset.range n, (1 + (2 : ℂ)^(j+1))

def EntrywiseMoment : Prop :=
  ∀ {n k : ℕ}, 1 ≤ k → ∀ X Y : CopyConfig n k,
    (((Fintype.card (StabilizerGroup n) : ℂ)⁻¹) •
      ∑ S : StabilizerGroup n, matrixTensorPower k (stabilizerProjection S)) X Y =
      ((2 : ℂ)^n * ∏ j ∈ Finset.range (k-1), ((2 : ℂ)^n + (2 : ℂ)^j))⁻¹ *
        (∑ T : StochasticLagrangian k,
          matrixTensorPower n (fun x y : BinaryVector k =>
            if (x,y) ∈ T.carrier then (1 : ℂ) else 0)
            (copyColumnsEquiv n k X) (copyColumnsEquiv n k Y))

def AllQubitsPositiveCopiesMoment : Prop :=
  ∀ n k : ℕ, 1 ≤ k →
    ((((Fintype.card (StabilizerGroup n) : ℂ)⁻¹) •
      ∑ S : StabilizerGroup n, matrixTensorPower k (stabilizerProjection S)).submatrix
        (copyColumnsEquiv n k).symm (copyColumnsEquiv n k).symm) =
      (((2 : ℂ)^n *
        ∏ j ∈ Finset.range (k-1), ((2 : ℂ)^n + (2 : ℂ)^j))⁻¹) •
      ∑ T : StochasticLagrangian k,
        matrixTensorPower n (fun x y : BinaryVector k =>
          if (x,y) ∈ T.carrier then (1 : ℂ) else 0)

