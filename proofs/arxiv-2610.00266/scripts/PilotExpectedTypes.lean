def RayOrbitOptimality {ι Ω : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype Ω] [DecidableEq Ω] : Prop :=
  ∀ S : Matrix ι Ω ℂ,
    (∀ j, (Sᴴ * S) j j = 1) →
    (∀ i j, ∃ R : RaySymmetry S, R.permutation i = j) → Ω →
    IsGreatest
      {v : ℝ | ∃ M : POVM ι Ω,
        (∑ j, (Matrix.trace (M.effect j *
          Matrix.vecMulVec (fun x => S x j) (star (fun x => S x j)))).re) /
            Fintype.card Ω = v}
      (((Matrix.trace (CFC.sqrt (Sᴴ * S))).re / Fintype.card Ω) ^ 2)

def PGMAttainment {ι Ω : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype Ω] [DecidableEq Ω] : Prop :=
  ∀ (S : Matrix ι Ω ℂ),
    (∀ i j, ∃ R : RaySymmetry S, R.permutation i = j) →
    ∀ i₀ : Ω,
    (∑ j, (Matrix.trace ((prettyGoodMeasurement S i₀).effect j *
      Matrix.vecMulVec (fun x => S x j) (star (fun x => S x j)))).re) /
        Fintype.card Ω =
      (((Matrix.trace (CFC.sqrt (Sᴴ * S))).re / Fintype.card Ω) ^ 2)

def DecodedOptimality {ι Ω : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype Ω] [DecidableEq Ω] {Γ : Type*} [Fintype Γ] : Prop :=
  ∀ S : Matrix ι Ω ℂ,
    (∀ j, (Sᴴ * S) j j = 1) →
    (∀ i j, ∃ R : RaySymmetry S, R.permutation i = j) → Ω →
    ∀ (M : POVM ι Γ) (decoder : Γ → Ω → ℝ),
    (∀ g j, 0 ≤ decoder g j) → (∀ g, ∑ j, decoder g j = 1) →
      (∑ j, ∑ g, decoder g j * (Matrix.trace (M.effect g *
        Matrix.vecMulVec (fun x => S x j) (star (fun x => S x j)))).re) /
          Fintype.card Ω ≤
      (((Matrix.trace (CFC.sqrt (Sᴴ * S))).re / Fintype.card Ω) ^ 2)

def FunctionBurnside (G X : Type*) [Group G] [Fintype G] [Fintype X]
    [MulAction G X] : Prop :=
  ∀ n : ℕ, (∑ g : G, Nat.card (MulAction.fixedBy X g) ^ n) =
    Fintype.card G * Nat.card (MulAction.orbitRel.Quotient G (Fin n → X))

def BinaryAverage {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
    [Fintype V] [DistribMulAction G V] [SMulCommClass G (ZMod 2) V] [Fintype G] : Prop :=
  ∀ n : ℕ,
    (∑ g : G, ((2 : ℚ) ^ n) ^ Module.finrank (ZMod 2)
      (fixedSubmodule (ZMod 2) V g)) / Fintype.card G =
        (Nat.card (MulAction.orbitRel.Quotient G (Fin n → V)) : ℚ)

/- Kernel-checked semantic bridge spelling out every field of the ray-symmetry
   hypothesis separately. Extra hidden structure fields cannot be silently added. -/
theorem rayTransitive_expanded {ι Ω : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype Ω] [DecidableEq Ω] (S : Matrix ι Ω ℂ) :
    RayTransitive S ↔
      ∀ i j, ∃ (e : Equiv.Perm Ω) (U : unitary (Matrix ι ι ℂ)) (phase : Ω → ℂ),
        (∀ l, Complex.normSq (phase l) = 1) ∧
        S.submatrix id e = (U : Matrix ι ι ℂ) * S * Matrix.diagonal phase ∧
        e i = j := by
  constructor
  · intro h i j
    obtain ⟨R, hR⟩ := h i j
    exact ⟨R.permutation, R.operator, R.phase, R.phase_unit, R.covariance, hR⟩
  · intro h i j
    obtain ⟨e, U, phase, hphase, hcov, hij⟩ := h i j
    exact ⟨⟨e, U, phase, hphase, hcov⟩, hij⟩
end CriticalCurveExpected

