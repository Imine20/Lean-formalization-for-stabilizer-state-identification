namespace CompressedAlgebraExpected
open Classical Matrix Module ExactCriticalCurve ExactCriticalCurve.Binary ExactCriticalCurve.Quantum
open scoped BigOperators
set_option maxHeartbeats 2400000

abbrev M (n k : ℕ) := Matrix (Fin n → (Fin k → ZMod 2)) (Fin n → (Fin k → ZMod 2)) ℂ
def C {k : ℕ} (n : ℕ) (T : StochasticLagrangian k) : M n k :=
  stochasticFixedProjection n k * relationOperator n T.carrier * stochasticFixedProjection n k
def S (n k : ℕ) : Submodule ℝ (M n k) := Submodule.span ℝ (Set.range (C (k := k) n))

def Average : Prop :=
  ∀ n k : ℕ, stochasticFixedProjection n k =
    (Fintype.card (StochasticIsometryGroup k) : ℝ)⁻¹ •
      ∑ g : StochasticIsometryGroup k, stochasticIsometryMatrix n g
def RealProduct : Prop :=
  ∀ {k : ℕ} (n : ℕ) (T U : StochasticLagrangian k),
    relationOperator n T.carrier * relationOperator n U.carrier =
      (((2 : ℝ)^n)^finrank (ZMod 2) ↥(T.rightDefect ⊓ U.leftDefect)) •
        relationOperator n (LinearMap.range (relationOuterMap T U))
def RightTranslation : Prop :=
  ∀ {k : ℕ} (n : ℕ) (T : StochasticLagrangian k) (g : StochasticIsometryGroup k),
    relationOperator n T.carrier * stochasticIsometryMatrix n g =
      relationOperator n (stochasticRelation 1 g⁻¹ T.carrier)
def CompressedProduct : Prop :=
  ∀ {k : ℕ} (n : ℕ) (T U : StochasticLagrangian k),
    C n T * C n U =
      (Fintype.card (StochasticIsometryGroup k) : ℝ)⁻¹ •
        ∑ g : StochasticIsometryGroup k,
          (((2 : ℝ)^n)^finrank (ZMod 2)
            ↥((stochasticLagrangianAction 1 g⁻¹ T).rightDefect ⊓ U.leftDefect)) •
            C n (stochasticLagrangianComposition (stochasticLagrangianAction 1 g⁻¹ T) U)
def GeneratorMem : Prop :=
  ∀ {k : ℕ} (n : ℕ) (T : StochasticLagrangian k), C n T ∈ S n k
def GeneratorProductMem : Prop :=
  ∀ {k : ℕ} (n : ℕ) (T U : StochasticLagrangian k), C n T * C n U ∈ S n k
def MulClosed : Prop :=
  ∀ n k : ℕ, ∀ {A B : M n k}, A ∈ S n k → B ∈ S n k → A * B ∈ S n k
def GeneratorHermitian : Prop :=
  ∀ {k : ℕ} (n : ℕ) (T : StochasticLagrangian k), (C n T).IsHermitian
def SpanHermitian : Prop :=
  ∀ n k : ℕ, ∀ {A : M n k}, A ∈ S n k → A.IsHermitian
def SpanCommute : Prop :=
  ∀ n k : ℕ, ∀ {A B : M n k}, A ∈ S n k → B ∈ S n k → Commute A B
def IdentityGenerator : Prop :=
  ∀ n k : ℕ, C n (identityStochasticLagrangian k) = stochasticFixedProjection n k
def IdentityMem : Prop :=
  ∀ n k : ℕ, stochasticFixedProjection n k ∈ S n k
def LeftIdentity : Prop :=
  ∀ n k : ℕ, ∀ {A : M n k}, A ∈ S n k → stochasticFixedProjection n k * A = A
def RightIdentity : Prop :=
  ∀ n k : ℕ, ∀ {A : M n k}, A ∈ S n k → A * stochasticFixedProjection n k = A
def PositivePower : Prop :=
  ∀ n k : ℕ, ∀ {A : M n k}, A ∈ S n k → ∀ m : ℕ, A^(m+1) ∈ S n k
def PolynomialClosed : Prop :=
  ∀ n k : ℕ, ∀ {A : M n k}, A ∈ S n k →
    ∀ p : Polynomial ℝ, p.coeff 0 = 0 → Polynomial.aeval A p ∈ S n k

def CompressedType : Type :=
  ∀ {k : ℕ} (n : ℕ), StochasticLagrangian k → M n k
def SpanType : Type := ∀ n k : ℕ, Submodule ℝ (M n k)

