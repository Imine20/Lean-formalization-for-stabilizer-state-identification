namespace GNWNormalizationExpected
open ExactCriticalCurve.Counting

def Prefix {K : Type*} [Field K] [CharZero K] : Prop :=
  ∀ d b : ℕ, d ≤ b →
    (∏ j ∈ Finset.range d, (1+(2 : K)^((j : ℤ)+1-(b : ℤ)))) *
      (∏ j ∈ Finset.range (b-d), (1+(2 : K)^j)) =
    ((2 : K)^(2*d+d.choose 2)/(2 : K)^(d*(b+1))) *
      (∏ j ∈ Finset.range b, (1+(2 : K)^j))

def ExtensionNonzero {K : Type*} [Field K] [CharZero K] : Prop :=
  ∀ b : ℕ, (∏ j ∈ Finset.range b, (1+(2 : K)^j)) ≠ 0

def MomentNonzero {K : Type*} [Field K] [CharZero K] : Prop :=
  ∀ a b : ℕ, (∏ j ∈ Finset.range b, ((2 : K)^a+(2 : K)^j)) ≠ 0

def Split {K : Type*} [Field K] [CharZero K] : Prop :=
  ∀ a d b : ℕ,
    (∏ j ∈ Finset.range (a+d), (1+(2 : K)^((j : ℤ)+1-(b : ℤ)))) =
      (∏ j ∈ Finset.range d, (1+(2 : K)^((j : ℤ)+1-(b : ℤ)))) *
      (∏ j ∈ Finset.range a, (1+(2 : K)^j*((2 : K)^(d+2)/(2 : K)^(b+1))))

def BeforeDivision {K : Type*} [Field K] [CharZero K] : Prop :=
  ∀ a d b : ℕ, d ≤ b →
    (∑ r ∈ Finset.range (a+1),
      (Nat.card {U : Submodule (ZMod 2) (Fin a → ZMod 2) //
        Module.finrank (ZMod 2) U = r} : K) *
      ((2 : K)^(2*(d+r)+(d+r).choose 2)/(2 : K)^((d+r)*(b+1)))) *
        (∏ j ∈ Finset.range b, ((2 : K)^(a+d)+(2 : K)^j)) =
      (∏ j ∈ Finset.range (a+d), (1+(2 : K)^(j+1))) *
        (∏ j ∈ Finset.range (b-d), (1+(2 : K)^j))

def Normalization {K : Type*} [Field K] [CharZero K] : Prop :=
  ∀ n d k : ℕ, d ≤ n → d < k →
    (∑ r ∈ Finset.range (n-d+1),
      (Nat.card {U : Submodule (ZMod 2) (Fin (n-d) → ZMod 2) //
        Module.finrank (ZMod 2) U = r} : K) *
      ((2 : K)^(2*(d+r)+(d+r).choose 2)/(2 : K)^((d+r)*k))) =
      ((2 : K)^n*(∏ j ∈ Finset.range n, (1+(2 : K)^(j+1)))) /
        ((2 : K)^n*(∏ j ∈ Finset.range (k-1), ((2 : K)^n+(2 : K)^j))) *
          (∏ j ∈ Finset.range (k-d-1), (1+(2 : K)^j))

