def Concat (R : Type u) [CommRing R] : Prop := ∀ (z : R) (m a : ℕ),
  (∏ j ∈ Finset.range (m+a), (z-(2:R)^j*1)) =
    (∏ j ∈ Finset.range m, (z-(2:R)^j*1)) *
    (∏ j ∈ Finset.range a, (z-(2:R)^j*(2:R)^m))
def Paired (R : Type u) [CommRing R] : Prop := ∀ (s : ℕ) (z : R),
  (∏ j ∈ Finset.range (s+1), (z-(2:R)^j*1)) *
    (∏ j ∈ Finset.range s, (z+(2:R)^j*2)) =
      (z-1) * ∏ j ∈ Finset.range s, (z^2-(4:R)^(j+1))
def Increment (R : Type u) [CommRing R] : Prop := ∀ (s : ℕ) (z : R),
  (z-1) * (∏ j ∈ Finset.range s, (z^2-(4:R)^(j+1))) * (z+(4:R)^(s+1)) =
    ∑ a ∈ Finset.range (s+2),
      ((binaryGaussian (s+1) a:R) * (∏ j ∈ Finset.range (s+1-a), ((2:R)^(s+1)+(2:R)^j*2)) +
       ((4:R)^(s+1)-(2:R)^(s+1)) * (binaryGaussian s a:R) *
       (∏ j ∈ Finset.range (s-a), ((2:R)^(s+1)+(2:R)^j*2))) *
      (∏ j ∈ Finset.range (s+1+a), (z-(2:R)^j*1))
