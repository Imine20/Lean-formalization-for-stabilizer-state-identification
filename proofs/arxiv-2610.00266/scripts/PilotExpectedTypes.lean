namespace MixedMomentExpected
open scoped BigOperators
open Classical ExactCriticalCurve ExactCriticalCurve.Binary ExactCriticalCurve.Quantum

def SignedSwitch : Prop :=
  ∀ {k : ℕ} (m : Fin k → Bool) (p : BinaryVector k × BinaryVector k),
    ((∑ i, if m i then -bitLift (if m i then p.2 i else p.1 i)
      else bitLift (if m i then p.2 i else p.1 i)) -
      (∑ i, if m i then -bitLift (if m i then p.1 i else p.2 i)
      else bitLift (if m i then p.1 i else p.2 i)) : ZMod 4) =
      (∑ i, bitLift (p.1 i)) - ∑ i, bitLift (p.2 i)

def SubspaceMembership : Prop :=
  ∀ {k : ℕ} (m : Fin k → Bool)
    (T : Submodule (ZMod 2) (BinaryVector k × BinaryVector k)) (p : BinaryVector k × BinaryVector k),
    p ∈ T.map (signatureSwitch m).toLinearMap ↔ signatureSwitch m p ∈ T

def SubspaceRank : Prop :=
  ∀ {k : ℕ} (m : Fin k → Bool) (T : Submodule (ZMod 2) (BinaryVector k × BinaryVector k)),
    Module.finrank (ZMod 2) (T.map (signatureSwitch m).toLinearMap) = Module.finrank (ZMod 2) T

def IndexFamilyCarrier : Prop :=
  ∀ {k : ℕ} (m : Fin k → Bool) (T : StochasticLagrangian k),
    (signedStochasticLagrangianEquiv m T).carrier = T.carrier.map (signatureSwitch m).toLinearMap

def FixedDiagonal : Prop :=
  ∀ {k : ℕ} (m : Fin k → Bool) (T : Submodule (ZMod 2) (BinaryVector k × BinaryVector k))
    (x : BinaryVector k), (x,x) ∈ T.map (signatureSwitch m).toLinearMap ↔ (x,x) ∈ T

def RelationTranspose : Prop :=
  ∀ {k : ℕ} (n : ℕ) (m : Fin k → Bool)
    (T : Submodule (ZMod 2) (BinaryVector k × BinaryVector k)),
    (fun X Y : ColumnConfig n k => ∏ a,
      if ((fun i => if m i then Y a i else X a i),
        (fun i => if m i then X a i else Y a i)) ∈ T then (1 : ℂ) else 0) =
    (fun X Y : ColumnConfig n k => ∏ a,
      if (X a,Y a) ∈ T.map (signatureSwitch m).toLinearMap then (1 : ℂ) else 0)

def RankOneTranspose : Prop :=
  ∀ {n k : ℕ} (m : Fin k → Bool) (v : BinaryVector n → ℂ),
    partialTransposeColumns n m
      ((matrixTensorPower k (Matrix.vecMulVec v (star v))).submatrix
        (copyColumnsEquiv n k).symm (copyColumnsEquiv n k).symm) =
      (Matrix.vecMulVec
        (fun X : CopyConfig n k => ∏ i, if m i then star (v (X i)) else v (X i))
        (star (fun X : CopyConfig n k => ∏ i, if m i then star (v (X i)) else v (X i)))).submatrix
        (copyColumnsEquiv n k).symm (copyColumnsEquiv n k).symm

def RayIndependence : Prop :=
  ∀ {n k : ℕ} (m : Fin k → Bool) (v w : BinaryVector n → ℂ),
    Matrix.vecMulVec v (star v) = Matrix.vecMulVec w (star w) →
      Matrix.vecMulVec
        (fun X : CopyConfig n k => ∏ i, if m i then star (v (X i)) else v (X i))
        (star (fun X : CopyConfig n k => ∏ i, if m i then star (v (X i)) else v (X i))) =
      Matrix.vecMulVec
        (fun X : CopyConfig n k => ∏ i, if m i then star (w (X i)) else w (X i))
        (star (fun X : CopyConfig n k => ∏ i, if m i then star (w (X i)) else w (X i)))

def ActualMixedMoment : Prop :=
  ∀ {k : ℕ} (n : ℕ) (m : Fin k → Bool), 1 ≤ k →
    (((Fintype.card (StabilizerGroup n) : ℂ)⁻¹ •
      ∑ S : StabilizerGroup n, Matrix.vecMulVec
        (fun X : CopyConfig n k => ∏ i, if m i then star (stabilizerVector S (X i)) else stabilizerVector S (X i))
        (star (fun X : CopyConfig n k => ∏ i, if m i then star (stabilizerVector S (X i)) else stabilizerVector S (X i)))).submatrix
          (copyColumnsEquiv n k).symm (copyColumnsEquiv n k).symm) =
      (((2 : ℂ)^n * ∏ j ∈ Finset.range (k-1), ((2 : ℂ)^n+(2 : ℂ)^j))⁻¹) •
      ∑ T : SignedStochasticLagrangian m,
        (fun X Y : ColumnConfig n k => ∏ a, if (X a,Y a) ∈ T.carrier then (1 : ℂ) else 0)

def TracePreservation : Prop :=
  ∀ {n k : ℕ} (m : Fin k → Bool) (A : Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ),
    Matrix.trace (fun X Y : ColumnConfig n k =>
      A (fun a i => if m i then Y a i else X a i)
        (fun a i => if m i then X a i else Y a i)) = Matrix.trace A

