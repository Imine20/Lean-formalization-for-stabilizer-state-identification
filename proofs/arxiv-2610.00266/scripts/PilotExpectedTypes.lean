namespace PositiveSumRangesExpected
open ExactCriticalCurve Matrix Classical
open scoped BigOperators ComplexOrder MatrixOrder

def KernelDomination {ι : Type*} [Fintype ι] : Prop :=
  ∀ (A P : Matrix ι ι ℂ), P.PosSemidef → (A-P).PosSemidef →
    LinearMap.ker A.mulVecLin ≤ LinearMap.ker P.mulVecLin

def SumZero {ι : Type*} [Fintype ι] {α : Type*} [Fintype α] : Prop :=
  ∀ (F : α → Matrix ι ι ℂ), (∀ t, (F t).PosSemidef) → ∀ x : ι → ℂ,
    (∑ t, F t) *ᵥ x = 0 ↔ ∀ t, F t *ᵥ x = 0

def SumKernel {ι : Type*} [Fintype ι] {α : Type*} [Fintype α] : Prop :=
  ∀ (F : α → Matrix ι ι ℂ), (∀ t, (F t).PosSemidef) →
    LinearMap.ker (∑ t, F t).mulVecLin = ⨅ t, LinearMap.ker (F t).mulVecLin

def RectangularZero {ι : Type*} [Fintype ι] {α κ : Type*} [Fintype α] : Prop :=
  ∀ (F : α → Matrix ι ι ℂ), (∀ t, (F t).PosSemidef) → ∀ C : Matrix ι κ ℂ,
    (∑ t, F t) * C = 0 ↔ ∀ t, F t * C = 0

def SumRangeBound {ι : Type*} [Fintype ι] {α : Type*} [Fintype α] : Prop :=
  ∀ F : α → Matrix ι ι ℂ,
    LinearMap.range (∑ t, F t).mulVecLin ≤ ⨆ t, LinearMap.range (F t).mulVecLin

def SumRange {ι : Type*} [Fintype ι] {α : Type*} [Fintype α] : Prop :=
  ∀ (F : α → Matrix ι ι ℂ), (∀ t, (F t).PosSemidef) →
    LinearMap.range (∑ t, F t).mulVecLin = ⨆ t, LinearMap.range (F t).mulVecLin

def CompressionRange {ι : Type*} [Fintype ι] : Prop :=
  ∀ B P : Matrix ι ι ℂ, P.IsHermitian → P*P=P →
    LinearMap.range (B*P*Bᴴ).mulVecLin = (LinearMap.range P.mulVecLin).map B.mulVecLin

def FamilyCompressionRange {ι : Type*} [Fintype ι] {α : Type*} [Fintype α] : Prop :=
  ∀ (B : Matrix ι ι ℂ) (F : α → Matrix ι ι ℂ),
    (∀ t, (F t).PosSemidef) → (∀ t, F t * F t = F t) →
    LinearMap.range (∑ t, B*F t*Bᴴ).mulVecLin =
      (⨆ t, LinearMap.range (F t).mulVecLin).map B.mulVecLin

def InvariantImage {ι : Type*} [Fintype ι] : Prop :=
  ∀ P : Matrix ι ι ℂ, P*P=P → ∀ W : Submodule ℂ (ι → ℂ),
    (∀ x, x ∈ W → P *ᵥ x ∈ W) →
    W.map P.mulVecLin = W ⊓ LinearMap.range P.mulVecLin

