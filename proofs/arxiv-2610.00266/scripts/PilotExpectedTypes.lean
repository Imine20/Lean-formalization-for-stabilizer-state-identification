namespace DefectProductExpected
open ExactCriticalCurve.Binary ExactCriticalCurve.Quantum Matrix

def SumQuadratic : Prop :=
  ∀ {k : ℕ} {U N : Submodule (ZMod 2) (Fin k → ZMod 2)},
    (∀ x ∈ U, (∑ i, ((x i).val : ZMod 4)) = 0) →
    (∀ x ∈ N, (∑ i, ((x i).val : ZMod 4)) = 0) →
    U ≤ orthogonal N →
    ∀ x ∈ U ⊔ N, (∑ i, ((x i).val : ZMod 4)) = 0

def MiddleExists : Prop :=
  ∀ {k : ℕ} {U N : Submodule (ZMod 2) (Fin k → ZMod 2)},
    (∀ x ∈ U, (∑ i, ((x i).val : ZMod 4)) = 0) →
    (∀ x ∈ N, (∑ i, ((x i).val : ZMod 4)) = 0) →
    U ≤ orthogonal N →
    ∀ x y : Fin k → ZMod 2,
      (∃ z, (x,z) ∈ defectRelation U ∧ (z,y) ∈ defectRelation N) ↔
        (x,y) ∈ defectRelation (U ⊔ N)

def MiddleUnique : Prop :=
  ∀ {k : ℕ} {U N : Submodule (ZMod 2) (Fin k → ZMod 2)}, Disjoint U N →
    ∀ {x y z w : Fin k → ZMod 2},
    (x,z) ∈ defectRelation U → (z,y) ∈ defectRelation N →
    (x,w) ∈ defectRelation U → (w,y) ∈ defectRelation N → z = w

def SumCardinality : Prop :=
  ∀ {k : ℕ} (U N : Submodule (ZMod 2) (Fin k → ZMod 2)), Disjoint U N →
    Nat.card (U ⊔ N : Submodule (ZMod 2) (Fin k → ZMod 2)) = Nat.card U * Nat.card N

def RelationProduct : Prop :=
  ∀ {k : ℕ} (U N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    (∀ x ∈ U, (∑ i, ((x i).val : ZMod 4)) = 0) →
    (∀ x ∈ N, (∑ i, ((x i).val : ZMod 4)) = 0) →
    U ≤ orthogonal N → Disjoint U N →
    (fun x y => ∑ z : Fin k → ZMod 2,
      (@ite ℂ ((x,z) ∈ defectRelation U) (Classical.propDecidable _) 1 0) *
      (@ite ℂ ((z,y) ∈ defectRelation N) (Classical.propDecidable _) 1 0)) =
    (fun x y => @ite ℂ ((x,y) ∈ defectRelation (U ⊔ N)) (Classical.propDecidable _) 1 0)

def ProjectionProduct : Prop :=
  ∀ {k : ℕ} (n : ℕ) (U N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    (∀ x ∈ U, (∑ i, ((x i).val : ZMod 4)) = 0) →
    (∀ x ∈ N, (∑ i, ((x i).val : ZMod 4)) = 0) →
    U ≤ orthogonal N → Disjoint U N →
    (cssColumnSynthesis n U * (cssColumnSynthesis n U)ᴴ) *
      (cssColumnSynthesis n N * (cssColumnSynthesis n N)ᴴ) =
