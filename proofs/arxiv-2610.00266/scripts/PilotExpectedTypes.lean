  (hU : ∀ x ∈ U, Q x = 0) (hRad : ∀ u ∈ U, ∀ v : V, Q (u+v)-Q u-Q v=0)
  (x : V), quotientForm Q U hU hRad (Submodule.Quotient.mk x) = Q x

def QuotientNondegenerate : Prop :=
  ∀ (Q : QuadraticForm (ZMod 2) V) (U : Submodule (ZMod 2) V)
  (hU : ∀ x ∈ U, Q x = 0) (hRad : ∀ u ∈ U, ∀ v : V, Q (u+v)-Q u-Q v=0),
  (∀ x : V, (∀ y : V, Q (x+y)-Q x-Q y=0) → x ∈ U) →
