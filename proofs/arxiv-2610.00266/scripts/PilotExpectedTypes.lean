namespace GNWCoefficientsExpected
open ExactCriticalCurve.Counting

def ChooseTwoAdd : Prop :=
  ∀ d r : ℕ, (d + r).choose 2 = d.choose 2 + r.choose 2 + d * r

def WeightCoefficients {K : Type*} [Field K] [CharZero K] : Prop :=
  ∀ m k : ℕ, (2 : K) ^ (2 * m + m.choose 2) / (2 : K) ^ (m * k) =
    ((4 : K)^m * (2 : K)^(m.choose 2)) / ((2 : K)^m)^k

def WeightAdd {K : Type*} [Field K] [CharZero K] : Prop :=
  ∀ d r k : ℕ,
    (2 : K) ^ (2 * (d + r) + (d + r).choose 2) / (2 : K) ^ ((d + r) * k) =
      ((2 : K) ^ (2 * d + d.choose 2) / (2 : K) ^ (d * k)) *
        (2 : K) ^ (r.choose 2) * ((2 : K) ^ (d + 2) / (2 : K)^k)^r

def WeightedActualSubspaces {K : Type*} [Field K] [CharZero K] : Prop :=
  ∀ a d k : ℕ,
    (∑ r ∈ Finset.range (a + 1),
      (Nat.card {U : Submodule (ZMod 2) (Fin a → ZMod 2) //
        Module.finrank (ZMod 2) U = r} : K) *
        ((2 : K) ^ (2 * (d + r) + (d + r).choose 2) /
          (2 : K) ^ ((d + r) * k))) =
    ((2 : K) ^ (2 * d + d.choose 2) / (2 : K) ^ (d * k)) *
      ∏ j ∈ Finset.range a, (1 + (2 : K)^j * ((2 : K)^(d+2)/(2 : K)^k))

def ShiftedStep {K : Type*} [Field K] [CharZero K] : Prop :=
  ∀ a b : ℕ,
    (∏ j ∈ Finset.range a, (1 + (2 : K)^((j : ℤ)+1-((b+1 : ℕ) : ℤ)))) *
      (1 + (2 : K)^((a : ℤ)-(b : ℤ))) =
    (1 + (2 : K)^(-(b : ℤ))) *
      ∏ j ∈ Finset.range a, (1 + (2 : K)^((j : ℤ)+1-(b : ℤ)))

def MomentFactor {K : Type*} [Field K] [CharZero K] : Prop :=
  ∀ a b : ℕ, (2 : K)^a + (2 : K)^b =
    (2 : K)^b * (1 + (2 : K)^((a : ℤ)-(b : ℤ)))

def NegativeFactor {K : Type*} [Field K] [CharZero K] : Prop :=
  ∀ b : ℕ, (2 : K)^b * (1 + (2 : K)^(-(b : ℤ))) = 1 + (2 : K)^b

def RectangularProduct {K : Type*} [Field K] [CharZero K] : Prop :=
  ∀ a b : ℕ,
    (∏ j ∈ Finset.range a, (1 + (2 : K)^((j : ℤ)+1-(b : ℤ)))) *
      (∏ j ∈ Finset.range b, ((2 : K)^a + (2 : K)^j)) =
    (∏ j ∈ Finset.range a, (1 + (2 : K)^(j+1))) *
      (∏ j ∈ Finset.range b, (1 + (2 : K)^j))

