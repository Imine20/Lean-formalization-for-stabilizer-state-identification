namespace RefinementExpected
open ExactCriticalCurve.Quantum ExactCriticalCurve.Binary Matrix

def RawRefinementData {n : ℕ} (L : Submodule (ZMod 2) (Fin n → ZMod 2)) :=
  {d : LinearMap.BilinForm (ZMod 2) L × (L → ZMod 4) //
    (∀ t u, d.1 t u = d.1 u t) ∧ d.2 0 = 0 ∧
    ∀ t u, d.2 (t + u) = d.2 t + d.2 u + 2 * ((d.1 t u).val : ZMod 4)}

def refinementDataEquiv {n : ℕ} (L : Submodule (ZMod 2) (Fin n → ZMod 2)) :
    StabilizerPhaseData L ≃ RawRefinementData L where
  toFun q := ⟨(q.polar, q.phase), q.polar_symm, q.phase_zero, q.phase_add⟩
  invFun q := ⟨q.val.1, q.property.1, q.val.2, q.property.2.1, q.property.2.2⟩
  left_inv q := by cases q; rfl
  right_inv q := by cases q; rfl

theorem phaseClockSpace_expanded {n : ℕ}
    {L : Submodule (ZMod 2) (Fin n → ZMod 2)} (q : StabilizerPhaseData L)
    (p : L × (Fin n → ZMod 2)) :
    p ∈ phaseClockSpace q ↔ ∀ u : L, (∑ i, p.2 i * u.val i) = q.polar p.1 u := by
  constructor
  · intro h u
    exact congrArg (fun f : Module.Dual (ZMod 2) L => f u) h
  · intro h
    apply LinearMap.ext
    exact h

theorem phasePauliLabel_expanded {n : ℕ}
    {L : Submodule (ZMod 2) (Fin n → ZMod 2)} (a : Fin n → ZMod 2)
    (q : StabilizerPhaseData L) (p : phaseClockSpace q) :
    phasePauliLabel a q p =
      ⟨q.phase p.val.1 - 2 * ((∑ i, p.val.2 i * a i : ZMod 2).val : ZMod 4),
        p.val.1.val, p.val.2⟩ := rfl

theorem phaseStabilizerRange_expanded {n : ℕ}
    {L : Submodule (ZMod 2) (Fin n → ZMod 2)} (a : Fin n → ZMod 2)
    (q : StabilizerPhaseData L) :
    (phaseStabilizer a q).carrier = (MonoidHom.range (G := Multiplicative (phaseClockSpace q)) (N := PauliLabel n) (phasePauliHom a q)) := rfl

def PhaseTranslationAmplitude : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (a : Fin n → ZMod 2)
    (t : stabilizerTranslationSpace S),
    stabilizerVector S (a + t.val) =
      Complex.I ^ (stabilizerPhase S a t).val * stabilizerVector S a

def PhaseLiftIndependence : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (a : Fin n → ZMod 2),
    stabilizerVector S a ≠ 0 → ∀ (t : stabilizerTranslationSpace S) (g : S.carrier),
    g.val.shift = t.val →
      stabilizerPhase S a t =
        g.val.phase + 2 * ((∑ i, g.val.clock i * a i : ZMod 2).val : ZMod 4)

def StabilizerPhaseZero : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (a : Fin n → ZMod 2),
    stabilizerVector S a ≠ 0 → stabilizerPhase S a 0 = 0

def StabilizerPhaseCocycle : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (a : Fin n → ZMod 2),
    stabilizerVector S a ≠ 0 → ∀ t u : stabilizerTranslationSpace S,
    stabilizerPhase S a (t + u) = stabilizerPhase S a t + stabilizerPhase S a u +
      2 * ((∑ i, (stabilizerShiftLift S t).val.clock i * u.val i : ZMod 2).val : ZMod 4)

def StabilizerLiftPairingSymmetric : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (t u : stabilizerTranslationSpace S),
    (∑ i, (stabilizerShiftLift S t).val.clock i * u.val i) =
      (∑ i, (stabilizerShiftLift S u).val.clock i * t.val i : ZMod 2)

def StabilizerPhaseDiagonal : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (a : Fin n → ZMod 2),
    stabilizerVector S a ≠ 0 → ∀ t : stabilizerTranslationSpace S,
    2 * stabilizerPhase S a t =
      2 * ((∑ i, (stabilizerShiftLift S t).val.clock i * t.val i : ZMod 2).val : ZMod 4)

def StabilizerActualPairing : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (t u : stabilizerTranslationSpace S),
    stabilizerPairing S t u =
      (∑ i, (stabilizerShiftLift S t).val.clock i * u.val i : ZMod 2)

def StabilizerPairingSymmetric : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (t u : stabilizerTranslationSpace S),
    stabilizerPairing S t u = stabilizerPairing S u t

def RefinementDiagonal : Prop :=
  ∀ {n : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (q : StabilizerPhaseData L) (t : L),
    2 * q.phase t = 2 * ((q.polar t t).val : ZMod 4)

def ClockCoordinates : Prop :=
  ∀ {n : ℕ} (L : Submodule (ZMod 2) (Fin n → ZMod 2))
    (b : Fin n → ZMod 2) (u : L),
    clockRestriction L b u = (∑ i, b i * u.val i : ZMod 2)

def ClockOntoTrueDual : Prop :=
  ∀ {n : ℕ} (L : Submodule (ZMod 2) (Fin n → ZMod 2)),
    Function.Surjective (clockRestriction L)

def ClockTrueKernel : Prop :=
  ∀ {n : ℕ} (L : Submodule (ZMod 2) (Fin n → ZMod 2)),
    LinearMap.ker (clockRestriction L) =
      LinearMap.BilinForm.orthogonal
        (dotProductBilin (ZMod 2) (ZMod 2) :
          LinearMap.BilinForm (ZMod 2) (Fin n → ZMod 2)) L

def CompatibleTranslationOnto : Prop :=
  ∀ {n : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (q : StabilizerPhaseData L), Function.Surjective (phaseClockTranslation q)

def CompatibleSpaceDimension : Prop :=
  ∀ {n : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (q : StabilizerPhaseData L), Module.finrank (ZMod 2) (phaseClockSpace q) = n

def CompatibleSpaceCardinality : Prop :=
  ∀ {n : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (q : StabilizerPhaseData L), Nat.card (phaseClockSpace q) = 2 ^ n

def PhaseLabelMultiplication : Prop :=
  ∀ {n : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (a : Fin n → ZMod 2) (q : StabilizerPhaseData L) (p s : phaseClockSpace q),
    phasePauliLabel a q (p + s) = phasePauliLabel a q p * phasePauliLabel a q s

def PhaseLabelIdentity : Prop :=
  ∀ {n : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (a : Fin n → ZMod 2) (q : StabilizerPhaseData L), phasePauliLabel a q 0 = 1

def PhaseLabelFaithful : Prop :=
  ∀ {n : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (a : Fin n → ZMod 2) (q : StabilizerPhaseData L),
    Function.Injective (phasePauliLabel a q)

def PhaseHomFaithful : Prop :=
  ∀ {n : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (a : Fin n → ZMod 2) (q : StabilizerPhaseData L),
    Function.Injective (phasePauliHom a q)

def PhaseRangeScalarFree : Prop :=
  ∀ {n : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (a : Fin n → ZMod 2) (q : StabilizerPhaseData L),
    ∀ g : PauliLabel n, g ∈ (MonoidHom.range (G := Multiplicative (phaseClockSpace q)) (N := PauliLabel n) (phasePauliHom a q)) → g.shift = 0 → g.clock = 0 → g.phase = 0

def PhaseRangeCardinality : Prop :=
  ∀ {n : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (a : Fin n → ZMod 2) (q : StabilizerPhaseData L),
    Nat.card (MonoidHom.range (G := Multiplicative (phaseClockSpace q)) (N := PauliLabel n) (phasePauliHom a q)) = 2 ^ n

def PhaseStabilizerMembership : Prop :=
  ∀ {n : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (a : Fin n → ZMod 2) (q : StabilizerPhaseData L) (g : PauliLabel n),
    g ∈ (phaseStabilizer a q).carrier ↔
      ∃ t : L, g.shift = t.val ∧ clockRestriction L g.clock = q.polar t ∧
        g.phase + 2 * ((∑ i, g.clock i * a i : ZMod 2).val : ZMod 4) = q.phase t

end RefinementExpected

