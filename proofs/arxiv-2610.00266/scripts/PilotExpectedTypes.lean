/- Frozen independent physical critical-window expected statements. -/
namespace PhysicalDCTAuditDriver
set_option maxHeartbeats 20000000
open Lean Elab Command Meta in
def auditExactTheorem (actual expected : Name) : CommandElabM Unit := do
  let env ← getEnv
  match env.find? actual with
  | some (.thmInfo _) => pure ()
  | _ => throwError "Expected a theorem declaration: {actual}"
  liftTermElabM do
    let actualInfo ← getConstInfo actual
    let expectedInfo ← getConstInfo expected
    unless actualInfo.levelParams.length == expectedInfo.levelParams.length do
      throwError "Universe generality mismatch: {actual}"
    let levelParams := (List.range actualInfo.levelParams.length).map
      (fun i => Name.mkSimple ("auditUniverse" ++ toString i))
    let levels := levelParams.map Level.param
    let term := mkConst actual levels
    let expectedTerm := mkConst expected levels
    let expectedType ← inferType expectedTerm
    -- Abstract all universe-polymorphic typeclass and index parameters on expected definitions.
    let expectedValue ← forallTelescope expectedType fun args _ => do
      let body := mkAppN expectedTerm args
      mkForallFVars args body
    unless ← isDefEq (← inferType term) expectedValue do
      throwError "Exact theorem type mismatch: {actual}\nactual: {← inferType term}\nexpected: {expectedValue}"
    -- Check both the theorem constant and its original proof body directly in
    -- the kernel against the independently constructed expected type.
    -- addDeclCore has no skipKernelTC option and returns synchronously.
    let kernelEnv := (← getEnv).toKernelEnv
    let heartbeatLimit := (Core.getMaxHeartbeats (← getOptions)).toUSize
    for (label, proof) in #[
        ("constant", term),
        ("body", actualInfo.instantiateValueLevelParams! levels)] do
      let witnessName ← mkFreshUserName (Name.mkSimple ("kernelAudit_" ++ label))
      let decl : Declaration := .thmDecl {
        name := witnessName
        levelParams := levelParams
        type := expectedValue
        value := proof
      }
      let _ ← ofExceptKernelException <|
        Kernel.Environment.addDeclCore kernelEnv heartbeatLimit decl none
      logInfo m!"KERNEL_EXPECTED_TYPE_OK {label} {actual}"
  let axioms ← collectAxioms actual
  for ax in axioms do
    unless #[`propext, `Classical.choice, `Quot.sound].contains ax do
      throwError "Forbidden transitive axiom {ax} in {actual}"
  logInfo m!"EXACT_TYPE_AND_AXIOMS_OK {actual}"





open Lean Elab Command Meta in
def auditCSSStageConstant (actual expected : Name) : CommandElabM Unit := do
  liftTermElabM do
    let info ← getConstInfo actual
    let ei ← getConstInfo expected
    unless info.levelParams.length == ei.levelParams.length do
      throwError "Definition universe mismatch {actual}"
    let levelParams := (List.range info.levelParams.length).map
      (fun i => Name.mkSimple ("auditUniverse" ++ toString i))
    let levels := levelParams.map Level.param
    let value := mkConst actual levels
    let et := mkConst expected levels
    let etype ← inferType et
    let expectedValue ← forallTelescope etype fun args _ => do
      mkForallFVars args (mkAppN et args)
    unless ← isDefEq (← inferType value) expectedValue do
      throwError "Independent constant type mismatch {actual}\nactual: {← inferType value}\nexpected: {expectedValue}"
    let kernelEnv := (← getEnv).toKernelEnv
    let limit := (Core.getMaxHeartbeats (← getOptions)).toUSize
    let mut terms := #[("constant",value)]
    if info.value?.isSome then
      terms := terms.push ("body",info.instantiateValueLevelParams! levels)
    for (label, term) in terms do
      let name ← mkFreshUserName (Name.mkSimple ("definitionAudit_" ++ label))
      let decl : Declaration := .defnDecl {
        name := name, levelParams := levelParams, type := expectedValue, value := term,
        hints := .opaque, safety := .safe
      }
      let _ ← ofExceptKernelException <| Kernel.Environment.addDeclCore kernelEnv limit decl none
      logInfo m!"KERNEL_EXPECTED_DEFINITION_OK {label} {actual}"
open Lean Elab Command in
def resolveModFourPrivate (suffix : String) : CommandElabM Name := do
 let env ← getEnv
 let names := env.constants.toList.filterMap fun (nm,_) =>
   if nm.toString.endsWith suffix then some nm else none
 if names.length != 1 then throwError "Private name resolution is not unique: {suffix}"
 pure names.head!


namespace PhysicalExpected
open Classical Matrix Module Filter
open ExactCriticalCurve.Asymptotics ExactCriticalCurve.Binary ExactCriticalCurve.Quantum
open scoped BigOperators Topology
def A : ℝ := ∏' j : ℕ, (1+(1/2:ℝ)^(j+1))
def Q : ℝ := ∏' j : ℕ, (1-(1/4:ℝ)^(j+1))
def AP (n : ℕ) : ℝ := ∏j∈Finset.range n,(1+(1/2:ℝ)^(j+1))
def Phi (u : ℝ) : ℝ := (2:ℝ)^(-(u^2+3*u+4)/2)
def F (r : ℕ) (x : ℝ) : ℝ :=
 (2:ℝ)^((r:ℝ)*((r:ℝ)-1))/(∏j∈Finset.range r,((2:ℝ)^(j+1)-1))*
   ∏j∈Finset.range r,(x+(2:ℝ)^(1-(j:ℝ)))
def R (c : ℤ) : ℝ := if c≤1 then AP (1-c).toNat else (∏j∈Finset.range (c-1).toNat,(1+(2:ℝ)^j))⁻¹
def L0 (c : ℤ) : ℝ := (2:ℝ)^(((c:ℝ)-1)*((c:ℝ)-2)/2+1)*Q*R c
def L (c : ℤ) (r : ℕ) : ℝ := L0 c*F r ((2:ℝ)^(3-(c:ℝ)))
def W (c : ℤ) (r : ℕ) : ℝ :=
 (Phi (2*(r:ℝ)-(c:ℝ))*(1+(2:ℝ)^(-(2*(r:ℝ)-(c:ℝ))-2)))/(A*Q)
def OW (n k r : ℕ) : ℝ :=
 (finrank ℂ (LinearMap.range (ordinaryCSSGrade n k r).mulVecLin):ℝ)/
   (Nat.card (StabilizerGroup n):ℝ)
def Scale (n k : ℕ) : ℝ :=
 (Fintype.card (StabilizerGroup n):ℝ)/((2:ℝ)^n*∏j∈Finset.range (k-1),((2:ℝ)^n+(2:ℝ)^j))
def OV (n k r : ℕ) : ℝ := if Nonempty (OrdinaryDefect k r) then
 Scale n k*(ordinarySectorScalarPolynomial k r).eval ((2:ℝ)^n) else 0
def SW (n k : ℕ) (a : PhysicalSectorLabel k) : ℝ :=
 (finrank ℂ (LinearMap.range (physicalSectorGrade n k a).mulVecLin):ℝ)/
   (Fintype.card (StabilizerGroup n):ℝ)
def SV (n k : ℕ) (a : PhysicalSectorLabel k) : ℝ :=
 Scale n k*(physicalSectorScalarPolynomial k a).eval ((2:ℝ)^n)
def EM (n k : ℕ) : ℝ :=
 ∑r:{r:Fin (k+1)//Nonempty (ExceptionalDefect k r.val)},SW n k (.inr r)*SV n k (.inr r)
def EA (n k : ℕ) : ℝ :=
 ∑r:{r:Fin (k+1)//Nonempty (ExceptionalDefect k r.val)},SW n k (.inr r)*Real.sqrt (SV n k (.inr r))
def FiniteP (n k : ℕ) : ℝ :=
 (∑a:PhysicalSectorLabel k,SW n k a*Real.sqrt (SV n k a))^2
example (n k r : ℕ) : physicalOrdinaryWeight n k r=OW n k r := rfl
example (n k r : ℕ) : physicalOrdinaryValue n k r=OV n k r := rfl
example (n k : ℕ) : physicalExceptionalMoment n k=EM n k := rfl
example (n k : ℕ) : physicalExceptionalAmplitude n k=EA n k := rfl
example (n k : ℕ) : physicalFiniteSuccess n k=FiniteP n k := rfl
example (c : ℤ) : criticalCurve c=(∑'r:ℕ,W c r*Real.sqrt (L c r))^2 := rfl

def E_physicalOrdinaryWeight (n k r : ℕ) := ℝ
def E_physicalOrdinaryValue (n k r : ℕ) := ℝ
def E_physicalExceptionalMoment (n k : ℕ) := ℝ
def E_physicalExceptionalAmplitude (n k : ℕ) := ℝ
def E_physicalOrdinaryWeight_nonneg (n k r : ℕ) := 0≤OW n k r
def E_physicalOrdinaryValue_nonneg (n k r : ℕ) := 0≤OV n k r
def E_physicalOrdinaryWeight_eq_zero (n : ℕ) {k r : ℕ} :=
 ¬Nonempty (OrdinaryDefect k r) → OW n k r=0
def E_physicalOrdinaryWeight_eq_zero_of_gt (n : ℕ) {k r : ℕ} := k<r → OW n k r=0
def E_physicalOrdinaryWeight_eq_sector (n k : ℕ)
 (r:{r:Fin (k+1)//Nonempty (OrdinaryDefect k r.val)}) := OW n k r.val.val=SW n k (.inl r)
def E_physicalOrdinaryValue_eq_sector (n k : ℕ)
 (r:{r:Fin (k+1)//Nonempty (OrdinaryDefect k r.val)}) := OV n k r.val.val=SV n k (.inl r)
def E_physicalOrdinary_sum_reindex (n k : ℕ) (f : ℝ→ℝ) :=
 (∑r:{r:Fin (k+1)//Nonempty (OrdinaryDefect k r.val)},SW n k (.inl r)*f (SV n k (.inl r)))=
 ∑'r:ℕ,OW n k r*f (OV n k r)
def E_physicalFiniteSuccess_eq_ordinary_exceptional (n k : ℕ) :=
 FiniteP n k=((∑'r:ℕ,OW n k r*Real.sqrt (OV n k r))+EA n k)^2
def E_physicalOrdinary_moment_add_exceptional (n : ℕ) {k : ℕ} :=
 0<k → (∑'r:ℕ,OW n k r*OV n k r)+EM n k=1
def E_physicalExceptionalMoment_nonneg (n k : ℕ) := 0≤EM n k
def E_physicalExceptionalAmplitude_nonneg (n k : ℕ) := 0≤EA n k

def E_ordinaryDefect_nonempty_of_large_copy {k r : ℕ} :=
 2*r+4≤k → Nonempty (OrdinaryDefect k r)
def E_eventually_physicalCritical_copy_ge (c : ℤ) (K : ℕ) :=
 ∀ᶠn:ℕ in atTop,K≤((n:ℤ)+c).toNat
def E_eventually_physicalCritical_ordinary_nonempty (c : ℤ) (r : ℕ) :=
 ∀ᶠn:ℕ in atTop,Nonempty (OrdinaryDefect ((n:ℤ)+c).toNat r)
def E_eventually_physicalCritical_window_exact (c : ℤ) :=
 ∀ᶠn:ℕ in atTop,(((n:ℤ)+c).toNat:ℤ)=(n:ℤ)+c
def E_eventually_physicalOrdinaryValue_eq_raw (c : ℤ) (r : ℕ) :=
 ∀ᶠn:ℕ in atTop,OV n ((n:ℤ)+c).toNat r=
   Scale n ((n:ℤ)+c).toNat*(ordinarySectorScalarPolynomial ((n:ℤ)+c).toNat r).eval ((2:ℝ)^n)

def E_physicalGramScale_shortening (n m : ℕ) :=
 Scale n (m+2)*((2:ℝ)^n+(2:ℝ)^m)=Scale n (m+1)
def E_physicalExceptionalValue_shortening (n m r : ℕ) :=
 Scale n (m+2)*(exceptionalSectorScalarPolynomial (m+2) (r+1)).eval ((2:ℝ)^n)=
 Scale n (m+1)*(ordinarySectorScalarPolynomial (m+1) r).eval ((2:ℝ)^n)
def E_physicalExceptionalMoment_zero_of_not_four (n : ℕ) {k : ℕ} := ¬4∣k → EM n k=0
def E_physicalExceptionalAmplitude_zero_of_not_four (n : ℕ) {k : ℕ} := ¬4∣k → EA n k=0
def E_weighted_sqrt_sum_sq_le {ι : Type*} [Fintype ι] (w v : ι→ℝ) :=
 (∀i,0≤w i) → (∀i,0≤v i) →
 (∑i,w i*Real.sqrt (v i))^2≤(∑i,w i)*(∑i,w i*v i)
def E_physicalExceptionalAmplitude_sq_le_moment (n : ℕ) {k : ℕ} := 0<k → (EA n k)^2≤EM n k
def E_physicalExceptionalMoment_mul_dimension (n : ℕ) {k : ℕ} := 0<k → 4∣k → (2:ℝ)^n*EM n k=1
def E_physicalExceptionalMoment_eq (n : ℕ) {k : ℕ} := 0<k → 4∣k → EM n k=1/(2:ℝ)^n
def E_physicalExceptionalMoment_le_geometric (n : ℕ) {k : ℕ} := 0<k → EM n k≤(1/2:ℝ)^n
def E_physicalExceptionalMoment_window_tendsto (c : ℤ) :=
 Tendsto (fun n:ℕ=>EM n ((n:ℤ)+c).toNat) atTop (𝓝 0)
def E_physicalExceptionalAmplitude_window_tendsto (c : ℤ) :=
 Tendsto (fun n:ℕ=>EA n ((n:ℤ)+c).toNat) atTop (𝓝 0)
def E_physicalOrdinary_moment_window_tendsto (c : ℤ) :=
 Tendsto (fun n:ℕ=>∑'r:ℕ,OW n ((n:ℤ)+c).toNat r*OV n ((n:ℤ)+c).toNat r) atTop (𝓝 1)

def E_physicalCritical_signed_exponentialRatio (σ a b : ℝ) :=
 (σ=1∨σ= -1) → a≤0 → b≤ -1 →
 0≤(1-σ*(2:ℝ)^a)/(1-σ*(2:ℝ)^b) ∧ (1-σ*(2:ℝ)^a)/(1-σ*(2:ℝ)^b)≤4
def E_physicalOrdinaryWeight_le_gaussian (n k r : ℕ) :=
 0<k → -2≤(n:ℝ)+2*(r:ℝ)-(k:ℝ) →
 OW n k r≤(8/Q)*Phi ((n:ℝ)+2*(r:ℝ)-(k:ℝ))
def E_physicalOrdinaryWeight_window_bulk (c : ℤ) :=
 ∀ᶠn:ℕ in atTop,∀r:ℕ,c.natAbs+1≤r → OW n ((n:ℤ)+c).toNat r≤(8/Q)*Phi (2*(r:ℝ)-(c:ℝ))
def E_physicalOrdinaryValue_window_tendsto (c : ℤ) (r : ℕ) :=
 Tendsto (fun n:ℕ=>OV n ((n:ℤ)+c).toNat r) atTop (𝓝 (L c r))
def E_eventually_physicalOrdinaryValue_le (c : ℤ) :=
 ∀ᶠn:ℕ in atTop,∀r,OV n ((n:ℤ)+c).toNat r≤(2*L0 c)*F r ((2:ℝ)^(3-(c:ℝ)))

def E_physicalOrdinaryWeight_window_tendsto (c : ℤ) (r : ℕ) :=
 Tendsto (fun n:ℕ=>OW n ((n:ℤ)+c).toNat r) atTop (𝓝 (W c r))
def E_physicalOrdinary_moment_tsum_critical_tendsto (c : ℤ) :=
 Tendsto (fun n:ℕ=>∑'r:ℕ,OW n ((n:ℤ)+c).toNat r*OV n ((n:ℤ)+c).toNat r)
 atTop (𝓝 (∑'r:ℕ,W c r*L c r))
def E_criticalWeight_mul_lambda_tsum (c : ℤ) := (∑'r:ℕ,W c r*L c r)=1
def E_physicalOrdinary_amplitude_critical_tendsto (c : ℤ) :=
 Tendsto (fun n:ℕ=>∑'r:ℕ,OW n ((n:ℤ)+c).toNat r*Real.sqrt (OV n ((n:ℤ)+c).toNat r))
 atTop (𝓝 (∑'r:ℕ,W c r*Real.sqrt (L c r)))
def E_physicalFiniteSuccess_critical_tendsto (c : ℤ) :=
 Tendsto (fun n:ℕ=>FiniteP n ((n:ℤ)+c).toNat)
 atTop (𝓝 ((∑'r:ℕ,W c r*Real.sqrt (L c r))^2))
end PhysicalExpected
