    Module.finrank (ZMod 2)
      (↥((L ⊓ LinearMap.BilinForm.orthogonal Q.polarBilin U) ⊔ U)) = r

def Maximality [FiniteDimensional (ZMod 2) V] : Prop :=
  ∀ (Q : QuadraticForm (ZMod 2) V),
  (∀ x : V, (∀ y : V, Q (x + y) - Q x - Q y = 0) → x = 0) →
