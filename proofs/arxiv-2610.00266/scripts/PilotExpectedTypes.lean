open Lean Elab Command Meta in
def auditAlternatingBoundaryDefinition (actual expected : Name) : CommandElabM Unit := do
  liftTermElabM do
    let info ← getConstInfo actual
    let expectedInfo ← getConstInfo expected
    unless info.levelParams.length == expectedInfo.levelParams.length do
      throwError "Definition universe generality mismatch: {actual}"
    let levelParams := (List.range info.levelParams.length).map
      (fun i => Name.mkSimple ("auditUniverse" ++ toString i))
    let levels := levelParams.map Level.param
    let term := mkConst actual levels
    let expectedTerm := mkConst expected levels
    let expectedType ← inferType expectedTerm
    let expectedValue ← forallTelescope expectedType fun args _ => do
      mkForallFVars args (mkAppN expectedTerm args)
    unless ← isDefEq (← inferType term) expectedValue do
      throwError "Independent definition type mismatch {actual}"
    let kernelEnv := (← getEnv).toKernelEnv
    let limit := (Core.getMaxHeartbeats (← getOptions)).toUSize
    for (label, value) in #[
        ("constant", term), ("body", info.instantiateValueLevelParams! levels)] do
      let name ← mkFreshUserName (Name.mkSimple ("definitionAudit_" ++ label))
      let decl : Declaration := .defnDecl {
        name := name, levelParams := levelParams, type := expectedValue, value := value,
        hints := .opaque, safety := .safe
      }
      let _ ← ofExceptKernelException <| Kernel.Environment.addDeclCore kernelEnv limit decl none
      logInfo m!"KERNEL_EXPECTED_DEFINITION_OK {label} {actual}"

namespace AlternatingBoundaryExpected
universe u v
open ExactCriticalCurve ExactCriticalCurve.FiniteQuadratic Module
open scoped BigOperators
abbrev Alt (E : Type u) [AddCommGroup E] [Module (ZMod 2) E] :=
  {A : LinearMap.BilinForm (ZMod 2) E // A.IsAlt}
abbrev ND (E : Type u) [AddCommGroup E] [Module (ZMod 2) E] :=
  {A : LinearMap.BilinForm (ZMod 2) E // A.IsAlt ∧ A.Nondegenerate}
abbrev Data (E : Type u) [AddCommGroup E] [Module (ZMod 2) E] (m : ℕ) :=
  {p : Submodule (ZMod 2) E × LinearMap.BilinForm (ZMod 2) E // p.2.IsAlt ∧
    p.1≤LinearMap.ker p.2 ∧ finrank (ZMod 2) E+finrank (ZMod 2) (LinearMap.ker p.2)≤m+2*finrank (ZMod 2) p.1}
abbrev Boundary (E : Type u) [AddCommGroup E] [Module (ZMod 2) E] (ell : ℕ) :=
  {p : Submodule (ZMod 2) E × LinearMap.BilinForm (ZMod 2) E // p.2.IsAlt ∧
    p.1≤LinearMap.ker p.2 ∧ finrank (ZMod 2) E+finrank (ZMod 2) (LinearMap.ker p.2)=2*ell+2*finrank (ZMod 2) p.1}
abbrev FlagFiber {E : Type u} [AddCommGroup E] [Module (ZMod 2) E]
    (K : Submodule (ZMod 2) E) (ell : ℕ) :=
  Σ R : {R : Submodule (ZMod 2) E // K≤R ∧ finrank (ZMod 2) E+finrank (ZMod 2) R=2*ell+2*finrank (ZMod 2) K}, ND (E ⧸ R.val)
def Average {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) V) (n : ℕ) : ℚ :=
  (∑ g : BinarySymplecticIsometryGroup B, ((2 : ℚ)^n)^finrank (ZMod 2) (Counting.fixedSubmodule (ZMod 2) V g)) /
    (Nat.card (BinarySymplecticIsometryGroup B) : ℚ)

def PullbackRadical : Prop :=
  ∀ {E : Type u} {F : Type v} [AddCommGroup E] [Module (ZMod 2) E] [AddCommGroup F] [Module (ZMod 2) F], ∀ (C : LinearMap.BilinForm (ZMod 2) F) (q : E →ₗ[ZMod 2] F), Function.Surjective q → LinearMap.ker (C.comp q q) = (LinearMap.ker C).comap q

def RadicalIndex : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E], ∀ A : Alt E, (alternatingRadicalEquiv A).1 = LinearMap.ker A.val

def FlagKernel : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E], ∀ (m : ℕ) (p : Data E m), (realizableAlternatingFlagEquiv m p).1 = p.val.1

def FlagRadical : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E], ∀ (m : ℕ) (p : Data E m), (realizableAlternatingFlagEquiv m p).2.1.val = LinearMap.ker p.val.2

def AddRadicalEven : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E], ∀ A : LinearMap.BilinForm (ZMod 2) E, A.IsAlt → Even (finrank (ZMod 2) E+finrank (ZMod 2) (LinearMap.ker A))

def CardSucc : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E], ∀ s : ℕ, Nat.card (Data E (2*(s+1))) = Nat.card (Data E (2*s))+Nat.card (Boundary E (s+1))

def CardIncrement : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E], ∀ s : ℕ, (Nat.card (Data E (2*(s+1))) : ℚ)-(Nat.card (Data E (2*s)) : ℚ) = (Nat.card (Boundary E (s+1)) : ℚ)

def SubspaceCard : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E], ∀ {d : ℕ}, finrank (ZMod 2) E=d → ∀ t : ℕ, Nat.card {K : Submodule (ZMod 2) E // finrank (ZMod 2) K=t} = Counting.binaryGaussian d t

def FlagFiberCard : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E], ∀ (ell a : ℕ), a≤ell → ∀ K : Submodule (ZMod 2) E, finrank (ZMod 2) K+(ell+a)=finrank (ZMod 2) E → Nat.card (FlagFiber K ell)=Counting.binaryGaussian (ell+a) (ell-a)*nondegenerateAlternatingCount (2*a)

def BoundaryBounds : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E], ∀ (ell : ℕ) (p : Boundary E ell), ell≤finrank (ZMod 2) E-finrank (ZMod 2) p.val.1 ∧ finrank (ZMod 2) E-finrank (ZMod 2) p.val.1≤2*ell

def IndexIff : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E], ∀ (ell : ℕ) (p : Boundary E ell) (a : Fin (ell+1)), alternatingBoundaryIndex ell p=a ↔ finrank (ZMod 2) p.val.1+(ell+a.val)=finrank (ZMod 2) E

def IndexFiberCard : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E], ∀ (ell : ℕ) (a : Fin (ell+1)), Nat.card {p : Boundary E ell // alternatingBoundaryIndex ell p=a} = if ell+a.val≤finrank (ZMod 2) E then Counting.binaryGaussian (finrank (ZMod 2) E) (finrank (ZMod 2) E-(ell+a.val))*Counting.binaryGaussian (ell+a.val) (ell-a.val)*nondegenerateAlternatingCount (2*a.val) else 0

def BoundarySum : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E], ∀ ell : ℕ, Nat.card (Boundary E ell) = ∑ a : Fin (ell+1), if ell+a.val ≤ finrank (ZMod 2) E then Counting.binaryGaussian (finrank (ZMod 2) E) (finrank (ZMod 2) E-(ell+a.val)) * Counting.binaryGaussian (ell+a.val) (ell-a.val) * nondegenerateAlternatingCount (2*a.val) else 0

def ActualAverageBoundary : Prop :=
  ∀ {V : Type u} {W : Type v} [AddCommGroup V] [Module (ZMod 2) V] [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) V] [FiniteDimensional (ZMod 2) W], ∀ (B : LinearMap.BilinForm (ZMod 2) V), B.IsAlt → B.Nondegenerate → ∀ (C : LinearMap.BilinForm (ZMod 2) W), C.IsAlt → C.Nondegenerate → ∀ (s n : ℕ), finrank (ZMod 2) V=2*s → finrank (ZMod 2) W=2*(s+1) → Average C n-Average B n = (Nat.card (Boundary (Fin n → ZMod 2) (s+1)) : ℚ)

def ActualAverageCount : Prop :=
  ∀ {V : Type u} {W : Type v} [AddCommGroup V] [Module (ZMod 2) V] [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) V] [FiniteDimensional (ZMod 2) W], ∀ (B : LinearMap.BilinForm (ZMod 2) V), B.IsAlt → B.Nondegenerate → ∀ (C : LinearMap.BilinForm (ZMod 2) W), C.IsAlt → C.Nondegenerate → ∀ (s n : ℕ), finrank (ZMod 2) V=2*s → finrank (ZMod 2) W=2*(s+1) → Average C n-Average B n = ((∑ a : Fin (s+1+1), if s+1+a.val≤n then Counting.binaryGaussian n (n-(s+1+a.val))*Counting.binaryGaussian (s+1+a.val) (s+1-a.val)*nondegenerateAlternatingCount (2*a.val) else 0 : ℕ) : ℚ)

def RadicalFiberType : Type (u+1) :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E], ∀ R : Submodule (ZMod 2) E, {A : LinearMap.BilinForm (ZMod 2) E // A.IsAlt ∧ LinearMap.ker A=R} ≃ ND (E ⧸ R)

def AltType : Type (u+1) :=
  ∀ (E : Type u) [AddCommGroup E] [Module (ZMod 2) E], Type u

def RadicalSigmaType : Type (u+1) :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E], Alt E ≃ (Σ R : Submodule (ZMod 2) E, ND (E ⧸ R))

def FlagPredicateType : Type (u+1) :=
