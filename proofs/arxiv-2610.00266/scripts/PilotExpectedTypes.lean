def OneSided : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k),
    ∃ g : StochasticIsometryGroup k,
      T.carrier = (defectRelation
        (T.carrier.comap (LinearMap.inr (ZMod 2) (Fin k → ZMod 2) (Fin k → ZMod 2)))).map
        (g.val.prodCongr (LinearEquiv.refl (ZMod 2) (Fin k → ZMod 2))).toLinearMap

def CompressedPositive : Prop :=
  ∀ (n : ℕ) {k : ℕ} (T : StochasticLagrangian k),
    (finiteGroupProjection (stochasticIsometryRepresentation n) *
      matrixTensorPower n (relationMatrix T.carrier) *
        finiteGroupProjection (stochasticIsometryRepresentation n)).PosSemidef

def IdentityLowerBound : Prop :=
  ∀ n k : ℕ,
    ((∑ T : StochasticLagrangian k, matrixTensorPower n (relationMatrix T.carrier)) -
      finiteGroupProjection (stochasticIsometryRepresentation (k := k) n)).PosSemidef

def SumRange : Prop :=
  ∀ n k : ℕ,
    LinearMap.range (∑ T : StochasticLagrangian k,
      matrixTensorPower n (relationMatrix T.carrier)).mulVecLin =
    LinearMap.range (finiteGroupProjection
      (stochasticIsometryRepresentation (k := k) n)).mulVecLin

def FrameFormula : Prop :=
  ∀ n k : ℕ, 1 ≤ k →
    let C : Matrix (ColumnConfig n k) (StabilizerGroup n) ℂ :=
      fun X S => ∏ i : Fin k, stabilizerVector S (((copyColumnsEquiv n k).symm X) i)
    C*Cᴴ = ((Fintype.card (StabilizerGroup n) : ℂ) *
      ((2 : ℂ)^n * ∏ j ∈ Finset.range (k-1), ((2 : ℂ)^n+(2 : ℂ)^j))⁻¹) •
        ∑ T : StochasticLagrangian k, matrixTensorPower n (relationMatrix T.carrier)

def PositiveCopiesRange : Prop :=
  ∀ n k : ℕ, 1 ≤ k →
    LinearMap.range (Matrix.mulVecLin (fun X S => ∏ i : Fin k,
      stabilizerVector (S : StabilizerGroup n) (((copyColumnsEquiv n k).symm X) i))) =
    LinearMap.range (finiteGroupProjection
      (stochasticIsometryRepresentation (k := k) n)).mulVecLin

def ZeroFrame : Prop :=
  ∀ n : ℕ,
    let C : Matrix (ColumnConfig n 0) (StabilizerGroup n) ℂ :=
      fun X S => ∏ i : Fin 0, stabilizerVector S (((copyColumnsEquiv n 0).symm X) i)
    C*Cᴴ = (Fintype.card (StabilizerGroup n) : ℂ) •
      (1 : Matrix (ColumnConfig n 0) (ColumnConfig n 0) ℂ)

def ZeroRange : Prop :=
  ∀ n : ℕ,
    LinearMap.range (Matrix.mulVecLin (fun X S => ∏ i : Fin 0,
      stabilizerVector (S : StabilizerGroup n) (((copyColumnsEquiv n 0).symm X) i))) = ⊤

def AllCopiesRange : Prop :=
  ∀ n k : ℕ,
    LinearMap.range (Matrix.mulVecLin (fun X S => ∏ i : Fin k,
      stabilizerVector (S : StabilizerGroup n) (((copyColumnsEquiv n k).symm X) i))) =
    LinearMap.range (finiteGroupProjection
      (stochasticIsometryRepresentation (k := k) n)).mulVecLin

def ActualSpan : Prop :=
  ∀ n k : ℕ,
    Submodule.span ℂ (Set.range (fun S : StabilizerGroup n =>
      fun X : ColumnConfig n k =>
        ∏ i : Fin k, stabilizerVector S (((copyColumnsEquiv n k).symm X) i))) =
    LinearMap.range (finiteGroupProjection
      (stochasticIsometryRepresentation (k := k) n)).mulVecLin

end StochasticSpanExpected

