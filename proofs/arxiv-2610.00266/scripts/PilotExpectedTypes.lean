    (x, 0) ∈ T.carrier → (∑ i, bitLift (x i)) = (0 : ZMod 4)

def RelationRightFullQuadratic : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k) (y : Fin k → ZMod 2),
    (0, y) ∈ T.carrier → (∑ i, bitLift (y i)) = (0 : ZMod 4)

def RelationSelfOrthogonal : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k),
    (Binary.StochasticCounting.relationBilinear k).orthogonal T.carrier = T.carrier

def RelationLeftImageLiteral : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k),
    T.carrier.map (LinearMap.fst (ZMod 2) (Fin k → ZMod 2) (Fin k → ZMod 2)) =
      orthogonal (T.carrier.comap
        (LinearMap.inl (ZMod 2) (Fin k → ZMod 2) (Fin k → ZMod 2)))

def RelationRightImageLiteral : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k),
    T.carrier.map (LinearMap.snd (ZMod 2) (Fin k → ZMod 2) (Fin k → ZMod 2)) =
      orthogonal (T.carrier.comap
        (LinearMap.inr (ZMod 2) (Fin k → ZMod 2) (Fin k → ZMod 2)))

def RelationWuBranch : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k),
    (allOnes k, 0) ∈ T.carrier ↔ (0, allOnes k) ∈ T.carrier

def RelationDefectRanks : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k),
    Module.finrank (ZMod 2) (T.carrier.comap
      (LinearMap.inl (ZMod 2) (Fin k → ZMod 2) (Fin k → ZMod 2))) =
    Module.finrank (ZMod 2) (T.carrier.comap
      (LinearMap.inr (ZMod 2) (Fin k → ZMod 2) (Fin k → ZMod 2)))

def RelationActualClasses : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k) (p : T.carrier),
    relationQuotientEquiv T
      (Submodule.Quotient.mk (⟨p.val.2, T.right_mem_orthogonal p.property⟩ :
        orthogonal T.rightDefect)) =
      Submodule.Quotient.mk (⟨p.val.1, T.left_mem_orthogonal p.property⟩ :
        orthogonal T.leftDefect)

def RelationActualQuotientQuadratic : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k)
    (x : (orthogonal T.rightDefect) ⧸
      T.rightDefect.comap (orthogonal T.rightDefect).subtype),
    cssQuotientQuadratic T.leftDefect T.leftDefect_isDefect (relationQuotientEquiv T x) =
      cssQuotientQuadratic T.rightDefect T.rightDefect_isDefect x

def RelationActualQuotientPairing : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k)
    (x y : (orthogonal T.rightDefect) ⧸
      T.rightDefect.comap (orthogonal T.rightDefect).subtype),
    cssQuotientBilinear T.leftDefect (relationQuotientEquiv T x) (relationQuotientEquiv T y) =
      cssQuotientBilinear T.rightDefect x y

def RelationActualWuClasses : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k),
    relationQuotientEquiv T
      (Submodule.Quotient.mk (⟨allOnes k, T.rightDefect_isDefect.allOnes_mem_orthogonal⟩ :
        orthogonal T.rightDefect)) =
      Submodule.Quotient.mk (⟨allOnes k, T.leftDefect_isDefect.allOnes_mem_orthogonal⟩ :
        orthogonal T.leftDefect)

def RelationReconstructOnImages : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k)
    (x : orthogonal T.leftDefect) (y : orthogonal T.rightDefect),
    (x.val, y.val) ∈ T.carrier ↔
      relationQuotientEquiv T (Submodule.Quotient.mk y) = Submodule.Quotient.mk x

def RelationReconstructAmbient : Prop :=
  ∀ {k : ℕ} (T : StochasticLagrangian k) (x y : Fin k → ZMod 2),
    (x, y) ∈ T.carrier ↔
      ∃ hx : x ∈ orthogonal T.leftDefect, ∃ hy : y ∈ orthogonal T.rightDefect,
        relationQuotientEquiv T
          (Submodule.Quotient.mk (⟨y, hy⟩ : orthogonal T.rightDefect)) =
          Submodule.Quotient.mk (⟨x, hx⟩ : orthogonal T.leftDefect)

end RelationNormalFormExpected

