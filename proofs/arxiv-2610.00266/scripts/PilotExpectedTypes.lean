  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V], ∀ B : LinearMap.BilinForm (ZMod 2) V, (symplecticFixedSpacePolynomial B).coeff (finrank (ZMod 2) V)=(Nat.card (BinarySymplecticIsometryGroup B) : ℚ)⁻¹

