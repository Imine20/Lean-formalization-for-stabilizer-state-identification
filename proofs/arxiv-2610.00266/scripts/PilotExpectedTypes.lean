namespace DefectFactorExpected
open ExactCriticalCurve ExactCriticalCurve.Binary ExactCriticalCurve.Quantum Module
abbrev V (k : ℕ) := Fin k → ZMod 2
abbrev D (k : ℕ) := Submodule (ZMod 2) (V k)
abbrev Ordinary (k r : ℕ) := {N : D k //
  (∀ x ∈ N, weightQuadratic x = 0) ∧ finrank (ZMod 2) N = r ∧
    (fun _ : Fin k => (1 : ZMod 2)) ∉ N}
local instance literalOrdinaryAction (k r : ℕ) :
    MulAction (StochasticIsometryGroup k) (Ordinary k r) :=
  ordinaryDefectMulAction (k := k) (r := r)
def Ambient (k : ℕ) := {g : V k ≃ₗ[ZMod 2] V k //
  (∀ x, weightQuadratic (g x) = weightQuadratic x) ∧
    g (fun _ : Fin k => (1 : ZMod 2)) = (fun _ : Fin k => (1 : ZMod 2))}
def Stabilizer (N : D k) := {g : StochasticIsometryGroup k // N.map g.val.toLinearMap = N}
def Kernel (N : D k) := {g : StochasticIsometryGroup k //
  N.map g.val.toLinearMap = N ∧ ∀ x : orthogonal N, g.val x.val - x.val ∈ N}
abbrev Quotient (N : D k) := orthogonal N ⧸ N.comap (orthogonal N).subtype
def QuotientGroup (N : D k) (hN : ∀ x ∈ N, weightQuadratic x = 0) :=
  {e : Quotient N ≃ₗ[ZMod 2] Quotient N //
    (∀ x, cssQuotientQuadratic N hN (e x) = cssQuotientQuadratic N hN x) ∧
      e (cssQuotientWu N hN) = cssQuotientWu N hN}
def ActionOnto : Prop := ∀ {k : ℕ} (N : D k) (hN : ∀ x ∈ N, weightQuadratic x = 0),
  Function.Surjective (stochasticDefectQuotientAction N hN)
def ActionKernel : Prop := ∀ {k : ℕ} (N : D k) (hN : ∀ x ∈ N, weightQuadratic x = 0)
  (g : stochasticDefectStabilizer N),
  stochasticDefectQuotientAction N hN g = 1 ↔
    N.map g.val.val.toLinearMap = N ∧ ∀ x : orthogonal N, g.val.val x.val - x.val ∈ N
def StabilizerCard : Prop := ∀ {k : ℕ} (N : D k) (hN : ∀ x ∈ N, weightQuadratic x = 0),
  Nat.card (Stabilizer N) = Nat.card (Kernel N) * Nat.card (QuotientGroup N hN)
def StabilizerAction : Prop := ∀ {k r : ℕ} (N : Ordinary k r),
  stochasticDefectStabilizer N.val = MulAction.stabilizer (StochasticIsometryGroup k) N
def OrbitContains : Prop := ∀ {k r : ℕ} (N M : Ordinary k r),
  M ∈ MulAction.orbit (StochasticIsometryGroup k) N
def OrbitCard : Prop := ∀ {k r : ℕ} (N : Ordinary k r),
  Nat.card (Ambient k) = Nat.card (Ordinary k r) * Nat.card (Stabilizer N.val)
def ActualFactorization : Prop := ∀ {k r : ℕ} (N : Ordinary k r),
  Nat.card (Ambient k) = Nat.card (Ordinary k r) * Nat.card (Kernel N.val) *
    Nat.card (QuotientGroup N.val N.property.1)
def ExplicitFactorization : Prop := ∀ {k r : ℕ} (N : Ordinary k r),
  Nat.card (Ambient k) = Nat.card (Ordinary k r) *
    (Nat.card ((Fin r → ZMod 2) ≃ₗ[ZMod 2] (Fin r → ZMod 2)) *
      2 ^ (r * (k - 2*r - 1)) * 2 ^ r.choose 2) *
    Nat.card (QuotientGroup N.val N.property.1)
def ActionRepresentative : Prop := ∀ {k : ℕ} (N : D k) (hN : ∀ x ∈ N, weightQuadratic x = 0)
  (g : stochasticDefectStabilizer N) (x : orthogonal N),
  (stochasticDefectQuotientAction N hN g).val (Submodule.Quotient.mk x) =
    Submodule.Quotient.mk (stabilizerOrthogonalEquiv N g x)
def QuotientGroupType : Type := ∀ {k : ℕ} (N : D k),
  (∀ x ∈ N, weightQuadratic x = 0) → Subgroup (Quotient N ≃ₗ[ZMod 2] Quotient N)
def ActionType : Type := ∀ {k : ℕ} (N : D k) (hN : ∀ x ∈ N, weightQuadratic x = 0),
  stochasticDefectStabilizer N →* CSSQuotientIsometryGroup N hN
def KernelEquivType : Type := ∀ {k : ℕ} (N : D k) (hN : ∀ x ∈ N, weightQuadratic x = 0),
  (stochasticDefectQuotientAction N hN).ker ≃ Kernel N
def OrbitEquivType : Type := ∀ {k r : ℕ} (N : Ordinary k r),
  MulAction.orbit (StochasticIsometryGroup k) N ≃ Ordinary k r
end DefectFactorExpected
