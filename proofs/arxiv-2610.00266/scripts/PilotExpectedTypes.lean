def P {k : ℕ} (x : Fin k → ZMod 2) : ZMod 2 := ∑ i, 1 * x i
def Q {k : ℕ} (x : Fin k → ZMod 2) : ZMod 2 :=
  halfEven ((∑ i, bitLift (x i)) - bitLift (P x))
def B {k : ℕ} (x y : Fin k → ZMod 2) : ZMod 2 :=
  (∑ i, x i * y i) + P x * P y
def EvenSpace (k : ℕ) : Submodule (ZMod 2) (Fin k → ZMod 2) :=
  LinearMap.ker ((dotProductBilin (ZMod 2) (ZMod 2)) (fun _ => 1))

def CorrectedEven : Prop := ∀ {k : ℕ} (x : Fin k → ZMod 2),
  ((∑ i, bitLift (x i)) - bitLift (P x)) +
    ((∑ i, bitLift (x i)) - bitLift (P x)) = 0
def Reconstruction : Prop := ∀ {k : ℕ} (x : Fin k → ZMod 2),
  (2 : ZMod 4) * bitLift (Q x) + bitLift (P x) = ∑ i, bitLift (x i)
def QuadraticAddition : Prop := ∀ {k : ℕ} (x y : Fin k → ZMod 2),
  Q (x+y) = Q x + Q y + B x y
def Polarization : Prop := ∀ k : ℕ,
  (stochasticHalfForm k).polarBilin =
    dotProductBilin (ZMod 2) (ZMod 2) +
      (LinearMap.mul (ZMod 2) (ZMod 2)).compl₁₂
        ((dotProductBilin (ZMod 2) (ZMod 2)) (fun _ : Fin k => 1))
        ((dotProductBilin (ZMod 2) (ZMod 2)) (fun _ : Fin k => 1))
def EvenWuPairing : Prop := ∀ {k : ℕ}, (k : ZMod 2) = 0 →
  ∀ x : Fin k → ZMod 2, B (fun _ => 1) x = P x
def EvenNondegenerate : Prop := ∀ {k : ℕ}, (k : ZMod 2) = 0 →
  ∀ x : Fin k → ZMod 2, (∀ y, B x y = 0) → x = 0
def EvenPolarNondegenerate : Prop := ∀ {k : ℕ}, (k : ZMod 2) = 0 →
  LinearMap.BilinForm.Nondegenerate (stochasticHalfForm k).polarBilin
def WuValue : Prop := ∀ {k : ℕ}, (k : ZMod 2) = 0 →
  Q (fun _ : Fin k => 1) = halfEven (k : ZMod 4)
def RestrictedValue : Prop := ∀ {k : ℕ} (x : EvenSpace k),
  evenWeightHalfForm k x = halfEven (∑ i, bitLift (x.val i))
def RestrictedPolar : Prop := ∀ {k : ℕ} (x y : EvenSpace k),
  (evenWeightHalfForm k).polarBilin x y = ∑ i, x.val i * y.val i
def OddCorrection : Prop := ∀ {k : ℕ}, (k : ZMod 2) = 1 →
  ∀ x : Fin k → ZMod 2, x + P x • (fun _ : Fin k => (1 : ZMod 2)) ∈ EvenSpace k
def OddNondegenerate : Prop := ∀ {k : ℕ}, (k : ZMod 2) = 1 →
  LinearMap.BilinForm.Nondegenerate (evenWeightHalfForm k).polarBilin
def EqualityCriterion : Prop := ∀ {k : ℕ} (x y : Fin k → ZMod 2),
  P x = P y → ((∑ i, bitLift (x i)) = (∑ i, bitLift (y i)) ↔ Q x = Q y)
end StochasticQuadraticReductionExpected

