def CoordinateRawRefinement {n : ℕ} (L : Submodule (ZMod 2) (Fin n → ZMod 2)) :=
  {d : LinearMap.BilinForm (ZMod 2) L × (L → ZMod 4) //
    (∀ t u, d.1 t u = d.1 u t) ∧ d.2 0 = 0 ∧
    ∀ t u, d.2 (t+u) = d.2 t + d.2 u + 2 * ((d.1 t u).val : ZMod 4)}

def coordinateRawRefinementEquiv {n : ℕ} (L : Submodule (ZMod 2) (Fin n → ZMod 2)) :
    StabilizerPhaseData L ≃ CoordinateRawRefinement L where
  toFun q := ⟨(q.polar,q.phase), q.polar_symm, q.phase_zero, q.phase_add⟩
  invFun q := ⟨q.val.1,q.property.1,q.val.2,q.property.2.1,q.property.2.2⟩
  left_inv q := by cases q; rfl
  right_inv q := by cases q; rfl

def CoordinatePolynomial {m : ℕ}
    (c : (Fin m → ZMod 4) × ({p : Fin m × Fin m // p.1<p.2} → ZMod 2))
    (z : Fin m → ZMod 2) : ZMod 4 :=
  (∑ i, c.1 i * ((z i).val : ZMod 4)) +
    2 * ∑ p, ((c.2 p).val : ZMod 4) * ((z p.val.1).val : ZMod 4) *
      ((z p.val.2).val : ZMod 4)

theorem phaseDataCoefficients_expanded {n m : ℕ}
    {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (b : Basis (Fin m) (ZMod 2) L) (q : StabilizerPhaseData L) :
    phaseDataCoefficients b q = (fun i => q.phase (b i),
      fun p : {p : Fin m × Fin m // p.1<p.2} => q.polar (b p.val.1) (b p.val.2)) := rfl

theorem phaseDataConstructedPhase_expanded {n m : ℕ}
    {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (b : Basis (Fin m) (ZMod 2) L)
    (c : (Fin m → ZMod 4) × ({p : Fin m × Fin m // p.1<p.2} → ZMod 2)) (t : L) :
    (phaseDataOfCoefficients b c).phase t = CoordinatePolynomial c (b.equivFun t) := rfl

theorem phaseDataConstructedPolar_expanded {n m : ℕ}
    {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (b : Basis (Fin m) (ZMod 2) L)
    (c : (Fin m → ZMod 4) × ({p : Fin m × Fin m // p.1<p.2} → ZMod 2)) (t u : L) :
    (phaseDataOfCoefficients b c).polar t u =
      (∑ i, phaseParity (c.1 i) * b.equivFun t i * b.equivFun u i) +
        ∑ p, c.2 p * (b.equivFun t p.val.1 * b.equivFun u p.val.2 +
          b.equivFun t p.val.2 * b.equivFun u p.val.1) := rfl

theorem phaseDataCoordinateEquiv_forward {n m : ℕ}
    {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (b : Basis (Fin m) (ZMod 2) L) (q : StabilizerPhaseData L) :
    phaseDataCoordinatesEquiv b q = (fun i => q.phase (b i),
      fun p : {p : Fin m × Fin m // p.1<p.2} => q.polar (b p.val.1) (b p.val.2)) := rfl

theorem phaseDataCoordinateEquiv_backward {n m : ℕ}
    {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (b : Basis (Fin m) (ZMod 2) L)
    (c : (Fin m → ZMod 4) × ({p : Fin m × Fin m // p.1<p.2} → ZMod 2)) :
    (phaseDataCoordinatesEquiv b).symm c = phaseDataOfCoefficients b c := rfl

def PhaseDeterminesAllData : Prop :=
  ∀ {n : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    {q r : StabilizerPhaseData L}, q.phase = r.phase → q = r

def BasisActualCoordinates : Prop :=
  ∀ {n m : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (b : Basis (Fin m) (ZMod 2) L) (i : Fin m), b.equivFun (b i) = Pi.single i 1

def CoefficientRoundtrip : Prop :=
  ∀ {n m : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (b : Basis (Fin m) (ZMod 2) L)
    (c : (Fin m → ZMod 4) × ({p : Fin m × Fin m // p.1<p.2} → ZMod 2)),
    phaseDataCoefficients b (phaseDataOfCoefficients b c) = c

def ActualPolarReconstruction : Prop :=
  ∀ {n m : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (b : Basis (Fin m) (ZMod 2) L) (q : StabilizerPhaseData L),
    (phaseDataOfCoefficients b (phaseDataCoefficients b q)).polar = q.polar

def ActualPhaseReconstruction : Prop :=
  ∀ {n m : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (b : Basis (Fin m) (ZMod 2) L) (q : StabilizerPhaseData L) (t : L),
    CoordinatePolynomial
      (fun i => q.phase (b i),
        fun p : {p : Fin m × Fin m // p.1<p.2} => q.polar (b p.val.1) (b p.val.2))
      (b.equivFun t) = q.phase t

def RefinementRoundtrip : Prop :=
  ∀ {n m : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (b : Basis (Fin m) (ZMod 2) L) (q : StabilizerPhaseData L),
    phaseDataOfCoefficients b (phaseDataCoefficients b q) = q

def ActualCoefficientBijection : Prop :=
  ∀ {n m : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (b : Basis (Fin m) (ZMod 2) L),
    Function.Bijective (fun q : StabilizerPhaseData L =>
      (fun i => q.phase (b i),
        fun p : {p : Fin m × Fin m // p.1<p.2} => q.polar (b p.val.1) (b p.val.2)))

def ActualRefinementCount : Prop :=
  ∀ {n : ℕ} (L : Submodule (ZMod 2) (Fin n → ZMod 2)),
    Nat.card (StabilizerPhaseData L) = 4 ^ (Module.finrank (ZMod 2) L) *
      2 ^ (Nat.choose (Module.finrank (ZMod 2) L) 2)

theorem rawRefinement_count {n : ℕ} (L : Submodule (ZMod 2) (Fin n → ZMod 2)) :
    Nat.card (CoordinateRawRefinement L) = 4 ^ (Module.finrank (ZMod 2) L) *
      2 ^ (Nat.choose (Module.finrank (ZMod 2) L) 2) := by
  rw [← Nat.card_congr (coordinateRawRefinementEquiv L)]
  exact stabilizerPhaseData_card L

