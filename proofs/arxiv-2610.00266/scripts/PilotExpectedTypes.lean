namespace CSSSignedClassificationExpected
open Classical Module ExactCriticalCurve ExactCriticalCurve.Binary ExactCriticalCurve.Quantum
open scoped BigOperators

def UnitVector {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] : Prop :=
  ∀ (B : LinearMap.BilinForm (ZMod 2) V), B.IsSymm → B.Nondegenerate →
  ∀ w : V, w ≠ 0 → (∀ x, B x x = B x w) →
    ∃ v : V, B v v = 1 ∧ (v ≠ w ∨ Module.finrank (ZMod 2) V = 1)

def OrthonormalBasis {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] : Prop :=
  ∀ (B : LinearMap.BilinForm (ZMod 2) V), B.IsSymm → B.Nondegenerate →
  ∀ w : V, (∀ x, B x x = B x w) → (w ≠ 0 ∨ Module.finrank (ZMod 2) V = 0) →
    ∃ b : Module.Basis (Fin (Module.finrank (ZMod 2) V)) (ZMod 2) V,
      ∀ i j, B (b i) (b j) = if i = j then 1 else 0

def PairingRight {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] {m : ℕ} : Prop :=
  ∀ (B : LinearMap.BilinForm (ZMod 2) V) (b : Module.Basis (Fin m) (ZMod 2) V),
    (∀ i j, B (b i) (b j) = if i = j then 1 else 0) →
    ∀ (i : Fin m) (x : V), B (b i) x = b.equivFun x i

def PairingFull {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] {m : ℕ} : Prop :=
  ∀ (B : LinearMap.BilinForm (ZMod 2) V) (b : Module.Basis (Fin m) (ZMod 2) V),
    (∀ i j, B (b i) (b j) = if i = j then 1 else 0) →
    ∀ x y : V, B x y = ∑ i, b.equivFun x i * b.equivFun y i

def RefinementSum {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] {m : ℕ} : Prop :=
  ∀ (B : LinearMap.BilinForm (ZMod 2) V) (b : Module.Basis (Fin m) (ZMod 2) V),
    (∀ i j, B (b i) (b j) = if i = j then 1 else 0) →
    ∀ q : V → ZMod 4, q 0 = 0 →
    (∀ x y, q (x + y) = q x + q y + (2 : ZMod 4) * bitLift (B x y)) →
    ∀ (c : Fin m → ZMod 2) (s : Finset (Fin m)),
      q (∑ i ∈ s, c i • b i) = ∑ i ∈ s, bitLift (c i) * q (b i)

def SignedCoordinates : Prop :=
  ∀ {k r : ℕ} (N : {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
    IsDefect N ∧ Module.finrank (ZMod 2) N = r ∧ allOnes k ∉ N}),
    ∃ (mask : Fin (Module.finrank (ZMod 2)
        ((orthogonal N.val) ⧸ N.val.comap (orthogonal N.val).subtype)) → Bool)
      (e : ((orthogonal N.val) ⧸ N.val.comap (orthogonal N.val).subtype) ≃ₗ[ZMod 2]
        (Fin (Module.finrank (ZMod 2)
          ((orthogonal N.val) ⧸ N.val.comap (orthogonal N.val).subtype)) → ZMod 2)),
      (∀ x, cssQuotientQuadratic N.val N.property.1 x =
        ∑ i, if mask i then -bitLift (e x i) else bitLift (e x i)) ∧
      (∀ x y, cssQuotientBilinear N.val x y = ∑ i, e x i * e y i) ∧
      e (Submodule.Quotient.mk
        (⟨allOnes k, N.property.1.allOnes_mem_orthogonal⟩ : orthogonal N.val)) =
        fun _ => 1

def SignedDimension : Prop :=
  ∀ {k r : ℕ} (N : {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
    IsDefect N ∧ Module.finrank (ZMod 2) N = r ∧ allOnes k ∉ N}),
    Module.finrank (ZMod 2)
      ((orthogonal N.val) ⧸ N.val.comap (orthogonal N.val).subtype) = k - 2 * r

end CSSSignedClassificationExpected

