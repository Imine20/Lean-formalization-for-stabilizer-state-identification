def FlagPackType : Type (u+1) :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E], ∀ m : ℕ, Data E m ≃ (Σ K : Submodule (ZMod 2) E, Σ R : {R : Submodule (ZMod 2) E // K≤R ∧ finrank (ZMod 2) E+finrank (ZMod 2) R≤m+2*finrank (ZMod 2) K}, ND (E ⧸ R.val))

