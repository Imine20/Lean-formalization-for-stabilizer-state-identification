def CliffordAdjointLeft : Prop :=
  ∀ {n : ℕ} (U : CliffordGroup n),
    (U.val.val)ᴴ * U.val.val = (1 : Matrix (Fin n → ZMod 2) (Fin n → ZMod 2) ℂ)

def CliffordAdjointRight : Prop :=
  ∀ {n : ℕ} (U : CliffordGroup n),
    U.val.val * (U.val.val)ᴴ = (1 : Matrix (Fin n → ZMod 2) (Fin n → ZMod 2) ℂ)

def CliffordActualConjugation : Prop :=
  ∀ {n : ℕ} (U : CliffordGroup n) (g : PauliLabel n),
    pauliOperator (cliffordPauliAut U g) =
      U.val.val * pauliOperator g * (U.val.val)ᴴ

def CliffordTracePreserved : Prop :=
  ∀ {n : ℕ} (U : CliffordGroup n) (g : PauliLabel n),
    (∑ x : Fin n → ZMod 2, pauliOperator (cliffordPauliAut U g) x x) =
      ∑ x : Fin n → ZMod 2, pauliOperator g x x

def CliffordScalarFree : Prop :=
  ∀ {n : ℕ} (U : CliffordGroup n) (S : StabilizerGroup n),
    ∀ g ∈ S.carrier.map (cliffordPauliAut U).toMonoidHom,
      g.shift = 0 → g.clock = 0 → g.phase = 0

def CliffordIdentityAction : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n), cliffordStabilizer 1 S = S

def CliffordComposedAction : Prop :=
  ∀ {n : ℕ} (U V : CliffordGroup n) (S : StabilizerGroup n),
    cliffordStabilizer (U * V) S = cliffordStabilizer U (cliffordStabilizer V S)

/-- Independent, explicit finite subgroup average. -/
def CliffordAverage {n : ℕ} (S : StabilizerGroup n) :
    Matrix (Fin n → ZMod 2) (Fin n → ZMod 2) ℂ :=
  (Fintype.card S.carrier : ℂ)⁻¹ •
    ∑ g : S.carrier, Complex.I ^ g.val.phase.val •
      (fun x y => if x = y + g.val.shift
        then (-1 : ℂ) ^ (∑ a, g.val.clock a * y a : ZMod 2).val else 0)

def CliffordAverageCovariant : Prop :=
  ∀ {n : ℕ} (U : CliffordGroup n) (S : StabilizerGroup n),
    CliffordAverage (cliffordStabilizer U S) =
      U.val.val * CliffordAverage S * (U.val.val)ᴴ

def CliffordImageMembership : Prop :=
  ∀ {n : ℕ} (U : CliffordGroup n) (S : StabilizerGroup n) (g : PauliLabel n),
    g ∈ (cliffordStabilizer U S).carrier ↔
      (cliffordPauliAut U).symm g ∈ S.carrier

