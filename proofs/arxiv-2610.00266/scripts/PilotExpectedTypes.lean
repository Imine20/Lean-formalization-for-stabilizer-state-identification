namespace CSSFiltrationExpected
open Classical ExactCriticalCurve
open ExactCriticalCurve.Binary ExactCriticalCurve.Quantum

def OrdinarySubdefect : Prop :=
  ∀ {k s r : ℕ} (M : {M : Submodule (ZMod 2) (Fin k → ZMod 2) //
    IsDefect M ∧ Module.finrank (ZMod 2) M = s ∧ allOnes k ∉ M}),
    r ≤ s → ∃ N : {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
      IsDefect N ∧ Module.finrank (ZMod 2) N = r ∧ allOnes k ∉ N}, N.val ≤ M.val

def WuSurjective : Prop :=
  ∀ {k r : ℕ} (hk : 0 < k) (h4 : 4 ∣ k),
    Function.Surjective (extendWuDefect (r := r) hk h4)

def ExceptionalZero : Prop :=
  ∀ {k : ℕ}, 0 < k → IsEmpty
    {M : Submodule (ZMod 2) (Fin k → ZMod 2) //
      IsDefect M ∧ Module.finrank (ZMod 2) M = 0 ∧ allOnes k ∈ M}

def ExceptionalSubdefect : Prop :=
  ∀ {k r : ℕ}, 0 < k → 4 ∣ k →
    ∀ M : {M : Submodule (ZMod 2) (Fin k → ZMod 2) //
      IsDefect M ∧ Module.finrank (ZMod 2) M = r + 2 ∧ allOnes k ∈ M},
    ∃ N : {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
      IsDefect N ∧ Module.finrank (ZMod 2) N = r + 1 ∧ allOnes k ∈ N},
      N.val ≤ M.val

def CodeSpan : Prop :=
  ∀ (n : ℕ) {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)), IsDefect N →
    LinearMap.range (cssColumnProjection n N).mulVecLin =
      Submodule.span ℂ (Set.range (cssColumnSynthesis n N).col)

def LeftAbsorption : Prop :=
  ∀ (n : ℕ) {k : ℕ} (N M : Submodule (ZMod 2) (Fin k → ZMod 2)),
    IsDefect N → IsDefect M → N ≤ M →
      cssColumnProjection n N * cssColumnProjection n M = cssColumnProjection n M

def RightAbsorption : Prop :=
  ∀ (n : ℕ) {k : ℕ} (N M : Submodule (ZMod 2) (Fin k → ZMod 2)),
    IsDefect N → IsDefect M → N ≤ M →
      cssColumnProjection n M * cssColumnProjection n N = cssColumnProjection n M

def CodeInclusion : Prop :=
  ∀ (n : ℕ) {k : ℕ} (N M : Submodule (ZMod 2) (Fin k → ZMod 2)),
    IsDefect N → IsDefect M → N ≤ M →
      LinearMap.range (cssColumnProjection n M).mulVecLin ≤
        LinearMap.range (cssColumnProjection n N).mulVecLin

def WuCodeImage : Prop :=
  ∀ (n : ℕ) {k : ℕ}, 4 ∣ k →
    ∀ N : Submodule (ZMod 2) (Fin k → ZMod 2), IsDefect N → allOnes k ∉ N →
    (LinearMap.range (cssColumnProjection n N).mulVecLin).map
      (cssColumnProjection n (Submodule.span (ZMod 2) {allOnes k})).mulVecLin =
    LinearMap.range
      (cssColumnProjection n (N ⊔ Submodule.span (ZMod 2) {allOnes k})).mulVecLin

def RawAntitone : Prop :=
  ∀ n k : ℕ, Antitone (fun r =>
    ⨆ N : {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
      IsDefect N ∧ Module.finrank (ZMod 2) N = r ∧ allOnes k ∉ N},
      LinearMap.range (cssColumnProjection n N.val).mulVecLin)

def RawHigher : Prop :=
  ∀ n k r : ℕ,
    (⨆ N : {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
      IsDefect N ∧ Module.finrank (ZMod 2) N = r ∧ allOnes k ∉ N},
      LinearMap.range (cssColumnProjection n N.val).mulVecLin) =
    (⨆ N : {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
      IsDefect N ∧ r ≤ Module.finrank (ZMod 2) N ∧ allOnes k ∉ N},
      LinearMap.range (cssColumnProjection n N.val).mulVecLin)

def OrdinaryAntitone : Prop :=
  ∀ n k : ℕ, Antitone (fun r =>
    if 4 ∣ k then
      (⨆ N : {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
        IsDefect N ∧ Module.finrank (ZMod 2) N = r ∧ allOnes k ∉ N},
        LinearMap.range (cssColumnProjection n N.val).mulVecLin).map
          (1 - cssColumnProjection n (Submodule.span (ZMod 2) {allOnes k})).mulVecLin
    else
      (⨆ N : {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
        IsDefect N ∧ Module.finrank (ZMod 2) N = r ∧ allOnes k ∉ N},
        LinearMap.range (cssColumnProjection n N.val).mulVecLin))

def WuFiltrationImage : Prop :=
  ∀ {k : ℕ}, 0 < k → 4 ∣ k → ∀ n r : ℕ,
    (⨆ N : {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
      IsDefect N ∧ Module.finrank (ZMod 2) N = r ∧ allOnes k ∉ N},
      LinearMap.range (cssColumnProjection n N.val).mulVecLin).map
        (cssColumnProjection n (Submodule.span (ZMod 2) {allOnes k})).mulVecLin =
    (⨆ M : {M : Submodule (ZMod 2) (Fin k → ZMod 2) //
      IsDefect M ∧ Module.finrank (ZMod 2) M = r + 1 ∧ allOnes k ∈ M},
      LinearMap.range (cssColumnProjection n M.val).mulVecLin)

def ExceptionalStep : Prop :=
  ∀ {k : ℕ}, 0 < k → 4 ∣ k → ∀ n r : ℕ,
    (⨆ M : {M : Submodule (ZMod 2) (Fin k → ZMod 2) //
      IsDefect M ∧ Module.finrank (ZMod 2) M = r + 2 ∧ allOnes k ∈ M},
      LinearMap.range (cssColumnProjection n M.val).mulVecLin) ≤
    (⨆ N : {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
      IsDefect N ∧ Module.finrank (ZMod 2) N = r + 1 ∧ allOnes k ∈ N},
      LinearMap.range (cssColumnProjection n N.val).mulVecLin)

def ExceptionalAntitone : Prop :=
  ∀ {k : ℕ}, 0 < k → 4 ∣ k → ∀ n : ℕ, Antitone (fun r =>
    ⨆ M : {M : Submodule (ZMod 2) (Fin k → ZMod 2) //
      IsDefect M ∧ Module.finrank (ZMod 2) M = r + 1 ∧ allOnes k ∈ M},
      LinearMap.range (cssColumnProjection n M.val).mulVecLin)

def ExceptionalZeroLayer : Prop :=
  ∀ {k : ℕ}, 0 < k → ∀ n : ℕ,
    (⨆ M : {M : Submodule (ZMod 2) (Fin k → ZMod 2) //
      IsDefect M ∧ Module.finrank (ZMod 2) M = 0 ∧ allOnes k ∈ M},
      LinearMap.range (cssColumnProjection n M.val).mulVecLin) = ⊥

end CSSFiltrationExpected

