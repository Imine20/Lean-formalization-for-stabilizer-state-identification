namespace PhaseAverageExpected
open ExactCriticalCurve.Binary ExactCriticalCurve.Quantum

abbrev RawPhaseData (m : ℕ) :=
  (Fin m → ZMod 4) × ({p : Fin m × Fin m // p.1 < p.2} → ZMod 2)

def RawPhaseValue {m : ℕ} (q : RawPhaseData m) (z : Fin m → ZMod 2) : ZMod 4 :=
  (∑ j, q.1 j * ((z j).val : ZMod 4)) +
    2 * ∑ p, ((q.2 p).val : ZMod 4) * ((z p.val.1).val : ZMod 4) *
      ((z p.val.2).val : ZMod 4)

def RawCoefficientPairing {m : ℕ} (q : RawPhaseData m)
    (A : Fin m → ZMod 4) (B : {p : Fin m × Fin m // p.1 < p.2} → ZMod 2) : ZMod 4 :=
  (∑ j, q.1 j * A j) + 2 * ((∑ p, q.2 p * B p : ZMod 2).val : ZMod 4)

theorem phaseValue_expanded {m : ℕ} (q : RawPhaseData m) (z : Fin m → ZMod 2) :
    quadraticPhaseValue q z = RawPhaseValue q z := rfl

theorem phasePairing_expanded {m : ℕ} (q : RawPhaseData m)
    (A : Fin m → ZMod 4) (B : {p : Fin m × Fin m // p.1 < p.2} → ZMod 2) :
    phaseCoefficientPairing q A B = RawCoefficientPairing q A B := rfl

theorem phaseStatistics_expanded {k m : ℕ} (X Y : Fin k → Fin m → ZMod 2) :
    phaseStatisticsVanish X Y ↔
      (∀ j, (∑ i, ((X i j).val : ZMod 4)) - (∑ i, ((Y i j).val : ZMod 4)) = 0) ∧
      (∀ p : {p : Fin m × Fin m // p.1 < p.2},
        (∑ i, X i p.val.1 * X i p.val.2) - (∑ i, Y i p.val.1 * Y i p.val.2) = 0) :=
  Iff.rfl

def ActualPairCount : Prop :=
  ∀ m : ℕ, Fintype.card {p : Fin m × Fin m // p.1 < p.2} = Nat.choose m 2

def ActualCoefficientCount : Prop :=
  ∀ m : ℕ, Nat.card (RawPhaseData m) = 4 ^ m * 2 ^ (Nat.choose m 2)

def PairingCoefficientAdditive : Prop :=
  ∀ {m : ℕ} (q s : RawPhaseData m) (A : Fin m → ZMod 4)
    (B : {p : Fin m × Fin m // p.1 < p.2} → ZMod 2),
    RawCoefficientPairing (q+s) A B =
      RawCoefficientPairing q A B + RawCoefficientPairing s A B

def ValueEqualsCoordinatePairing : Prop :=
  ∀ {m : ℕ} (q : RawPhaseData m) (z : Fin m → ZMod 2),
    RawPhaseValue q z =
      RawCoefficientPairing q (fun j => ((z j).val : ZMod 4))
