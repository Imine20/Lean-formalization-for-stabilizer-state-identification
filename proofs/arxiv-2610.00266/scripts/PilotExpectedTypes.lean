def FiniteGroupType : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) V),
    Finite {a : V ≃ₗ[ZMod 2] V // ∀ x y, B (a x) (a y) = B x y}

def FintypeGroupType : Type (u + 1) :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) V),
    Fintype {a : V ≃ₗ[ZMod 2] V // ∀ x y, B (a x) (a y) = B x y}

example {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) V) :
    BinarySymplecticIsometryGroup B = {a : V ≃ₗ[ZMod 2] V // ∀ x y, B (a x) (a y) = B x y} := rfl

example {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    {E : Type v} [AddCommGroup E] [Module (ZMod 2) E]
    (f g : E →ₗ[ZMod 2] V) (h : LinearMap.ker f = LinearMap.ker g) :
    symplecticTupleRangeEquiv f g h =
      f.quotKerEquivRange.symm.trans
        ((Submodule.quotEquivOfEq _ _ h).trans g.quotKerEquivRange) := rfl

example {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] (n : ℕ) :
    symplecticTupleLinearEquiv (V := V) n = (Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) := rfl

example {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) V) (hB : B.IsAlt) (hnd : B.Nondegenerate)
    (n : ℕ) (x : Fin n → V) :
    (symplecticTupleOrbitEquivRealized B hB hnd n (Quotient.mk _ x)).val =
      (LinearMap.ker ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x),
        B.comp ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x)
          ((Pi.basisFun (ZMod 2) (Fin n)).constr (ZMod 2) x)) := rfl
