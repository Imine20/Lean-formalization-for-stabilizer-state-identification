namespace CompressedCSSMembershipExpected
open ExactCriticalCurve ExactCriticalCurve.Binary ExactCriticalCurve.Quantum Matrix Classical
open scoped BigOperators Polynomial ComplexOrder MatrixOrder

def Space (n k : ℕ) :
    Submodule ℝ (Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ) :=
  Submodule.span ℝ (Set.range (fun T : StochasticLagrangian k =>
    stochasticFixedProjection n k * relationOperator n T.carrier * stochasticFixedProjection n k))

def Corner (n k : ℕ) : Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ :=
  stochasticFixedProjection n k *
    (if 4 ∣ k then 1 - cssColumnProjection n (wuLine k) else 1)

def OrdinarySum (n k r : ℕ) : Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ :=
  ∑ N : OrdinaryDefect k r, Corner n k * cssColumnProjection n N.val * (Corner n k)ᴴ

def ExceptionalSum (n k r : ℕ) : Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ :=
  ∑ N : ExceptionalDefect k r, stochasticFixedProjection n k * cssColumnProjection n N.val *
    (stochasticFixedProjection n k)ᴴ

def ActualSupport {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι ℂ) (h : A.IsHermitian) : Matrix ι ι ℂ :=
  Polynomial.aeval A
    (1 - ∏ i ∈ Finset.univ.filter (fun i => h.eigenvalues i ≠ 0),
      (1 - Polynomial.C ((h.eigenvalues i)⁻¹) * Polynomial.X))

def OrdinarySupport (n k r : ℕ) : Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ :=
  ActualSupport (OrdinarySum n k r) (ordinaryFixedCSSSum_posSemidef n k r).isHermitian

def ExceptionalSupport (n k r : ℕ) : Matrix (ColumnConfig n k) (ColumnConfig n k) ℂ :=
  ActualSupport (ExceptionalSum n k r) (exceptionalFixedCSSSum_posSemidef n k r).isHermitian

def WuCommutes : Prop :=
  ∀ n k : ℕ, stochasticFixedProjection n k * cssColumnProjection n (wuLine k) =
    cssColumnProjection n (wuLine k) * stochasticFixedProjection n k

def CSSCompression : Prop :=
  ∀ (n : ℕ) {k : ℕ} (N : Submodule (ZMod 2) (BinaryVector k)), IsDefect N →
    stochasticFixedProjection n k * cssColumnProjection n N * stochasticFixedProjection n k ∈
      Space n k

def CornerMember : Prop := ∀ n k : ℕ, Corner n k ∈ Space n k

def CornerProduct : Prop :=
  ∀ (n : ℕ) {k : ℕ} (N : Submodule (ZMod 2) (BinaryVector k)),
    Corner n k * cssColumnProjection n N * (Corner n k)ᴴ =
      Corner n k * (stochasticFixedProjection n k * cssColumnProjection n N *
        stochasticFixedProjection n k) * Corner n k

def OrdinarySumMember : Prop := ∀ n k r : ℕ, OrdinarySum n k r ∈ Space n k
def ExceptionalSumMember : Prop := ∀ n k r : ℕ, ExceptionalSum n k r ∈ Space n k
def OrdinarySupportMember : Prop := ∀ n k r : ℕ, OrdinarySupport n k r ∈ Space n k
def ExceptionalSupportMember : Prop := ∀ n k r : ℕ, ExceptionalSupport n k r ∈ Space n k

def OrdinaryDifferenceMember : Prop :=
  ∀ n k r s : ℕ, OrdinarySupport n k r - OrdinarySupport n k s ∈ Space n k
def ExceptionalDifferenceMember : Prop :=
  ∀ n k r s : ℕ, ExceptionalSupport n k r - ExceptionalSupport n k s ∈ Space n k

def WuOrdinary : Prop :=
  ∀ {k : ℕ}, 4 ∣ k → ∀ n r : ℕ, cssColumnProjection n (wuLine k) * OrdinarySupport n k r = 0
def OrdinaryWu : Prop :=
  ∀ {k : ℕ}, 4 ∣ k → ∀ n r : ℕ, OrdinarySupport n k r * cssColumnProjection n (wuLine k) = 0
def WuExceptional : Prop :=
  ∀ {k : ℕ}, 4 ∣ k → ∀ n r : ℕ,
    cssColumnProjection n (wuLine k) * ExceptionalSupport n k r = ExceptionalSupport n k r
def ExceptionalWu : Prop :=
  ∀ {k : ℕ}, 4 ∣ k → ∀ n r : ℕ,
    ExceptionalSupport n k r * cssColumnProjection n (wuLine k) = ExceptionalSupport n k r
def CrossBranchZero : Prop :=
  ∀ {k : ℕ}, 4 ∣ k → ∀ n r s : ℕ, OrdinarySupport n k r * ExceptionalSupport n k s = 0

example (n k r : ℕ) : ordinaryFixedCSSSum n k r = OrdinarySum n k r := rfl
example (n k r : ℕ) : exceptionalFixedCSSSum n k r = ExceptionalSum n k r := rfl
example (n k r : ℕ) : ordinaryFixedCSSProjection n k r = OrdinarySupport n k r := rfl
example (n k r : ℕ) : exceptionalFixedCSSProjection n k r = ExceptionalSupport n k r := rfl

