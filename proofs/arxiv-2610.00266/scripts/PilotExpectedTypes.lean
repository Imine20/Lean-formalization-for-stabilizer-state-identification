namespace RelationDiagonalExpected
open Classical
open ExactCriticalCurve.Binary ExactCriticalCurve.Counting ExactCriticalCurve.Quantum

def Delta (k : ℕ) : Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2)) :=
  LinearMap.range
    ((LinearMap.id : (Fin k → ZMod 2) →ₗ[ZMod 2] (Fin k → ZMod 2)).prod LinearMap.id)

def Dimension {k : ℕ}
    (T : Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))) : ℕ :=
  Module.finrank (ZMod 2) (T ⊓ Delta k :
    Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2)))

def Count (k r : ℕ) : ℕ :=
  Nat.card {U : Submodule (ZMod 2) (Fin k → ZMod 2) //
    Module.finrank (ZMod 2) U = r}

def ActualPolynomial (k : ℕ) : Polynomial ℂ :=
  ∑ T : StochasticLagrangian k, Polynomial.monomial (Dimension T.carrier) 1

def CoefficientPolynomial (k : ℕ) : Polynomial ℂ :=
  ∑ r ∈ Finset.range k,
    Polynomial.monomial (k-r) ((Count (k-1) r : ℂ)*(2 : ℂ)^(r.choose 2))

def MatrixTrace : Prop :=
  ∀ {k : ℕ} (T : Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))),
    Matrix.trace (fun x y => if (x,y) ∈ T then (1 : ℂ) else 0) =
      (2 : ℂ)^(Dimension T)

def TensorTrace : Prop :=
  ∀ n : ℕ, ∀ {k : ℕ}
    (T : Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))),
    Matrix.trace (relationOperator n T) = ((2 : ℂ)^n)^(Dimension T)

def ActualEvaluation : Prop :=
  ∀ n k : ℕ, 1 ≤ k →
    (ActualPolynomial k).eval ((2 : ℂ)^n) =
      (2 : ℂ)^n * ∏ j ∈ Finset.range (k-1), ((2 : ℂ)^n+(2 : ℂ)^j)

def Homogeneous : Prop :=
  ∀ (m : ℕ) (x : ℂ), x ≠ 0 →
    (∑ r ∈ Finset.range (m+1), (Count m r : ℂ)*(2 : ℂ)^(r.choose 2)*x^(m-r)) =
      ∏ j ∈ Finset.range m, (x+(2 : ℂ)^j)

def CandidateEvaluation : Prop :=
  ∀ n k : ℕ, 1 ≤ k →
    (CoefficientPolynomial k).eval ((2 : ℂ)^n) =
      (2 : ℂ)^n * ∏ j ∈ Finset.range (k-1), ((2 : ℂ)^n+(2 : ℂ)^j)

def PolynomialIdentity : Prop :=
  ∀ k : ℕ, 1 ≤ k → ActualPolynomial k = CoefficientPolynomial k

def ActualCoefficient : Prop :=
  ∀ k d : ℕ, (ActualPolynomial k).coeff d =
    (Nat.card {T : StochasticLagrangian k // Dimension T.carrier = d} : ℂ)

def CandidateCoefficient : Prop :=
  ∀ k ell : ℕ, 1 ≤ k → ell ≤ k-1 →
    (CoefficientPolynomial k).coeff (k-ell) =
      (Count (k-1) ell : ℂ)*(2 : ℂ)^(ell.choose 2)

def OrdinaryStratum : Prop :=
  ∀ k ell : ℕ, 1 ≤ k → ell ≤ k-1 →
    Nat.card {T : StochasticLagrangian k // Dimension T.carrier = k-ell} =
      2^(ell.choose 2)*Count (k-1) ell

def DiagonalTransport : Prop :=
  ∀ {k : ℕ} (mask : Fin k → Bool)
    (T : Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))),
    T.map (signatureSwitch mask).toLinearMap ⊓ Delta k = T ⊓ Delta k

def SignedStratum : Prop :=
  ∀ {k : ℕ} (mask : Fin k → Bool) (ell : ℕ), 1 ≤ k → ell ≤ k-1 →
    Nat.card {T : SignedStochasticLagrangian mask // Dimension T.carrier = k-ell} =
      2^(ell.choose 2)*Count (k-1) ell

