        (fun p => (∑ i, X i p.val.1 * X i p.val.2) - (∑ i, Y i p.val.1 * Y i p.val.2))

def ActualPairingCharacterSum : Prop :=
  ∀ {m : ℕ} (A : Fin m → ZMod 4) (B : {p : Fin m × Fin m // p.1 < p.2} → ZMod 2),
    (∑ q : RawPhaseData m, Complex.I ^ (RawCoefficientPairing q A B).val) =
      if (∀ j, A j=0) ∧ (∀ p, B p=0) then (Nat.card (RawPhaseData m) : ℂ) else 0

def ActualPhaseAverage : Prop :=
  ∀ {k m : ℕ} (X Y : Fin k → Fin m → ZMod 2),
    (∑ q : RawPhaseData m, Complex.I ^
      ((∑ i, RawPhaseValue q (X i)) - (∑ i, RawPhaseValue q (Y i))).val) =
      if phaseStatisticsVanish X Y then (Nat.card (RawPhaseData m) : ℂ) else 0

def ActualPhaseAverageCounted : Prop :=
  ∀ {k m : ℕ} (X Y : Fin k → Fin m → ZMod 2),
    (∑ q : RawPhaseData m, Complex.I ^
      ((∑ i, RawPhaseValue q (X i)) - (∑ i, RawPhaseValue q (Y i))).val) =
      if phaseStatisticsVanish X Y
      then ((4 ^ m * 2 ^ (Nat.choose m 2) : ℕ) : ℂ) else 0

end PhaseAverageExpected

