  ∀ {m : ℕ}, StochasticLagrangian (m+1) →
    Matrix (CSSQuotient (wuLine (m+1))) (CSSQuotient (wuLine (m+1))) ℂ

def ShorteningQuotientIndicator : Prop :=
  ∀ {m : ℕ} (R : StochasticLagrangian (m+1)), (allOnes (m+1),0) ∈ R.carrier →
    cosetIndicator (orthogonal (wuLine (m+1))) (wuLine (m+1)) * shorteningQuotientMatrix R *
      (cosetIndicator (orthogonal (wuLine (m+1))) (wuLine (m+1)))ᴴ =
        relationMatrix R.carrier

def ShorteningQuotientNormalization : Prop :=
  ∀ {m : ℕ} (R : StochasticLagrangian (m+1)), (allOnes (m+1),0) ∈ R.carrier →
    (2 : ℂ) • (cssCosetSynthesis (wuLine (m+1)) * shorteningQuotientMatrix R *
      (cssCosetSynthesis (wuLine (m+1)))ᴴ) = relationMatrix R.carrier

def ShorteningRelationReindex : Prop :=
  ∀ {m : ℕ} (h4 : 4 ∣ m+1) (S : StochasticLagrangian m),
    ((1 : Matrix (ZMod 2) (ZMod 2) ℂ) ⊗ₖ shorteningQuotientMatrix (shorteningClosedLift h4 S)).submatrix
      (shorteningLabelEquiv (shortening_predecessor_odd h4))
      (shorteningLabelEquiv (shortening_predecessor_odd h4)) = relationMatrix S.carrier

def ShorteningOneRelation : Prop :=
  ∀ {m : ℕ} (h4 : 4 ∣ m+1) (S : StochasticLagrangian m),
    (2 : ℂ) • (shorteningOneSynthesis (shortening_predecessor_odd h4) *
      relationMatrix S.carrier * (shorteningOneSynthesis (shortening_predecessor_odd h4))ᴴ) =
      (1 : Matrix (ZMod 2) (ZMod 2) ℂ) ⊗ₖ relationMatrix (shorteningClosedLift h4 S).carrier

def ShorteningTensorRelation : Prop :=
  ∀ {m : ℕ} (n : ℕ) (h4 : 4 ∣ m+1) (S : StochasticLagrangian m),
    ((2 : ℂ)^n) • (shorteningSynthesis n (shortening_predecessor_odd h4) *
      relationOperator n S.carrier * (shorteningSynthesis n (shortening_predecessor_odd h4))ᴴ) =
      (1 : Matrix (Fin n → ZMod 2) (Fin n → ZMod 2) ℂ) ⊗ₖ
        relationOperator n (shorteningClosedLift h4 S).carrier

def ShorteningIndividualCompression : Prop :=
  ∀ {m : ℕ} (n : ℕ) (h4 : 4 ∣ m+1) (T : StochasticLagrangian (m+1)),
    (1 : Matrix (Fin n → ZMod 2) (Fin n → ZMod 2) ℂ) ⊗ₖ
      (cssColumnProjection n (wuLine (m+1)) * relationOperator n T.carrier *
        cssColumnProjection n (wuLine (m+1))) =
      (if (allOnes (m+1),0) ∈ T.carrier then (2 : ℂ)^n else 1) •
        (shorteningSynthesis n (shortening_predecessor_odd h4) *
          relationOperator n (shorteningRelation h4 T).carrier *
            (shorteningSynthesis n (shortening_predecessor_odd h4))ᴴ)

def ShorteningWeightedFiber : Prop :=
  ∀ {m : ℕ} (n : ℕ) (h4 : 4 ∣ m+1) (S : StochasticLagrangian m),
    (∑ T : {T : StochasticLagrangian (m+1) // shorteningRelation h4 T = S},
      if (allOnes (m+1),0) ∈ T.val.carrier then (2 : ℂ)^n else 1) =
        (2 : ℂ)^n + (2 : ℂ)^((m+1)-2)

def ShorteningSuccessorSum : Prop :=
  ∀ {m : ℕ} (n : ℕ) (h4 : 4 ∣ m+1),
    (1 : Matrix (Fin n → ZMod 2) (Fin n → ZMod 2) ℂ) ⊗ₖ
      (cssColumnProjection n (wuLine (m+1)) * stochasticRelationSum n (m+1) *
        cssColumnProjection n (wuLine (m+1))) =
      ((2 : ℂ)^n + (2 : ℂ)^((m+1)-2)) •
        (shorteningSynthesis n (shortening_predecessor_odd h4) * stochasticRelationSum n m *
          (shorteningSynthesis n (shortening_predecessor_odd h4))ᴴ)

def ShorteningPositiveObject : Type :=
  ∀ {k : ℕ} (n : ℕ), 0 < k → 4 ∣ k →
    Matrix ((Fin n → ZMod 2) × (Fin n → Fin k → ZMod 2)) (Fin n → Fin (k-1) → ZMod 2) ℂ

def ShorteningPositiveIsometry : Prop :=
  ∀ {k : ℕ} (n : ℕ) (hk : 0 < k) (h4 : 4 ∣ k),
    (shorteningSynthesisPositive n hk h4)ᴴ * shorteningSynthesisPositive n hk h4 = 1

def ShorteningPositiveRangeProjection : Prop :=
  ∀ {k : ℕ} (n : ℕ) (hk : 0 < k) (h4 : 4 ∣ k),
    shorteningSynthesisPositive n hk h4 * (shorteningSynthesisPositive n hk h4)ᴴ =
      (1 : Matrix (Fin n → ZMod 2) (Fin n → ZMod 2) ℂ) ⊗ₖ cssColumnProjection n (wuLine k)

def ShorteningPositiveOperatorSum : Prop :=
  ∀ {k : ℕ} (n : ℕ) (hk : 0 < k) (h4 : 4 ∣ k),
    (1 : Matrix (Fin n → ZMod 2) (Fin n → ZMod 2) ℂ) ⊗ₖ
      (cssColumnProjection n (wuLine k) * stochasticRelationSum n k * cssColumnProjection n (wuLine k)) =
      ((2 : ℂ)^n + (2 : ℂ)^(k-2)) •
        (shorteningSynthesisPositive n hk h4 * stochasticRelationSum n (k-1) *
          (shorteningSynthesisPositive n hk h4)ᴴ)
end ShorteningOperatorsExpected


