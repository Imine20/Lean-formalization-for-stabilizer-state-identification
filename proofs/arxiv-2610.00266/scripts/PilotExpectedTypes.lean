open ExactCriticalCurve ExactCriticalCurve.Binary ExactCriticalCurve.Quantum Module
abbrev V (k : ℕ) := Fin k → ZMod 2
abbrev D (k : ℕ) := Submodule (ZMod 2) (V k)
def Ordinary (k r : ℕ) := {N : D k //
  (∀ x ∈ N, weightQuadratic x = 0) ∧ finrank (ZMod 2) N = r ∧
    (fun _ : Fin k => (1 : ZMod 2)) ∉ N}
def Kernel (N : D k) := {g : StochasticIsometryGroup k //
  N.map g.val.toLinearMap = N ∧ ∀ x : orthogonal N, g.val x.val - x.val ∈ N}
def Fixer (N : D k) := {g : StochasticIsometryGroup k //
  ∀ x : orthogonal N, g.val x.val = x.val}
abbrev Quotient (N : D k) := orthogonal N ⧸ N.comap (orthogonal N).subtype
def ActualCard : Prop := ∀ {k r : ℕ} (N : Ordinary k r),
  Nat.card (Kernel N.val) =
    Nat.card ((Fin r → ZMod 2) ≃ₗ[ZMod 2] (Fin r → ZMod 2)) *
      2 ^ (r * (k - 2*r - 1)) * 2 ^ r.choose 2
def IntrinsicCard : Prop := ∀ {k r : ℕ} (N : Ordinary k r),
  Nat.card (Kernel N.val) =
    Nat.card (N.val ≃ₗ[ZMod 2] N.val) *
      2 ^ (r * (finrank (ZMod 2) (Quotient N.val) - 1)) * 2 ^ r.choose 2
def FixerCard : Prop := ∀ {k : ℕ} (N : D k), (∀ x ∈ N, weightQuadratic x = 0) →
  Nat.card (Fixer N) = 2 ^ (finrank (ZMod 2) N).choose 2
def PositiveQuotient : Prop := ∀ {k r : ℕ} (N : Ordinary k r),
  0 < finrank (ZMod 2) (Quotient N.val)
def RankBound : Prop := ∀ {k r : ℕ} (N : Ordinary k r), 2*r < k
def PairingDimension : Prop := ∀ {k : ℕ} (N : D k),
  finrank (ZMod 2) (V k ⧸ orthogonal N) = finrank (ZMod 2) N
def RestrictionOnto : Prop := ∀ {k : ℕ} (N : D k) (hN : ∀ x ∈ N, weightQuadratic x = 0),
  Function.Surjective (stochasticParabolicRestriction N hN)
def RestrictionKernel : Prop := ∀ {k : ℕ} (N : D k) (hN : ∀ x ∈ N, weightQuadratic x = 0)
  (g : stochasticParabolicKernel N),
  stochasticParabolicRestriction N hN g = 1 ↔
    ∀ x : orthogonal N, g.val.val x.val = x.val
def FixerDifference : Prop := ∀ {k : ℕ} (N : D k) (g : stochasticOrthogonalFixer N)
  (x : V k), g.val.val x - x ∈ N
def FixerEquivType : Type := ∀ {k : ℕ} (N : D k),
  (∀ x ∈ N, weightQuadratic x = 0) →
    Fixer N ≃ {B : LinearMap.BilinForm (ZMod 2) (V k ⧸ orthogonal N) // ∀ x, B x x = 0}
def PairingEquivType : Type := ∀ {k : ℕ} (N : D k),
  N ≃ₗ[ZMod 2] ((V k ⧸ orthogonal N) →ₗ[ZMod 2] ZMod 2)
def KernelEquivType : Type := ∀ {k : ℕ} (N : D k) (hN : ∀ x ∈ N, weightQuadratic x = 0),
  (stochasticParabolicRestriction N hN).ker ≃ Fixer N
def KernelType : Type := ∀ {k : ℕ}, D k → Subgroup (StochasticIsometryGroup k)
end ParabolicExpected
