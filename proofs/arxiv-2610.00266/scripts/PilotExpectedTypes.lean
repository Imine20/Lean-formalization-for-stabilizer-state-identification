    freeRegisterSpace (Fin n → ZMod 2)
      (LinearMap.range (exceptionalCSSGrade n (m+1) (r+1)).mulVecLin)

def ShorteningGradeRank : Prop :=
  ∀ (n r : ℕ) {m : ℕ}, 4 ∣ m+1 →
    (ordinaryCSSGrade n m r).rank = 2^n * (exceptionalCSSGrade n (m+1) (r+1)).rank

def ShorteningPositiveGrade : Prop :=
  ∀ (n r : ℕ) {k : ℕ} (hk : 0<k) (h4 : 4 ∣ k),
    shorteningSynthesisPositive n hk h4 * ordinaryCSSGrade n (k-1) r *
      (shorteningSynthesisPositive n hk h4)ᴴ =
      (1 : Matrix (Fin n → ZMod 2) (Fin n → ZMod 2) ℂ) ⊗ₖ exceptionalCSSGrade n k (r+1)

def ShorteningPositiveGradeRank : Prop :=
  ∀ (n r : ℕ) {k : ℕ}, 0<k → 4 ∣ k →
    (ordinaryCSSGrade n (k-1) r).rank = 2^n * (exceptionalCSSGrade n k (r+1)).rank

def ShorteningConditionalScalar : Prop :=
  ∀ (n r : ℕ) {m : ℕ}, 4 ∣ m+1 → ∀ c : ℂ,
    stochasticRelationSum n m * ordinaryCSSGrade n m r = c • ordinaryCSSGrade n m r →
    stochasticRelationSum n (m+1) * exceptionalCSSGrade n (m+1) (r+1) =
      (((2 : ℂ)^n+(2 : ℂ)^((m+1)-2))*c) • exceptionalCSSGrade n (m+1) (r+1)

def ShorteningExceptionalProduct : Prop :=
  ∀ (n r : ℕ) {m : ℕ}, 4 ∣ m+1 → ExceptionalDefect (m+1) (r+1) → m ≤ n →
    ∃ θ : ℝ,
      (stochasticRelationSum n (m+1) * exceptionalCSSGrade n (m+1) (r+1) =
          θ • exceptionalCSSGrade n (m+1) (r+1) ∧
       exceptionalCSSGrade n (m+1) (r+1) * stochasticRelationSum n (m+1) =
          θ • exceptionalCSSGrade n (m+1) (r+1)) ∧
      (θ : ℂ) = ((2 : ℂ)^n+(2 : ℂ)^((m+1)-2)) *
        ((Fintype.card (StochasticIsometryGroup m) : ℂ) /
          ((2 : ℂ)^(r*(m-r-2)) * ∏ j ∈ Finset.range r, ((2 : ℂ)^(j+1)-1)) *
            ∏ j ∈ Finset.range r, ((2 : ℂ)^n+(2 : ℂ)^(m-r-1+j)))

def ShorteningPositiveExceptionalProduct : Prop :=
  ∀ (n r : ℕ) {k : ℕ}, 0<k → 4 ∣ k → ExceptionalDefect k (r+1) → k-1 ≤ n →
    ∃ θ : ℝ,
      (stochasticRelationSum n k * exceptionalCSSGrade n k (r+1) = θ • exceptionalCSSGrade n k (r+1) ∧
       exceptionalCSSGrade n k (r+1) * stochasticRelationSum n k = θ • exceptionalCSSGrade n k (r+1)) ∧
      (θ : ℂ) = ((2 : ℂ)^n+(2 : ℂ)^(k-2)) *
        ((Fintype.card (StochasticIsometryGroup (k-1)) : ℂ) /
          ((2 : ℂ)^(r*((k-1)-r-2)) * ∏ j ∈ Finset.range r, ((2 : ℂ)^(j+1)-1)) *
            ∏ j ∈ Finset.range r, ((2 : ℂ)^n+(2 : ℂ)^((k-1)-r-1+j)))

def ProjectionRangeUniqueness : Prop :=
  ∀ {ι : Type u} [Fintype ι] [DecidableEq ι] (P Q : Matrix ι ι ℂ),
    P.IsHermitian → Q.IsHermitian → P*P=P → Q*Q=Q →
    LinearMap.range P.mulVecLin = LinearMap.range Q.mulVecLin → P=Q

def ProjectionCompressionRange : Prop :=
  ∀ {ι : Type u} {κ : Type v} [Fintype ι] [Fintype κ]
    (U : Matrix κ ι ℂ) (P : Matrix ι ι ℂ), P.IsHermitian → P*P=P →
    LinearMap.range (U*P*Uᴴ).mulVecLin = (LinearMap.range P.mulVecLin).map U.mulVecLin

def FreeRegisterIntersection : Prop :=
  ∀ {α : Type u} {β : Type v} [Fintype α] (V W : Submodule ℂ (β → ℂ)),
    freeRegisterSpace α (V ⊓ W) = freeRegisterSpace α V ⊓ freeRegisterSpace α W

def CommutingProjectionRange : Prop :=
  ∀ {ι : Type u} [Fintype ι] (P Q : Matrix ι ι ℂ), P*P=P → Q*Q=Q → P*Q=Q*P →
    LinearMap.range (P*Q).mulVecLin = LinearMap.range P.mulVecLin ⊓ LinearMap.range Q.mulVecLin

def ExceptionalFiltrationSupport : Prop :=
  ∀ (n k r : ℕ), 4 ∣ k →
    exceptionalCSSFiltration n k r ≤ LinearMap.range (cssColumnProjection n (wuLine k)).mulVecLin

def FreeRegisterFaithful : Prop :=
  ∀ {α : Type u} {β : Type v} [Nonempty α] [DecidableEq α] (A B : Matrix β β ℂ),
    (1 : Matrix α α ℂ) ⊗ₖ A = (1 : Matrix α α ℂ) ⊗ₖ B → A=B

def ExceptionalGradeCompression : Prop :=
  ∀ (n k r : ℕ), 4 ∣ k →
    (cssColumnProjection n (wuLine k)*stochasticRelationSum n k*cssColumnProjection n (wuLine k)) *
      exceptionalCSSGrade n k r = stochasticRelationSum n k * exceptionalCSSGrade n k r
end ShorteningFixedGradesExpected

