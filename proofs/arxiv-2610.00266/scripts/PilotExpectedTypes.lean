/-- Independent subgroup data: exactly the actual finite Pauli subgroup and two conditions. -/
def RawStabilizerData (n : ℕ) :=
  {S : Subgroup (PauliLabel n) //
    (∀ g ∈ S, g.shift = 0 → g.clock = 0 → g.phase = 0) ∧ Nat.card S = 2 ^ n}

def stabilizerDataEquiv (n : ℕ) : StabilizerGroup n ≃ RawStabilizerData n where
  toFun S := ⟨S.carrier, S.phase_free, S.card_eq⟩
  invFun S := ⟨S.val, S.property.1, S.property.2⟩
  left_inv S := by cases S; rfl
  right_inv S := by cases S; rfl

/-- Independent matrix data, exposing central phase, shift, clock and the actual finite sum. -/
def SubgroupAverage {n : ℕ} (S : StabilizerGroup n) :
    Matrix (Fin n → ZMod 2) (Fin n → ZMod 2) ℂ :=
  (Fintype.card S.carrier : ℂ)⁻¹ •
    ∑ g : S.carrier, Complex.I ^ g.val.phase.val •
      (fun x y => if x = y + g.val.shift
        then (-1 : ℂ) ^ (∑ a, g.val.clock a * y a : ZMod 2).val else 0)

theorem stabilizerAverage_expanded {n : ℕ} (S : StabilizerGroup n) :
    stabilizerProjection S = SubgroupAverage S := rfl

theorem computationalGroup_expanded (n : ℕ) (g : PauliLabel n) :
    g ∈ computationalPauliGroup n ↔ g.phase = 0 ∧ g.shift = 0 := Iff.rfl

theorem stabilizerMoment_expanded (n k : ℕ) (X Y : Fin k → Fin n → ZMod 2) :
    stabilizerMoment n k X Y =
      (Fintype.card (StabilizerGroup n) : ℂ)⁻¹ *
        ∑ S : StabilizerGroup n, ∏ i : Fin k, SubgroupAverage S (X i) (Y i) := by
  simp [stabilizerMoment, ExactCriticalCurve.matrixTensorPower, Matrix.sum_apply,
    stabilizerAverage_expanded, Matrix.smul_apply, smul_eq_mul]

theorem stabilizerColumnMoment_expanded (n k : ℕ)
    (X Y : Fin n → Fin k → ZMod 2) :
    stabilizerColumnMoment n k X Y =
      (Fintype.card (StabilizerGroup n) : ℂ)⁻¹ *
        ∑ S : StabilizerGroup n, ∏ i : Fin k,
          SubgroupAverage S (fun a => X a i) (fun a => Y a i) :=
  stabilizerMoment_expanded n k _ _

def SGNoMinusIdentity : Prop :=
  ∀ {n : ℕ} (S : Subgroup (PauliLabel n)),
    (∀ g ∈ S, g.shift = 0 → g.clock = 0 → g.phase = 0) ↔
      (⟨2, 0, 0⟩ : PauliLabel n) ∉ S

def SGProjectiveInjective : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n),
    Function.Injective (fun g : S.carrier => (g.val.shift, g.val.clock))

def SGCommutative : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (g h : S.carrier), g * h = h * g

def SGInvolution : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (g : S.carrier), g * g = 1

def SGMemberTrace : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (g : S.carrier),
    (∑ x : Fin n → ZMod 2, pauliOperator g.val x x) =
      if g = 1 then (2 : ℂ) ^ n else 0

def SGProjectionHermitian : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n), (SubgroupAverage S)ᴴ = SubgroupAverage S

def SGProjectionIdempotent : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n),
    SubgroupAverage S * SubgroupAverage S = SubgroupAverage S

def SGProjectionPositive : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n), (SubgroupAverage S).PosSemidef

def SGProjectionTrace : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n),
    (∑ x : Fin n → ZMod 2, SubgroupAverage S x x) = 1

def SGProjectionRank : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n), (SubgroupAverage S).rank = 1

def SGProjectionVector : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n), ∃ v : (Fin n → ZMod 2) → ℂ,
    (∑ x, star (v x) * v x) = 1 ∧ (fun x y => v x * star (v y)) = SubgroupAverage S

def SGChosenVectorNormalized : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n),
    (∑ x : Fin n → ZMod 2, star (stabilizerVector S x) * stabilizerVector S x) = 1

def SGChosenVectorProjector : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n),
    (fun x y => stabilizerVector S x * star (stabilizerVector S y)) = SubgroupAverage S

def SGChosenVectorFixed : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (g : S.carrier),
    (fun x => ∑ y : Fin n → ZMod 2,
      pauliOperator g.val x y * stabilizerVector S y) = stabilizerVector S

def ComputationalGroupCard : Prop :=
  ∀ n : ℕ, Nat.card (computationalPauliGroup n) = 2 ^ n

def ComputationalVectorNorm : Prop :=
  ∀ n : ℕ,
    (∑ x : Fin n → ZMod 2, star (if x = 0 then (1 : ℂ) else 0) *
      (if x = 0 then (1 : ℂ) else 0)) = 1

def ComputationalVectorFixed : Prop :=
  ∀ (n : ℕ) (g : computationalPauliGroup n),
    (fun x => ∑ y : Fin n → ZMod 2,
      pauliOperator g.val x y * (if y = 0 then (1 : ℂ) else 0)) =
      (fun x => if x = 0 then (1 : ℂ) else 0)

def ComputationalProjection : Prop :=
  ∀ n : ℕ, SubgroupAverage (computationalStabilizerGroup n) =
    (fun x y => (if x = 0 then (1 : ℂ) else 0) *
      star (if y = 0 then (1 : ℂ) else 0))

/-- Independent synthesis and moment data in copy coordinates. -/
def StabilizerColumns (n k : ℕ) :
    Matrix (Fin k → Fin n → ZMod 2) (StabilizerGroup n) ℂ :=
  fun X S => ∏ i : Fin k, stabilizerVector S (X i)

def StabilizerMomentData (n k : ℕ) :
    Matrix (Fin k → Fin n → ZMod 2) (Fin k → Fin n → ZMod 2) ℂ :=
  (Fintype.card (StabilizerGroup n) : ℂ)⁻¹ •
    ∑ S : StabilizerGroup n, (fun X Y : Fin k → Fin n → ZMod 2 =>
      ∏ i : Fin k, SubgroupAverage S (X i) (Y i))

def SGTensorProjector : Prop :=
  ∀ {n : ℕ} (S : StabilizerGroup n) (k : ℕ),
    (fun X Y : Fin k → Fin n → ZMod 2 =>
      (∏ i : Fin k, stabilizerVector S (X i)) *
        star (∏ i : Fin k, stabilizerVector S (Y i))) =
    (fun X Y : Fin k → Fin n → ZMod 2 =>
      ∏ i : Fin k, SubgroupAverage S (X i) (Y i))

def SGGramNormalized : Prop :=
  ∀ (n k : ℕ) (S : StabilizerGroup n),
    (∑ X : Fin k → Fin n → ZMod 2,
      star (∏ i : Fin k, stabilizerVector S (X i)) *
        (∏ i : Fin k, stabilizerVector S (X i))) = 1

def SGFrameSum : Prop :=
  ∀ n k : ℕ,
    StabilizerColumns n k * (StabilizerColumns n k)ᴴ =
      ∑ S : StabilizerGroup n, (fun X Y : Fin k → Fin n → ZMod 2 =>
        ∏ i : Fin k, SubgroupAverage S (X i) (Y i))

def SGMomentTrace : Prop :=
  ∀ n k : ℕ, (∑ X : Fin k → Fin n → ZMod 2, StabilizerMomentData n k X X) = 1

def SGFrameMoment : Prop :=
  ∀ n k : ℕ, StabilizerColumns n k * (StabilizerColumns n k)ᴴ =
    (Fintype.card (StabilizerGroup n) : ℂ) • StabilizerMomentData n k

end CriticalCurveExpected

