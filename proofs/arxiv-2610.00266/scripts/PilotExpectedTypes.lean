abbrev M (n k : ℕ) := Matrix (Fin n → Fin k → ZMod 2) (Fin n → Fin k → ZMod 2) ℂ
abbrev L (k : ℕ) :=
  {r : Fin (k+1) // Nonempty (OrdinaryDefect k r.val)} ⊕
  {r : Fin (k+1) // Nonempty (ExceptionalDefect k r.val)}
def G (n k : ℕ) : L k → M n k
  | .inl r => ordinaryFixedCSSProjection n k r.val.val -
      ordinaryFixedCSSProjection n k (r.val.val+1)
  | .inr r => exceptionalFixedCSSProjection n k r.val.val -
      exceptionalFixedCSSProjection n k (r.val.val+1)
def S (n k : ℕ) : Submodule ℝ (M n k) :=
  Submodule.span ℝ (Set.range (fun T : StochasticLagrangian k =>
    stochasticFixedProjection n k * relationOperator n T.carrier * stochasticFixedProjection n k))

def ExceptionalFour : Prop :=
  ∀ {k r : ℕ}, ExceptionalDefect k r → 4 ∣ k
def ExceptionalPositive : Prop :=
  ∀ {k r : ℕ}, 0 < k → ExceptionalDefect k r → 0 < r
def GradeMembership : Prop := ∀ n k : ℕ, ∀ a : L k, G n k a ∈ S n k
def GradeHermitian : Prop := ∀ n k : ℕ, ∀ a : L k, (G n k a).IsHermitian
def ExceptionalIdempotent : Prop :=
  ∀ {k : ℕ}, 0 < k → ∀ n r : ℕ, Nonempty (ExceptionalDefect k r) →
    (exceptionalFixedCSSProjection n k r - exceptionalFixedCSSProjection n k (r+1)) *
      (exceptionalFixedCSSProjection n k r - exceptionalFixedCSSProjection n k (r+1)) =
      exceptionalFixedCSSProjection n k r - exceptionalFixedCSSProjection n k (r+1)
def GradeIdempotent : Prop :=
  ∀ {k : ℕ}, 0 < k → ∀ n : ℕ, ∀ a : L k, G n k a * G n k a = G n k a
def GradePSD : Prop :=
  ∀ {k : ℕ}, 0 < k → ∀ n : ℕ, ∀ a : L k, (G n k a).PosSemidef
def GradeNonzero : Prop :=
  ∀ {n k : ℕ}, 0 < k → k ≤ n → ∀ a : L k, G n k a ≠ 0
def CrossProduct : Prop :=
  ∀ {k : ℕ} (n r s : ℕ), Nonempty (ExceptionalDefect k s) →
    (ordinaryFixedCSSProjection n k r - ordinaryFixedCSSProjection n k (r+1)) *
      (exceptionalFixedCSSProjection n k s - exceptionalFixedCSSProjection n k (s+1)) = 0
def ExceptionalOrthogonal : Prop :=
  ∀ {k : ℕ}, 0 < k → ∀ n r s : ℕ,
    Nonempty (ExceptionalDefect k r) → Nonempty (ExceptionalDefect k s) → r ≠ s →
    (exceptionalFixedCSSProjection n k r - exceptionalFixedCSSProjection n k (r+1)) *
      (exceptionalFixedCSSProjection n k s - exceptionalFixedCSSProjection n k (s+1)) = 0
def GradeOrthogonal : Prop :=
  ∀ {k : ℕ}, 0 < k → ∀ n : ℕ, ∀ a b : L k, a ≠ b → G n k a * G n k b = 0
def GradeIndependent : Prop :=
  ∀ {n k : ℕ}, 0 < k → k ≤ n → LinearIndependent ℝ (G n k)
def DimensionBound : Prop :=
  ∀ n k : ℕ, finrank ℝ (S n k) ≤ Fintype.card (L k)
def ActualSpan : Prop :=
  ∀ {n k : ℕ}, 0 < k → k ≤ n → S n k = Submodule.span ℝ (Set.range (G n k))
def ActualDimension : Prop :=
  ∀ {n k : ℕ}, 0 < k → k ≤ n → finrank ℝ (S n k) = Fintype.card (L k)
def BasisApplication : Prop :=
  ∀ {n k : ℕ} (hk : 0 < k) (hn : k ≤ n) (a : L k),
    (physicalSectorBasis hk hn a : M n k) = G n k a
def UniqueExpansion : Prop :=
  ∀ {n k : ℕ}, 0 < k → k ≤ n → ∀ A : M n k, A ∈ S n k →
    ∃! c : L k → ℝ, A = ∑ a, c a • G n k a
def ProjectionSum : Prop :=
  ∀ {n k : ℕ}, 0 < k → k ≤ n → stochasticFixedProjection n k = ∑ a : L k, G n k a
def UniqueScalarDecomposition : Prop :=
  ∀ {n k : ℕ}, 0 < k → k ≤ n → ∀ A : M n k, A ∈ S n k →
    ∃! c : L k → ℝ, (A = ∑ a, c a • G n k a) ∧
      ∀ a : L k, A * G n k a = c a • G n k a ∧ G n k a * A = c a • G n k a

def LabelType : Type 1 := ℕ → Type
def GradeType : Type := ∀ n k : ℕ, L k → M n k
def BasisType : Type := ∀ {n k : ℕ}, 0 < k → k ≤ n → Basis (L k) ℝ (S n k)

example (k : ℕ) : PhysicalSectorLabel k = L k := rfl
example (n k : ℕ) : physicalSectorGrade n k = G n k := rfl
example (n k : ℕ) : compressedRelationSpan n k = S n k := rfl
