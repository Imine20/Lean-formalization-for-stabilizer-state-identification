def tsum_int_parity_affine_real : Prop := ∀ (p : ℤ) (f : ℝ → ℝ),
  (∑' n : ℤ, f ((p : ℝ)+2*(n : ℝ)))=∑' u : ℤ, if u%2=p%2 then f (u : ℝ) else 0

def summable_criticalWeight : Prop := ∀ c : ℤ, Summable (Weight c)
def criticalWeight_tsum_le_one : Prop := ∀ c : ℤ, (∑' r : ℕ, Weight c r) ≤ 1

def weighted_uniform_absolute_error {ι : Type u} : Prop :=
  ∀ w e : ι → ℝ, (∀ i, 0 ≤ w i) → Summable w → (∑' i, w i) ≤ 1 →
  ∀ ε : ℝ, 0 ≤ ε → (∀ i, |e i| ≤ ε) →
  Summable (fun i => w i*|e i|) ∧ (∑' i, w i*|e i|) ≤ ε

def weighted_uniform_signed_error {ι : Type u} : Prop :=
  ∀ w e : ι → ℝ, (∀ i, 0 ≤ w i) → Summable w → (∑' i, w i) ≤ 1 →
  ∀ ε : ℝ, 0 ≤ ε → (∀ i, |e i| ≤ ε) →
  Summable (fun i => w i*e i) ∧ |∑' i, w i*e i| ≤ ε

def sqrt_second_order_perturbation_abs_le : Prop :=
  ∀ t a b C z : ℝ, 0 ≤ t → 0 ≤ z → z ≤ 1 → 1 ≤ C →
  |a| ≤ C*z → |b| ≤ C*z^2 → |t-1-a-b| ≤ C*z^3 →
  |Real.sqrt t-1-a/2-b/2+a^2/8| ≤ 12*C^3*z^3

def rightTailWeight_mul_linear_pow_gaussian_bound : Prop := ∀ (v : ℝ) (q : ℕ),
  ‖W v*L v^q‖ ≤ (2*(5 : ℝ)^q/(A*Q))*(2 : ℝ)^(-(1/2 : ℝ)*v^2+((5/2 : ℝ)+(q : ℝ)/2)*|v|)

def summable_rightTailWeight_linear_pow_int : Prop :=
  ∀ q : ℕ, Summable (fun u : ℤ => W (u : ℝ)*L (u : ℝ)^q)

def summable_criticalWeight_linear_pow : Prop :=
  ∀ (c : ℤ) (q : ℕ), Summable (fun r : ℕ => Weight c r*L (2*(r : ℝ)-(c : ℝ))^q)

def rightTailWeight_parity_mass : Prop :=
