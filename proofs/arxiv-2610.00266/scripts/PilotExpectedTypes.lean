namespace DCTExpected
open ExactCriticalCurve.Asymptotics Filter
open scoped BigOperators Topology
def A : ℝ := ∏' j : ℕ, (1+(1/2:ℝ)^(j+1))
def Q : ℝ := ∏' j : ℕ, (1-(1/4:ℝ)^(j+1))
def AP (n : ℕ) : ℝ := ∏ j∈Finset.range n,(1+(1/2:ℝ)^(j+1))
def QP (l : ℕ) : ℝ := ∏ j∈Finset.range l,(1-(1/4:ℝ)^(j+1))
def Tail (n l : ℕ) : ℝ := ∏ j∈Finset.range l,(1-(4:ℝ)^((j:ℝ)-(n:ℝ)))
def Phi (u : ℝ) : ℝ := (2:ℝ)^(-(u^2+3*u+4)/2)
def F (r : ℕ) (x : ℝ) : ℝ :=
 (2:ℝ)^((r:ℝ)*((r:ℝ)-1))/(∏ j∈Finset.range r,((2:ℝ)^(j+1)-1))*
   ∏ j∈Finset.range r,(x+(2:ℝ)^(1-(j:ℝ)))
def R (c : ℤ) : ℝ := if c≤1 then AP (1-c).toNat else (∏ j∈Finset.range (c-1).toNat,(1+(2:ℝ)^j))⁻¹
def L (c : ℤ) (r : ℕ) : ℝ :=
 ((2:ℝ)^(((c:ℝ)-1)*((c:ℝ)-2)/2+1)*Q*R c)*F r ((2:ℝ)^(3-(c:ℝ)))
def W (c : ℤ) (r : ℕ) : ℝ :=
 (Phi (2*(r:ℝ)-(c:ℝ))*(1+(2:ℝ)^(-(2*(r:ℝ)-(c:ℝ))-2)))/(A*Q)
def M (c : ℤ) (C L : ℝ) (r : ℕ) : ℝ :=
 C*L*Phi (2*(r:ℝ)-(c:ℝ))*(2:ℝ)^((r:ℝ)^2+(|(c:ℝ)|+4)*(r:ℝ))
def AmpBound (c : ℤ) (C L : ℝ) (r : ℕ) : ℝ :=
 C*Phi (2*(r:ℝ)-(c:ℝ))+M c C L r
example (c : ℤ) (C L : ℝ) (r : ℕ) : physicalCriticalMomentMajorant c C L r=M c C L r := rfl
example (c : ℤ) (C L : ℝ) (r : ℕ) : physicalCriticalAmplitudeMajorant c C L r=AmpBound c C L r := rfl
def E_criticalF_denominator_one_le (r : ℕ) := 1≤∏j∈Finset.range r,((2:ℝ)^(j+1)-1)
def E_criticalF_coarse_bound (r : ℕ) (x : ℝ) := 0≤x → F r x≤(2:ℝ)^((r:ℝ)^2)*(x+2)^r
def E_critical_parameter_add_two_bound (c : ℤ) := (2:ℝ)^(3-(c:ℝ))+2≤(2:ℝ)^(|(c:ℝ)|+4)
def E_criticalF_window_bound (c : ℤ) (r : ℕ) := F r ((2:ℝ)^(3-(c:ℝ)))≤(2:ℝ)^((r:ℝ)^2+(|(c:ℝ)|+4)*(r:ℝ))
def E_physicalCriticalMomentMajorant (c : ℤ) (C L : ℝ) (r : ℕ) := ℝ
def E_physicalCriticalAmplitudeMajorant (c : ℤ) (C L : ℝ) (r : ℕ) := ℝ
def E_summable_physicalCriticalWeightMajorant (c : ℤ) (C : ℝ) := Summable (fun r : ℕ=>C*Phi (2*(r:ℝ)-(c:ℝ)))
def E_summable_physicalCriticalMomentMajorant (c : ℤ) (C L : ℝ) := Summable (M c C L)
def E_summable_physicalCriticalAmplitudeMajorant (c : ℤ) (C L : ℝ) := Summable (AmpBound c C L)
def E_physicalCriticalMoment_le_majorant (c : ℤ) (C L w v : ℝ) (r : ℕ) :=
 0≤C → 0≤L → 0≤w → 0≤v → w≤C*Phi (2*(r:ℝ)-(c:ℝ)) →
 v≤L*F r ((2:ℝ)^(3-(c:ℝ))) → w*v≤M c C L r
def E_physicalCriticalAmplitude_le_majorant (c : ℤ) (C L w v : ℝ) (r : ℕ) :=
 0≤C → 0≤L → 0≤w → 0≤v → w≤C*Phi (2*(r:ℝ)-(c:ℝ)) →
 v≤L*F r ((2:ℝ)^(3-(c:ℝ))) → w*Real.sqrt v≤AmpBound c C L r
def E_physicalCritical_reverseProduct_bounds (n l : ℕ) := 0≤Tail n l ∧ Tail n l≤1
def E_criticalAPartial_one_le (n : ℕ) := 1≤AP n
def E_physicalCritical_signedRatio_bounds (σ a b : ℝ) :=
 (σ=1∨σ= -1) → 0≤a → a≤1 → 0≤b → b≤1/2 → 0≤(1-σ*a)/(1-σ*b) ∧ (1-σ*a)/(1-σ*b)≤4
def E_physicalCritical_bulkProduct_bound (u A0 Q0 s T : ℝ) :=
 -2≤u → 1≤A0 → Q≤Q0 → 0≤s → s≤4 → 0≤T → T≤1 →
 ((Phi u*(1+(2:ℝ)^(-u-2)))/A0)*s*T/Q0≤(8/Q)*Phi u
def E_physicalWeightTail_bounds (n l : ℕ) := 0≤Tail n l ∧ Tail n l≤1
def E_physicalCritical_normalizedProduct_bound (u : ℝ) (n q l : ℕ) (s : ℝ) :=
 -2≤u → 0≤s → s≤4 →
 ((Phi u*(1+(2:ℝ)^(-u-2)))/AP n)*s*Tail n l/QP q≤(8/Q)*Phi u
def E_physicalCritical_endpoint_bound (n a : ℕ) := (a=1∨a=2) →
 ((2:ℝ)^n)^a/(Nat.card (ExactCriticalCurve.Quantum.StabilizerGroup n):ℝ)≤2*Phi ((n:ℝ)-(a:ℝ))
def E_eventually_dominated_of_finite_head (f : ℕ→ℕ→ℝ) (g b : ℕ→ℝ) (R : ℕ) :=
 Summable b → (∀r<R,Tendsto (fun n=>f n r) atTop (𝓝 (g r))) →
 (∀ᶠn in atTop,∀r,R≤r→‖f n r‖≤b r) →
 ∃B:ℕ→ℝ,Summable B ∧ ∀ᶠn in atTop,∀r,‖f n r‖≤B r
def E_tendsto_tsum_of_finite_head_domination (f : ℕ→ℕ→ℝ) (g b : ℕ→ℝ) (R : ℕ) :=
 Summable b → (∀r,Tendsto (fun n=>f n r) atTop (𝓝 (g r))) →
 (∀ᶠn in atTop,∀r,R≤r→‖f n r‖≤b r) →
 Tendsto (fun n=>∑'r,f n r) atTop (𝓝 (∑'r,g r))
def E_physicalCritical_moment_tsum_tendsto (c : ℤ) (C L0 : ℝ) (w v : ℕ→ℕ→ℝ) (R : ℕ) :=
 0≤C → 0≤L0 → (∀n r,0≤w n r) → (∀n r,0≤v n r) →
