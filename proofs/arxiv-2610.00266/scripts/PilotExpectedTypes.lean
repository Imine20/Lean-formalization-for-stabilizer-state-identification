namespace GaussIsometryExpected
universe u v w
open ExactCriticalCurve ExactCriticalCurve.FiniteQuadratic ExactCriticalCurve.Quantum Module
open scoped BigOperators

def GaussType : Type (u + 1) :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [Fintype V],
    QuadraticForm (ZMod 2) V → ℂ
def Square : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [Fintype V]
    (Q : QuadraticForm (ZMod 2) V),
    LinearMap.BilinForm.Nondegenerate Q.polarBilin →
      (∑ x : V, pauliSign (Q x)) ^ 2 = (Fintype.card V : ℂ)
def IsometryInvariant : Prop :=
  ∀ {V : Type u} {W : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    [AddCommGroup W] [Module (ZMod 2) W] [Fintype V] [Fintype W]
    (Q : QuadraticForm (ZMod 2) V) (P : QuadraticForm (ZMod 2) W),
    Q.IsometryEquiv P →
      (∑ x : V, pauliSign (Q x)) = ∑ y : W, pauliSign (P y)
def FullFiber : Prop :=
  ∀ {V : Type u} {W : Type v} {E : Type w}
    [AddCommGroup V] [Module (ZMod 2) V]
    [AddCommGroup W] [Module (ZMod 2) W]
    [AddCommGroup E] [Module (ZMod 2) E]
    [Fintype V] [Fintype W] [Fintype E]
    (Q : QuadraticForm (ZMod 2) V) (P : QuadraticForm (ZMod 2) W),
    LinearMap.BilinForm.Nondegenerate Q.polarBilin →
    LinearMap.BilinForm.Nondegenerate P.polarBilin →
    Fintype.card V = Fintype.card W →
    (∑ x : V, pauliSign (Q x)) = (∑ y : W, pauliSign (P y)) →
    ∀ (f : E →ₗ[ZMod 2] V) (g : E →ₗ[ZMod 2] W),
    Function.Injective f → Function.Injective g →
    (∀ s, Q (f s) = P (g s)) →
    ∀ (a : ZMod 2) (l : E →ₗ[ZMod 2] ZMod 2),
    Fintype.card {x : V // Q x = a ∧ ∀ s, Q.polarBilin x (f s) = l s} =
    Fintype.card {y : W // P y = a ∧ ∀ s, P.polarBilin y (g s) = l s}
def Polar : Prop :=
  ∀ {V : Type u} {W : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    [AddCommGroup W] [Module (ZMod 2) W]
    (Q : QuadraticForm (ZMod 2) V) (P : QuadraticForm (ZMod 2) W)
    (S : Submodule (ZMod 2) V) (f : S →ₗ[ZMod 2] W),
    (∀ s : S, P (f s) = Q s.val) →
    ∀ s t : S, P.polarBilin (f s) (f t) = Q.polarBilin s.val t.val
def External : Prop :=
  ∀ {V : Type u} {W : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    [AddCommGroup W] [Module (ZMod 2) W] [Fintype V] [Fintype W]
    (Q : QuadraticForm (ZMod 2) V) (P : QuadraticForm (ZMod 2) W),
    LinearMap.BilinForm.Nondegenerate Q.polarBilin →
    LinearMap.BilinForm.Nondegenerate P.polarBilin →
    Fintype.card V = Fintype.card W →
    (∑ x : V, pauliSign (Q x)) = (∑ y : W, pauliSign (P y)) →
    ∀ (S : Submodule (ZMod 2) V) (f : S →ₗ[ZMod 2] W),
    Function.Injective f → (∀ s : S, P (f s) = Q s.val) →
    ∀ x : V, x ∉ S →
    ∃ y : W, y ∉ LinearMap.range f ∧ P y = Q x ∧
      ∀ s : S, P.polarBilin y (f s) = Q.polarBilin x s.val
def Step : Prop :=
  ∀ {V : Type u} {W : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    [AddCommGroup W] [Module (ZMod 2) W] [Fintype V] [Fintype W]
    (Q : QuadraticForm (ZMod 2) V) (P : QuadraticForm (ZMod 2) W),
    LinearMap.BilinForm.Nondegenerate Q.polarBilin →
    LinearMap.BilinForm.Nondegenerate P.polarBilin →
    Fintype.card V = Fintype.card W →
    (∑ x : V, pauliSign (Q x)) = (∑ y : W, pauliSign (P y)) →
    ∀ (S : Submodule (ZMod 2) V) (f : S →ₗ[ZMod 2] W),
    Function.Injective f → (∀ s : S, P (f s) = Q s.val) →
    ∀ x : V, x ∉ S →
    ∃ g : ↥(S ⊔ Submodule.span (ZMod 2) {x}) →ₗ[ZMod 2] W,
      Function.Injective g ∧ (∀ z, P (g z) = Q z.val) ∧
      ∀ s : S, g ⟨s.val, (show S ≤ S ⊔ Submodule.span (ZMod 2) {x} from le_sup_left) s.property⟩ = f s
def Extension : Prop :=
  ∀ {V : Type u} {W : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    [AddCommGroup W] [Module (ZMod 2) W]
    [FiniteDimensional (ZMod 2) V] [FiniteDimensional (ZMod 2) W]
    [Fintype V] [Fintype W]
    (Q : QuadraticForm (ZMod 2) V) (P : QuadraticForm (ZMod 2) W),
    LinearMap.BilinForm.Nondegenerate Q.polarBilin →
    LinearMap.BilinForm.Nondegenerate P.polarBilin →
    finrank (ZMod 2) V = finrank (ZMod 2) W →
    (∑ x : V, pauliSign (Q x)) = (∑ y : W, pauliSign (P y)) →
    ∀ (S : Submodule (ZMod 2) V) (f : S →ₗ[ZMod 2] W),
    Function.Injective f → (∀ s : S, P (f s) = Q s.val) →
    ∃ e : Q.IsometryEquiv P, ∀ s : S, e s.val = f s
def Classification : Prop :=
  ∀ {V : Type u} {W : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    [AddCommGroup W] [Module (ZMod 2) W]
    [FiniteDimensional (ZMod 2) V] [FiniteDimensional (ZMod 2) W]
    [Fintype V] [Fintype W]
    (Q : QuadraticForm (ZMod 2) V) (P : QuadraticForm (ZMod 2) W),
    LinearMap.BilinForm.Nondegenerate Q.polarBilin →
    LinearMap.BilinForm.Nondegenerate P.polarBilin →
    (Nonempty (Q.IsometryEquiv P) ↔
      finrank (ZMod 2) V = finrank (ZMod 2) W ∧
      (∑ x : V, pauliSign (Q x)) = (∑ y : W, pauliSign (P y)))
def ZeroEndpoint : Prop :=
  ∀ {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [Fintype V] [Subsingleton V]
    (Q : QuadraticForm (ZMod 2) V), (∑ x : V, pauliSign (Q x)) = 1

example {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [Fintype V]
    (Q : QuadraticForm (ZMod 2) V) :
    binaryQuadraticGaussSum Q = ∑ x : V, pauliSign (Q x) := rfl
end GaussIsometryExpected


