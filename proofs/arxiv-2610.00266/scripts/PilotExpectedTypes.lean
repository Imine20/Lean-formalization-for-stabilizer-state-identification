def CountingRawStabilizerGroup (n : ℕ) :=
  {H : Subgroup (PauliLabel n) //
    (∀ g ∈ H, g.shift = 0 → g.clock = 0 → g.phase = 0) ∧ Nat.card H = 2 ^ n}

def countingRawStabilizerEquiv (n : ℕ) :
    StabilizerGroup n ≃ CountingRawStabilizerGroup n where
  toFun S := ⟨S.carrier,S.phase_free,S.card_eq⟩
  invFun S := ⟨S.val,S.property.1,S.property.2⟩
  left_inv S := by cases S; rfl
  right_inv S := by cases S; rfl

theorem countingDirectionFiber_expanded {n : ℕ}
    (L : Submodule (ZMod 2) (Fin n → ZMod 2)) :
    AffineDirectionFiber L =
      {A : {A : AffineSubspace (ZMod 2) (Fin n → ZMod 2) // Nonempty A} //
        A.val.direction = L} := rfl

theorem countingDirectionCoset_forward {n : ℕ}
    (L : Submodule (ZMod 2) (Fin n → ZMod 2)) (A : AffineDirectionFiber L) :
    affineDirectionCosetEquiv L A = L.mkQ (affineSupportAnchor A.val) := rfl

theorem countingDimension_forward (n m : ℕ) (A : AffineSupportsOfDimension n m) :
    ((affineDimensionEquivDirections n m) A).1.val = A.val.val.direction ∧
      ((affineDimensionEquivDirections n m) A).2.val = A.val := ⟨rfl,rfl⟩

theorem countingDimension_inverse (n m : ℕ)
    (p : Σ L : {L : Submodule (ZMod 2) (Fin n → ZMod 2) //
        Module.finrank (ZMod 2) L = m}, AffineDirectionFiber L.val) :
    ((affineDimensionEquivDirections n m).symm p).val = p.2.val := rfl

theorem countingActualDimension {n : ℕ} (A : NonemptyAffineSupport n) :
    (affineSupportDimension A).val = Module.finrank (ZMod 2) A.val.direction := rfl

def ActualFixedDirectionSupportCount : Prop :=
  ∀ {n : ℕ} (L : Submodule (ZMod 2) (Fin n → ZMod 2)),
    Nat.card {A : {A : AffineSubspace (ZMod 2) (Fin n → ZMod 2) // Nonempty A} //
      A.val.direction = L} = 2 ^ (n - Module.finrank (ZMod 2) L)

def ActualFixedDimensionSupportCount : Prop :=
  ∀ n m : ℕ,
    Nat.card {A : {A : AffineSubspace (ZMod 2) (Fin n → ZMod 2) // Nonempty A} //
      Module.finrank (ZMod 2) A.val.direction = m} =
      2 ^ (n-m) * Nat.card {L : Submodule (ZMod 2) (Fin n → ZMod 2) //
        Module.finrank (ZMod 2) L = m}

def ActualWeightedSupportEnumeration : Prop :=
  ∀ (n : ℕ) (f : ℕ → ℕ),
    (∑ A : NonemptyAffineSupport n, f (Module.finrank (ZMod 2) A.val.direction)) =
      ∑ m ∈ Finset.range (n+1),
        (2 ^ (n-m) * Nat.card {L : Submodule (ZMod 2) (Fin n → ZMod 2) //
          Module.finrank (ZMod 2) L = m}) * f m

def ActualSignedStabilizerTotalCount : Prop :=
  ∀ n : ℕ, Nat.card (StabilizerGroup n) =
    2 ^ n * ∏ j ∈ Finset.range n, (1 + 2 ^ (j+1))

theorem countingRawGroups_product (n : ℕ) :
    Nat.card (CountingRawStabilizerGroup n) =
      2 ^ n * ∏ j ∈ Finset.range n, (1 + 2 ^ (j+1)) := by
  rw [← Nat.card_congr (countingRawStabilizerEquiv n)]
  exact stabilizerGroup_card n

end CriticalCurveExpected
