    affineSupportAnchor A ∈ A.val

def RecoveryAnchorDirectionSpace : Prop :=
  ∀ {n : ℕ} (A : {A : AffineSubspace (ZMod 2) (Fin n → ZMod 2) // Nonempty A}),
