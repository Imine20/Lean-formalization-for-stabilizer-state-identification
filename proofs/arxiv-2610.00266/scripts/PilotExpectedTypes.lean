def PauliCharacterSum : Prop :=
  ∀ {n : ℕ} (b : Fin n → ZMod 2),
    (∑ y : Fin n → ZMod 2, (-1 : ℂ) ^ (∑ i, b i * y i).val) =
      if b = 0 then (2 : ℂ) ^ n else 0

def PauliProductCocycle : Prop :=
  ∀ {n : ℕ} (a b c d : Fin n → ZMod 2),
    pauliMatrix a b * pauliMatrix c d =
      ((-1 : ℂ) ^ (∑ i, b i * c i).val) • pauliMatrix (a + c) (b + d)

def PauliOrderedAdjoint : Prop :=
  ∀ {n : ℕ} (a b : Fin n → ZMod 2),
    (pauliMatrix a b)ᴴ =
      ((-1 : ℂ) ^ (∑ i, b i * a i).val) • pauliMatrix a b

def PauliFourthPhaseFaithful : Prop :=
  ∀ s t : ZMod 4, Complex.I ^ s.val = Complex.I ^ t.val → s = t

def PauliActualUnitary : Prop :=
  ∀ {n : ℕ} (g : PauliLabel n), (pauliOperator g)ᴴ * pauliOperator g = 1

def PauliActualProduct : Prop :=
  ∀ {n : ℕ} (g h : PauliLabel n),
    pauliOperator ⟨g.phase + h.phase +
      2 * ((∑ i, g.clock i * h.shift i).val : ZMod 4),
      g.shift + h.shift, g.clock + h.clock⟩ =
        pauliOperator g * pauliOperator h

def PauliActualFaithful : Prop :=
  ∀ {n : ℕ} (g h : PauliLabel n),
    pauliOperator g = pauliOperator h → g = h

def PauliActualTrace : Prop :=
  ∀ {n : ℕ} (g : PauliLabel n),
    (∑ x : Fin n → ZMod 2, pauliOperator g x x) =
      if g.shift = 0 ∧ g.clock = 0
      then Complex.I ^ g.phase.val * (2 : ℂ) ^ n else 0
end CriticalCurveExpected

