def Complements {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    [Finite K] [FiniteDimensional K V] : Prop :=
  ∀ (p H : Submodule K V), IsCompl p H →
    Nat.card {q : Submodule K V // IsCompl p q} =
      Nat.card K ^ (Module.finrank K H * Module.finrank K p)

def MissingHyperplanes {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] : Prop :=
  ∀ (w : V), w ≠ 0 → ∀ r : ℕ, Module.finrank (ZMod 2) V = r + 1 →
    Nat.card {q : Submodule (ZMod 2) V //
      Module.finrank (ZMod 2) q + 1 = Module.finrank (ZMod 2) V ∧ w ∉ q} = 2 ^ r

def AmbientCount {k : ℕ} : Prop :=
  ∀ (M : Submodule (ZMod 2) (Fin k → ZMod 2)) (w : Fin k → ZMod 2),
    w ∈ M → w ≠ 0 → ∀ r : ℕ, Module.finrank (ZMod 2) M = r + 1 →
      Nat.card {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
        N ≤ M ∧ Module.finrank (ZMod 2) N = r ∧ w ∉ N} = 2 ^ r

def AmbientExtension {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] : Prop :=
  ∀ (M : Submodule K V) (w : V), w ∈ M → w ≠ 0 → ∀ r : ℕ,
    Module.finrank K M = r + 1 →
      ∀ N : {S : Submodule K V // S ≤ M ∧ Module.finrank K S = r ∧ w ∉ S},
        N.val ⊔ Submodule.span K {w} = M

def DefectFiberCount {k : ℕ} : Prop :=
  ∀ (M : Submodule (ZMod 2) (Fin k → ZMod 2)),
    (∀ x : Fin k → ZMod 2, x ∈ M → (∑ i : Fin k, ((x i).val : ZMod 4)) = 0) →
      ∀ (w : Fin k → ZMod 2), w ∈ M → w ≠ 0 → ∀ r : ℕ,
        Module.finrank (ZMod 2) M = r + 1 →
          Nat.card {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
            (∀ x : Fin k → ZMod 2, x ∈ N → (∑ i : Fin k, ((x i).val : ZMod 4)) = 0) ∧
            Module.finrank (ZMod 2) N = r ∧ w ∉ N ∧
            N ⊔ Submodule.span (ZMod 2) {w} = M} = 2 ^ r

end ProjectorFactorExpected

