def BinaryGaussianFactorialNonzero : Prop :=
  ∀ n : ℕ, binaryGaussianFactorial n ≠ 0

def BinaryGaussianFactorialSplit : Prop :=
  ∀ n r : ℕ, r ≤ n →
    binaryGaussianFactorial n = binaryGaussianFactorial (n-r) *
      ∏ j ∈ Finset.range r, ((2 : ℚ)^(n-j)-1)

def BinaryGaussianFactorialCross : Prop :=
  ∀ n r : ℕ, r ≤ n →
    (binaryGaussian n r : ℚ) * binaryGaussianFactorial r * binaryGaussianFactorial (n-r) =
      binaryGaussianFactorial n

def BinaryGaussianFactorialQuotient : Prop :=
  ∀ n r : ℕ, r ≤ n →
    (binaryGaussian n r : ℚ) = binaryGaussianFactorial n /
      (binaryGaussianFactorial r * binaryGaussianFactorial (n-r))

def BinaryGaussianSymmetry : Prop :=
  ∀ n k : ℕ, k ≤ n → binaryGaussian n k = binaryGaussian n (n-k)

def BinaryGaussianFlagReorder : Prop :=
  ∀ n r k : ℕ, k ≤ r → r ≤ n →
    binaryGaussian n r * binaryGaussian r k =
      binaryGaussian n k * binaryGaussian (n-k) (r-k)
