universe u v

def ShorteningOneSynthesisObject : Type :=
  ∀ {m : ℕ}, Odd m → Matrix (ZMod 2 × (Fin (m+1) → ZMod 2)) (Fin m → ZMod 2) ℂ

def ShorteningFreeRegisterObject : Type (max (u+1) (v+1)) :=
  ∀ (α : Type u) {β : Type v}, Submodule ℂ (β → ℂ) → Submodule ℂ ((α × β) → ℂ)

def ShorteningPairingEven : Prop :=
  ∀ {m : ℕ} (a : Fin m → ZMod 2) (ha : shorteningParity m a = 0) (x : Fin m → ZMod 2),
    cssQuotientBilinear (wuLine (m+1))
      (Submodule.Quotient.mk (shorteningEvenLift a ha))
      (Submodule.Quotient.mk (shorteningIotaOrth m x)) = binaryDot a x

def ShorteningPauliReindex : Prop :=
  ∀ {m : ℕ} (hm : Odd m) (x : Fin m → ZMod 2) (hx : shorteningParity m x = 0) (a b : ZMod 2),
    ((1 : Matrix (ZMod 2) (ZMod 2) ℂ) ⊗ₖ
      cssQuotientPauli (wuLine (m+1)) (shorteningEvenLift x hx) a b).submatrix
        (shorteningLabelEquiv hm) (shorteningLabelEquiv hm) =
      pauliMatrix (a • x) (b • x)

def ShorteningOnePauli : Prop :=
  ∀ {m : ℕ} (hm : Odd m) (x : Fin m → ZMod 2) (hx : shorteningParity m x = 0) (a b : ZMod 2),
    ((1 : Matrix (ZMod 2) (ZMod 2) ℂ) ⊗ₖ
      pauliMatrix (a • shorteningZeroAppend m x) (b • shorteningZeroAppend m x)) *
        shorteningOneSynthesis hm =
      shorteningOneSynthesis hm * pauliMatrix (a • x) (b • x)

def ShorteningOnePauliPair : Prop :=
  ∀ {m : ℕ} (hm : Odd m) (a b : Fin m → ZMod 2),
    shorteningParity m a = 0 → shorteningParity m b = 0 →
      ((1 : Matrix (ZMod 2) (ZMod 2) ℂ) ⊗ₖ
        pauliMatrix (shorteningZeroAppend m a) (shorteningZeroAppend m b)) *
          shorteningOneSynthesis hm =
        shorteningOneSynthesis hm * pauliMatrix a b

def ShorteningOneProjection : Prop :=
  ∀ {m : ℕ} (hm : Odd m) (M : Submodule (ZMod 2) (Fin m → ZMod 2)),
    IsDefect M →
      ((1 : Matrix (ZMod 2) (ZMod 2) ℂ) ⊗ₖ
        cosetProjection (orthogonal (M.map (shorteningZeroAppend m))) (M.map (shorteningZeroAppend m))) *
          shorteningOneSynthesis hm =
        shorteningOneSynthesis hm * cosetProjection (orthogonal M) M

def ShorteningOneCSS : Prop :=
  ∀ {m : ℕ} (h4 : 4 ∣ m+1) (M : Submodule (ZMod 2) (Fin m → ZMod 2)),
    IsDefect M →
      shorteningOneSynthesis (shortening_predecessor_odd h4) *
        cosetProjection (orthogonal M) M *
          (shorteningOneSynthesis (shortening_predecessor_odd h4))ᴴ =
        (1 : Matrix (ZMod 2) (ZMod 2) ℂ) ⊗ₖ
          cosetProjection (orthogonal (shorteningExtend M)) (shorteningExtend M)

def ShorteningTensorCSS : Prop :=
  ∀ {m : ℕ} (n : ℕ) (h4 : 4 ∣ m+1) (M : Submodule (ZMod 2) (Fin m → ZMod 2)),
    IsDefect M →
      shorteningSynthesis n (shortening_predecessor_odd h4) * cssColumnProjection n M *
        (shorteningSynthesis n (shortening_predecessor_odd h4))ᴴ =
        (1 : Matrix (Fin n → ZMod 2) (Fin n → ZMod 2) ℂ) ⊗ₖ cssColumnProjection n (shorteningExtend M)

def ShorteningFreeRegisterRange : Prop :=
  ∀ {α : Type u} {β : Type v} [Fintype α] [Fintype β] [DecidableEq α] (P : Matrix β β ℂ),
    freeRegisterSpace α (LinearMap.range P.mulVecLin) =
      LinearMap.range ((1 : Matrix α α ℂ) ⊗ₖ P).mulVecLin

def ShorteningCodeMap : Prop :=
  ∀ {m : ℕ} (n : ℕ) (h4 : 4 ∣ m+1) (M : Submodule (ZMod 2) (Fin m → ZMod 2)),
    IsDefect M →
      (cssCode n M).map (shorteningSynthesis n (shortening_predecessor_odd h4)).mulVecLin =
        freeRegisterSpace (Fin n → ZMod 2) (cssCode n (shorteningExtend M))

def ShorteningFiltrationMap : Prop :=
  ∀ {m : ℕ} (n r : ℕ) (h4 : 4 ∣ m+1),
    (ordinaryCSSFiltration n m r).map (shorteningSynthesis n (shortening_predecessor_odd h4)).mulVecLin =
      freeRegisterSpace (Fin n → ZMod 2) (exceptionalCSSFiltration n (m+1) (r+1))

end ShorteningTransportExpected


