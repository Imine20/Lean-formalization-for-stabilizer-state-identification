def rightTailWeight_parity_second_moment : Prop :=
  ∀ p : ℤ, (∑' u : ℤ, if u%2=p%2 then W (u : ℝ)*L (u : ℝ)^2 else 0)=4

def rightTailMoment_restricted_sum_isLittleO : Prop :=
  ∀ (q : ℕ) (η J : ℝ), 0 < η → ∀ P : ℕ → ℤ → Prop,
  (∀ (m : ℕ) (u : ℤ), P m u → η*(m : ℝ) < |(u : ℝ)|) →
  (fun m : ℕ => ∑' u : ℤ, if P m u then W (u : ℝ)*L (u : ℝ)^q else 0) =o[atTop]
    (fun m : ℕ => (2 : ℝ)^(-(J*(m : ℝ))))

def rightTailMoment_abs_restricted_sum_isLittleO : Prop :=
  ∀ (q : ℕ) (η J : ℝ), 0 < η → ∀ P : ℕ → ℤ → Prop,
  (∀ (m : ℕ) (u : ℤ), P m u → η*(m : ℝ) < |(u : ℝ)|) →
  (fun m : ℕ => ∑' u : ℤ, if P m u then ‖W (u : ℝ)*L (u : ℝ)^q‖ else 0) =o[atTop]
    (fun m : ℕ => (2 : ℝ)^(-(J*(m : ℝ))))

def critical_lattice_tsum_sub_parity : Prop := ∀ (m : ℤ) (f : ℤ → ℝ), Summable f →
  (∑' r : ℕ, f (2*(r : ℤ)-m))-(∑' u : ℤ, if u%2=m%2 then f u else 0) =
    -(∑' u : ℤ, if u < -m ∧ u%2=m%2 then f u else 0)

def criticalWeight_moment_sub_parity_isLittleO : Prop := ∀ (q : ℕ) (J : ℝ),
  (fun m : ℕ => (∑' r : ℕ, Weight (m : ℤ) r*L (2*(r : ℝ)-(m : ℝ))^q)-
    (∑' u : ℤ, if u%2=(m : ℤ)%2 then W (u : ℝ)*L (u : ℝ)^q else 0)) =o[atTop]
      (fun m : ℕ => (2 : ℝ)^(-(J*(m : ℝ))))

def criticalWeight_mass_sub_one_isLittleO : Prop := ∀ J : ℝ,
  (fun m : ℕ => (∑' r : ℕ, Weight (m : ℤ) r)-1) =o[atTop]
    (fun m : ℕ => (2 : ℝ)^(-(J*(m : ℝ))))

def criticalWeight_linear_moment_isLittleO : Prop := ∀ J : ℝ,
  (fun m : ℕ => ∑' r : ℕ, Weight (m : ℤ) r*L (2*(r : ℝ)-(m : ℝ))) =o[atTop]
    (fun m : ℕ => (2 : ℝ)^(-(J*(m : ℝ))))

def criticalWeight_second_moment_sub_four_isLittleO : Prop := ∀ J : ℝ,
