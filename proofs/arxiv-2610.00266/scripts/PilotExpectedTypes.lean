def F {V : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    (e : V ≃ₗ[ZMod 2] V) : Submodule (ZMod 2) V where
  carrier := {x | e x=x}
  zero_mem' := map_zero e
  add_mem' {x y} hx hy := by
    change e (x+y)=x+y
    change e x=x at hx
    change e y=y at hy
    rw [map_add,hx,hy]
  smul_mem' a x hx := by
    change e (a • x)=a • x
    change e x=x at hx
    rw [map_smul,hx]
