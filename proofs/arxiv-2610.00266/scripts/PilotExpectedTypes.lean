namespace MatrixProjectionGradesExpected
open ExactCriticalCurve Matrix Polynomial Classical
open scoped BigOperators Polynomial ComplexOrder

def Grade {ι : Type*} {m : ℕ} (P : Fin (m+1) → Matrix ι ι ℂ) (i : Fin m) :
    Matrix ι ι ℂ := P i.castSucc - P i.succ

def GradeType {ι : Type*} :=
  ∀ {m : ℕ}, (Fin (m+1) → Matrix ι ι ℂ) → Fin m → Matrix ι ι ℂ

def RangeFixed {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ (P : Matrix ι ι ℂ), P*P=P → ∀ v : ι → ℂ,
    v ∈ LinearMap.range P.mulVecLin ↔ P *ᵥ v=v

def AbsorbLeft {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ P Q : Matrix ι ι ℂ, P*P=P →
    LinearMap.range Q.mulVecLin ≤ LinearMap.range P.mulVecLin → P*Q=Q

def AbsorbRight {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ P Q : Matrix ι ι ℂ, P.IsHermitian → Q.IsHermitian → P*P=P →
    LinearMap.range Q.mulVecLin ≤ LinearMap.range P.mulVecLin → Q*P=Q

def Positive {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ P : Matrix ι ι ℂ, P.IsHermitian → P*P=P → P.PosSemidef

def DifferenceHermitian {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ P Q : Matrix ι ι ℂ, P.IsHermitian → Q.IsHermitian → (P-Q).IsHermitian

def DifferenceIdempotent {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ P Q : Matrix ι ι ℂ, P.IsHermitian → Q.IsHermitian → P*P=P → Q*Q=Q →
    LinearMap.range Q.mulVecLin ≤ LinearMap.range P.mulVecLin → (P-Q)*(P-Q)=P-Q

def DifferencePositive {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ P Q : Matrix ι ι ℂ, P.IsHermitian → Q.IsHermitian → P*P=P → Q*Q=Q →
    LinearMap.range Q.mulVecLin ≤ LinearMap.range P.mulVecLin → (P-Q).PosSemidef

def DifferenceRange {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ P Q : Matrix ι ι ℂ, P.IsHermitian → Q.IsHermitian → P*P=P → Q*Q=Q →
    LinearMap.range Q.mulVecLin ≤ LinearMap.range P.mulVecLin →
    LinearMap.range (P-Q).mulVecLin =
      LinearMap.range P.mulVecLin ⊓ LinearMap.ker Q.mulVecLin

def DifferenceWitness {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ P Q : Matrix ι ι ℂ, P*P=P → ∀ v : ι → ℂ,
    v ∈ LinearMap.range P.mulVecLin → Q *ᵥ v=0 → v≠0 → P-Q≠0

def GradeHermitian {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ {m : ℕ} (P : Fin (m+1) → Matrix ι ι ℂ),
    (∀ i, (P i).IsHermitian) → ∀ i : Fin m, (Grade P i).IsHermitian

def GradeIdempotent {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ {m : ℕ} (P : Fin (m+1) → Matrix ι ι ℂ),
    (∀ i, (P i).IsHermitian) → (∀ i, P i*P i=P i) →
    (∀ i j, i≤j → LinearMap.range (P j).mulVecLin ≤ LinearMap.range (P i).mulVecLin) →
    ∀ i : Fin m, Grade P i*Grade P i=Grade P i

def GradePositive {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ {m : ℕ} (P : Fin (m+1) → Matrix ι ι ℂ),
    (∀ i, (P i).IsHermitian) → (∀ i, P i*P i=P i) →
    (∀ i j, i≤j → LinearMap.range (P j).mulVecLin ≤ LinearMap.range (P i).mulVecLin) →
    ∀ i : Fin m, (Grade P i).PosSemidef

def GradeRange {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ {m : ℕ} (P : Fin (m+1) → Matrix ι ι ℂ),
    (∀ i, (P i).IsHermitian) → (∀ i, P i*P i=P i) →
    (∀ i j, i≤j → LinearMap.range (P j).mulVecLin ≤ LinearMap.range (P i).mulVecLin) →
    ∀ i : Fin m, LinearMap.range (Grade P i).mulVecLin =
      LinearMap.range (P i.castSucc).mulVecLin ⊓ LinearMap.ker (P i.succ).mulVecLin

def OrderedOrthogonal {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ {m : ℕ} (P : Fin (m+1) → Matrix ι ι ℂ),
    (∀ i, P i*P i=P i) →
    (∀ i j, i≤j → LinearMap.range (P j).mulVecLin ≤ LinearMap.range (P i).mulVecLin) →
    ∀ i j : Fin m, i<j → Grade P i*Grade P j=0

def PairwiseOrthogonal {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ {m : ℕ} (P : Fin (m+1) → Matrix ι ι ℂ),
    (∀ i, (P i).IsHermitian) → (∀ i, P i*P i=P i) →
    (∀ i j, i≤j → LinearMap.range (P j).mulVecLin ≤ LinearMap.range (P i).mulVecLin) →
    ∀ i j : Fin m, i≠j → Grade P i*Grade P j=0

def Telescope {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ {m : ℕ} (P : Fin (m+1) → Matrix ι ι ℂ),
    (∑ i : Fin m, Grade P i)=P 0-P (Fin.last m)

def TelescopeTerminal {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ {m : ℕ} (P : Fin (m+1) → Matrix ι ι ℂ),
    (∑ i : Fin m, Grade P i)+P (Fin.last m)=P 0

-- The support operator is expanded to its actual zero-constant polynomial evaluation.
def SupportKernel {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ (A : Matrix ι ι ℂ) (h : A.IsHermitian),
    LinearMap.ker (Polynomial.aeval A
      (1 - ∏ i ∈ Finset.univ.filter (fun i => h.eigenvalues i ≠ 0),
        (1 - Polynomial.C ((h.eigenvalues i)⁻¹) * Polynomial.X))).mulVecLin =
      LinearMap.ker A.mulVecLin

example {ι : Type*} {m : ℕ} (P : Fin (m+1) → Matrix ι ι ℂ) (i : Fin m) :
    matrixProjectionGrade P i = Grade P i := rfl

