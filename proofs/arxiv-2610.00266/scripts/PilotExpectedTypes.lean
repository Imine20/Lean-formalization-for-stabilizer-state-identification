def FreeRegisterEquivalence : Type _ :=
  ∀ {α : Type u} {β : Type v} [Fintype α] (W : Submodule ℂ (β → ℂ)),
    freeRegisterSpace α W ≃ₗ[ℂ] (α → W)

def FreeRegisterDimension : Prop :=
  ∀ {α : Type u} {β : Type v} [Fintype α] [Fintype β] (W : Submodule ℂ (β → ℂ)),
