open Lean Elab Command Meta in
def auditAlternatingCountDefinition (actual expected : Name) : CommandElabM Unit := do
  liftTermElabM do
    let info ← getConstInfo actual
    let expectedInfo ← getConstInfo expected
    unless info.levelParams.length == expectedInfo.levelParams.length do
      throwError "Definition universe generality mismatch: {actual}"
    let levelParams := (List.range info.levelParams.length).map
      (fun i => Name.mkSimple ("auditUniverse" ++ toString i))
    let levels := levelParams.map Level.param
    let term := mkConst actual levels
    let expectedTerm := mkConst expected levels
    let expectedType ← inferType expectedTerm
    let expectedValue ← forallTelescope expectedType fun args _ => do
      mkForallFVars args (mkAppN expectedTerm args)
    unless ← isDefEq (← inferType term) expectedValue do
      throwError "Independent definition type mismatch {actual}"
    let kernelEnv := (← getEnv).toKernelEnv
    let limit := (Core.getMaxHeartbeats (← getOptions)).toUSize
    for (label, value) in #[
        ("constant", term), ("body", info.instantiateValueLevelParams! levels)] do
      let name ← mkFreshUserName (Name.mkSimple ("definitionAudit_" ++ label))
      let decl : Declaration := .defnDecl {
        name := name, levelParams := levelParams, type := expectedValue, value := value,
        hints := .opaque, safety := .safe
      }
      let _ ← ofExceptKernelException <| Kernel.Environment.addDeclCore kernelEnv limit decl none
      logInfo m!"KERNEL_EXPECTED_DEFINITION_OK {label} {actual}"

namespace AlternatingCountExpected
universe u v
open ExactCriticalCurve ExactCriticalCurve.FiniteQuadratic Module
open scoped BigOperators
abbrev Forms (K : Type u) [AddCommGroup K] [Module (ZMod 2) K] :=
  {A : LinearMap.BilinForm (ZMod 2) K // A.IsAlt ∧ A.Nondegenerate}

def BlockFormula : Prop :=
  ∀ {K : Type u} [AddCommGroup K] [Module (ZMod 2) K], ∀ (h : Module.Dual (ZMod 2) K) (C : LinearMap.BilinForm (ZMod 2) K) (x y : ZMod 2 × (ZMod 2 × K)), alternatingBlockForm h C x y = x.1*y.2.1+x.2.1*y.1+x.2.1*h y.2.2+h x.2.2*y.2.1+C x.2.2 y.2.2

def BlockAlt : Prop :=
  ∀ {K : Type u} [AddCommGroup K] [Module (ZMod 2) K], ∀ (h : Module.Dual (ZMod 2) K) (C : LinearMap.BilinForm (ZMod 2) K), C.IsAlt → (alternatingBlockForm h C).IsAlt

def BlockND : Prop :=
  ∀ {K : Type u} [AddCommGroup K] [Module (ZMod 2) K], ∀ (h : Module.Dual (ZMod 2) K) (C : LinearMap.BilinForm (ZMod 2) K), (alternatingBlockForm h C).Nondegenerate ↔ C.Nondegenerate

def BlockFirst : Prop :=
  ∀ {K : Type u} [AddCommGroup K] [Module (ZMod 2) K], ∀ (h : Module.Dual (ZMod 2) K) (C : LinearMap.BilinForm (ZMod 2) K) (x : ZMod 2 × (ZMod 2 × K)), alternatingBlockForm h C (1,(0,0)) x = x.2.1

def ExtractRow : Prop :=
  ∀ {K : Type u} [AddCommGroup K] [Module (ZMod 2) K], ∀ (h : Module.Dual (ZMod 2) K) (C : LinearMap.BilinForm (ZMod 2) K), alternatingBlockRow (alternatingBlockForm h C) = h

def ExtractRestriction : Prop :=
  ∀ {K : Type u} [AddCommGroup K] [Module (ZMod 2) K], ∀ (h : Module.Dual (ZMod 2) K) (C : LinearMap.BilinForm (ZMod 2) K), alternatingBlockRestriction (alternatingBlockForm h C) = C

def Reconstruct : Prop :=
  ∀ {K : Type u} [AddCommGroup K] [Module (ZMod 2) K], ∀ (A : LinearMap.BilinForm (ZMod 2) (ZMod 2 × (ZMod 2 × K))), A.IsAlt → (∀ x, A (1,(0,0)) x = x.2.1) → alternatingBlockForm (alternatingBlockRow A) (alternatingBlockRestriction A) = A

def FirstRow : Prop :=
  ∀ {U : Type u} [AddCommGroup U] [Module (ZMod 2) U], ∀ (A : Forms (ZMod 2 × U)) (x : ZMod 2 × U), A.val (1,0) x = (alternatingFirstFunctional A).val x.2

def CardDimension : Prop :=
  ∀ {U : Type u} [AddCommGroup U] [Module (ZMod 2) U] [FiniteDimensional (ZMod 2) U], ∀ {d : ℕ}, finrank (ZMod 2) U = d → Nat.card (Forms U) = Nat.card (Forms (Fin d → ZMod 2))

def NonzeroDualCard : Prop :=
  ∀ {U : Type u} [AddCommGroup U] [Module (ZMod 2) U] [FiniteDimensional (ZMod 2) U], Nat.card {l : Module.Dual (ZMod 2) U // l ≠ 0} = 2 ^ finrank (ZMod 2) U - 1

def Recurrence : Prop :=
  ∀ d : ℕ, Nat.card (Forms (Fin (d+2) → ZMod 2)) = (2^(d+1)-1)*2^d*Nat.card (Forms (Fin d → ZMod 2))

def DimensionZero : Prop :=
  Nat.card (Forms (Fin 0 → ZMod 2)) = 1

def OddDimension : Prop :=
  ∀ d : ℕ, Nat.card (Forms (Fin (2*d+1) → ZMod 2)) = 0

def EvenProduct : Prop :=
  ∀ a : ℕ, Nat.card (Forms (Fin (2*a) → ZMod 2)) = ∏ j ∈ Finset.range a, ((2^(2*j+1)-1)*2^(2*j))

def FormType : Type (u+1) :=
  ∀ (K : Type u) [AddCommGroup K] [Module (ZMod 2) K], Type u

def BlockType : Type (u+1) :=
  ∀ {K : Type u} [AddCommGroup K] [Module (ZMod 2) K], Module.Dual (ZMod 2) K → LinearMap.BilinForm (ZMod 2) K → LinearMap.BilinForm (ZMod 2) (ZMod 2 × (ZMod 2 × K))

def RowType : Type (u+1) :=
  ∀ {K : Type u} [AddCommGroup K] [Module (ZMod 2) K], LinearMap.BilinForm (ZMod 2) (ZMod 2 × (ZMod 2 × K)) → Module.Dual (ZMod 2) K

def RestrictionType : Type (u+1) :=
  ∀ {K : Type u} [AddCommGroup K] [Module (ZMod 2) K], LinearMap.BilinForm (ZMod 2) (ZMod 2 × (ZMod 2 × K)) → LinearMap.BilinForm (ZMod 2) K

def BlockFiberType : Type (u+1) :=
  ∀ {K : Type u} [AddCommGroup K] [Module (ZMod 2) K], {A : Forms (ZMod 2 × (ZMod 2 × K)) // ∀ x, A.val (1,(0,0)) x = x.2.1} ≃ Module.Dual (ZMod 2) K × Forms K

def CongrType : Type (max (u+1) (v+1)) :=
  ∀ {U : Type u} {V : Type v} [AddCommGroup U] [Module (ZMod 2) U] [AddCommGroup V] [Module (ZMod 2) V], (U ≃ₗ[ZMod 2] V) → (Forms U ≃ Forms V)

def SplitType : Type (u+1) :=
  ∀ {U : Type u} [AddCommGroup U] [Module (ZMod 2) U], ∀ (l : Module.Dual (ZMod 2) U) (v : U), l v = 1 → (U ≃ₗ[ZMod 2] (ZMod 2 × LinearMap.ker l))

def FunctionalType : Type (u+1) :=
  ∀ {U : Type u} [AddCommGroup U] [Module (ZMod 2) U], Forms (ZMod 2 × U) → {l : Module.Dual (ZMod 2) U // l ≠ 0}

def FiberBlockType : Type (u+1) :=
  ∀ {U : Type u} [AddCommGroup U] [Module (ZMod 2) U], ∀ (l : {l : Module.Dual (ZMod 2) U // l ≠ 0}) (v : U), l.val v = 1 → ({A : Forms (ZMod 2 × U) // alternatingFirstFunctional A = l} ≃ {A : Forms (ZMod 2 × (ZMod 2 × LinearMap.ker l.val)) // ∀ x, A.val (1,(0,0)) x = x.2.1})

def FiberType : Type (u+1) :=
  ∀ {U : Type u} [AddCommGroup U] [Module (ZMod 2) U], ∀ l : {l : Module.Dual (ZMod 2) U // l ≠ 0}, {A : Forms (ZMod 2 × U) // alternatingFirstFunctional A = l} ≃ Module.Dual (ZMod 2) (LinearMap.ker l.val) × Forms (LinearMap.ker l.val)

def SigmaType : Type (u+1) :=
  ∀ {U : Type u} [AddCommGroup U] [Module (ZMod 2) U], Forms (ZMod 2 × U) ≃ (Σ l : {l : Module.Dual (ZMod 2) U // l ≠ 0}, Module.Dual (ZMod 2) (LinearMap.ker l.val) × Forms (LinearMap.ker l.val))

def FiniteDual : Prop :=
  ∀ {U : Type u} [AddCommGroup U] [Module (ZMod 2) U] [Finite U], Finite (Module.Dual (ZMod 2) U)

def FiniteBilin : Prop :=
  ∀ {U : Type u} [AddCommGroup U] [Module (ZMod 2) U] [Finite U], Finite (LinearMap.BilinForm (ZMod 2) U)

def CountType : Type :=
  ℕ → ℕ

example (K : Type u) [AddCommGroup K] [Module (ZMod 2) K] :
    NondegenerateAlternatingForm K = Forms K := rfl
example {K : Type u} [AddCommGroup K] [Module (ZMod 2) K]
    (h : Module.Dual (ZMod 2) K) (C : LinearMap.BilinForm (ZMod 2) K)
    (x y : ZMod 2 × (ZMod 2 × K)) :
    alternatingBlockForm h C x y = x.1*y.2.1+x.2.1*y.1+x.2.1*h y.2.2+
      h x.2.2*y.2.1+C x.2.2 y.2.2 := rfl
example {K : Type u} [AddCommGroup K] [Module (ZMod 2) K]
    (A : LinearMap.BilinForm (ZMod 2) (ZMod 2 × (ZMod 2 × K))) (k : K) :
    alternatingBlockRow A k = A (0,(1,0)) (0,(0,k)) := rfl
example {K : Type u} [AddCommGroup K] [Module (ZMod 2) K]
    (A : LinearMap.BilinForm (ZMod 2) (ZMod 2 × (ZMod 2 × K))) (x y : K) :
    alternatingBlockRestriction A x y = A (0,(0,x)) (0,(0,y)) := rfl
example {U : Type u} {V : Type v} [AddCommGroup U] [Module (ZMod 2) U]
    [AddCommGroup V] [Module (ZMod 2) V] (e : U ≃ₗ[ZMod 2] V)
    (A : Forms U) (x y : V) :
    (nondegenerateAlternatingCongr e A).val x y = A.val (e.symm x) (e.symm y) := rfl
example {U : Type u} [AddCommGroup U] [Module (ZMod 2) U]
    (l : Module.Dual (ZMod 2) U) (v : U) (hv : l v=1) (u : U) :
    ((binaryFunctionalSplit l v hv u).1, (binaryFunctionalSplit l v hv u).2.val) =
      (l u, u-l u • v) := rfl
example {U : Type u} [AddCommGroup U] [Module (ZMod 2) U]
    (l : Module.Dual (ZMod 2) U) (v : U) (hv : l v=1)
    (p : ZMod 2 × LinearMap.ker l) :
    (binaryFunctionalSplit l v hv).symm p = p.1 • v+p.2.val := rfl
example {U : Type u} [AddCommGroup U] [Module (ZMod 2) U]
    (A : Forms (ZMod 2 × U)) (u : U) :
    (alternatingFirstFunctional A).val u = A.val (1,0) (0,u) := rfl
example {K : Type u} [AddCommGroup K] [Module (ZMod 2) K]
    (A : {A : Forms (ZMod 2 × (ZMod 2 × K)) // ∀ x, A.val (1,(0,0)) x=x.2.1}) :
    (alternatingBlockFiberEquiv A).1 = alternatingBlockRow A.val.val := rfl
example {K : Type u} [AddCommGroup K] [Module (ZMod 2) K]
    (p : Module.Dual (ZMod 2) K × Forms K) :
    (alternatingBlockFiberEquiv.symm p).val.val = alternatingBlockForm p.1 p.2.val := rfl
example (d : ℕ) : nondegenerateAlternatingCount d =
    Nat.card {A : LinearMap.BilinForm (ZMod 2) (Fin d → ZMod 2) //
      A.IsAlt ∧ A.Nondegenerate} := rfl
end AlternatingCountExpected
