/-- Independently written actual product of normalized quotient indicators. -/
def CSSColumns {k : ℕ} (n : ℕ) (N : Submodule (ZMod 2) (Fin k → ZMod 2)) :
    Matrix (Fin n → (Fin k → ZMod 2))
      (Fin n → ((orthogonal N) ⧸ N.comap (orthogonal N).subtype)) ℂ :=
  fun X q => ∏ a : Fin n,
    (Real.sqrt (Nat.card N) : ℂ)⁻¹ *
      (@ite ℂ (∃ hx : X a ∈ orthogonal N,
        (Submodule.Quotient.mk (⟨X a, hx⟩ : orthogonal N) :
          (orthogonal N) ⧸ N.comap (orthogonal N).subtype) = q a) (Classical.propDecidable _) 1 0)

def CSSRelationFactor : Prop :=
  ∀ {k : ℕ} (n : ℕ) (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    (fun (X Y : Fin n → (Fin k → ZMod 2)) =>
      ∏ a : Fin n, @ite ℂ
        (X a ∈ orthogonal N ∧ Y a ∈ orthogonal N ∧ X a - Y a ∈ N)
        (Classical.propDecidable _) 1 0) =
    (((2 : ℂ) ^ n) ^ Module.finrank (ZMod 2) N) •
      (CSSColumns n N * (CSSColumns n N)ᴴ)

def CSSCopyColumnIsometry : Prop :=
  ∀ {k : ℕ} (n : ℕ) (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    (∀ x ∈ N, (∑ i, ((x i).val : ZMod 4)) = 0) →
    (cssCopySynthesis n N)ᴴ * cssCopySynthesis n N =
      (1 : Matrix
        ((Fin n → ZMod 2) →ₗ[ZMod 2] ((orthogonal N) ⧸ N.comap (orthogonal N).subtype))
        ((Fin n → ZMod 2) →ₗ[ZMod 2] ((orthogonal N) ⧸ N.comap (orthogonal N).subtype)) ℂ)

def CSSProjectionIdempotent : Prop :=
  ∀ {k : ℕ} (n : ℕ) (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    (∀ x ∈ N, (∑ i, ((x i).val : ZMod 4)) = 0) →
    (CSSColumns n N * (CSSColumns n N)ᴴ) * (CSSColumns n N * (CSSColumns n N)ᴴ) =
      CSSColumns n N * (CSSColumns n N)ᴴ

def CSSProjectionSpan : Prop :=
  ∀ {k : ℕ} (n : ℕ) (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    (∀ x ∈ N, (∑ i, ((x i).val : ZMod 4)) = 0) →
    LinearMap.range (CSSColumns n N * (CSSColumns n N)ᴴ).mulVecLin =
      Submodule.span ℂ (Set.range (CSSColumns n N).col)

def CSSLiftExists : Prop :=
  ∀ {k : ℕ} (n : ℕ) (N : Submodule (ZMod 2) (Fin k → ZMod 2))
    (f : (Fin n → ZMod 2) →ₗ[ZMod 2] ((orthogonal N) ⧸ N.comap (orthogonal N).subtype)),
    ∃ F : (Fin n → ZMod 2) →ₗ[ZMod 2] orthogonal N,
      (N.comap (orthogonal N).subtype).mkQ.comp F = f

def CSSNoiseCardinality : Prop :=
  ∀ {k : ℕ} (n : ℕ) (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    Nat.card ((Fin n → ZMod 2) →ₗ[ZMod 2] N) =
      ((2 : ℕ) ^ n) ^ Module.finrank (ZMod 2) N

def CSSAffineSupport : Prop :=
  ∀ {k : ℕ} (n : ℕ) (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    (∀ x ∈ N, (∑ i, ((x i).val : ZMod 4)) = 0) →
    ∀ (f : (Fin n → ZMod 2) →ₗ[ZMod 2]
      ((orthogonal N) ⧸ N.comap (orthogonal N).subtype))
      (F : (Fin n → ZMod 2) →ₗ[ZMod 2] orthogonal N),
    (N.comap (orthogonal N).subtype).mkQ.comp F = f →
    ∀ X : Fin n → (Fin k → ZMod 2),
      (∀ a, ∃ hx : X a ∈ orthogonal N,
        (Submodule.Quotient.mk (⟨X a, hx⟩ : orthogonal N) :
          (orthogonal N) ⧸ N.comap (orthogonal N).subtype) = f (Pi.single a 1)) ↔
      ∃ Z : (Fin n → ZMod 2) →ₗ[ZMod 2] N,
        X = fun a => (F (Pi.single a 1)).val + (Z (Pi.single a 1)).val

def CSSCopyAffineSum : Prop :=
  ∀ {k : ℕ} (n : ℕ) (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    (∀ x ∈ N, (∑ i, ((x i).val : ZMod 4)) = 0) →
    ∀ (f : (Fin n → ZMod 2) →ₗ[ZMod 2]
      ((orthogonal N) ⧸ N.comap (orthogonal N).subtype))
      (F : (Fin n → ZMod 2) →ₗ[ZMod 2] orthogonal N),
    (N.comap (orthogonal N).subtype).mkQ.comp F = f →
    ∀ X : Fin k → (Fin n → ZMod 2),
      cssCopySynthesis n N X f =
        (Real.sqrt (((((2 : ℕ) ^ n) ^ Module.finrank (ZMod 2) N : ℕ) : ℝ)) : ℂ)⁻¹ *
          ∑ Z : (Fin n → ZMod 2) →ₗ[ZMod 2] N,
            if (fun a i => X i a) =
              (fun a => (F (Pi.single a 1)).val + (Z (Pi.single a 1)).val)
            then 1 else 0

def CSSCopyAffineRealPower : Prop :=
  ∀ {k : ℕ} (n : ℕ) (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    (∀ x ∈ N, (∑ i, ((x i).val : ZMod 4)) = 0) →
    ∀ (f : (Fin n → ZMod 2) →ₗ[ZMod 2]
      ((orthogonal N) ⧸ N.comap (orthogonal N).subtype))
      (F : (Fin n → ZMod 2) →ₗ[ZMod 2] orthogonal N),
    (N.comap (orthogonal N).subtype).mkQ.comp F = f →
    ∀ X : Fin k → (Fin n → ZMod 2),
      cssCopySynthesis n N X f =
        (Real.rpow ((2 : ℝ) ^ n) (-(Module.finrank (ZMod 2) N : ℝ) / 2) : ℂ) *
          ∑ Z : (Fin n → ZMod 2) →ₗ[ZMod 2] N,
            if (fun a i => X i a) =
              (fun a => (F (Pi.single a 1)).val + (Z (Pi.single a 1)).val)
            then 1 else 0

def CSSRealPowerNormalization : Prop :=
  ∀ n r : ℕ, Real.rpow ((2 : ℝ) ^ n) (-(r : ℝ) / 2) =
    (Real.sqrt (((((2 : ℕ) ^ n) ^ r : ℕ) : ℝ)))⁻¹

/-- This checks the column data independently of the implementation's proposition aliases. -/
theorem cssColumns_expanded {k : ℕ} (n : ℕ)
    (N : Submodule (ZMod 2) (Fin k → ZMod 2)) :
    cssColumnSynthesis n N = CSSColumns n N := rfl

/-- Actual copy-first basis entries and Hom labels, with every quotient test explicit. -/
theorem cssCopySynthesis_expanded {k : ℕ} (n : ℕ)
    (N : Submodule (ZMod 2) (Fin k → ZMod 2))
    (X : Fin k → (Fin n → ZMod 2))
    (f : (Fin n → ZMod 2) →ₗ[ZMod 2]
      ((orthogonal N) ⧸ N.comap (orthogonal N).subtype)) :
    cssCopySynthesis n N X f =
      if ∀ a : Fin n, ∃ hx : (fun i => X i a) ∈ orthogonal N,
        (Submodule.Quotient.mk (⟨fun i => X i a, hx⟩ : orthogonal N) :
          (orthogonal N) ⧸ N.comap (orthogonal N).subtype) = f (Pi.single a 1)
      then ((Real.sqrt (Nat.card N) : ℂ)⁻¹) ^ n else 0 := by
  rw [cssCopySynthesis_apply]
  unfold cosetMember
  split_ifs <;> rfl

end CriticalCurveExpected

