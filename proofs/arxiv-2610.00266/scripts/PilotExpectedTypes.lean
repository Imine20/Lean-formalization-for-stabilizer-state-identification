namespace CSSAffineOverlapExpected
open Classical Matrix Module ExactCriticalCurve ExactCriticalCurve.Binary ExactCriticalCurve.Quantum
open scoped BigOperators
abbrev V (k : ℕ) := Fin k → ZMod 2
abbrev D (k : ℕ) := Submodule (ZMod 2) (V k)
abbrev C (n k : ℕ) := Fin n → V k

def Support {n k : ℕ} (N : D k) (F X : C n k) : Prop := ∀ a, X a - F a ∈ N
def Intersection {n k : ℕ} (N M : D k) (F G : C n k) :=
  {X : C n k // Support N F X ∧ Support M G X}
def Vector {n k : ℕ} (N : D k) (F : C n k) : C n k → ℂ :=
  fun X => if Support N F X then ((Real.sqrt (Nat.card N) : ℂ)⁻¹)^n else 0

def NonemptyCriterion : Prop := ∀ {n k : ℕ} (N M : D k) (F G : C n k),
  Nonempty (Intersection N M F G) ↔ ∀ a, G a - F a ∈ N ⊔ M
def IntersectionCount : Prop := ∀ {n k : ℕ} (N M : D k) (F G : C n k),
  Nonempty (Intersection N M F G) →
  Nat.card (Intersection N M F G) = ((2 : ℕ)^n)^finrank (ZMod 2) ↥(N ⊓ M)
def FullCount : Prop := ∀ {n k : ℕ} (N M : D k) (F G : C n k),
  Nat.card (Intersection N M F G) = if ∀ a, G a - F a ∈ N ⊔ M
    then ((2 : ℕ)^n)^finrank (ZMod 2) ↥(N ⊓ M) else 0

def ActualSynthesis : Prop := ∀ {n k : ℕ} (N : D k) (hN : IsDefect N)
  (F : (Fin n → ZMod 2) →ₗ[ZMod 2] orthogonal N),
  Vector N (fun a => (F (Pi.single a 1)).val) =
    (cssHomSynthesis n N).col ((N.comap (orthogonal N).subtype).mkQ.comp F)
def ActualAction : Prop := ∀ {n k : ℕ} (N : D k) (F : C n k) (g : StochasticIsometryGroup k),
  stochasticIsometryMatrix n g *ᵥ Vector N F =
    Vector (N.map g.val.toLinearMap) (fun a => g.val (F a))
def CountOverlap : Prop := ∀ {n k : ℕ} (N M : D k) (F G : C n k),
  star (Vector N F) ⬝ᵥ Vector M G =
    (((Real.sqrt (Nat.card N) : ℂ)⁻¹)^n * ((Real.sqrt (Nat.card M) : ℂ)⁻¹)^n) *
      (Nat.card (Intersection N M F G) : ℂ)
def FullSpaceCriterion : Prop := ∀ {n k : ℕ} (N : D k)
  (F : (Fin n → ZMod 2) →ₗ[ZMod 2] orthogonal N) (hF : Function.Surjective F)
  (g : StochasticIsometryGroup k),
  Nonempty (Intersection N (N.map g.val.toLinearMap)
    (fun a => (F (Pi.single a 1)).val) (fun a => g.val (F (Pi.single a 1)).val)) ↔
  ∀ x ∈ orthogonal N, g.val x - x ∈ N ⊔ N.map g.val.toLinearMap

def AmplitudeSquare : Prop := ∀ {n k : ℕ} (N : D k),
  ((Real.sqrt (Nat.card N) : ℂ)⁻¹)^n * ((Real.sqrt (Nat.card N) : ℂ)⁻¹)^n =
    (((2 : ℂ)^n)^finrank (ZMod 2) N)⁻¹
def NormalizedOverlap : Prop := ∀ {n k : ℕ} (N M : D k) (F G : C n k),
  finrank (ZMod 2) M = finrank (ZMod 2) N →
  star (Vector N F) ⬝ᵥ Vector M G = if ∀ a, G a - F a ∈ N ⊔ M
    then (((2 : ℂ)^n)^(finrank (ZMod 2) N - finrank (ZMod 2) ↥(N ⊓ M)))⁻¹ else 0
def PhysicalOverlap : Prop := ∀ {n k : ℕ} (N : D k) (hN : IsDefect N)
  (F : (Fin n → ZMod 2) →ₗ[ZMod 2] orthogonal N) (hF : Function.Surjective F)
  (g : StochasticIsometryGroup k),
  let v := (cssHomSynthesis n N).col ((N.comap (orthogonal N).subtype).mkQ.comp F)
  star v ⬝ᵥ (stochasticIsometryMatrix n g *ᵥ v) =
    if ∀ x ∈ orthogonal N, g.val x - x ∈ N ⊔ N.map g.val.toLinearMap
    then (((2 : ℂ)^n)^(finrank (ZMod 2) N - finrank (ZMod 2) ↥(N ⊓ N.map g.val.toLinearMap)))⁻¹
    else 0

def SupportType : Type := ∀ {n k : ℕ}, D k → C n k → C n k → Prop
def IntersectionType : Type 1 := ∀ {n k : ℕ}, D k → D k → C n k → C n k → Type
def TranslationType : Type := ∀ {n k : ℕ} (N M : D k) (F G : C n k),
  Intersection N M F G → ((Fin n → ↥(N ⊓ M)) ≃ Intersection N M F G)
def VectorType : Type := ∀ {n k : ℕ}, D k → C n k → C n k → ℂ

example {n k : ℕ} (N : D k) (F X : C n k) : cssAffineSupport N F X = Support N F X := rfl
example {n k : ℕ} (N M : D k) (F G : C n k) :
  CSSAffineIntersection N M F G = Intersection N M F G := rfl
example {n k : ℕ} (N : D k) (F : C n k) : cssAffineColumnVector N F = Vector N F := rfl
example {n k : ℕ} (N M : D k) (F G : C n k) (Y : Intersection N M F G)
  (Z : Fin n → ↥(N ⊓ M)) :
  (cssAffineIntersectionEquiv N M F G Y Z).val = fun a => Y.val a + (Z a).val := rfl
example {n k : ℕ} (N M : D k) (F G : C n k) (Y X : Intersection N M F G) (a : Fin n) :
  ((cssAffineIntersectionEquiv N M F G Y).symm X a).val = X.val a - Y.val a := rfl
end CSSAffineOverlapExpected

