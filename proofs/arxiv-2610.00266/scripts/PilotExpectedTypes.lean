def DefectPairOrthogonality : Prop :=
  ∀ {k : ℕ} {N : Submodule (ZMod 2) (Fin k → ZMod 2)},
    (∀ x ∈ N, (∑ i, ((x i).val : ZMod 4)) = 0) →
    ∀ {x y : Fin k → ZMod 2}, x ∈ N → y ∈ N → (∑ i, x i * y i) = 0

def OrthogonalDimension : Prop :=
  ∀ {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    Module.finrank (ZMod 2) (orthogonal N) + Module.finrank (ZMod 2) N = k

def DefectRelationDimension : Prop :=
  ∀ {k : ℕ} {N : Submodule (ZMod 2) (Fin k → ZMod 2)},
    (∀ x ∈ N, (∑ i, ((x i).val : ZMod 4)) = 0) →
    Module.finrank (ZMod 2) (defectRelation N) = k

def DefectRelationQuadratic : Prop :=
  ∀ {k : ℕ} {N : Submodule (ZMod 2) (Fin k → ZMod 2)},
    (∀ x ∈ N, (∑ i, ((x i).val : ZMod 4)) = 0) →
    ∀ p : (Fin k → ZMod 2) × (Fin k → ZMod 2), p ∈ defectRelation N →
      (∑ i, ((p.1 i).val : ZMod 4)) - (∑ i, ((p.2 i).val : ZMod 4)) = 0

def CosetFiberCardinality : Prop :=
  ∀ {k : ℕ} (H N : Submodule (ZMod 2) (Fin k → ZMod 2)), N ≤ H →
    ∀ q : H ⧸ N.comap H.subtype,
      Nat.card {x : Fin k → ZMod 2 //
        ∃ hx : x ∈ H, (Submodule.Quotient.mk (⟨x, hx⟩ : H) : H ⧸ N.comap H.subtype) = q} =
      Nat.card N

def CosetColumnIsometry : Prop :=
  ∀ {k : ℕ} (H N : Submodule (ZMod 2) (Fin k → ZMod 2)), N ≤ H →
    (cosetSynthesis H N)ᴴ * cosetSynthesis H N = 1

def CosetRelationFactor : Prop :=
  ∀ {k : ℕ} (H N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    (fun x y => if x ∈ H ∧ y ∈ H ∧ x - y ∈ N then (1 : ℂ) else 0) =
      (Nat.card N : ℂ) • (cosetSynthesis H N * (cosetSynthesis H N)ᴴ)

def CosetRelationSquare : Prop :=
  ∀ {k : ℕ} (H N : Submodule (ZMod 2) (Fin k → ZMod 2)), N ≤ H →
    cosetRelationMatrix H N * cosetRelationMatrix H N =
      (Nat.card N : ℂ) • cosetRelationMatrix H N

def CosetProjectionIdempotent : Prop :=
  ∀ {k : ℕ} (H N : Submodule (ZMod 2) (Fin k → ZMod 2)), N ≤ H →
    (cosetSynthesis H N * (cosetSynthesis H N)ᴴ) *
      (cosetSynthesis H N * (cosetSynthesis H N)ᴴ) =
        cosetSynthesis H N * (cosetSynthesis H N)ᴴ

def CosetProjectionSpan : Prop :=
  ∀ {k : ℕ} (H N : Submodule (ZMod 2) (Fin k → ZMod 2)), N ≤ H →
    LinearMap.range (cosetSynthesis H N * (cosetSynthesis H N)ᴴ).mulVecLin =
      Submodule.span ℂ (Set.range (cosetSynthesis H N).col)

/- Independent structural bridges expand the definitions used in the expected types. -/
theorem defectRelation_expanded {k : ℕ}
    (N : Submodule (ZMod 2) (Fin k → ZMod 2))
    (p : (Fin k → ZMod 2) × (Fin k → ZMod 2)) :
    p ∈ defectRelation N ↔
      (∀ z ∈ N, (∑ i, z i * p.1 i) = 0) ∧
      (∀ z ∈ N, (∑ i, z i * p.2 i) = 0) ∧ p.1 - p.2 ∈ N := Iff.rfl

theorem stochasticLagrangian_unrestricted {k : ℕ}
    (T : Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2)))
    (hDim : Module.finrank (ZMod 2) T = k)
    (hQuad : ∀ p ∈ T,
      (∑ i, ((p.1 i).val : ZMod 4)) - (∑ i, ((p.2 i).val : ZMod 4)) = 0)
    (hOne : ((fun _ => (1 : ZMod 2)), (fun _ => (1 : ZMod 2))) ∈ T) :
    ∃ S : StochasticLagrangian k, S.carrier = T :=
  ⟨⟨T, hDim, hQuad, hOne⟩, rfl⟩

theorem stochasticLagrangian_conditions {k : ℕ} (S : StochasticLagrangian k) :
    Module.finrank (ZMod 2) S.carrier = k ∧
      (∀ p ∈ S.carrier,
        (∑ i, ((p.1 i).val : ZMod 4)) - (∑ i, ((p.2 i).val : ZMod 4)) = 0) ∧
      ((fun _ => (1 : ZMod 2)), (fun _ => (1 : ZMod 2))) ∈ S.carrier :=
  ⟨S.finrank_eq, S.quadratic_zero, S.allOnes_mem⟩

theorem cosetSynthesis_expanded {k : ℕ}
    (H N : Submodule (ZMod 2) (Fin k → ZMod 2))
    (x : Fin k → ZMod 2) (q : H ⧸ N.comap H.subtype) :
    cosetSynthesis H N x q =
      if ∃ hx : x ∈ H,
        (Submodule.Quotient.mk (⟨x, hx⟩ : H) : H ⧸ N.comap H.subtype) = q
      then (Real.sqrt (Nat.card N) : ℂ)⁻¹ else 0 := by
  classical
  by_cases h : ∃ hx : x ∈ H,
      (Submodule.Quotient.mk (⟨x, hx⟩ : H) : H ⧸ N.comap H.subtype) = q
  · simp [cosetSynthesis, cosetIndicator, cosetMember, h]
  · simp [cosetSynthesis, cosetIndicator, cosetMember, h]

end CriticalCurveExpected

