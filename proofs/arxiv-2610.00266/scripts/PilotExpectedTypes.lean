abbrev RawPhaseCoefficients (m : ℕ) :=
  (Fin m → ZMod 4) × ({p : Fin m × Fin m // p.1 < p.2} → ZMod 2)

def RawPhaseValue {m : ℕ} (q : RawPhaseCoefficients m) (z : Fin m → ZMod 2) : ZMod 4 :=
  (∑ i : Fin m, q.1 i * (z i).val) +
    2 * ∑ p : {p : Fin m × Fin m // p.1 < p.2},
      ((q.2 p).val : ZMod 4) * (z p.val.1).val * (z p.val.2).val

def RawPhaseParity : ZMod 4 →+* ZMod 2 :=
  ZMod.castHom (by decide : 2 ∣ 4) (ZMod 2)

def RawPhaseCross {m : ℕ} (q : RawPhaseCoefficients m) (i j : Fin m) : ZMod 2 :=
  if h : i < j then q.2 ⟨(i, j), h⟩ else
    if h : j < i then q.2 ⟨(j, i), h⟩ else 0

def RawPhasePolar {m : ℕ} (q : RawPhaseCoefficients m)
    (z w : Fin m → ZMod 2) : ZMod 2 :=
  (∑ i : Fin m, RawPhaseParity (q.1 i) * z i * w i) +
    ∑ p : {p : Fin m × Fin m // p.1 < p.2},
      q.2 p * (z p.val.1 * w p.val.2 + z p.val.2 * w p.val.1)

theorem quadraticPhaseValue_expanded {m : ℕ} (q : RawPhaseCoefficients m)
    (z : Fin m → ZMod 2) : quadraticPhaseValue q z = RawPhaseValue q z := rfl

theorem quadraticPhaseParity_expanded (c : ZMod 4) :
    phaseParity c = ZMod.cast c := rfl

def PhaseValueZero : Prop :=
  ∀ {m : ℕ} (q : RawPhaseCoefficients m), RawPhaseValue q 0 = 0

def PhaseValueSingle : Prop :=
  ∀ {m : ℕ} (q : RawPhaseCoefficients m) (i : Fin m),
    RawPhaseValue q (Pi.single i 1) = q.1 i

def PhaseValueDouble : Prop :=
  ∀ {m : ℕ} (q : RawPhaseCoefficients m) (i j : Fin m) (h : i < j),
    RawPhaseValue q (Pi.single i 1 + Pi.single j 1) =
      q.1 i + q.1 j + 2 * ((q.2 ⟨(i, j), h⟩).val : ZMod 4)

def PhaseCoefficientInjective : Prop :=
  ∀ {m : ℕ}, Function.Injective (@RawPhaseValue m)

def PhaseExactDifference : Prop :=
  ∀ {m : ℕ} (q : RawPhaseCoefficients m) (z : Fin m → ZMod 2) (j : Fin m),
    RawPhaseValue q (z + Pi.single j 1) - RawPhaseValue q z =
      q.1 j + 2 * ((RawPhaseParity (q.1 j) * z j +
        ∑ l ∈ Finset.univ.erase j, RawPhaseCross q j l * z l).val : ZMod 4)

def PhaseExactPolarization : Prop :=
  ∀ {m : ℕ} (q : RawPhaseCoefficients m) (z w : Fin m → ZMod 2),
    RawPhaseValue q (z + w) =
      RawPhaseValue q z + RawPhaseValue q w + 2 * ((RawPhasePolar q z w).val : ZMod 4)

def PhasePolarSymmetric : Prop :=
  ∀ {m : ℕ} (q : RawPhaseCoefficients m) (z w : Fin m → ZMod 2),
    RawPhasePolar q z w = RawPhasePolar q w z

def PhasePolarActualForm : Prop :=
  ∀ {m : ℕ} (q : RawPhaseCoefficients m) (z w : Fin m → ZMod 2),
    quadraticPhasePolarForm q z w = RawPhasePolar q z w

def PhasePolarSymmetricForm : Prop :=
  ∀ {m : ℕ} (q : RawPhaseCoefficients m), (quadraticPhasePolarForm q).IsSymm

def BinaryDifferenceRecovery : Prop :=
  ∀ {m : ℕ} (f g : (Fin m → ZMod 2) → ZMod 4),
    f 0 = g 0 →
    (∀ (z : Fin m → ZMod 2) (j : Fin m),
      f (z + Pi.single j 1) - f z = g (z + Pi.single j 1) - g z) →
    f = g

def PhaseDifferenceRecovery : Prop :=
  ∀ {m : ℕ} (q : RawPhaseCoefficients m) (f : (Fin m → ZMod 2) → ZMod 4),
    f 0 = 0 →
    (∀ (z : Fin m → ZMod 2) (j : Fin m),
      f (z + Pi.single j 1) - f z =
        q.1 j + 2 * ((RawPhaseParity (q.1 j) * z j +
          ∑ l ∈ Finset.univ.erase j, RawPhaseCross q j l * z l).val : ZMod 4)) →
    f = RawPhaseValue q

end CriticalCurveExpected

