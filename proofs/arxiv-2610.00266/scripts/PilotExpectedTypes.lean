        (∑ j, (Matrix.trace (M.effect j *
          Matrix.vecMulVec (fun x => S x j) (star (fun x => S x j)))).re) /
            Fintype.card Ω = v}
      (((((Finset.univ.val.map (Matrix.isHermitian_transpose_mul_self S).eigenvalues).filter (· ≠ 0)).map Real.sqrt).sum / Fintype.card Ω) ^ 2)

def SpectralAttainment {ι Ω : Type*} [Fintype ι] [DecidableEq ι]
