def AutomorphismCard : Prop := ∀ r : ℕ,
  Nat.card ((Fin r → ZMod 2) ≃ₗ[ZMod 2] (Fin r → ZMod 2)) =
    2 ^ r.choose 2 * ∏ j ∈ Finset.range r, (2 ^ (j + 1) - 1)
def Exponent : Prop := ∀ {k r : ℕ} (_ : Ordinary k r),
  r.choose 2 + r * (k - 2 * r - 1) + r.choose 2 = r * (k - r - 2)
def ClosedCard : Prop := ∀ {k r : ℕ} (N : Ordinary k r),
  Nat.card (Kernel N.val) =
    2 ^ (r * (k - r - 2)) * ∏ j ∈ Finset.range r, (2 ^ (j + 1) - 1)
def ZeroCard : Prop := ∀ {k : ℕ} (N : Ordinary k 0), Nat.card (Kernel N.val) = 1
def QuotientOneCard : Prop := ∀ {k r : ℕ} (N : Ordinary k r),
  finrank (ZMod 2) (Quotient N.val) = 1 →
    Nat.card (Kernel N.val) =
      2 ^ (r * (r - 1)) * ∏ j ∈ Finset.range r, (2 ^ (j + 1) - 1)
