namespace CSSQuotientGeometryExpected
open Classical ExactCriticalCurve ExactCriticalCurve.Binary ExactCriticalCurve.Quantum
open scoped BigOperators

def QuadraticRepresentative : Prop :=
  ∀ {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (hN : IsDefect N)
    (x : orthogonal N),
    cssQuotientQuadratic N hN
      (Submodule.Quotient.mk x : (orthogonal N) ⧸ N.comap (orthogonal N).subtype) =
      ∑ i, bitLift (x.val i)

def PairingRepresentative : Prop :=
  ∀ {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (x y : orthogonal N),
    cssQuotientPairing N
      (Submodule.Quotient.mk x : (orthogonal N) ⧸ N.comap (orthogonal N).subtype)
      (Submodule.Quotient.mk y : (orthogonal N) ⧸ N.comap (orthogonal N).subtype) =
      ∑ i, x.val i * y.val i

def BilinearRepresentative : Prop :=
  ∀ {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (x y : orthogonal N),
    cssQuotientBilinear N
      (Submodule.Quotient.mk x : (orthogonal N) ⧸ N.comap (orthogonal N).subtype)
      (Submodule.Quotient.mk y : (orthogonal N) ⧸ N.comap (orthogonal N).subtype) =
      ∑ i, x.val i * y.val i

def BilinearSymmetry : Prop :=
  ∀ {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2))
    (x y : (orthogonal N) ⧸ N.comap (orthogonal N).subtype),
    cssQuotientBilinear N x y = cssQuotientBilinear N y x

def BilinearNondegeneracy : Prop :=
  ∀ {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    ∀ x : (orthogonal N) ⧸ N.comap (orthogonal N).subtype,
      (∀ y : (orthogonal N) ⧸ N.comap (orthogonal N).subtype,
        cssQuotientBilinear N x y = 0) → x = 0

def QuadraticZero : Prop :=
  ∀ {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (hN : IsDefect N),
    cssQuotientQuadratic N hN (0 : (orthogonal N) ⧸ N.comap (orthogonal N).subtype) = 0

def QuadraticAddition : Prop :=
  ∀ {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (hN : IsDefect N)
    (x y : (orthogonal N) ⧸ N.comap (orthogonal N).subtype),
    cssQuotientQuadratic N hN (x + y) =
      cssQuotientQuadratic N hN x + cssQuotientQuadratic N hN y +
        (2 : ZMod 4) * bitLift (cssQuotientBilinear N x y)

def DefectDimensionBound : Prop :=
  ∀ {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    IsDefect N → 2 * Module.finrank (ZMod 2) N ≤ k

def AdditiveDimension : Prop :=
  ∀ {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)), IsDefect N →
    Module.finrank (ZMod 2) ((orthogonal N) ⧸ N.comap (orthogonal N).subtype) +
      2 * Module.finrank (ZMod 2) N = k

def DimensionDifference : Prop :=
  ∀ {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)), IsDefect N →
    Module.finrank (ZMod 2) ((orthogonal N) ⧸ N.comap (orthogonal N).subtype) =
      k - 2 * Module.finrank (ZMod 2) N

def WuCharacteristic : Prop :=
  ∀ {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (hN : IsDefect N)
    (x : (orthogonal N) ⧸ N.comap (orthogonal N).subtype),
    cssQuotientBilinear N x x =
      cssQuotientBilinear N x (Submodule.Quotient.mk
        (⟨allOnes k, hN.allOnes_mem_orthogonal⟩ : orthogonal N))

def WuZeroCriterion : Prop :=
  ∀ {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (hN : IsDefect N),
    (Submodule.Quotient.mk
      (⟨allOnes k, hN.allOnes_mem_orthogonal⟩ : orthogonal N) :
        (orthogonal N) ⧸ N.comap (orthogonal N).subtype) = 0 ↔ allOnes k ∈ N

def WuQuadratic : Prop :=
  ∀ {k : ℕ} (N : Submodule (ZMod 2) (Fin k → ZMod 2)) (hN : IsDefect N),
    cssQuotientQuadratic N hN (Submodule.Quotient.mk
      (⟨allOnes k, hN.allOnes_mem_orthogonal⟩ : orthogonal N)) = (k : ZMod 4)

def OrdinaryWuNonzero : Prop :=
  ∀ {k r : ℕ} (N : {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
    IsDefect N ∧ Module.finrank (ZMod 2) N = r ∧ allOnes k ∉ N}),
    (Submodule.Quotient.mk
      (⟨allOnes k, N.property.1.allOnes_mem_orthogonal⟩ : orthogonal N.val) :
        (orthogonal N.val) ⧸ N.val.comap (orthogonal N.val).subtype) ≠ 0

def ExceptionalWuZero : Prop :=
  ∀ {k r : ℕ} (N : {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
    IsDefect N ∧ Module.finrank (ZMod 2) N = r ∧ allOnes k ∈ N}),
    (Submodule.Quotient.mk
      (⟨allOnes k, N.property.1.allOnes_mem_orthogonal⟩ : orthogonal N.val) :
        (orthogonal N.val) ⧸ N.val.comap (orthogonal N.val).subtype) = 0

def ExceptionalAlternating : Prop :=
  ∀ {k r : ℕ} (N : {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
    IsDefect N ∧ Module.finrank (ZMod 2) N = r ∧ allOnes k ∈ N}),
    ∀ x : (orthogonal N.val) ⧸ N.val.comap (orthogonal N.val).subtype,
      cssQuotientBilinear N.val x x = 0

def OrdinaryNonalternating : Prop :=
  ∀ {k r : ℕ} (N : {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
    IsDefect N ∧ Module.finrank (ZMod 2) N = r ∧ allOnes k ∉ N}),
    ¬ ∀ x : (orthogonal N.val) ⧸ N.val.comap (orthogonal N.val).subtype,
      cssQuotientBilinear N.val x x = 0

end CSSQuotientGeometryExpected

