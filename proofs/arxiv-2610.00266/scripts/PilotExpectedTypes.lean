def TensorMultiplication {α β γ : Type*} [Fintype β] : Prop :=
  ∀ (n : ℕ) (A : Matrix α β ℂ) (B : Matrix β γ ℂ),
    (fun (X : Fin n → α) (Z : Fin n → γ) =>
      ∏ a : Fin n, ∑ y : β, A (X a) y * B y (Z a)) =
    (fun (X : Fin n → α) (Z : Fin n → γ) =>
      ∑ Y : Fin n → β,
        (∏ a : Fin n, A (X a) (Y a)) * (∏ a : Fin n, B (Y a) (Z a)))

def TensorScaling {α β : Type*} : Prop :=
  ∀ (n : ℕ) (c : ℂ) (A : Matrix α β ℂ),
    (fun (X : Fin n → α) (Y : Fin n → β) =>
      ∏ a : Fin n, c * A (X a) (Y a)) =
    (fun (X : Fin n → α) (Y : Fin n → β) =>
      c ^ n * ∏ a : Fin n, A (X a) (Y a))

def TensorColumnIsometry {α β : Type*} [Fintype α] [DecidableEq β] : Prop :=
  ∀ (n : ℕ) (A : Matrix α β ℂ), Aᴴ * A = 1 →
    (fun (Y Z : Fin n → β) =>
      ∑ X : Fin n → α,
        star (∏ a : Fin n, A (X a) (Y a)) *
          (∏ a : Fin n, A (X a) (Z a))) =
      (1 : Matrix (Fin n → β) (Fin n → β) ℂ)

def CoordinateTranspose : Prop :=
  ∀ (n k : ℕ) (F : Fin k → (Fin n → ZMod 2)) (a : Fin n) (i : Fin k),
    copyColumnsEquiv n k F a i = F i a

def HomColumnsEvaluation (n : ℕ) (Q : Type*) [AddCommMonoid Q]
    [Module (ZMod 2) Q] : Prop :=
  ∀ (f : (Fin n → ZMod 2) →ₗ[ZMod 2] Q) (a : Fin n),
    (Module.piEquiv (Fin n) (ZMod 2) Q).symm f a = f (Pi.single a 1)

def HomColumnsReconstruction (n : ℕ) (Q : Type*) [AddCommMonoid Q]
    [Module (ZMod 2) Q] : Prop :=
  ∀ (X : Fin n → Q) (v : Fin n → ZMod 2),
    Module.piEquiv (Fin n) (ZMod 2) Q X v = ∑ a, v a • X a

end CriticalCurveExpected

