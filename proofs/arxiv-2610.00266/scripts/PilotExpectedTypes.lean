    ((binaryGaussian (a+t) a : ℚ)*binaryGaussianFactorial t*binaryPlusProduct a t)
def PowerProduct : Prop := ∀ t : ℕ,
  (∏ j ∈ Finset.range t, (2 : ℚ)^(j+1))=(2 : ℚ)^((t+1).choose 2)
def RisingReverse : Prop := ∀ a t : ℕ,
  binaryNewtonRising ((2 : ℚ)^(a+t+1)) 2 t=(2 : ℚ)^((t+1).choose 2)*binaryPlusProduct a t
def RisingTop : Prop := ∀ a t : ℕ, 0<t →
  ((2 : ℚ)^(a+t)+1)*binaryNewtonRising ((2 : ℚ)^(a+t)) 2 (t-1)=
    (2 : ℚ)^(t.choose 2)*binaryPlusProduct a t

def NewtonCoefficient : Type := ℕ → ℕ → ℚ
def GaussianRowCross : Prop := ∀ a v : ℕ,
