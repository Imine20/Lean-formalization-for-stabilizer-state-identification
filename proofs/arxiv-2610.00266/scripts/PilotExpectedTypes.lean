open Lean Elab Command Meta in
def auditSupportDefinition (actual expected : Name) : CommandElabM Unit := do
  liftTermElabM do
    let info ← getConstInfo actual
    match info with
    | .defnInfo _ => pure ()
    | _ => throwError "Expected definition: {actual}"
    let einfo ← getConstInfo expected
    unless info.levelParams.length == einfo.levelParams.length do
      throwError "Definition universe generality mismatch: {actual}"
    let params := (List.range info.levelParams.length).map (fun i => Name.mkSimple ("supportAuditUniverse" ++ toString i))
    let levels := params.map Level.param
    let eterm := mkConst expected levels
    let etype ← inferType eterm
    let expectedValue ← forallTelescope etype fun args _ => mkForallFVars args (mkAppN eterm args)
    let constant := mkConst actual levels
    unless ← isDefEq (← inferType constant) expectedValue do
      throwError "Definition literal type mismatch: {actual}"
    let env := (← getEnv).toKernelEnv
    let limit := (Core.getMaxHeartbeats (← getOptions)).toUSize
    for (label,value) in #[("constant",constant),("body",info.instantiateValueLevelParams! levels)] do
      let name ← mkFreshUserName (Name.mkSimple ("supportDefinitionKernel_" ++ label))
      let decl : Declaration := .defnDecl {
        name := name, levelParams := params, type := expectedValue, value := value,
        hints := .opaque, safety := .safe }
      let _ ← ofExceptKernelException <| Kernel.Environment.addDeclCore env limit decl none
      logInfo m!"KERNEL_EXPECTED_TYPE_OK {label} {actual}"
  let axioms ← collectAxioms actual
  for ax in axioms do
    unless #[`propext, `Classical.choice, `Quot.sound].contains ax do
      throwError "Forbidden transitive axiom {ax} in {actual}"
  logInfo m!"EXACT_DEFINITION_TYPE_AND_AXIOMS_OK {actual}"

