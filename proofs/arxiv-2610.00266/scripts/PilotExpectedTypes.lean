def GLZero : Prop := binaryGLFactor 0=1
def SymplecticZero : Prop := binarySymplecticFactor 0=1
def GLSucc : Prop := ∀ d : ℕ,
  binaryGLFactor (d+1)=(2 : ℚ)^d*((2 : ℚ)^(d+1)-1)*binaryGLFactor d
def SymplecticSucc : Prop := ∀ a : ℕ,
  binarySymplecticFactor (a+1)=(2 : ℚ)^(2*a+1)*((4 : ℚ)^(a+1)-1)*binarySymplecticFactor a
def ActualAlternatingFactor : Prop := ∀ a : ℕ,
  (nondegenerateAlternatingCount (2*a) : ℚ)*binarySymplecticFactor a=binaryGLFactor (2*a)
def ActualGaussianFalling : Prop := ∀ n d : ℕ,
  (binaryGaussian n d : ℚ)*binaryGLFactor d=binaryNewtonFalling ((2 : ℚ)^n) 1 d
def ChooseAdd : Prop := ∀ u v : ℕ, (u+v).choose 2=u.choose 2+v.choose 2+u*v
def ActualGaussianGL : Prop := ∀ u v : ℕ,
  (binaryGaussian (u+v) u : ℚ)*binaryGLFactor u*binaryGLFactor v*(2 : ℚ)^(u*v)=binaryGLFactor (u+v)
def ActualFlagTerm : Prop := ∀ n ell a : ℕ, a≤ell →
  (binaryGaussian n (ell+a) : ℚ)*(binaryGaussian (ell+a) (ell-a) : ℚ)*
    (nondegenerateAlternatingCount (2*a) : ℚ)=
  binaryNewtonFalling ((2 : ℚ)^n) 1 (ell+a)/
    ((2 : ℚ)^(2*a*(ell-a))*binaryGLFactor (ell-a)*binarySymplecticFactor a)

def PlusProduct : Type := ℕ → ℕ → ℚ
def GaussianShifted : Prop := ∀ a t : ℕ,
  (binaryGaussian (a+t) a : ℚ)*binaryGaussianFactorial t=
    ∏ j ∈ Finset.range t, ((2 : ℚ)^(a+j+1)-1)
def SymplecticAdd : Prop := ∀ a t : ℕ,
