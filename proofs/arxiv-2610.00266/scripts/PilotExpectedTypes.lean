open scoped BigOperators ComplexOrder MatrixOrder
open Classical
namespace CriticalCurveExpected
open ExactCriticalCurve ExactCriticalCurve.Binary ExactCriticalCurve.Quantum Matrix

def StochasticWeight : Prop :=
  ∀ {k : ℕ} (g : StochasticIsometryGroup k) (x : Fin k → ZMod 2),
    (∑ i, bitLift (g.val x i)) = ∑ i, bitLift (x i)

def StochasticWu : Prop :=
  ∀ {k : ℕ} (g : StochasticIsometryGroup k), g.val (fun _ => 1) = fun _ => 1

def StochasticDot : Prop :=
  ∀ {k : ℕ} (g : StochasticIsometryGroup k) (x y : Fin k → ZMod 2),
    (∑ i, g.val x i * g.val y i) = ∑ i, x i * y i

def StochasticDefect : Prop :=
  ∀ {k : ℕ} (g : StochasticIsometryGroup k)
    {N : Submodule (ZMod 2) (Fin k → ZMod 2)},
    (∀ x ∈ N, (∑ i, bitLift (x i)) = 0) →
      ∀ x ∈ N.map g.val.toLinearMap, (∑ i, bitLift (x i)) = 0

def StochasticOrthogonal : Prop :=
  ∀ {k : ℕ} (g : StochasticIsometryGroup k)
    (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    orthogonal (N.map g.val.toLinearMap) = (orthogonal N).map g.val.toLinearMap

def StochasticDefectRelation : Prop :=
  ∀ {k : ℕ} (g : StochasticIsometryGroup k)
    (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    (defectRelation N).map (g.val.prodCongr g.val).toLinearMap =
      defectRelation (N.map g.val.toLinearMap)

def StochasticPhysicalAction : Prop :=
  ∀ {k : ℕ} (n : ℕ) (g : StochasticIsometryGroup k)
    (v : (Fin n → Fin k → ZMod 2) → ℂ),
    stochasticIsometryMatrix n g *ᵥ v = fun X => v (fun a => g.val.symm (X a))

def StochasticRepresentationLaw : Prop :=
  ∀ {k : ℕ} (n : ℕ) (g h : StochasticIsometryGroup k),
    (stochasticIsometryRepresentation n (g*h) : Matrix (Fin n → Fin k → ZMod 2)
      (Fin n → Fin k → ZMod 2) ℂ) =
      (stochasticIsometryRepresentation n g).val * (stochasticIsometryRepresentation n h).val

def StochasticRelationCovariance : Prop :=
  ∀ {k : ℕ} (n : ℕ) (g h : StochasticIsometryGroup k)
    (T : Submodule (ZMod 2) ((Fin k → ZMod 2) × (Fin k → ZMod 2))),
    stochasticIsometryMatrix n g *
      Matrix.of (fun X Y : Fin n → Fin k → ZMod 2 =>
        ∏ a, if (X a,Y a) ∈ T then (1:ℂ) else 0) *
      (stochasticIsometryMatrix n h)ᴴ =
      Matrix.of (fun X Y : Fin n → Fin k → ZMod 2 =>
        ∏ a, if (X a,Y a) ∈ T.map (g.val.prodCongr h.val).toLinearMap then (1:ℂ) else 0)

def StochasticSumBiinvariance : Prop :=
  ∀ {k : ℕ} (n : ℕ) (g h : StochasticIsometryGroup k),
    stochasticIsometryMatrix n g *
        (∑ T : StochasticLagrangian k, relationOperator n T.carrier) *
      (stochasticIsometryMatrix n h)ᴴ =
        ∑ T : StochasticLagrangian k, relationOperator n T.carrier

def StochasticAverageSupport : Prop :=
  ∀ n k : ℕ,
    ((Fintype.card (StochasticIsometryGroup k) : ℂ)⁻¹ •
      ∑ g : StochasticIsometryGroup k, stochasticIsometryMatrix n g) *
    (∑ T : StochasticLagrangian k, relationOperator n T.carrier) *
    ((Fintype.card (StochasticIsometryGroup k) : ℂ)⁻¹ •
      ∑ g : StochasticIsometryGroup k, stochasticIsometryMatrix n g) =
      ∑ T : StochasticLagrangian k, relationOperator n T.carrier

def StochasticAverageFixedCriterion : Prop :=
  ∀ n k : ℕ, ∀ v : (Fin n → Fin k → ZMod 2) → ℂ,
    ((Fintype.card (StochasticIsometryGroup k) : ℂ)⁻¹ •
      ∑ g : StochasticIsometryGroup k, stochasticIsometryMatrix n g) *ᵥ v = v ↔
        ∀ g : StochasticIsometryGroup k, stochasticIsometryMatrix n g *ᵥ v = v

def StochasticCSSCovariance : Prop :=
  ∀ {k : ℕ} (n : ℕ) (g : StochasticIsometryGroup k)
    (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    stochasticIsometryMatrix n g * (cssColumnSynthesis n N * (cssColumnSynthesis n N)ᴴ) *
        (stochasticIsometryMatrix n g)ᴴ =
      cssColumnSynthesis n (N.map g.val.toLinearMap) *
        (cssColumnSynthesis n (N.map g.val.toLinearMap))ᴴ

def StochasticTensorFixed : Prop :=
  ∀ n k : ℕ, ∀ (g : StochasticIsometryGroup k) (S : StabilizerGroup n),
    stochasticIsometryMatrix n g *ᵥ
      (fun X : Fin n → Fin k → ZMod 2 => ∏ i, stabilizerVector S (fun a => X a i)) =
      (fun X : Fin n → Fin k → ZMod 2 => ∏ i, stabilizerVector S (fun a => X a i))

def StochasticTensorSpanInclusion : Prop :=
  ∀ n k : ℕ,
    Submodule.span ℂ (Set.range (fun S : StabilizerGroup n =>
      fun X : Fin n → Fin k → ZMod 2 => ∏ i, stabilizerVector S (fun a => X a i))) ≤
    LinearMap.range
      (((Fintype.card (StochasticIsometryGroup k) : ℂ)⁻¹ •
        ∑ g : StochasticIsometryGroup k, stochasticIsometryMatrix n g).mulVecLin)

end CriticalCurveExpected

