section
open Lean Elab Command Meta in
def auditOrthogonalBoundaryDefinition (actual expected : Name) : CommandElabM Unit := do
  liftTermElabM do
    let info ← getConstInfo actual
    let expectedInfo ← getConstInfo expected
    unless info.levelParams.length == expectedInfo.levelParams.length do
      throwError "Definition universe generality mismatch: {actual}"
    let levelParams := (List.range info.levelParams.length).map
      (fun i => Name.mkSimple ("auditUniverse" ++ toString i))
    let levels := levelParams.map Level.param
    let term := mkConst actual levels
    let expectedTerm := mkConst expected levels
    let expectedType ← inferType expectedTerm
    let expectedValue ← forallTelescope expectedType fun args _ => do
      mkForallFVars args (mkAppN expectedTerm args)
    unless ← isDefEq (← inferType term) expectedValue do
      throwError "Independent definition type mismatch {actual}"
    let kernelEnv := (← getEnv).toKernelEnv
    let limit := (Core.getMaxHeartbeats (← getOptions)).toUSize
    for (label, value) in #[
        ("constant", term), ("body", info.instantiateValueLevelParams! levels)] do
      let name ← mkFreshUserName (Name.mkSimple ("definitionAudit_" ++ label))
      let decl : Declaration := .defnDecl {
        name := name, levelParams := levelParams, type := expectedValue, value := value,
        hints := .opaque, safety := .safe
      }
      let _ ← ofExceptKernelException <| Kernel.Environment.addDeclCore kernelEnv limit decl none
      logInfo m!"KERNEL_EXPECTED_DEFINITION_OK {label} {actual}"

namespace OrthogonalQuotientBoundaryExpected
universe u
open ExactCriticalCurve ExactCriticalCurve.FiniteQuadratic Module
open scoped BigOperators

def Alt (E : Type u) [AddCommGroup E] [Module (ZMod 2) E] :=
  {B : LinearMap.BilinForm (ZMod 2) E // B.IsAlt}
def QData (E : Type u) [AddCommGroup E] [Module (ZMod 2) E] :=
  Σ K : Submodule (ZMod 2) E, Alt (E ⧸ K)
def FullData (E : Type u) [AddCommGroup E] [Module (ZMod 2) E] :=
  {p : Submodule (ZMod 2) E × LinearMap.BilinForm (ZMod 2) E // p.2.IsAlt ∧ p.1 ≤ LinearMap.ker p.2}
def QBoundary (E : Type u) [AddCommGroup E] [Module (ZMod 2) E] (ell : ℕ) :=
  {p : QData E // finrank (ZMod 2) (E ⧸ p.1)+finrank (ZMod 2) (LinearMap.ker p.2.val)=2*ell}
def Boundary (E : Type u) [AddCommGroup E] [Module (ZMod 2) E] (ell : ℕ) :=
  {p : Submodule (ZMod 2) E × LinearMap.BilinForm (ZMod 2) E // p.2.IsAlt ∧ p.1 ≤ LinearMap.ker p.2 ∧
    finrank (ZMod 2) E+finrank (ZMod 2) (LinearMap.ker p.2)=2*ell+2*finrank (ZMod 2) p.1}

def BoundaryEquation : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E],
    ∀ (p : QData E) (ell : ℕ),
      finrank (ZMod 2) (E ⧸ p.1)+finrank (ZMod 2) (LinearMap.ker p.2.val)=2*ell ↔
      finrank (ZMod 2) E+finrank (ZMod 2) (LinearMap.ker (quotientAlternatingFullEquiv p).val.2)=
        2*ell+2*finrank (ZMod 2) (quotientAlternatingFullEquiv p).val.1
def Dimension : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E],
    ∀ p : QData E, finrank (ZMod 2) (E ⧸ p.1)=finrank (ZMod 2) (LinearMap.ker p.2.val)+
      2*quotientAlternatingHalfRank p
def BoundaryIndex : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E],
    ∀ (ell : ℕ) (p : QBoundary E ell),
      (alternatingBoundaryIndex ell (quotientAlternatingBoundaryEquiv ell p)).val=quotientAlternatingHalfRank p.val

def QDataType := ∀ (E : Type u) [AddCommGroup E] [Module (ZMod 2) E], Type u
def PullbackEquivType :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E], ∀ K : Submodule (ZMod 2) E,
    Alt (E ⧸ K) ≃ {A : Alt E // K ≤ LinearMap.ker A.val}
def FullEquivType :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E], QData E ≃ FullData E
def BoundaryEquivType :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E],
    ∀ ell : ℕ, QBoundary E ell ≃ Boundary E ell
def HalfRankType :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E], QData E → ℕ

example (E : Type u) [AddCommGroup E] [Module (ZMod 2) E] : QuotientAlternatingData E=QData E := rfl
example {E : Type u} [AddCommGroup E] [Module (ZMod 2) E]
    (K : Submodule (ZMod 2) E) (B : Alt (E ⧸ K)) :
    (alternatingQuotientPullbackEquiv K B).val.val=B.val.comp K.mkQ K.mkQ := rfl
example {E : Type u} [AddCommGroup E] [Module (ZMod 2) E]
    (K : Submodule (ZMod 2) E) (A : {A : Alt E // K ≤ LinearMap.ker A.val}) (x y : E) :
    ((alternatingQuotientPullbackEquiv K).symm A).val (K.mkQ x) (K.mkQ y)=A.val.val x y := rfl
example {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] (p : QData E) :
    (quotientAlternatingFullEquiv p).val=(p.1,p.2.val.comp p.1.mkQ p.1.mkQ) := rfl
example {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] (p : FullData E) (x y : E) :
    (quotientAlternatingFullEquiv.symm p).2.val (p.val.1.mkQ x) (p.val.1.mkQ y)=p.val.2 x y := rfl
example {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E]
    (ell : ℕ) (p : QBoundary E ell) :
    (quotientAlternatingBoundaryEquiv ell p).val=(p.val.1,p.val.2.val.comp p.val.1.mkQ p.val.1.mkQ) := rfl
example {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] (p : QData E) :
    quotientAlternatingHalfRank p=finrank (ZMod 2) (LinearMap.range p.2.val)/2 := rfl
example {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E]
    (ell : ℕ) (p : QBoundary E ell) :
    (alternatingBoundaryIndex ell (quotientAlternatingBoundaryEquiv ell p)).val=
      finrank (ZMod 2) E-finrank (ZMod 2) p.val.1-ell := rfl

def DataFiniteType : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E], Finite (QData E)
def DataFintypeType :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E], Fintype (QData E)
def BoundaryWeighted : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E],
    ∀ (ell : ℕ) (w : ℕ → ℚ),
      letI : Fintype (QData E) := quotientAlternatingDataFintype (E := E)
      (∑ p : QData E, if finrank (ZMod 2) (E ⧸ p.1)+finrank (ZMod 2) (LinearMap.ker p.2.val)=2*ell
        then w (finrank (ZMod 2) (LinearMap.range p.2.val)/2) else 0) =
      ∑ a ∈ Finset.range (ell+1),
        (Counting.binaryGaussian (finrank (ZMod 2) E) (ell+a) : ℚ)*
        (Counting.binaryGaussian (ell+a) (ell-a) : ℚ)*(nondegenerateAlternatingCount (2*a) : ℚ)*w a
def HeightWeighted : Prop :=
  ∀ {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E],
    ∀ (ell : ℕ) (w : ℕ → ℚ),
      letI : Fintype (QData E) := quotientAlternatingDataFintype (E := E)
      (∑ p : QData E, if finrank (ZMod 2) (LinearMap.ker p.2.val)+
          finrank (ZMod 2) (LinearMap.range p.2.val)/2=ell
        then w (finrank (ZMod 2) (LinearMap.range p.2.val)/2) else 0) =
      ∑ a ∈ Finset.range (ell+1),
        (Counting.binaryGaussian (finrank (ZMod 2) E) (ell+a) : ℚ)*
        (Counting.binaryGaussian (ell+a) (ell-a) : ℚ)*(nondegenerateAlternatingCount (2*a) : ℚ)*w a
example {E : Type u} [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E] :
    quotientAlternatingDataFintype (E := E)=@Fintype.ofFinite (QData E) (quotientAlternatingDataFinite (E := E)) := rfl
end OrthogonalQuotientBoundaryExpected
