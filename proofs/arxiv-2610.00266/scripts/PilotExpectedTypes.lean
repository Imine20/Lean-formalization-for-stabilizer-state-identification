section FiniteAverage
variable {G ι : Type*} [Group G] [Fintype G] [Fintype ι] [DecidableEq ι]

/-- Independent data expression: the actual uniform sum of every represented group element. -/
def UnitaryAverage (ρ : G →* unitary (Matrix ι ι ℂ)) : Matrix ι ι ℂ :=
  (Fintype.card G : ℂ)⁻¹ • ∑ g : G, (ρ g : Matrix ι ι ℂ)

def AverageInvarianceLeft : Prop :=
  ∀ (ρ : G →* unitary (Matrix ι ι ℂ)) (g : G),
    (ρ g : Matrix ι ι ℂ) * UnitaryAverage ρ = UnitaryAverage ρ

def AverageInvarianceRight : Prop :=
  ∀ (ρ : G →* unitary (Matrix ι ι ℂ)) (g : G),
    UnitaryAverage ρ * (ρ g : Matrix ι ι ℂ) = UnitaryAverage ρ

def AverageIdempotent : Prop :=
  ∀ ρ : G →* unitary (Matrix ι ι ℂ),
    UnitaryAverage ρ * UnitaryAverage ρ = UnitaryAverage ρ

def AverageHermitian : Prop :=
  ∀ ρ : G →* unitary (Matrix ι ι ℂ), (UnitaryAverage ρ)ᴴ = UnitaryAverage ρ

def AveragePositive : Prop :=
  ∀ ρ : G →* unitary (Matrix ι ι ℂ), (UnitaryAverage ρ).PosSemidef

def AverageTrace : Prop :=
  ∀ ρ : G →* unitary (Matrix ι ι ℂ),
    Matrix.trace (UnitaryAverage ρ) =
      (Fintype.card G : ℂ)⁻¹ * ∑ g : G, Matrix.trace (ρ g : Matrix ι ι ℂ)

def AverageFixedVectors : Prop :=
  ∀ (ρ : G →* unitary (Matrix ι ι ℂ)) (v : ι → ℂ),
    (fun i => ∑ j, UnitaryAverage ρ i j * v j) = v ↔
      ∀ g : G, (fun i => ∑ j, (ρ g : Matrix ι ι ℂ) i j * v j) = v

theorem finiteGroupProjection_expanded (ρ : G →* unitary (Matrix ι ι ℂ)) :
    ExactCriticalCurve.Quantum.finiteGroupProjection ρ =
      (Fintype.card G : ℂ)⁻¹ • ∑ g : G, (ρ g : Matrix ι ι ℂ) := rfl

end FiniteAverage

def ProjectionTraceOneRank {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ P : Matrix ι ι ℂ, Pᴴ = P → P * P = P → Matrix.trace P = 1 → P.rank = 1

def ProjectionTraceOneVector {ι : Type*} [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ P : Matrix ι ι ℂ, Pᴴ = P → P * P = P → Matrix.trace P = 1 →
    ∃ v : ι → ℂ, (∑ i, star (v i) * v i) = 1 ∧
      (fun i j => v i * star (v j)) = P

def EqualPureProjectorsPhase {ι : Type*} [Fintype ι] : Prop :=
  ∀ {u v : ι → ℂ},
    (∑ i, star (u i) * u i) = 1 →
    (∑ i, star (v i) * v i) = 1 →
    (fun i j => u i * star (u j)) = (fun i j => v i * star (v j)) →
    ∃ c : ℂ, Complex.normSq c = 1 ∧ u = c • v

end CriticalCurveExpected

