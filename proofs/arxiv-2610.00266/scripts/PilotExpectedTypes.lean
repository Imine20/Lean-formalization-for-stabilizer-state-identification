  (2 : ℝ)^(-(m : ℝ)/2)*L (2*(r : ℝ)-(m : ℝ))/2-
    ((2 : ℝ)^(-(m : ℝ)/2))^2*(L (2*(r : ℝ)-(m : ℝ))^2/24-(2/3 : ℝ))
