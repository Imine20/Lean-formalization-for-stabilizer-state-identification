def WuLineIsDefect : Prop :=
  ∀ {k : ℕ}, 4 ∣ k →
    ∀ x ∈ Submodule.span (ZMod 2) {fun _ : Fin k => (1 : ZMod 2)},
      (∑ i, ((x i).val : ZMod 4)) = 0

def WuExtensionDimension : Prop :=
  ∀ {k : ℕ}, 0 < k →
    ∀ {N : Submodule (ZMod 2) (Fin k → ZMod 2)},
      (fun _ : Fin k => (1 : ZMod 2)) ∉ N →
      Module.finrank (ZMod 2)
        (N ⊔ Submodule.span (ZMod 2) {fun _ : Fin k => (1 : ZMod 2)} :
          Submodule (ZMod 2) (Fin k → ZMod 2)) = Module.finrank (ZMod 2) N + 1

def WuProjectionProduct : Prop :=
  ∀ {k : ℕ}, 4 ∣ k → ∀ (n : ℕ) (N : Submodule (ZMod 2) (Fin k → ZMod 2)),
    (∀ x ∈ N, (∑ i, ((x i).val : ZMod 4)) = 0) →
    (fun _ : Fin k => (1 : ZMod 2)) ∉ N →
    (CSSColumns n (Submodule.span (ZMod 2) {fun _ : Fin k => (1 : ZMod 2)}) *
      (CSSColumns n (Submodule.span (ZMod 2) {fun _ : Fin k => (1 : ZMod 2)}))ᴴ) *
      (CSSColumns n N * (CSSColumns n N)ᴴ) =
    CSSColumns n (N ⊔ Submodule.span (ZMod 2) {fun _ : Fin k => (1 : ZMod 2)}) *
      (CSSColumns n (N ⊔ Submodule.span (ZMod 2) {fun _ : Fin k => (1 : ZMod 2)}))ᴴ

def WuFiberCardinality : Prop :=
  ∀ {k r : ℕ} (hk : 0 < k) (h4 : 4 ∣ k)
    (M : {M : Submodule (ZMod 2) (Fin k → ZMod 2) //
      (∀ x ∈ M, (∑ i, ((x i).val : ZMod 4)) = 0) ∧
      Module.finrank (ZMod 2) M = r + 1 ∧
      (fun _ : Fin k => (1 : ZMod 2)) ∈ M}),
    Nat.card {N :
      {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
        (∀ x ∈ N, (∑ i, ((x i).val : ZMod 4)) = 0) ∧
        Module.finrank (ZMod 2) N = r ∧
        (fun _ : Fin k => (1 : ZMod 2)) ∉ N} //
      extendWuDefect hk h4 N = M} = 2 ^ r

def WuProjectionSum : Prop :=
  ∀ {k : ℕ}, 0 < k → 4 ∣ k → ∀ n r : ℕ,
    letI : Fintype {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
      (∀ x ∈ N, (∑ i, ((x i).val : ZMod 4)) = 0) ∧
      Module.finrank (ZMod 2) N = r ∧
      (fun _ : Fin k => (1 : ZMod 2)) ∉ N} := Fintype.ofFinite _
    letI : Fintype {M : Submodule (ZMod 2) (Fin k → ZMod 2) //
      (∀ x ∈ M, (∑ i, ((x i).val : ZMod 4)) = 0) ∧
      Module.finrank (ZMod 2) M = r + 1 ∧
      (fun _ : Fin k => (1 : ZMod 2)) ∈ M} := Fintype.ofFinite _
    (CSSColumns n (Submodule.span (ZMod 2) {fun _ : Fin k => (1 : ZMod 2)}) *
      (CSSColumns n (Submodule.span (ZMod 2) {fun _ : Fin k => (1 : ZMod 2)}))ᴴ) *
      (∑ N :
        {N : Submodule (ZMod 2) (Fin k → ZMod 2) //
          (∀ x ∈ N, (∑ i, ((x i).val : ZMod 4)) = 0) ∧
          Module.finrank (ZMod 2) N = r ∧
          (fun _ : Fin k => (1 : ZMod 2)) ∉ N},
        CSSColumns n N.val * (CSSColumns n N.val)ᴴ) =
    ((2 : ℂ) ^ r) •
      (∑ M :
        {M : Submodule (ZMod 2) (Fin k → ZMod 2) //
          (∀ x ∈ M, (∑ i, ((x i).val : ZMod 4)) = 0) ∧
          Module.finrank (ZMod 2) M = r + 1 ∧
          (fun _ : Fin k => (1 : ZMod 2)) ∈ M},
        CSSColumns n M.val * (CSSColumns n M.val)ᴴ)

/-- Fiber equality is equality of the actual subspace sum with the actual target. -/
theorem wuExtensionFiber_condition_expanded {k r : ℕ}
    (hk : 0 < k) (h4 : 4 ∣ k) (N : OrdinaryDefect k r)
    (M : ExceptionalDefect k (r + 1)) :
    extendWuDefect hk h4 N = M ↔
      N.val ⊔ Submodule.span (ZMod 2) {fun _ : Fin k => (1 : ZMod 2)} = M.val := by
  constructor
  · intro h
    exact congrArg Subtype.val h
  · intro h
    exact Subtype.ext h

end CriticalCurveExpected

