def Polynomial {m : ℕ}
    (c : (Fin m → ZMod 4) × ({p : Fin m × Fin m // p.1 < p.2} → ZMod 2))
    (z : Fin m → ZMod 2) : ZMod 4 :=
  (∑ j, c.1 j * ((z j).val : ZMod 4)) +
    2 * ∑ p, ((c.2 p).val : ZMod 4) * ((z p.val.1).val : ZMod 4) *
      ((z p.val.2).val : ZMod 4)

theorem groupAverage_expanded {n : ℕ} (S : StabilizerGroup n)
    (x y : Fin n → ZMod 2) :
    stabilizerProjection S x y = (Nat.card S.carrier : ℂ)⁻¹ *
      ∑ g : S.carrier, Complex.I ^ g.val.phase.val *
        (if x = y + g.val.shift then
          (-1 : ℂ) ^ (∑ j, g.val.clock j * y j : ZMod 2).val else 0) := by
  simp [stabilizerProjection, finiteGroupProjection, StabilizerGroup.representation,
    pauliUnitaryRepresentation, pauliOperator, pauliMatrix, pauliPhase, pauliSign,
    Nat.card_eq_fintype_card, Matrix.sum_apply, Matrix.smul_apply, binaryDot]

theorem tensor_expanded {n k : ℕ} (S : StabilizerGroup n)
    (X Y : Fin k → Fin n → ZMod 2) :
    matrixTensorPower k (stabilizerProjection S) X Y =
      ∏ i, stabilizerProjection S (X i) (Y i) := rfl

theorem coefficientPhase_expanded {n m : ℕ}
    {L : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (b : Basis (Fin m) (ZMod 2) L)
    (c : (Fin m → ZMod 4) × ({p : Fin m × Fin m // p.1 < p.2} → ZMod 2)) (t : L) :
    (phaseDataOfCoefficients b c).phase t = Polynomial c (b.equivFun t) := rfl

theorem criterion_expanded {k m : ℕ} (X Y : Fin k → Fin m → ZMod 2) :
    phaseStatisticsVanish X Y ↔
      (∀ j, (∑ i, ((X i j).val : ZMod 4)) - (∑ i, ((Y i j).val : ZMod 4)) = 0) ∧
      (∀ p : {p : Fin m × Fin m // p.1 < p.2},
        (∑ i, X i p.val.1 * X i p.val.2) -
          (∑ i, Y i p.val.1 * Y i p.val.2) = 0) := Iff.rfl

def ActualAnchorNormalization : Prop :=
