def BinaryVectorSumZero : Prop :=
  ∀ {n : ℕ} (a b : Fin n → ZMod 2), a + b = 0 ↔ a = b

def PauliUnphasedHilbertSchmidt : Prop :=
  ∀ {n : ℕ} (a b c d : Fin n → ZMod 2),
    (∑ x : Fin n → ZMod 2, ∑ y : Fin n → ZMod 2,
      star (pauliMatrix a b y x) * pauliMatrix c d y x) =
      if a = c ∧ b = d then (2 : ℂ) ^ n else 0

def PauliMixedHilbertSchmidt : Prop :=
  ∀ {n : ℕ} (a b : Fin n → ZMod 2) (g : PauliLabel n),
    (∑ x : Fin n → ZMod 2, ∑ y : Fin n → ZMod 2,
      star (pauliMatrix a b y x) * pauliOperator g y x) =
      if a = g.shift ∧ b = g.clock then Complex.I ^ g.phase.val * (2 : ℂ) ^ n else 0

def PauliPhasefulHilbertSchmidt : Prop :=
  ∀ {n : ℕ} (g h : PauliLabel n),
    (∑ x : Fin n → ZMod 2, ∑ y : Fin n → ZMod 2,
      star (pauliOperator g y x) * pauliOperator h y x) =
      if g.shift = h.shift ∧ g.clock = h.clock
      then Complex.I ^ (h.phase - g.phase).val * (2 : ℂ) ^ n else 0

def PauliMaximalCoefficient : Prop :=
  ∀ {n : ℕ} (g h : PauliLabel n),
    (∑ x : Fin n → ZMod 2, ∑ y : Fin n → ZMod 2,
      star (pauliOperator g y x) * pauliOperator h y x) = (2 : ℂ) ^ n ↔ g = h

end CriticalCurveExpected

