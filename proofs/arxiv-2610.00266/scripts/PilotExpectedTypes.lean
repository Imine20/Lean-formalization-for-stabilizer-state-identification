open Lean Elab Command Meta in
def auditOrbitDefinition (actual expected : Name) : CommandElabM Unit := do
  liftTermElabM do
    let info ← getConstInfo actual
    unless info.levelParams.isEmpty do
      throwError "Unexpected universe parameters for definition {actual}"
    let expectedType := mkConst expected
    unless ← isDefEq (← inferType (mkConst actual)) expectedType do
      throwError "Independent definition type mismatch {actual}"
    let kernelEnv := (← getEnv).toKernelEnv
    let limit := (Core.getMaxHeartbeats (← getOptions)).toUSize
    for (label, term) in #[("constant", mkConst actual), ("body", info.value!)] do
      let name ← mkFreshUserName (Name.mkSimple ("definitionAudit_" ++ label))
      let decl : Declaration := .defnDecl {
        name := name, levelParams := [], type := expectedType, value := term,
        hints := .opaque, safety := .safe
      }
      let _ ← ofExceptKernelException <| Kernel.Environment.addDeclCore kernelEnv limit decl none
      logInfo m!"KERNEL_EXPECTED_DEFINITION_OK {label} {actual}"



namespace CompressedOrbitExpected
open Classical Matrix Module ExactCriticalCurve ExactCriticalCurve.Binary ExactCriticalCurve.Quantum
set_option maxHeartbeats 2400000

abbrev V (k : ℕ) := Fin k → ZMod 2
abbrev D (k : ℕ) := Submodule (ZMod 2) (V k)
abbrev M (n k : ℕ) := Matrix (Fin n → V k) (Fin n → V k) ℂ
def ActualSpace (n k : ℕ) : Submodule ℝ (M n k) :=
  Submodule.span ℝ (Set.range (fun T : StochasticLagrangian k =>
    stochasticFixedProjection n k * relationOperator n T.carrier * stochasticFixedProjection n k))
def Ordinary (k r : ℕ) := {N : D k // (∀ x ∈ N, weightQuadratic x = 0) ∧
  finrank (ZMod 2) N = r ∧ (fun _ : Fin k => (1 : ZMod 2)) ∉ N}
def Exceptional (k r : ℕ) := {N : D k // (∀ x ∈ N, weightQuadratic x = 0) ∧
  finrank (ZMod 2) N = r ∧ (fun _ : Fin k => (1 : ZMod 2)) ∈ N}

def RealizedIff : Prop :=
  ∀ {k : ℕ} (r : Fin (k+1)) (b : Bool),
    (∃ N : D k, (∀ x ∈ N, weightQuadratic x = 0) ∧ finrank (ZMod 2) N = r.val ∧
      ((fun _ : Fin k => (1 : ZMod 2)) ∈ N ↔ b = true)) ↔
      if b then Nonempty (Exceptional k r.val) else Nonempty (Ordinary k r.val)
def LabelEquality : Prop :=
  ∀ {k : ℕ} {N M : D k} (hN : IsDefect N) (hM : IsDefect M),
    defectOrbitLabel hN = defectOrbitLabel hM ↔
      finrank (ZMod 2) N = finrank (ZMod 2) M ∧
        ((fun _ : Fin k => (1 : ZMod 2)) ∈ N ↔ (fun _ : Fin k => (1 : ZMod 2)) ∈ M)
def DefectRelationRight : Prop :=
  ∀ {k : ℕ} {N : D k} (hN : IsDefect N),
    hN.stochasticLagrangian.carrier.comap (LinearMap.inr (ZMod 2) (V k) (V k)) = N
def ChosenSubspaceSpec : Prop :=
  ∀ {k : ℕ} (l : DefectOrbitLabel k),
    (∀ x ∈ defectOrbitSubspace l, weightQuadratic x = 0) ∧
      finrank (ZMod 2) (defectOrbitSubspace l) = l.val.1.val ∧
      ((fun _ : Fin k => (1 : ZMod 2)) ∈ defectOrbitSubspace l ↔ l.val.2 = true)
def RepresentativeDefect : Prop :=
  ∀ {k : ℕ} (l : DefectOrbitLabel k),
    (defectOrbitRepresentative l).carrier.comap (LinearMap.inr (ZMod 2) (V k) (V k)) =
      defectOrbitSubspace l
def LabelCard : Prop :=
  ∀ k : ℕ, Fintype.card (DefectOrbitLabel k) =
    Fintype.card {r : Fin (k+1) // Nonempty (OrdinaryDefect k r.val)} +
    Fintype.card {r : Fin (k+1) // Nonempty (ExceptionalDefect k r.val)}
def ActionInvariance : Prop :=
  ∀ {k : ℕ} (n : ℕ) (g h : StochasticIsometryGroup k) (T : StochasticLagrangian k),
    stochasticFixedProjection n k * relationOperator n (stochasticRelation g h T.carrier) *
      stochasticFixedProjection n k =
    stochasticFixedProjection n k * relationOperator n T.carrier * stochasticFixedProjection n k
def LabelInvariance : Prop :=
  ∀ {k : ℕ} (n : ℕ) (T U : StochasticLagrangian k),
    defectOrbitLabel T.rightDefect_isDefect = defectOrbitLabel U.rightDefect_isDefect →
    stochasticFixedProjection n k * relationOperator n T.carrier * stochasticFixedProjection n k =
    stochasticFixedProjection n k * relationOperator n U.carrier * stochasticFixedProjection n k
def RepresentativeEquality : Prop :=
  ∀ {k : ℕ} (n : ℕ) (T : StochasticLagrangian k),
    stochasticFixedProjection n k * relationOperator n T.carrier * stochasticFixedProjection n k =
    stochasticFixedProjection n k * relationOperator n
      (defectOrbitRepresentative (defectOrbitLabel T.rightDefect_isDefect)).carrier *
        stochasticFixedProjection n k
def RepresentativeSpan : Prop :=
  ∀ n k : ℕ, ActualSpace n k =
    Submodule.span ℝ (Set.range (fun l : DefectOrbitLabel k =>
      stochasticFixedProjection n k * relationOperator n (defectOrbitRepresentative l).carrier *
        stochasticFixedProjection n k))
def DimensionLabels : Prop :=
  ∀ n k : ℕ, finrank ℝ (ActualSpace n k) ≤ Fintype.card (DefectOrbitLabel k)
def DimensionClasses : Prop :=
  ∀ n k : ℕ, finrank ℝ (ActualSpace n k) ≤
    Fintype.card {r : Fin (k+1) // Nonempty (OrdinaryDefect k r.val)} +
    Fintype.card {r : Fin (k+1) // Nonempty (ExceptionalDefect k r.val)}

def RealizedType : Type := ∀ k : ℕ, Fin (k+1) → Bool → Prop
def LabelType : Type 1 := ℕ → Type
def FiniteLabelType : Type := ∀ k : ℕ, Fintype (DefectOrbitLabel k)
def LabelMapType : Type := ∀ {k : ℕ} {N : D k}, IsDefect N → DefectOrbitLabel k
def ChosenSubspaceType : Type := ∀ {k : ℕ}, DefectOrbitLabel k → D k
def RepresentativeType : Type := ∀ {k : ℕ}, DefectOrbitLabel k → StochasticLagrangian k
def LabelEquivType : Type :=
  ∀ k : ℕ, DefectOrbitLabel k ≃
    ({r : Fin (k+1) // Nonempty (Ordinary k r.val)} ⊕
     {r : Fin (k+1) // Nonempty (Exceptional k r.val)})

example (k : ℕ) (r : Fin (k+1)) (b : Bool) :
  DefectLabelRealized k r b =
    (∃ N : D k, (∀ x ∈ N, weightQuadratic x = 0) ∧ finrank (ZMod 2) N = r.val ∧
      ((fun _ : Fin k => (1 : ZMod 2)) ∈ N ↔ b = true)) := rfl
example (k : ℕ) : DefectOrbitLabel k =
  {p : Fin (k+1) × Bool // ∃ N : D k, (∀ x ∈ N, weightQuadratic x = 0) ∧
    finrank (ZMod 2) N = p.1.val ∧ ((fun _ : Fin k => (1 : ZMod 2)) ∈ N ↔ p.2 = true)} := rfl
example {k : ℕ} {N : D k} (hN : IsDefect N) :
  (defectOrbitLabel hN).val.1.val = finrank (ZMod 2) N := rfl
example {k : ℕ} {N : D k} (hN : IsDefect N) :
  (defectOrbitLabel hN).val.2 = decide ((fun _ : Fin k => (1 : ZMod 2)) ∈ N) := rfl
example {k : ℕ} (l : DefectOrbitLabel k) :
  defectOrbitSubspace l = Classical.choose l.property := rfl
example {k : ℕ} (l : DefectOrbitLabel k) :
  (defectOrbitRepresentative l).carrier = defectRelation (defectOrbitSubspace l) := rfl
end CompressedOrbitExpected
