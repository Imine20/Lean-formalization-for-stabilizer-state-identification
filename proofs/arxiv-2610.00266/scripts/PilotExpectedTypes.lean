set_option maxHeartbeats 3200000
abbrev Ordinary (k r : ℕ) :=
  {N : Submodule (ZMod 2) (BinaryVector k) //
    (∀ x∈N,weightQuadratic x=0) ∧ finrank (ZMod 2) N=r ∧ allOnes k∉N}
abbrev Family {k r : ℕ} (N : Ordinary k r) (K : Submodule (ZMod 2) (BinaryVector k)) :=
  {M : Ordinary k r // N.val⊓M.val=K ∧ N.val⊓orthogonal M.val=K ∧ M.val⊓orthogonal N.val=K}
abbrev Image {k : ℕ} (K M : Submodule (ZMod 2) (BinaryVector k)) :=
  (M.comap (orthogonal K).subtype).map (K.comap (orthogonal K).subtype).mkQ
abbrev Preimage {k : ℕ} (K : Submodule (ZMod 2) (BinaryVector k))
    (Q : Submodule (ZMod 2) (CSSQuotient K)) :=
  (Q.comap (K.comap (orthogonal K).subtype).mkQ).map (orthogonal K).subtype
abbrev Nu {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (D : ModFourQuadraticSpace V) {d : ℕ} (U : Submodule (ZMod 2) V)
    (b : Basis (Fin d) (ZMod 2) U) := LinearMap.pi fun i => D.pairing (b i).val
abbrev Core {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] (D : ModFourQuadraticSpace V) {d : ℕ}
    (U : Submodule (ZMod 2) V) (hw : D.wu∉U) (b : Basis (Fin d) (ZMod 2) U) :=
  LinearMap.ker (Nu D U b) ⊓
    LinearMap.ker (LinearMap.pi fun i => D.pairing (D.partnerVectors U hw b i))
abbrev CoreEven {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] (D : ModFourQuadraticSpace V) {d : ℕ}
    (U : Submodule (ZMod 2) V) (hU : ∀ x∈U,D.quadratic x=0)
    (hw : D.wu∉U) (b : Basis (Fin d) (ZMod 2) U) :=
  LinearMap.ker ((D.coreQuadraticSpace U hU hw b).pairing (D.coreQuadraticSpace U hU hw b).wu)
abbrev Section {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (D : ModFourQuadraticSpace V) {d : ℕ} (U : Submodule (ZMod 2) V)
    (b : Basis (Fin d) (ZMod 2) U) :=
  {f : (Fin d → ZMod 2) →ₗ[ZMod 2] V // (∀ x,Nu D U b (f x)=x) ∧ ∀ x,D.quadratic (f x)=0}
abbrev Opposite {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (D : ModFourQuadraticSpace V) {d : ℕ} (U : Submodule (ZMod 2) V)
    (b : Basis (Fin d) (ZMod 2) U) :=
  {M : Submodule (ZMod 2) V // (∀ x∈M,D.quadratic x=0) ∧ Function.Bijective ((Nu D U b).domRestrict M)}
def T_partnerVectors_quadratic {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (D : ModFourQuadraticSpace V) [FiniteDimensional (ZMod 2) V] : Prop :=
  ∀ {d : ℕ} (U : Submodule (ZMod 2) V) (hU : ∀ x∈U,D.quadratic x=0)
    (hw : D.wu∉U) (b : Basis (Fin d) (ZMod 2) U), ∀ i,D.quadratic (D.partnerVectors U hw b i)=0

def T_partnerVectors_pairing_left {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (D : ModFourQuadraticSpace V) [FiniteDimensional (ZMod 2) V] : Prop :=
  ∀ {d : ℕ} (U : Submodule (ZMod 2) V) (hU : ∀ x∈U,D.quadratic x=0)
    (hw : D.wu∉U) (b : Basis (Fin d) (ZMod 2) U), ∀ i j,D.pairing (b j).val (D.partnerVectors U hw b i)=if i=j then 1 else 0

def T_partnerVectors_pairing {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (D : ModFourQuadraticSpace V) [FiniteDimensional (ZMod 2) V] : Prop :=
  ∀ {d : ℕ} (U : Submodule (ZMod 2) V) (hU : ∀ x∈U,D.quadratic x=0)
    (hw : D.wu∉U) (b : Basis (Fin d) (ZMod 2) U), ∀ i j,D.pairing (D.partnerVectors U hw b i) (D.partnerVectors U hw b j)=0

def T_partnerVectors_wu {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (D : ModFourQuadraticSpace V) [FiniteDimensional (ZMod 2) V] : Prop :=
  ∀ {d : ℕ} (U : Submodule (ZMod 2) V) (hU : ∀ x∈U,D.quadratic x=0)
    (hw : D.wu∉U) (b : Basis (Fin d) (ZMod 2) U), ∀ i,D.pairing D.wu (D.partnerVectors U hw b i)=0

def T_ordinaryCoordinates_quadratic {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    (D : ModFourQuadraticSpace V) [FiniteDimensional (ZMod 2) V] : Prop :=
  ∀ {d : ℕ} (U : Submodule (ZMod 2) V) (hU : ∀ x∈U,D.quadratic x=0)
    (hw : D.wu∉U) (b : Basis (Fin d) (ZMod 2) U), ∀ (a z : Fin d → ZMod 2) (x : Core D U hw b),
    D.quadratic (D.ordinaryCoordinates U hU hw b (a,x,z))=
      D.quadratic x.val+2*bitLift (∑ i,a i*z i)

def T_ordinaryCoordinates_pairing {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] (D : ModFourQuadraticSpace V) : Prop :=
  ∀ {d : ℕ} (U : Submodule (ZMod 2) V) (hU : ∀ x∈U,D.quadratic x=0)
    (hw : D.wu∉U) (b : Basis (Fin d) (ZMod 2) U), ∀ (a z a' z' : Fin d → ZMod 2) (x y : Core D U hw b),
    D.pairing (D.ordinaryCoordinates U hU hw b (a,x,z))
      (D.ordinaryCoordinates U hU hw b (a',y,z'))=
      D.pairing x.val y.val+(∑ i,a i*z' i)+(∑ i,a' i*z i)

def T_core_finrank_add {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
