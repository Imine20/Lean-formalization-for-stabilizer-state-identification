def ShorteningLabelObject : Type :=
  ∀ {m : ℕ}, Odd m →
    (Fin m → ZMod 2) ≃ₗ[ZMod 2] (ZMod 2 × CSSQuotient (wuLine (m+1)))

def ShorteningUnitaryObject : Type :=
  ∀ {m : ℕ} (n : ℕ), 4 ∣ m+1 →
    ((Fin n → Fin m → ZMod 2) → ℂ) ≃ₗ[ℂ] freeWuCode n m

def ShorteningDefectObject : Type :=
  ∀ {m : ℕ}, 4 ∣ m+1 → ∀ r : ℕ,
    OrdinaryDefect m r ≃ ExceptionalDefect (m+1) (r+1)

def ShorteningLabelInjective : Prop :=
  ∀ {m : ℕ}, Odd m → Function.Injective (shorteningLabelMap m)

def ShorteningLabelSurjective : Prop :=
  ∀ {m : ℕ}, Odd m → Function.Surjective (shorteningLabelMap m)

def ShorteningLabelFormula : Prop :=
  ∀ {m : ℕ} (hm : Odd m) (x : Fin m → ZMod 2),
    shorteningLabelEquiv hm x =
      (binaryDot x (allOnes m), Submodule.Quotient.mk (shorteningIotaOrth m x))

def ShorteningUnitaryEntry : Prop :=
  ∀ {m : ℕ} (n : ℕ) (hm : Odd m)
    (b : Fin n → ZMod 2) (Y : Fin n → Fin (m+1) → ZMod 2) (X : Fin n → Fin m → ZMod 2),
    shorteningSynthesis n hm (b,Y) X =
      if b = fun a => shorteningParity m (X a) then
        cssColumnSynthesis n (wuLine (m+1)) Y
          (fun a => Submodule.Quotient.mk (shorteningIotaOrth m (X a))) else 0

def ShorteningUnitaryLeft : Prop :=
  ∀ {m : ℕ} (n : ℕ) (h4 : 4 ∣ m+1),
    (shorteningSynthesis n (shortening_predecessor_odd h4))ᴴ *
      shorteningSynthesis n (shortening_predecessor_odd h4) = 1

def ShorteningUnitaryRight : Prop :=
  ∀ {m : ℕ} (n : ℕ) (hm : Odd m),
    shorteningSynthesis n hm * (shorteningSynthesis n hm)ᴴ =
      (1 : Matrix (Fin n → ZMod 2) (Fin n → ZMod 2) ℂ) ⊗ₖ
        cssColumnProjection n (wuLine (m+1))

def ShorteningUnitaryRange : Prop :=
  ∀ {m : ℕ} (n : ℕ) (hm : Odd m),
    LinearMap.range (shorteningSynthesis n hm).mulVecLin = freeWuCode n m

def ShorteningUnitaryInner : Prop :=
  ∀ {m : ℕ} (n : ℕ) (h4 : 4 ∣ m+1) (v w : (Fin n → Fin m → ZMod 2) → ℂ),
    star (shorteningSynthesis n (shortening_predecessor_odd h4) *ᵥ v) ⬝ᵥ
      (shorteningSynthesis n (shortening_predecessor_odd h4) *ᵥ w) = star v ⬝ᵥ w

def ShorteningRestrictExtend : Prop :=
  ∀ {m : ℕ} (M : Submodule (ZMod 2) (Fin m → ZMod 2)),
    shorteningRestrict (shorteningExtend M) = M

def ShorteningExtendRestrict : Prop :=
  ∀ {m : ℕ} (N : Submodule (ZMod 2) (Fin (m+1) → ZMod 2)),
    allOnes (m+1) ∈ N → shorteningExtend (shorteningRestrict N) = N

def ShorteningExtendRank : Prop :=
  ∀ {m : ℕ} (M : Submodule (ZMod 2) (Fin m → ZMod 2)),
    Module.finrank (ZMod 2) (shorteningExtend M) = Module.finrank (ZMod 2) M + 1

def ShorteningExtendQuadratic : Prop :=
  ∀ {m : ℕ}, 4 ∣ m+1 → ∀ M : Submodule (ZMod 2) (Fin m → ZMod 2),
    IsDefect M → IsDefect (shorteningExtend M)

def ShorteningOrdinary : Prop :=
  ∀ {m : ℕ}, 4 ∣ m+1 → ∀ M : Submodule (ZMod 2) (Fin m → ZMod 2),
    IsDefect M → allOnes m ∉ M

def ShorteningMonotone : Prop :=
  ∀ {m : ℕ} {M L : Submodule (ZMod 2) (Fin m → ZMod 2)},
    M ≤ L → shorteningExtend M ≤ shorteningExtend L

end ShorteningFoundationExpected

