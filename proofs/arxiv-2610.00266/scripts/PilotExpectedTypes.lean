  ∀ {n m k : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)} (a : Fin n → ZMod 2)
    (b : Basis (Fin m) (ZMod 2) L) (X Y : Fin k → Fin m → ZMod 2),
    (∑ c : (Fin m → ZMod 4) × ({p : Fin m × Fin m // p.1<p.2} → ZMod 2),
      ∏ i, stabilizerProjection (phaseStabilizer a (phaseDataOfCoefficients b c))
        (a+(b.equivFun.symm (X i)).val) (a+(b.equivFun.symm (Y i)).val)) =
      if phaseStatisticsVanish X Y then
        (Nat.card ((Fin m → ZMod 4) × ({p : Fin m × Fin m // p.1<p.2} → ZMod 2)) : ℂ) *
          ((2 : ℂ) ^ (m*k))⁻¹ else 0

def ActualCoefficientTensorSumCounted : Prop :=
  ∀ {n m k : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)} (a : Fin n → ZMod 2)
    (b : Basis (Fin m) (ZMod 2) L) (X Y : Fin k → Fin m → ZMod 2),
    (∑ c : (Fin m → ZMod 4) × ({p : Fin m × Fin m // p.1<p.2} → ZMod 2),
      ∏ i, stabilizerProjection (phaseStabilizer a (phaseDataOfCoefficients b c))
        (a+(b.equivFun.symm (X i)).val) (a+(b.equivFun.symm (Y i)).val)) =
      if phaseStatisticsVanish X Y then
        ((4 ^ m * 2 ^ (Nat.choose m 2) : ℕ) : ℂ) * ((2 : ℂ) ^ (m*k))⁻¹ else 0

def ActualCoefficientTensorOutsideSum : Prop :=
  ∀ {n m k : ℕ} {L : Submodule (ZMod 2) (Fin n → ZMod 2)} (a : Fin n → ZMod 2)
    (b : Basis (Fin m) (ZMod 2) L) (X Y : Fin k → Fin n → ZMod 2),
    ((∃ i, X i - a ∉ L) ∨ (∃ i, Y i - a ∉ L)) →
      (∑ c : (Fin m → ZMod 4) × ({p : Fin m × Fin m // p.1<p.2} → ZMod 2),
        ∏ i, stabilizerProjection (phaseStabilizer a (phaseDataOfCoefficients b c))
          (X i) (Y i)) = 0

end PhaseProjectorExpected
