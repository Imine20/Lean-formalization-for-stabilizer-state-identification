example (n k : ℕ) (a : PhysicalSectorLabel k) : physicalSectorWeight n k a=
  (finrank ℂ (LinearMap.range (physicalSectorGrade n k a).mulVecLin):ℝ)/
    Fintype.card (StabilizerGroup n) := rfl
example (n k : ℕ) : physicalFiniteSuccess n k=
  (∑ a : PhysicalSectorLabel k, physicalSectorWeight n k a*Real.sqrt (physicalGramSectorValue n k a))^2 := rfl
end PhysicalGramExpected

open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let modules := #[`ExactCriticalCurve.Quantum.PhysicalSpectrum,`ExactCriticalCurve.Quantum.PhysicalGramSpectrum,`ExactCriticalCurve.Quantum.PhysicalFiniteSuccess]
  let mut declarations := 0
  let mut theorems := 0
  let mut closure : CollectAxioms.State := {}
  for (name, info) in env.constants.toList do
    let inPackage := match env.getModuleIdxFor? name with
      | some idx => modules.contains env.header.moduleNames[idx]!
      | none => false
    if inPackage then
      declarations := declarations + 1
      if let .thmInfo _ := info then theorems := theorems + 1
      if let .axiomInfo _ := info then throwError "Unproved project axiom: {name}"
      let (_, next) := ((CollectAxioms.collect name).run env).run closure
      closure := next
      for ax in closure.axioms do
        unless #[`propext, `Classical.choice, `Quot.sound].contains ax do
          throwError "Forbidden transitive axiom {ax} in {name}"
      logInfo m!"NEW_DECLARATION_AXIOMS_OK {name}"
  logInfo m!"PROJECT_AXIOMS_UNION {closure.axioms}"
  logInfo m!"PROJECT_AUDIT_OK declarations={declarations} theorems={theorems}"
end


/- Independent right-lambda product and bulk expansion expected types. -/
namespace RightLambdaIndependentExpected
open Classical
open scoped BigOperators
universe u

def A : ℝ := ∏' j : ℕ, (1+(1/2 : ℝ)^(j+1))
def Q : ℝ := ∏' j : ℕ, (1-(1/4 : ℝ)^(j+1))
def AP (n : ℕ) : ℝ := ∏ j ∈ Finset.range n, (1+(1/2 : ℝ)^(j+1))
def BP (n : ℕ) : ℝ := ∏ j ∈ Finset.range n, (1-(1/2 : ℝ)^(j+1))
def F (r : ℕ) (x : ℝ) : ℝ :=
  (2 : ℝ)^((r : ℝ)*((r : ℝ)-1)) /
    (∏ j ∈ Finset.range r, ((2 : ℝ)^(j+1)-1)) *
      (∏ j ∈ Finset.range r, (x+(2 : ℝ)^(1-(j : ℝ))))
def R (c : ℤ) : ℝ := if c ≤ 1 then AP (1-c).toNat
  else (∏ j ∈ Finset.range (c-1).toNat, (1+(2 : ℝ)^j))⁻¹
def Lambda0 (c : ℤ) : ℝ := (2 : ℝ)^(((c : ℝ)-1)*((c : ℝ)-2)/2+1)*Q*R c
def Lambda (c : ℤ) (r : ℕ) : ℝ := Lambda0 c*F r ((2 : ℝ)^(3-(c : ℝ)))
def Weight (c : ℤ) (r : ℕ) : ℝ :=
  (2 : ℝ)^(-((2*(r : ℝ)-(c : ℝ))^2+3*(2*(r : ℝ)-(c : ℝ))+4)/2) *
    (1+(2 : ℝ)^(-(2*(r : ℝ)-(c : ℝ))-2))/(A*Q)
def L (v : ℝ) : ℝ := 4*(2 : ℝ)^(v/2)-(2 : ℝ)^(-v/2)
def Error (m r : ℕ) : ℝ :=
  Lambda (m : ℤ) r-1-(2 : ℝ)^(-(m : ℝ)/2)*L (2*(r : ℝ)-(m : ℝ))-
    ((2 : ℝ)^(-(m : ℝ)/2))^2*((L (2*(r : ℝ)-(m : ℝ)))^2-4)/3

def FiniteCoefficient {ι : Type u} : Prop :=
  ∀ (s : Finset ι) (f : ι → ℝ),
    |((∑ i ∈ s, f i)^2-(∑ i ∈ s, (f i)^2))/2| ≤ (∑ i ∈ s, |f i|)^2/2

def FiniteRemainder {ι : Type u} : Prop :=
  ∀ (s : Finset ι) (f : ι → ℝ),
    |(∏ i ∈ s, (1+f i))-1-(∑ i ∈ s, f i)-
      ((∑ i ∈ s, f i)^2-(∑ i ∈ s, (f i)^2))/2| ≤
      (∑ i ∈ s, |f i|)^3*(∏ i ∈ s, (1+|f i|))

def FiniteExpRemainder {ι : Type u} : Prop :=
  ∀ (s : Finset ι) (f : ι → ℝ),
    |(∏ i ∈ s, (1+f i))-1-(∑ i ∈ s, f i)-
      ((∑ i ∈ s, f i)^2-(∑ i ∈ s, (f i)^2))/2| ≤
      Real.exp (∑ i ∈ s, |f i|)*(∑ i ∈ s, |f i|)^3

def InfiniteExpRemainder {ι : Type u} : Prop :=
  ∀ f : ι → ℝ, Summable (fun i => |f i|) →
    |(∏' i, (1+f i))-1-(∑' i, f i)-
      ((∑' i, f i)^2-(∑' i, (f i)^2))/2| ≤
      Real.exp (∑' i, |f i|)*(∑' i, |f i|)^3

def SignedProductError : Prop :=
  ∀ x y : ℝ, 0 ≤ x → 0 ≤ y →
    |((∏' j : ℕ, (1-x*(1/2 : ℝ)^(j+1)))*
        (∏' j : ℕ, (1+y*(1/2 : ℝ)^(j+1))))-1-(y-x)-
          ((y-x)^2-(x^2+y^2)/3)/2| ≤ Real.exp (x+y)*(x+y)^3

def LambdaZeroProduct : Prop := ∀ m : ℕ, 2 ≤ m → Lambda0 (m : ℤ)=Q/AP (m-2)
def FProduct : Prop := ∀ (c : ℝ) (r : ℕ),
  F r ((2 : ℝ)^(3-c))=(∏ j ∈ Finset.range r, (1+(2 : ℝ)^((j : ℝ)+2-c)))/BP r
def LambdaProduct : Prop := ∀ m r : ℕ, 2 ≤ m →
  Lambda (m : ℤ) r=Q*(∏ j ∈ Finset.range r, (1+(2 : ℝ)^((j : ℝ)+2-(m : ℝ)))) /
    (AP (m-2)*BP r)
def WindowBase : Prop := ∀ N : ℕ,
  (∏ j ∈ Finset.range (N+1), (1+(2 : ℝ)^((j : ℝ)-N)))=2*AP N

def WindowBound : Prop := ∀ N r : ℕ,
  (∏ j ∈ Finset.range r, (1+(2 : ℝ)^((j : ℝ)-N))) ≤
    2*A*(2 : ℝ)^(((r-(N+1) : ℕ) : ℝ)*(((r-(N+1) : ℕ) : ℝ)+3)/2)
def LambdaGlobal : Prop := ∀ m r : ℕ, 2 ≤ m →
  Lambda (m : ℤ) r ≤ 2*A^2*(2 : ℝ)^(((r+1-m : ℕ) : ℝ)*(((r+1-m : ℕ) : ℝ)+3)/2)
def WeightedMoments : Prop := ∀ m r j : ℕ, 2 ≤ m → j ≤ 2 →
  Weight (m : ℤ) r*Lambda (m : ℤ) r^j ≤
    (8*A^3/Q)*(2 : ℝ)^(-(2*(r : ℝ)-(m : ℝ))^2/4+4*|2*(r : ℝ)-(m : ℝ)|)

def SplitProduct : Prop := ∀ (a : ℝ) (r : ℕ),
  (∏ j ∈ Finset.range r, (1+a*(1/2 : ℝ)^(j+1))) *
    (∏' j : ℕ, (1+(a*(1/2 : ℝ)^r)*(1/2 : ℝ)^(j+1))) =
      (∏' j : ℕ, (1+a*(1/2 : ℝ)^(j+1)))
def ReverseProduct : Prop := ∀ (a : ℝ) (r : ℕ),
  (∏ j ∈ Finset.range r, (1+a*(2 : ℝ)^j)) =
    (∏ j ∈ Finset.range r, (1+(a*(2 : ℝ)^r)*(1/2 : ℝ)^(j+1)))
def QuotientInfiniteProducts : Prop := ∀ N r : ℕ,
  Q*(∏ j ∈ Finset.range r, (1+(1/2 : ℝ)^N*(2 : ℝ)^j))/(AP N*BP r) =
    (∏' j : ℕ, (1-(1/2 : ℝ)^r*(1/2 : ℝ)^(j+1))) *
    (∏' j : ℕ, (1+((1/2 : ℝ)^N*(2 : ℝ)^r)*(1/2 : ℝ)^(j+1)))
def LambdaInfiniteProducts : Prop := ∀ m r : ℕ, 2 ≤ m →
  Lambda (m : ℤ) r =
    (∏' j : ℕ, (1-(1/2 : ℝ)^r*(1/2 : ℝ)^(j+1))) *
    (∏' j : ℕ, (1+(2 : ℝ)^((r : ℝ)+2-(m : ℝ))*(1/2 : ℝ)^(j+1)))
def LambdaSecondOrder : Prop := ∀ m r : ℕ, 2 ≤ m →
  |Error m r| ≤ Real.exp ((1/2 : ℝ)^r+(2 : ℝ)^((r : ℝ)+2-(m : ℝ)))*
    ((1/2 : ℝ)^r+(2 : ℝ)^((r : ℝ)+2-(m : ℝ)))^3
def LambdaBulk : Prop := ∀ m r : ℕ, 8 ≤ m →
  |2*(r : ℝ)-(m : ℝ)| ≤ (m : ℝ)/4 →
  |Error m r| ≤ 125*Real.exp 1*((2 : ℝ)^(-(m : ℝ)/2))^3 *
    (2 : ℝ)^(3*|2*(r : ℝ)-(m : ℝ)|/2)
end RightLambdaIndependentExpected
