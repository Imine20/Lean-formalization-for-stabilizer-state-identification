def TensorPowerTrace {α : Type u} [Fintype α] : Prop :=
  ∀ (n : ℕ) (A : Matrix α α ℂ),
    (∑ X : Fin n → α, ∏ a : Fin n, A (X a) (X a)) = (∑ x : α, A x x) ^ n


def TensorEntries {α : Type u} (n : ℕ) (A : Matrix α α ℂ) :
    Matrix (Fin n → α) (Fin n → α) ℂ :=
  fun X Y => ∏ a : Fin n, A (X a) (Y a)

def TensorOrderedProduct {α : Type u} [Fintype α] [DecidableEq α] : Prop :=
  ∀ (n : ℕ) (As : List (Matrix α α ℂ)),
    TensorEntries n As.prod = (As.map (TensorEntries n)).prod

def TensorOrderedTrace {α : Type u} [Fintype α] [DecidableEq α] : Prop :=
  ∀ (n : ℕ) (As : List (Matrix α α ℂ)),
    (∑ X : Fin n → α, (As.map (TensorEntries n)).prod X X) =
      (∑ x : α, As.prod x x) ^ n

end CriticalCurveExpected

