namespace PhysicalWeightFiniteFullGuards
open ExactCriticalCurve.Quantum ExactCriticalCurve.Binary

def expectedShorteningLabelEquiv {m : ℕ} (h4 : 4∣m+1) :
    {r : Fin (m+1) // Nonempty (OrdinaryDefect m r.val)} ≃
      {r : Fin (m+2) // Nonempty (ExceptionalDefect (m+1) r.val)} where
  toFun a := ⟨⟨a.val.val+1,by have hb:=a.val.isLt;omega⟩,
    a.property.map (shorteningDefectEquiv h4 a.val.val)⟩
  invFun a := ⟨⟨a.val.val-1,by
      have hp:=exceptionalDefect_rank_pos (by omega : 0<m+1) a.property.some
      have hb:=a.val.isLt
      omega⟩,by
    have hp:=exceptionalDefect_rank_pos (by omega : 0<m+1) a.property.some
    have he : a.val.val-1+1=a.val.val := by omega
    exact (show Nonempty (ExceptionalDefect (m+1) (a.val.val-1+1)) by simpa only [he] using a.property).map
      (shorteningDefectEquiv h4 (a.val.val-1)).symm⟩
  left_inv a := by apply Subtype.ext;apply Fin.ext;simp
  right_inv a := by
    apply Subtype.ext
    apply Fin.ext
    have hp:=exceptionalDefect_rank_pos (by omega : 0<m+1) a.property.some
    change a.val.val-1+1=a.val.val
    omega
example {m : ℕ} (h4 : 4∣m+1) : shorteningSectorLabelEquiv h4=expectedShorteningLabelEquiv h4 := rfl
