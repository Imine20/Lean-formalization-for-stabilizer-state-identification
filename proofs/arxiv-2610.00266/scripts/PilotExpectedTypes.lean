    (hw : D.wu∉U) (b : Basis (Fin d) (ZMod 2) U), finrank (ZMod 2) (CoreEven D U hU hw b)+1=finrank (ZMod 2) (Core D U hw b)

def T_singularSection_card {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] (D : ModFourQuadraticSpace V) : Prop :=
  ∀ {d : ℕ} (U : Submodule (ZMod 2) V) (hU : ∀ x∈U,D.quadratic x=0)
    (hw : D.wu∉U) (b : Basis (Fin d) (ZMod 2) U), Nat.card (Section D U b)=2^(d*(finrank (ZMod 2) V-2*d-1)+d.choose 2)

def T_singularOpposite_card {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] (D : ModFourQuadraticSpace V) : Prop :=
