namespace NonsingularWuContentGuards
open ExactCriticalCurve.FiniteQuadratic ExactCriticalCurve.FiniteQuadratic.NonsingularWu ExactCriticalCurve.Counting
variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
variable (Q : QuadraticForm (ZMod 2) V) (w v : V) (hwv : Q.polarBilin w v=1)
example : complement Q w v = LinearMap.ker (Q.polarBilin w) ⊓ LinearMap.ker (Q.polarBilin v) := rfl
example (x : V) : projectionLinear Q w v x=x+Q.polarBilin v x • w+Q.polarBilin w x • v := rfl
example (x : V) : (projection Q w v hwv x).val=x+Q.polarBilin v x • w+Q.polarBilin w x • v := rfl
example (x : V) : coordinates Q w v hwv x=(projection Q w v hwv x,Q.polarBilin v x,Q.polarBilin w x) := rfl
example (u : complement Q w v) (a b : ZMod 2) : (coordinates Q w v hwv).symm (u,a,b)=u.val+a • w+b • v := rfl
example (x y : complement Q w v) : complementPairing Q w v x y=Q.polarBilin x.val y.val := rfl
example : stabilizer Q w=MulAction.stabilizer (BinaryQuadraticIsometryGroup Q) w := rfl
example (g : stabilizer Q w) (x : complement Q w v) : reductionLinear Q w v hwv g x=projection Q w v hwv (g.val.val x.val) := rfl
example (g : stabilizer Q w) (x : complement Q w v) : (reduction Q w v hwv g).val x=projection Q w v hwv (g.val.val x.val) := rfl
example (h : BinarySymplecticIsometryGroup (complementPairing Q w v)) (x : complement Q w v) : correction Q w v h x=Q x.val+Q (h.val x).val := rfl
example : perp Q w=LinearMap.ker (Q.polarBilin w) := rfl
example (h : BinarySymplecticIsometryGroup (complementPairing Q w v)) (x : perp Q w) :
    partialLift Q w v hwv h x=(h.val (projection Q w v hwv x.val)).val+
      (Q.polarBilin v x.val+correction Q w v h (projection Q w v hwv x.val)) • w := rfl
example (x : V) : transvectionLinear Q w x=x+Q.polarBilin w x • w := rfl
example (hw : Q w=1) (x : V) : (transvection Q w hw).val.val x=x+Q.polarBilin w x • w := rfl
example (g : stabilizer Q w) : fixedPerp Q w g=fixedSubmodule (ZMod 2) V g ⊓ LinearMap.ker (Q.polarBilin w) := rfl
example (hw : Q w=1) (g : stabilizer Q w) (x : fixedPerp Q w g) :
    (fixedPerpEquiv Q w v hwv hw g x).1.val=projection Q w v hwv x.val := rfl
example (hw : Q w=1) (g : stabilizer Q w) (x : fixedPerp Q w g) :
    (fixedPerpEquiv Q w v hwv hw g x).2=Q.polarBilin v x.val := rfl
example (g : stabilizer Q w) (x : fixedSubmodule (ZMod 2) V g) : fixedParity Q w g x=Q.polarBilin w x.val := rfl
example (g : stabilizer Q w) (x : LinearMap.ker (fixedParity Q w g)) : (fixedParityKerEquiv Q w g x).val=x.val.val := rfl
example (g : stabilizer Q w) : HasFixedOutside Q w g ↔ ∃ x : V, g.val.val x=x ∧ Q.polarBilin w x=1 := Iff.rfl
variable [FiniteDimensional (ZMod 2) V]
variable (hQ : LinearMap.BilinForm.Nondegenerate Q.polarBilin) (hw : Q w=1)
example (h : BinarySymplecticIsometryGroup (complementPairing Q w v)) :
    goodLift Q w v hwv hQ hw h=(exists_good_lift Q w v hwv hQ hw h).choose := rfl
example (p : BinarySymplecticIsometryGroup (complementPairing Q w v) × Bool) :
    pairLift Q w v hwv hQ hw p=if p.2 then transvection Q w hw*goodLift Q w v hwv hQ hw p.1 else goodLift Q w v hwv hQ hw p.1 := rfl
example (p : BinarySymplecticIsometryGroup (complementPairing Q w v) × Bool) :
    groupEquiv Q w v hwv hQ hw p=pairLift Q w v hwv hQ hw p := rfl
end NonsingularWuContentGuards

